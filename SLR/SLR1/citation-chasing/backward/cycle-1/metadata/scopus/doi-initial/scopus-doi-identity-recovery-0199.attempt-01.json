      "title": "Bibliometric Analysis of Model-Based Systems Engineering: Past, Current, and Future",
      "authors": [
        {
          "name": "Li Z."
        },
        {
          "name": "Wang G."
        },
        {
          "name": "Lu J."
        },
        {
