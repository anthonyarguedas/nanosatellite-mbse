      <data key="d4">{"artifact_or_process_linked": "Stakeholder needs/objectives/constraints; model elements and relationships from domain/enterprise to segments/subsystems.", "claim_text": "Compared with negotiating a pre-MBSE CRM requirements document, the MBSE process lets SSWG work with university teams to define model elements and relationships across the CubeSat domain and system hierarchy.", "evidence_source": "Section 6: \"A traditional pre-MBSE approach would be to negotiate a CRM requirements document and then to develop the model. In MBSE, the SSWG works with the university teams to define the model elements and relationships...\"", "extractor_confidence": "high", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Stakeholder alignment process is described, but no stakeholder evaluation or decision-quality measure is reported.", "source_claim_id": "C7_stakeholder_alignment_vs_document_process", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[4].extraction.claimed_outcomes_value_mechanisms_evidence[6]", "study_id": "paper-0005", "threats_or_alternative_explanations": "The process may reflect collaboration style rather than model-specific value; no stakeholder/user evaluation is reported."}</data>
    </node>
    <node id="paper-0005::claim-08">
