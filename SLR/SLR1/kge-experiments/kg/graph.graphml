      <data key="d4">{"artifact_or_process_linked": "SSWG model distribution and use process for classroom examples and mission-specific CubeSat teams.", "claim_text": "Distribution mechanisms such as MagicDraw, ZIP/XMI, OpenMBEE, Teamcenter, walk-throughs, and user feedback could support model sharing and reuse.", "evidence_source": "Section III.B: 'The SSWG team is developing a model distribution process to share to external entities...' Figure 9 lists 'MagicDraw, ZIP File, XMI File, OpenMBEE, and Teamcenter.' Conclusion: team 'hopes to release the models publicly in the near future.'", "extractor_confidence": "medium", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Future/planned effect: external entities can receive and adapt the reference model after distribution/licensing are resolved.", "quote_location": "Section III.B Model Use and Distribution; Figure 9; Conclusion.", "source_claim_id": "C7", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[14].extraction.claimed_outcomes_value_mechanisms_evidence[6]", "study_id": "paper-0022", "threats_or_alternative_explanations": "Distribution is not yet completed; licensing/copyright choices and actual external reuse are not reported."}</data>
