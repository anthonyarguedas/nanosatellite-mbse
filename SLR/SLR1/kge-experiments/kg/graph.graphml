      <data key="d5">HAS_LIMITATION</data>
      <data key="d6">structured_limitations.limitation_assessments[]</data>
      <data key="d7">no_physical_test_or_flight_evidence</data>
      <data key="d8">The study is restricted to preliminary design simulations and does not report hardware integration, environmental test, operations, or flight evidence for MBSE outcomes.</data>
