      <data key="d7">consistency</data>
      <data key="d8" />
      <data key="d9">Section 1: "The combination of Model-Based Systems Engineering (MBSE) and Systems Modeling Language (SysML) emerged as an alternative management and design approach that improves mission reliability ... Typical advantages of MBSE are that it provides better traceability, design consistency, quality improvement, and reduced document management overhead."</data>
      <data key="d10">high</data>
      <data key="d11">{"claim_id": "paper-0023::claim-03", "claim_text": "MBSE/SysML improves mission reliability and provides traceability, design consistency, quality improvement, and reduced document-management overhead compared with traditional DBSE.", "evidence_confidence": "Unsupported", "observed_effect": "Claimed generic improvement, not evaluated in MASAT1.", "source_claim_id": "C3", "source_path": "studies[15].extraction.claimed_outcomes_value_mechanisms_evidence[2]", "source_record_id": "paper-0023::claim-03", "study_id": "paper-0023"}</data>
    </edge>
