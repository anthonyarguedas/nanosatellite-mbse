      <data key="d7">decision support</data>
      <data key="d8" />
      <data key="d9">Different configurations of solar panel areas and maximum battery capacity were traded off to compare on-board energy levels and... orbital altitudes and ground station network configurations were traded off to compare quantity of data downloaded.</data>
      <data key="d10">medium</data>
      <data key="d11">{"claim_id": "paper-0011::claim-07", "claim_text": "Earlier phases of the CSRM/RAX lineage enabled model-based trade studies of solar-panel area, battery capacity, orbit altitude, and ground-station networks to compare energy and data-downlink outcomes.", "evidence_confidence": "Weak", "observed_effect": "Trade studies are reported as having been carried out; this paper does not present effect sizes or trade results.", "source_claim_id": "C7", "source_path": "studies[8].extraction.claimed_outcomes_value_mechanisms_evidence[6]", "source_record_id": "paper-0011::claim-07", "study_id": "paper-0011"}</data>
