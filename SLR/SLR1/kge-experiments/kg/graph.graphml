      <data key="d3">Claim</data>
      <data key="d4">{"artifact_or_process_linked": "TTC properties, ground-station visibility, contact windows, link/data budget simulation.", "claim_text": "Link/data-budget simulations verify downlink/uplink feasibility and support subsystem design optimization for real-time data delivery objectives.", "evidence_source": "Finally, communication simulations were used to verify the feasibility of data downlink scenarios, accounting for antenna configurations, ground station visibility, and bandwidth allocation.", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "metric_detail": "Total uplink/downlink data volumes and per-contact data bars.", "observed_effect_or_qualitative_effect": "Rendered figure reports total uplink 57.97 MB and total downlink 30.47 MB; no required threshold or comparator is stated.", "source_claim_id": "C5_communication_data_budget_feasibility", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[26].extraction.claimed_outcomes_value_mechanisms_evidence[4]", "study_id": "paper-0043", "threats_or_alternative_explanations": "Downlink feasibility may change with higher-fidelity antenna, ground-network, protocol, and operations assumptions."}</data>
    </node>
