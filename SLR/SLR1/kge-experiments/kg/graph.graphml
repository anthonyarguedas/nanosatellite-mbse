      <data key="d11">{"claim_id": "paper-0054::claim-02", "source_claim_id": "C2", "source_path": "studies[29].extraction.claimed_outcomes_value_mechanisms_evidence[1]", "source_record_id": "paper-0054::claim-02", "study_id": "paper-0054"}</data>
