      <data key="d11">{"assessment": "limitation_present", "limitation_type": "controlled_flag", "source": "author_stated", "source_path": "studies[38].structured_limitations.limitation_assessments[9]", "source_record_id": "paper-0080::limitation-10", "study_id": "paper-0080"}</data>
