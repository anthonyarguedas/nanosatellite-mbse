    <edge source="paper-0022" target="paper-0022::claim-05" id="e0002066">
      <data key="d5">HAS_CLAIM</data>
      <data key="d6">claimed_outcomes_value_mechanisms_evidence[]</data>
      <data key="d7">Phase-specific reference models can make MBSE adoption more gradual for CubeSat teams new to SysML/MBSE and ease model modification.</data>
      <data key="d8" />
      <data key="d9">'Providing a fully-formed CubeSat Reference Model could be a bit overwhelming... Having models for each life-cycle phase is a more gradual way to get up to speed. That should also make it easier for a team to modify, add, and remove SysML elements...'</data>
      <data key="d10">medium</data>
      <data key="d11">{"claim_id": "paper-0022::claim-05", "source_claim_id": "C5", "source_path": "studies[14].extraction.claimed_outcomes_value_mechanisms_evidence[4]", "source_record_id": "paper-0022::claim-05", "study_id": "paper-0022"}</data>
    </edge>
