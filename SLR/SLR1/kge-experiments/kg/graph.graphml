    <edge source="paper-0033::claim-03" target="outcomecategory::consistency" id="e0000785">
      <data key="d5">CLAIMS_OUTCOME</data>
      <data key="d6">claimed_outcomes_value_mechanisms_evidence[].outcome_category</data>
      <data key="d7">consistency</data>
      <data key="d8" />
      <data key="d9">The simulation results from each iteration are used to evaluate the amount of power used and data generated by each equipment, which are then used to drive changes in either expected behavior or operation parameters of each equipment</data>
      <data key="d10" />
      <data key="d11">{"claim_id": "paper-0033::claim-03", "claim_text": "Iterative simulation results can drive changes in expected behavior or operation parameters until power and data budget requirements are met.", "evidence_confidence": "Moderate", "observed_effect": "The final iteration showed stable power/data balances and the scenario was accepted as viable.", "source_claim_id": "C3", "source_path": "studies[21].extraction.claimed_outcomes_value_mechanisms_evidence[2]", "source_record_id": "paper-0033::claim-03", "study_id": "paper-0033"}</data>
    </edge>
