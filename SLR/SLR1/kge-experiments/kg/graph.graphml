      <data key="d3">Claim</data>
      <data key="d4">{"artifact_or_process_linked": "Open-source Capella-based pipeline; GNU GPLv3 public repository with models and code.", "claim_text": "Open-source tools and public MOSAiC assets improve accessibility, reproducibility, collaboration, and potential community-driven evolution for academic/resource-constrained teams.", "evidence_source": "All models and codes presented in this work are available in a public repository, under the GNU GPLv3 license", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Repository availability is reported; no reuse count, adoption metric, or cost comparison is reported.", "source_claim_id": "C7_open_source_reproducibility_accessibility", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[26].extraction.claimed_outcomes_value_mechanisms_evidence[6]", "study_id": "paper-0043", "threats_or_alternative_explanations": "Repository availability does not guarantee environment reproducibility, documentation sufficiency, or actual reuse by other teams."}</data>
