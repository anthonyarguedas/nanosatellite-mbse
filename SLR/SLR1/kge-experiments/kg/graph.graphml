    <edge source="paper-0061::claim-02" target="outcomecategory::cost_reduction" id="e0000967">
      <data key="d5">CLAIMS_OUTCOME</data>
      <data key="d6">claimed_outcomes_value_mechanisms_evidence[].outcome_category</data>
      <data key="d7">cost reduction</data>
      <data key="d8" />
