      <data key="d8" />
      <data key="d9">Concept 10 emerges as a standout, positioned prominently on the Pareto front.</data>
      <data key="d10" />
      <data key="d11">{"claim_id": "paper-0054::claim-01", "source_claim_id": "C1", "source_path": "studies[29].extraction.claimed_outcomes_value_mechanisms_evidence[0]", "source_record_id": "paper-0054::claim-01", "study_id": "paper-0054"}</data>
    </edge>
