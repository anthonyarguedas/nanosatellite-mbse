      <data key="d4">{"artifact_or_process_linked": "RFD process for low-cost PNSats and SMAD-derived mission-design flow.", "claim_text": "A risk-tolerant agile formal model-based process should lead to correct low-cost small-satellite designs with minimal-to-no redesign.", "evidence_source": "\"This proposed RFD process... notionally should lead to a correct design with minimal-to-no redesign through the use of an agile and formal design process based on models.\"", "extractor_confidence": "high", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Minimal-to-no redesign is stated as notional; no redesign, cost, or schedule measurements are reported.", "quote_location": "Section I Introduction", "source_claim_id": "C8", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[7].extraction.claimed_outcomes_value_mechanisms_evidence[7]", "study_id": "paper-0010", "threats_or_alternative_explanations": "The authors qualify the effect as notional; no project adoption data or baseline comparison is provided."}</data>
