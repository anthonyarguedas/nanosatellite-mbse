    <node id="paper-0061::claim-06">
      <data key="d2">CUTE-DB supports component selection and decision making by linking available CubeSat technology specifications and performance data to preliminary design.</data>
      <data key="d3">Claim</data>
      <data key="d4">{"artifact_or_process_linked": "CUTE-DB component database and S3D discipline spreadsheets used from Session 3 for COTS component selection.", "claim_text": "CUTE-DB supports component selection and decision making by linking available CubeSat technology specifications and performance data to preliminary design.", "evidence_source": "The CUTE-DB provides immediate access to specifications and performance data of commercially available components, supporting not only the component selection during the design process but also ensuring that CubeSat projects are based on current technological realities.", "extractor_confidence": "high", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "The database enables immediate access to COTS specifications and component options; no selection-quality metric is reported.", "source_claim_id": "C6_component_selection_decision_support", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[31].extraction.claimed_outcomes_value_mechanisms_evidence[5]", "study_id": "paper-0061", "threats_or_alternative_explanations": "Database completeness/data quality and update processes are not evaluated beyond source/update description."}</data>
    </node>
