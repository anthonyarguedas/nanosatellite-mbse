    <edge source="paper-0043" target="modelmaturity::conceptual_framework" id="e0005178">
      <data key="d5">HAS_MODEL_MATURITY</data>
      <data key="d6">study_context_population.model_maturity</data>
      <data key="d7">conceptual framework</data>
      <data key="d8">MOSAiC is presented as a first-version framework and demonstrated with executable simulations on a representative mission; no operational/flight validation is reported.</data>
