      <data key="d3">Claim</data>
      <data key="d4">{"artifact_or_process_linked": "Generic MBSE model visibility across domains.", "claim_text": "MBSE helps engineers see cross-domain relationships early in design decisions.", "evidence_source": "MBSE is becoming critical in today's multi domain systems; with it, engineers have the ability to see cross domain relationships early in the design process", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Generic rationale for adopting MBSE; no EIRSAT-specific evaluation.", "source_claim_id": "C6", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[32].extraction.claimed_outcomes_value_mechanisms_evidence[5]", "study_id": "paper-0063", "threats_or_alternative_explanations": "This is a generic MBSE benefit statement and not substantiated by the case results."}</data>
