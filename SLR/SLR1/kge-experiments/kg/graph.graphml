      <data key="d5">HAS_LIMITATION</data>
      <data key="d6">structured_limitations.limitation_assessments[]</data>
      <data key="d7">no_independent_validation</data>
      <data key="d8">The extraction found no independent expert, stakeholder, replication, or external validation of the MBSE-Nanospace approach.</data>
      <data key="d9">Absence-based: claimed outcomes are supported by author-run CREME examples and future-work statements, not independent validation.</data>
      <data key="d10">high</data>
      <data key="d11">{"assessment": "limitation_present", "limitation_type": "controlled_flag", "source": "extractor_identified", "source_path": "studies[18].structured_limitations.limitation_assessments[4]", "source_record_id": "paper-0027::limitation-05", "study_id": "paper-0027"}</data>
