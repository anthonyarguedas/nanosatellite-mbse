    <node id="paper-0024::claim-02">
      <data key="d2">An integrated MBSE/PLM chain would store design heritage and track architecture transformations.</data>
      <data key="d3">Claim</data>
      <data key="d4">{"artifact_or_process_linked": "MBSE/PLM digital chain and architecture artifacts", "claim_text": "An integrated MBSE/PLM chain would store design heritage and track architecture transformations.", "extractor_confidence": "low", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Claimed traceability/design-heritage capability; not demonstrated.", "quote_location": "Section 2: Such a chain would allow a product design team to store the design heritage and keep track of how the systems architecture transforms through the design process.", "source_claim_id": "C2", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[16].extraction.claimed_outcomes_value_mechanisms_evidence[1]", "study_id": "paper-0024", "threats_or_alternative_explanations": ["No repository/change-control/trace matrix is shown.", "Statement functions as motivation rather than result."]}</data>
