      <data key="d11">{"claim_id": "paper-0078::claim-05", "claim_text": "MBSE supported early requirement identification, risk management, performance optimization, avoidance of rework, and a more reliable design.", "evidence_confidence": "Moderate", "observed_effect": "Technical feasibility indicators include simulated contacts/lifetime, power/energy budgets, and thermal limits; no direct reliability metric or flight evidence is provided.", "source_claim_id": "C5", "source_path": "studies[36].extraction.claimed_outcomes_value_mechanisms_evidence[4]", "source_record_id": "paper-0078::claim-05", "study_id": "paper-0078"}</data>
