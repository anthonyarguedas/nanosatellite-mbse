    <node id="paper-0037::claim-02">
      <data key="d2">Docs-as-code enables automatic generation of synchronized diagrams, tables, text, and manuscripts from model files, reducing manual document-update effort.</data>
      <data key="d3">Claim</data>
      <data key="d4">{"artifact_or_process_linked": "YAML architecture files, Liquid/Jinja2/LaTeX templates, build shell script, generated UML diagrams/tables/manuscript.", "claim_text": "Docs-as-code enables automatic generation of synchronized diagrams, tables, text, and manuscripts from model files, reducing manual document-update effort.", "evidence_source": "Whether it be diagrams, tables, or text, continuous updating is ensured that any changes affecting dependencies within the mission architecture are kept in sync.", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Generated artifacts are shown; authors claim immediate regeneration and elimination of additional documentation work for model changes.", "source_claim_id": "C2", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[23].extraction.claimed_outcomes_value_mechanisms_evidence[1]", "study_id": "paper-0037", "threats_or_alternative_explanations": "Generated documentation may still lag if model content is incomplete or subsystem teams do not provide updates."}</data>
