    <edge source="paper-0061" target="limitationflag::model_not_available" id="e0004261">
      <data key="d5">HAS_LIMITATION</data>
      <data key="d6">structured_limitations.limitation_assessments[]</data>
      <data key="d7">model_not_available</data>
      <data key="d8">The paper describes tools and a user manual but does not provide a public repository, downloadable model, spreadsheet, database, or scripts.</data>
      <data key="d9">No availability statement, URL for S3D/CUTE-DB assets, model repository, or downloadable artifacts are reported in the paper markdown; only sources used to populate CUTE-DB are listed.</data>
