      <data key="d11">{"claim_id": "paper-0043::claim-06", "source_claim_id": "C6_reduced_integration_costs_late_surprises", "source_path": "studies[26].extraction.claimed_outcomes_value_mechanisms_evidence[5]", "source_record_id": "paper-0043::claim-06", "study_id": "paper-0043"}</data>
    </edge>
