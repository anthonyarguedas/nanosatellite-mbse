      <data key="d11">{"category": null, "description": "Matrix linking process-flow steps, business objectives/rules, requirements, code, and test cases; used as the central traceability/verification artifact.", "original_label": "Requirements Mapping Matrix (RMM)", "source_path": "studies[22].emergent_codes[1]", "source_record_id": "paper-0034::emergent-02", "study_id": "paper-0034"}</data>
    </edge>
    <edge source="paper-0034" target="emergentcode::requirements_modeling_language_rml" id="e0002513">
