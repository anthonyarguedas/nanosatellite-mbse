      <data key="d11">{"assessment": "emergent_limitation", "limitation_type": "emergent_limitation", "source": "author_stated", "source_path": "studies[38].structured_limitations.emergent_limitations[1]", "source_record_id": "paper-0080::limitation-16", "study_id": "paper-0080"}</data>
