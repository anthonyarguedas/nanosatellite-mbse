      <data key="d3">Claim</data>
      <data key="d4">{"artifact_or_process_linked": "Stakeholder needs, user stories, data structures, derivedFrom trace links, generated traceability diagrams.", "claim_text": "MBSE mission architecture captures data structures and expected behaviors unambiguously with traceability, rationale, and low configuration-management overhead.", "evidence_source": "The data structures and expected behaviors were captured in such a way that can unambiguously understood well enough to be implemented, as well as provide full traceability and rationale for architectural elements with minimal configuration management overhead [13].", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Qualitatively claims unambiguous implementation, full traceability, and minimal configuration-management overhead; no measured effect size.", "source_claim_id": "C1", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[23].extraction.claimed_outcomes_value_mechanisms_evidence[0]", "study_id": "paper-0037", "threats_or_alternative_explanations": "Traceability quality may depend on team discipline and completeness of captured legacy work; no independent audit of trace completeness."}</data>
