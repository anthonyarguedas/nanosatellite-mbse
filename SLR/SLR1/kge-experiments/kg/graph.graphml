    <edge source="paper-0054" target="limitationflag::assumptions_or_data_quality_limits" id="e0004229">
      <data key="d5">HAS_LIMITATION</data>
      <data key="d6">structured_limitations.limitation_assessments[]</data>
      <data key="d7">assumptions_or_data_quality_limits</data>
      <data key="d8">The utility weighting is subjective and based on engineering judgment, with uncertainties handled through Monte Carlo and sensitivity analysis rather than independently calibrated data.</data>
