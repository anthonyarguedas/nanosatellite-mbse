      <data key="d11">{"claim_id": "paper-0023::claim-07", "claim_text": "Implementing the MBSE view/process approach improved communication, planning, management, and development by replacing ad hoc work organization and facilitating PBS/WBS/CBS project documents.", "evidence_confidence": "Weak", "observed_effect": "Authors report qualitative improvement and facilitation of project documents after replacing ad hoc procedures.", "source_claim_id": "C7", "source_path": "studies[15].extraction.claimed_outcomes_value_mechanisms_evidence[6]", "source_record_id": "paper-0023::claim-07", "study_id": "paper-0023"}</data>
