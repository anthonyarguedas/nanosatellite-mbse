    <edge source="paper-0031" target="lifecyclestage::concept_pre_phase_a" id="e0000259">
      <data key="d5">ADDRESSES_LIFECYCLE_STAGE</data>
      <data key="d6">study_context_population.lifecycle_stage_addressed</data>
