      <data key="d4">{"artifact_or_process_linked": "Common model, simulation feedback loop, requirements-to-engineering execution traceability.", "claim_text": "The integrated MBSE/simulation framework reduces integration costs, misinterpretation risk, late-stage surprises, and rework.", "evidence_source": "Results show improved consistency between system models and simulation artifacts, reduced integration costs, and improved early validation of design choices.", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "No cost, rework, defect, or effort effect size is reported.", "source_claim_id": "C6_reduced_integration_costs_late_surprises", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[26].extraction.claimed_outcomes_value_mechanisms_evidence[5]", "study_id": "paper-0043", "threats_or_alternative_explanations": "Cost effects could be offset by model-building, training, parser maintenance, and simulation setup effort."}</data>
