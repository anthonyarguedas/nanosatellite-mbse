      <data key="d11">{"claim_id": "paper-0061::claim-04", "claim_text": "The Central Data Exchange System improves cross-discipline consistency, validation, and error reduction by sharing up-to-date data and checking common inputs.", "evidence_confidence": "Moderate", "observed_effect": "Faster validation, less manual effort, and fewer errors are claimed qualitatively; no error counts are measured.", "source_claim_id": "C4_consistency_error_reduction", "source_path": "studies[31].extraction.claimed_outcomes_value_mechanisms_evidence[3]", "source_record_id": "paper-0061::claim-04", "study_id": "paper-0061"}</data>
