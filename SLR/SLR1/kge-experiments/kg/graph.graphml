    <edge source="paper-0001::claim-06" target="outcomecategory::decision_support" id="e0000324">
      <data key="d5">CLAIMS_OUTCOME</data>
      <data key="d6">claimed_outcomes_value_mechanisms_evidence[].outcome_category</data>
      <data key="d7">decision support</data>
      <data key="d8" />
      <data key="d9">When the battery capacity was reduced, energy level could not rise above the max capacity of 100,000 J. This shows that there will be spillover of energy collected by solar panel, and it may be considered to reduce the size of the solar panel.</data>
      <data key="d10">high</data>
      <data key="d11">{"claim_id": "paper-0001::claim-06", "claim_text": "Battery-capacity trade study identifies energy spillover at reduced battery capacity and suggests possible solar-panel downsizing.", "evidence_confidence": "Moderate", "observed_effect": "Reduced capacity caps energy at 100,000 J, indicating collected energy spillover and a possible reason to reduce solar-panel size.", "source_claim_id": "C6", "source_path": "studies[0].extraction.claimed_outcomes_value_mechanisms_evidence[5]", "source_record_id": "paper-0001::claim-06", "study_id": "paper-0001"}</data>
    </edge>
