      <data key="d4">{"artifact_or_process_linked": "Reusable verification-model workflow for subsystem test scenarios.", "claim_text": "The verification models can be reused in similar verification scenarios and applied to remaining subsystems to create an automated framework.", "evidence_source": "the models can be reused several times in similar verification scenarios", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Reuse is proposed/claimed; no replication across subsystems or projects is reported.", "source_claim_id": "C5", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[32].extraction.claimed_outcomes_value_mechanisms_evidence[4]", "study_id": "paper-0063", "threats_or_alternative_explanations": "Future application to remaining subsystems may reveal subsystem-specific integration effort not captured by the communications example."}</data>
    </node>
    <node id="paper-0063::claim-06">
