      <data key="d10">high</data>
      <data key="d11">{"assessment": "limitation_present", "limitation_type": "controlled_flag", "source": "extractor_identified", "source_path": "studies[18].structured_limitations.limitation_assessments[5]", "source_record_id": "paper-0027::limitation-06", "study_id": "paper-0027"}</data>
