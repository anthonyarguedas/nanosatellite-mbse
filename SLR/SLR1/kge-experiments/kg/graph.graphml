      <data key="d3">Claim</data>
      <data key="d4">{"artifact_or_process_linked": "M30ML/YAML files, Git-compatible plain text, local filesystem, public repository, training session with experienced member.", "claim_text": "The lightweight YAML/M30ML docs-as-code approach is easy for new CubeSat team members to learn and use with minimal training and no proprietary software.", "evidence_source": "easy to learn and use even for newly admitted team members with little to no training", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Multiple team members reportedly learned quickly in a short guided session, but self-learning materials remain insufficient.", "source_claim_id": "C3", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[23].extraction.claimed_outcomes_value_mechanisms_evidence[2]", "study_id": "paper-0037", "threats_or_alternative_explanations": "Learning may depend on an experienced member; authors report confusion when members attempted self-learning from current guides."}</data>
