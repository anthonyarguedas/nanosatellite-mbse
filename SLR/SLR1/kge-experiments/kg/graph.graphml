    <edge source="paper-0078::claim-02" target="outcomecategory::lifecycle_continuity" id="e0001055">
      <data key="d5">CLAIMS_OUTCOME</data>
      <data key="d6">claimed_outcomes_value_mechanisms_evidence[].outcome_category</data>
      <data key="d7">lifecycle continuity</data>
      <data key="d8" />
