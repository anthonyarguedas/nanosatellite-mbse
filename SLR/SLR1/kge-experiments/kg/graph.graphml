      <data key="d3">Claim</data>
      <data key="d4">{"artifact_or_process_linked": "Classroom deployment of a constrained PSAT1U standardized MBSE template prepared by faculty.", "claim_text": "The faculty-prepared template lets students and discipline experts benefit from MBSE tools without becoming MBSE experts, allowing them to focus on analysis, testing, and mission-critical decisions.", "evidence_source": "This approach... will also allow subject matter experts in aerospace engineering and other specific disciplines to gain the benefit of these powerful systems engineering tools without becoming expert MBSE users.", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Expected educational/adoption benefit only; no classroom outcome data.", "source_claim_id": "C5", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[24].extraction.claimed_outcomes_value_mechanisms_evidence[4]", "study_id": "paper-0039", "threats_or_alternative_explanations": "The paper does not report actual student use, surveys, learning outcomes, design decisions, or comparison to a non-template course."}</data>
    </node>
