      <data key="d7">tool integration</data>
      <data key="d8" />
      <data key="d9">This is basically a set of libraries which collect the MATLAB/Simulink models, including the spacecraft hardware (sensors/actuators), kinematics dynamics, the space environment, as well as some generic functions and algorithms.</data>
      <data key="d10" />
      <data key="d11">{"claim_id": "paper-0079::claim-05", "claim_text": "Reusable Simulink model libraries and flexible configurations enable quick response to changing requirements and reduce design time.", "evidence_confidence": "Unsupported", "observed_effect": "Expected faster configuration/reconfiguration and reduced design time; no schedule metric.", "source_claim_id": "C5", "source_path": "studies[37].extraction.claimed_outcomes_value_mechanisms_evidence[4]", "source_record_id": "paper-0079::claim-05", "study_id": "paper-0079"}</data>
