    <node id="paper-0024::claim-03">
      <data key="d2">DSM-based mapping of OPM, CPM, and STEP entities identifies overlaps, gaps, and misfits in MBSE-to-PLM information exchange.</data>
      <data key="d3">Claim</data>
      <data key="d4">{"artifact_or_process_linked": "23-entity DSM with full/partial correspondences and frequency analysis", "claim_text": "DSM-based mapping of OPM, CPM, and STEP entities identifies overlaps, gaps, and misfits in MBSE-to-PLM information exchange.", "extractor_confidence": "medium", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "Reveals strong space/geometry representation and weak/absent time/state representation.", "quote_location": "Section 3: DSM maps core entities from conceptual to detail design and identifies overlaps and gaps; Figure 2 reports percentages.", "source_claim_id": "C3", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[16].extraction.claimed_outcomes_value_mechanisms_evidence[2]", "study_id": "paper-0024", "threats_or_alternative_explanations": ["Entity selection and F/P judgments are not independently validated.", "Mapping is conceptual rather than tested automated exchange."]}</data>
