      <data key="d4">{"artifact_or_process_linked": "GMAT/Python power and orbit scripts, Dosa link budget, Stela reentry simulation, Nanospace requirement status UI.", "claim_text": "Executable preliminary-design analyses support requirement/constraint checking and design decisions for power, communications, and reentry before physical development.", "extractor_confidence": "high", "field_path": "claimed_outcomes_value_mechanisms_evidence[]", "observed_effect_or_qualitative_effect": "2U scenario with 4 W solar arrays was insufficient for DoD constraint; 3U scenario with 6 W arrays recharged; S-band selected for data-rate constraint; 2000 km reentry violates 25-year rule.", "quote_location": {"location": "Section III.C", "quote": "the power input from the solar panels is insufficient ... a violation of constraint C-06 ... Simulation shows that, in spite of heavy transceiver data burst, batteries are able to recharge ... Simulation with the Stela tool shows that the orbit with an altitude of 2000 km is too far for a re-entry below 25 years"}, "source_claim_id": "C4", "source_codebook_version": "1.1", "source_generated_at": "2026-05-28T15:59:44-06:00", "source_path": "studies[18].extraction.claimed_outcomes_value_mechanisms_evidence[3]", "study_id": "paper-0027", "threats_or_alternative_explanations": "Evidence supports scripted analysis and requirement checking, but not necessarily MBSE-specific value; assumptions are simplified and not validated against physical tests."}</data>
    </node>
