      <data key="d5">HAS_CLAIM</data>
      <data key="d6">claimed_outcomes_value_mechanisms_evidence[]</data>
      <data key="d7">RMM may help prioritize requirements, identify missing requirements, highlight unnecessary requirements, and limit unspecified functionality/scope creep.</data>
      <data key="d8" />
      <data key="d9">RMM may help CubeSat developers and systems analysts prioritize requirements, identify missing requirements, and highlight unnecessary requirements.</data>
      <data key="d10">high</data>
      <data key="d11">{"claim_id": "paper-0034::claim-03", "source_claim_id": "C3", "source_path": "studies[22].extraction.claimed_outcomes_value_mechanisms_evidence[2]", "source_record_id": "paper-0034::claim-03", "study_id": "paper-0034"}</data>
    </edge>
