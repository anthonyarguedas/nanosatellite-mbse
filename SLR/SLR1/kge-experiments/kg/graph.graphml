      <data key="d11">{"assessment": "limitation_present", "limitation_type": "controlled_flag", "source": "extractor_identified", "source_path": "studies[14].structured_limitations.limitation_assessments[8]", "source_record_id": "paper-0022::limitation-09", "study_id": "paper-0022"}</data>
