      <data key="d5">HAS_LIMITATION</data>
      <data key="d6">structured_limitations.limitation_assessments[]</data>
      <data key="d7">no_eps_specific_evidence</data>
      <data key="d8">Power budgets and energy/power parameters are included, but no full EPS MBSE model, EPS architecture trace, or EPS-specific outcome evaluation is presented.</data>
      <data key="d9">Table I reports Energy and Power parameters; extraction codes EPS relevance as 'power-budget/electrical-architecture' rather than EPS-specific.</data>
      <data key="d10">high</data>
      <data key="d11">{"assessment": "limitation_present", "limitation_type": "controlled_flag", "source": "extractor_identified", "source_path": "studies[18].structured_limitations.limitation_assessments[6]", "source_record_id": "paper-0027::limitation-07", "study_id": "paper-0027"}</data>
