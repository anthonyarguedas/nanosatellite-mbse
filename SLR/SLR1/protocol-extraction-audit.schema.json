{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol-extraction-audit.schema.json",
  "title": "SLR1 focused audit record schema",
  "type": "object",
  "properties": {
    "audit_id": {
      "$ref": "protocol-extraction.schema.json#/$defs/stableId"
    },
    "report_id": {
      "$ref": "protocol-extraction.schema.json#/$defs/stableId"
    },
    "lineage_id": {
      "$ref": "protocol-extraction.schema.json#/$defs/stableId"
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "audit_completion_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        "incomplete_missing_source",
        "incomplete_other"
      ]
    },
    "issues_raised_count": {
      "type": "integer",
      "minimum": 0
    },
    "corrections_accepted_count": {
      "type": "integer",
      "minimum": 0
    },
    "flags_rejected_count": {
      "type": "integer",
      "minimum": 0
    },
    "unresolved_ambiguities_count": {
      "type": "integer",
      "minimum": 0
    },
    "unresolved_ambiguity_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "audit_id",
    "actor",
    "date",
    "scope",
    "audit_completion_status",
    "issues_raised_count",
    "corrections_accepted_count",
    "flags_rejected_count",
    "unresolved_ambiguities_count"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "report_id": true,
            "lineage_id": false
          },
          "required": [
            "report_id"
          ]
        },
        {
          "properties": {
            "report_id": false,
            "lineage_id": true
          },
          "required": [
            "lineage_id"
          ]
        }
      ]
    },
    {
      "if": {
        "properties": {
          "unresolved_ambiguities_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "unresolved_ambiguities_count"
        ]
      },
      "then": {
        "properties": {
          "unresolved_ambiguity_note": true
        },
        "required": [
          "unresolved_ambiguity_note"
        ]
      }
    }
  ],
  "additionalProperties": false
}
