    "crossEvidenceBasisValue": {
      "type": "object",
      "allOf": [
        {
          "$ref": "protocol-extraction.schema.json#/$defs/crossReportEvidenceMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "array",
              "items": {
                "$ref": "protocol-extraction.schema.json#/$defs/evidenceBasisCode"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "if": {
            "properties": {
              "value": {
                "type": "array",
                "contains": {
                  "const": "assertion_only"
                }
              }
            },
            "required": [
              "value"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "maxItems": 1
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "crossSupportValue": {
      "type": "object",
      "allOf": [
        {
          "$ref": "protocol-extraction.schema.json#/$defs/crossReportEvidenceMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "protocol-extraction.schema.json#/$defs/supportCode"
