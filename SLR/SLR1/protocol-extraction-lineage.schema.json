        "required_inputs",
        "linked_tool_ids",
        "organizational_prerequisites",
        "exclusions_and_limits",
        "target_refs",
        "lifecycle_stages",
        "linked_decision_ids",
        "eps_scope_refs",
        "model_scope_refs",
        "architecture_and_interface_refs",
        "environment_mode_and_load_refs",
        "required_input_refs",
        "organizational_prerequisite_refs",
        "limit_rule_ids"
