    "crossArtifactGenerality": {
      "oneOf": [
        {
          "$ref": "#/$defs/crossArtifactGeneralityValue"
        },
        {
          "$ref": "protocol-extraction.schema.json#/$defs/crossEvidenceStatusValue"
