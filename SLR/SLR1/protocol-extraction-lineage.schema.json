              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "value",
            "citation_ids",
            "basis_refs",
            "limitation_codes"
          ]
        },
        {
          "if": {
            "properties": {
              "limitation_codes": {
                "type": "array",
                "contains": {
                  "const": "none"
                }
              }
            },
            "required": [
              "limitation_codes"
            ]
          },
          "then": {
            "properties": {
              "limitation_codes": {
                "type": "array",
                "maxItems": 1
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
