{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protocol-prior-secondary-reviews.schema.json",
  "title": "SLR1 prior secondary review extraction schema",
  "description": "Machine-readable schema for one included prior-review report extraction under protocol-prior-secondary-reviews.md. It reuses the main extraction evidence, citation, availability, and audit definitions.",
  "$ref": "#/$defs/priorReviewExtraction",
  "$defs": {
    "stableId": {
      "$ref": "protocol-extraction.schema.json#/$defs/stableId"
    },
    "supportingReportId": {
      "allOf": [
        {
          "$ref": "#/$defs/stableId"
        },
        {
          "type": "string",
          "pattern": "^psr-candidate-[0-9]+$"
        }
      ]
    },
    "citationTable": {
      "$ref": "protocol-extraction.schema.json#/$defs/citationTable"
    },
    "evidencedValueMetadata": {
      "$ref": "protocol-extraction.schema.json#/$defs/evidencedValueMetadata"
    },
    "evidenceStatusValue": {
      "$ref": "protocol-extraction.schema.json#/$defs/evidenceStatusValue"
    },
    "reviewerInferredStatusWithSourceEvidence": {
      "allOf": [
        {
          "$ref": "protocol-extraction.schema.json#/$defs/statusWithSourceEvidence"
        },
        {
          "type": "object",
          "properties": {
            "provenance": {
              "const": "reviewer_inferred"
            }
          },
          "required": [
            "provenance"
          ]
        }
      ]
    },
    "reviewerCodedEvidenceStatusValue": {
      "oneOf": [
        {
          "$ref": "protocol-extraction.schema.json#/$defs/statusWithoutSourceEvidence"
        },
        {
          "$ref": "#/$defs/reviewerInferredStatusWithSourceEvidence"
        }
      ]
    },
    "reviewerInferredStringArrayValue": {
      "allOf": [
        {
          "$ref": "protocol-extraction.schema.json#/$defs/evidencedStringArrayValue"
        },
        {
          "type": "object",
          "properties": {
            "provenance": {
              "const": "reviewer_inferred"
            }
          },
          "required": [
            "provenance"
          ]
        }
      ]
    },
    "reviewerInferredStringArray": {
      "oneOf": [
        {
          "$ref": "#/$defs/reviewerInferredStringArrayValue"
        },
        {
          "$ref": "#/$defs/reviewerCodedEvidenceStatusValue"
        }
      ]
    },
    "evidencedString": {
      "$ref": "protocol-extraction.schema.json#/$defs/evidencedString"
    },
    "evidencedPositiveIntegerValue": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/evidencedValueMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "value"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "evidencedPositiveInteger": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidencedPositiveIntegerValue"
        },
        {
          "$ref": "#/$defs/evidenceStatusValue"
        }
      ]
    },
    "evidencedStringArray": {
      "$ref": "protocol-extraction.schema.json#/$defs/evidencedStringArray"
    },
    "availability": {
      "$ref": "protocol-extraction.schema.json#/$defs/availability"
    },
    "codedRowMetadata": {
      "$ref": "protocol-extraction.schema.json#/$defs/codedRowMetadata"
    },
    "repeatableFieldStatus": {
      "$ref": "protocol-extraction.schema.json#/$defs/repeatableFieldStatus"
    },
    "rowFieldStatus": {
      "$ref": "protocol-extraction.schema.json#/$defs/rowFieldStatus"
    },
    "rowString": {
      "$ref": "protocol-extraction.schema.json#/$defs/rowString"
    },
    "normalizedReviewType": {
      "type": "string",
      "minLength": 1
    },
    "evidencedNormalizedReviewTypeValue": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/evidencedValueMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/normalizedReviewType"
            },
            "provenance": {
              "const": "reviewer_inferred"
            }
          },
          "required": [
            "value",
            "provenance"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "evidencedNormalizedReviewType": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidencedNormalizedReviewTypeValue"
        },
        {
          "$ref": "#/$defs/reviewerCodedEvidenceStatusValue"
        }
      ]
    },
    "unsearchedIntervalValue": {
      "allOf": [
        {
          "$ref": "protocol-extraction.schema.json#/$defs/evidencedStringValue"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "const": "reviewer_derived"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provenance",
            "notes"
          ]
        }
      ]
    },
    "unsearchedInterval": {
      "oneOf": [
        {
          "$ref": "#/$defs/unsearchedIntervalValue"
        },
        {
          "$ref": "#/$defs/evidenceStatusValue"
        }
      ]
    },
    "sourceDate": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
        },
        {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      ]
    },
    "evidencedSourceDateValue": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/evidencedValueMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/sourceDate"
            }
          },
          "required": [
            "value"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "evidencedSourceDate": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidencedSourceDateValue"
        },
        {
          "$ref": "#/$defs/evidenceStatusValue"
        }
      ]
    },
    "yesPartlyNoUnclearCode": {
      "type": "string",
      "enum": [
        "yes",
        "partly",
        "no",
        "unclear"
      ]
    },
    "dareAnswerCode": {
      "$ref": "#/$defs/yesPartlyNoUnclearCode"
    },
    "evidencedYesPartlyNoUnclearValue": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/evidencedValueMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/yesPartlyNoUnclearCode"
            }
          },
          "required": [
            "value"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "evidencedYesPartlyNoUnclear": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidencedYesPartlyNoUnclearValue"
        },
        {
          "$ref": "#/$defs/evidenceStatusValue"
        }
      ]
    },
    "populationOverlapCode": {
      "description": "Select the first applicable category in this order: separable_nanosatellite_evidence, cubesat_or_nanosatellite_in_scope, smallsat_in_scope, broad_space_only, none.",
      "type": "string",
      "enum": [
        "separable_nanosatellite_evidence",
        "cubesat_or_nanosatellite_in_scope",
        "smallsat_in_scope",
        "broad_space_only",
        "none"
      ]
    },
    "epsOverlapCode": {
      "description": "direct_and_separable means EPS is an explicit review target or reported category with separate results. embedded_but_separable means EPS occurs within broader results but can be isolated. mentioned_not_separable means EPS appears but its results cannot be isolated. absent and unclear retain their plain meanings.",
      "type": "string",
      "enum": [
        "direct_and_separable",
        "embedded_but_separable",
        "mentioned_not_separable",
        "absent",
        "unclear"
      ]
    },
    "mbseDefinitionOverlapCode": {
      "description": "at_least_as_specific means the prior review meets or exceeds the main review's MBSE qualification. broader_than_main_review means it includes qualifying MBSE but also admits weaker modeling. adjacent_only means it covers related modeling or digital engineering without meeting the main qualification. unclear means reporting prevents classification.",
      "type": "string",
      "enum": [
        "at_least_as_specific",
        "broader_than_main_review",
        "adjacent_only",
        "unclear"
      ]
    },
    "rqCoverageCode": {
      "description": "substantial directly covers enough central elements to answer a substantial part of the RQ. partial directly covers at least one element but leaves material elements uncovered. adjacent provides relevant context without directly answering the RQ. none means no relevant coverage. unclear means reporting prevents classification.",
      "type": "string",
      "enum": [
        "substantial",
        "partial",
        "adjacent",
        "none",
        "unclear"
      ]
    },
    "supportingSearchDispositionCode": {
      "description": "Apply per prior-review report. no_substantial_overlap_identified means overlap is absent or adjacent only. partial_overlap_main_review_still_needed means some direct overlap exists with material coverage missing. substantial_overlap_but_scope_or_update_gap_remains means substantial coverage exists with a scope or currency gap. substantial_overlap_but_methodological_gap_remains means scope and currency are substantial but known methodological limitations prevent reliance on the review. potential_redundancy_requires_protocol_reconsideration means the nanosatellite population, direct EPS-MBSE relationship, all RQs, and currency are substantially covered. insufficient_information_to_decide means reporting prevents a reliable decision.",
      "type": "string",
      "enum": [
        "no_substantial_overlap_identified",
        "partial_overlap_main_review_still_needed",
        "substantial_overlap_but_scope_or_update_gap_remains",
        "substantial_overlap_but_methodological_gap_remains",
        "potential_redundancy_requires_protocol_reconsideration",
        "insufficient_information_to_decide"
      ]
    },
    "nanosatelliteEpsEvidenceCode": {
      "description": "directly_extractable means specific nanosatellite-EPS findings can be identified. embedded_in_broader_counts means nanosatellite-EPS evidence appears only inside broader reported counts. mentioned_without_separable_results means it is mentioned with no isolatable finding or count. absent means no nanosatellite-EPS evidence is reported.",
      "type": "string",
      "enum": [
        "directly_extractable",
        "embedded_in_broader_counts",
        "mentioned_without_separable_results",
        "absent"
      ]
    },
    "evidencedNanosatelliteEpsEvidenceValue": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/evidencedValueMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/nanosatelliteEpsEvidenceCode"
            },
            "provenance": {
              "const": "reviewer_inferred"
            }
          },
          "required": [
            "value",
            "provenance"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "evidencedNanosatelliteEpsEvidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidencedNanosatelliteEpsEvidenceValue"
        },
        {
          "$ref": "#/$defs/reviewerCodedEvidenceStatusValue"
        }
      ]
    },
    "yesNoUnclearCode": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "unclear"
      ]
    },
    "scopeInclusionCode": {
      "$ref": "#/$defs/yesNoUnclearCode"
    },
    "supportingSearchDispositionAssessment": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/reasonedAssessmentMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/supportingSearchDispositionCode"
            }
          },
          "required": [
            "value"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "reasonedAssessmentMetadata": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/evidencedValueMetadata"
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "const": "reviewer_inferred"
            }
          },
          "required": [
            "reason",
            "provenance"
          ]
        }
      ]
    },
    "populationOverlapAssessment": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/reasonedAssessmentMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/populationOverlapCode"
            }
          },
          "required": [
            "value"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "epsOverlapAssessment": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/reasonedAssessmentMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/epsOverlapCode"
            }
          },
          "required": [
            "value"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "mbseDefinitionOverlapAssessment": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/reasonedAssessmentMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/mbseDefinitionOverlapCode"
            }
          },
          "required": [
            "value"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "rqCoverageAssessment": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/reasonedAssessmentMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/rqCoverageCode"
            }
          },
          "required": [
            "value"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "evidencedYesNoUnclearValue": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/evidencedValueMetadata"
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/yesNoUnclearCode"
            },
            "provenance": {
              "const": "reviewer_inferred"
            }
          },
          "required": [
            "value",
            "provenance"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "evidencedYesNoUnclear": {
      "oneOf": [
        {
          "$ref": "#/$defs/evidencedYesNoUnclearValue"
        },
        {
          "$ref": "#/$defs/reviewerCodedEvidenceStatusValue"
        }
      ]
    },
    "findingsSeparabilityCode": {
      "type": "string",
      "enum": [
        "yes",
        "no",
        "not_applicable",
        "unclear"
      ]
    },
    "scopeCoverage": {
      "description": "included records whether the category is actually represented in the review's included evidence, rather than merely permitted by its eligibility criteria. findings_separable records whether findings for that category can be isolated from broader findings.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/codedRowMetadata"
        },
        {
          "type": "object",
          "properties": {
            "included": {
              "$ref": "#/$defs/scopeInclusionCode"
            },
            "findings_separable": {
              "$ref": "#/$defs/findingsSeparabilityCode"
            },
            "provenance": {
              "const": "reviewer_inferred"
            }
          },
          "required": [
            "included",
            "findings_separable",
            "provenance"
          ]
        },
        {
          "if": {
            "properties": {
              "included": {
                "const": "no"
              }
            },
            "required": [
              "included"
            ]
          },
          "then": {
            "properties": {
              "findings_separable": {
                "const": "not_applicable"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "verificationPass": {
      "allOf": [
        {
          "$ref": "protocol-extraction-audit.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "report_id": {
              "$ref": "#/$defs/supportingReportId"
            }
          },
          "required": [
            "report_id"
          ]
        }
      ]
    },
    "verificationPasses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verificationPass"
      },
      "minItems": 1
    },
    "identity": {
      "type": "object",
      "properties": {
        "report_id": {
          "$ref": "#/$defs/supportingReportId",
          "description": "The existing deduplicated psr-candidate identifier for the included report."
        },
        "full_citation": {
          "$ref": "#/$defs/evidencedString"
        },
        "doi": {
          "$ref": "#/$defs/evidencedString"
        },
        "other_stable_identifiers": {
          "$ref": "#/$defs/evidencedStringArray"
        },
        "report_version_used": {
          "$ref": "#/$defs/evidencedString"
        },
        "report_date_used": {
          "$ref": "#/$defs/evidencedSourceDate"
        },
        "review_type_as_stated": {
          "$ref": "#/$defs/evidencedString"
        },
        "review_type_normalized": {
          "$ref": "#/$defs/evidencedNormalizedReviewType"
        },
        "discovery_event_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_record_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "duplicate_or_companion_report_relationship": {
          "$ref": "#/$defs/evidencedString"
        },
        "version_chosen_for_assessment": {
          "$ref": "#/$defs/evidencedString"
        },
        "extractor": {
          "type": "string",
          "minLength": 1
        },
        "source_file_path": {
          "type": "string",
          "minLength": 1
        },
        "verification_passes": {
          "$ref": "#/$defs/verificationPasses",
          "description": "Each embedded pass must use the same report_id as this extraction."
        }
      },
      "required": [
        "report_id",
        "full_citation",
        "doi",
        "other_stable_identifiers",
        "report_version_used",
        "report_date_used",
        "review_type_as_stated",
        "review_type_normalized",
        "discovery_event_ids",
        "source_record_ids",
        "duplicate_or_companion_report_relationship",
        "version_chosen_for_assessment",
        "extractor",
        "source_file_path",
        "verification_passes"
      ],
      "additionalProperties": false
    },
    "countCategoryCode": {
      "type": "string",
      "enum": [
        "records",
        "included_reports",
        "underlying_studies"
      ]
    },
    "rowNonnegativeInteger": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/rowFieldStatus"
        }
      ]
    },
    "reportedCount": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/codedRowMetadata"
        },
        {
          "type": "object",
          "properties": {
            "reported_count_id": {
              "$ref": "#/$defs/stableId"
            },
            "category": {
              "$ref": "#/$defs/countCategoryCode"
            },
            "source_label": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "denominator_value": {
              "$ref": "#/$defs/rowNonnegativeInteger"
            },
            "denominator_label": {
              "$ref": "#/$defs/rowString"
            }
          },
          "required": [
            "reported_count_id",
            "category",
            "source_label",
            "value",
            "denominator_value",
            "denominator_label"
          ]
        },
        {
          "if": {
            "properties": {
              "denominator_value": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "not_applicable"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "denominator_value"
            ]
          },
          "then": {
            "properties": {
              "denominator_label": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "not_applicable"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "denominator_label": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "not_applicable"
                  }
                },
                "required": [
                  "status"
                ]
              }
            },
            "required": [
              "denominator_label"
            ]
          },
          "then": {
            "properties": {
              "denominator_value": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "not_applicable"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "reportedCounts": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reportedCount"
          },
          "minItems": 1
        },
        {
          "$ref": "#/$defs/repeatableFieldStatus"
        }
      ]
    },
    "searchRouteTypeCode": {
      "type": "string",
      "enum": [
        "database",
        "collection",
        "website",
        "manual_source",
        "citation_route",
        "expert_contact"
      ]
    },
    "searchedSourceOrRoute": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/codedRowMetadata"
        },
        {
          "type": "object",
          "properties": {
            "source_route_id": {
              "$ref": "#/$defs/stableId"
            },
            "route_type": {
              "$ref": "#/$defs/searchRouteTypeCode"
            },
            "source_name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source_route_id",
            "route_type",
            "source_name"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "searchedSourcesAndRoutes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/searchedSourceOrRoute"
      },
      "minItems": 1
    },
    "reviewSearchDate": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/codedRowMetadata"
        },
        {
          "type": "object",
          "properties": {
            "search_date_id": {
              "$ref": "#/$defs/stableId"
            },
            "source_route_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/stableId"
              },
              "minItems": 1,
              "uniqueItems": true,
