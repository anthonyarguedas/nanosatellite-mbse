{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/slr1/failure-register.schema.json",
  "title": "SLR1 source failure register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "entries"],
  "properties": {
    "schema_version": {"const": "slr1-failure-register/v1"},
    "review_id": {"const": "SLR1-restart"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure_id",
          "event_id",
          "source_id",
          "partition_id",
          "occurred_at",
          "stage",
          "failure_type",
          "reason",
          "source_reported_total",
          "records_imported",
          "partial_artifacts_quarantined",
          "disposition"
        ],
        "properties": {
          "failure_id": {"type": "string", "minLength": 1},
          "event_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "partition_id": {"type": ["string", "null"]},
          "occurred_at": {"type": "string", "format": "date-time"},
          "stage": {"enum": ["pilot", "final_search", "citation_search", "local_harvest"]},
          "failure_type": {
            "enum": [
              "access",
              "authentication",
              "challenge",
              "source_boundary",
              "query_syntax",
              "query_rewrite",
              "controls",
              "source_limit",
              "total_mismatch",
              "pagination",
              "export",
              "transport",
              "parse",
              "stable_identity",
              "completeness",
              "rights",
              "other"
            ]
          },
          "reason": {"type": "string", "minLength": 1},
          "source_reported_total": {"type": "null"},
          "records_imported": {"const": 0},
          "partial_artifacts_quarantined": {"type": "boolean"},
          "artifact_paths": {"type": "array", "items": {"type": "string"}},
          "retry_or_fallback": {"type": ["string", "null"]},
          "disposition": {"enum": ["retry_pilot", "revise_method", "skip_for_now", "final_source_failure", "resolved"]},
          "resolved_by_event_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}
