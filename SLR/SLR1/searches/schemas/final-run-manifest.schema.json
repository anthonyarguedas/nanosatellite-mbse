{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/slr1/final-run-manifest.schema.json",
  "title": "SLR1 final source-event manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "review_id",
    "source_id",
    "task_id",
    "partition_id",
    "event_kind",
    "status",
    "started_at",
    "ended_at",
    "common_evidence_cutoff",
    "protocol_commit",
    "guideline_version",
    "interface",
    "exact_query_or_operation",
    "controls",
    "source_reported_total",
    "retrieved_total",
    "records_imported",
    "completeness",
    "artifacts",
    "rights_and_access"
  ],
  "properties": {
    "schema_version": {"const": "slr1-final-run-manifest/v1"},
    "event_id": {"type": "string", "minLength": 1},
    "review_id": {"const": "SLR1-restart"},
    "source_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "partition_id": {"type": "string", "minLength": 1},
    "event_kind": {"const": "final_search"},
    "status": {"enum": ["success", "explicit_zero", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "common_evidence_cutoff": {"type": "string", "format": "date"},
    "protocol_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "guideline_version": {"type": "string", "minLength": 1},
    "interface": {"type": "object"},
    "exact_query_or_operation": {"type": "string"},
    "query_files": {"type": "array", "items": {"type": "string"}},
    "controls": {"type": "object"},
    "source_reported_total": {"type": ["integer", "null"], "minimum": 0},
    "retrieved_total": {"type": "integer", "minimum": 0},
    "records_imported": {"type": "integer", "minimum": 0},
    "completeness": {
      "type": "object",
      "required": ["method", "passed", "pass_identifiers_match", "totals_reconciled"],
      "properties": {
        "method": {"type": "string"},
        "passed": {"type": "boolean"},
        "pass_identifiers_match": {"type": ["boolean", "null"]},
        "totals_reconciled": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "rights_and_access": {"type": "object"},
    "failure_id": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}},
      "then": {
        "properties": {
          "source_reported_total": {"type": "integer", "minimum": 1},
          "completeness": {"properties": {"passed": {"const": true}, "totals_reconciled": {"const": true}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "explicit_zero"}}},
      "then": {
        "properties": {
          "source_reported_total": {"const": 0},
          "retrieved_total": {"const": 0},
          "records_imported": {"const": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "properties": {
          "source_reported_total": {"type": "null"},
          "retrieved_total": {"const": 0},
          "records_imported": {"const": 0},
          "failure_id": {"type": "string", "minLength": 1},
          "completeness": {"properties": {"passed": {"const": false}}}
        }
      }
    }
  ]
}
