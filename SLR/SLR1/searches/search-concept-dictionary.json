  "status": "version-1.6 frozen dictionary: version-1.5 concept semantics retained for complete Stream-A, finite T2, comparable V1/O1 tags, authorized IAF scope, and the PQDT/OATD source extension",
  "candidate_logic": {
    "scope": "Deterministic ESA Indico joined-metadata/individual-attachment matching and authorized IAF title/abstract matching. Direct A1/A2/A3/B1/B2/G/C1/T2 strategies—including PQDT aliases and finite OATD translations—and the NTRS finite matrix are defined separately in query-search-plan.md; NTRS applies E/T/V1/O1 locally after its source-cell union. No concept form changed in version 1.6.",
    "stream_a": "P AND E AND M within one searched route; source-query equivalent is A1 union A2 union A3",
    "stream_b_core": "P AND M within one searched route",
    "stream_b_genericity": "P AND a complete precise-G or conservative central-asset artifact within one searched route; no R term is required",
    "stream_b_genericity_relation_qualified": "Optional precision tag: stream_b_genericity plus at least one independent R hit",
    "stream_b_tailoring_tag": "P AND M AND T AND (model OR models OR architecture OR architectures) within one route with standalone token boundaries; a structural subset tag, not an added local candidate route",
    "stream_b": "stream_b_core OR stream_b_genericity",
    "routes": [
      "joined_metadata",
      "attachment_text"
    ],
    "union_rule": "Union core-B and genericity/central-asset-expanded B-G candidates from joined metadata and from each independently extracted attachment. Stream A remains the E-explicit tag within core-B; report an E-explicit B-G tag separately. Apply the exact finite V1/O1 sensitivity tags without adding candidates. Never combine P, G, R, M, E, V1, or O1 hits across metadata and attachment routes.",
    "relation_caveat": "R is an optional precision/provenance tag, not proof of an MBSE relationship and not required for relation-free artifact recall. The matcher separately records whether an R span does not overlap any required G component, so architecture-bearing phrases cannot self-satisfy that optional tag. Full-text eligibility still requires the protocol's structured-model and EPS bridge evidence.",
    "cross_route_cooccurrence": false,
    "generic_smallsat_is_population": false
  },
  "normalization": {
    "unicode_form": "NFKC",
    "case": "Unicode casefold",
    "html": "decode entities and remove markup before matching",
    "dash_and_hyphen": "map every Unicode dash punctuation character and ASCII hyphen to one space",
    "whitespace": "collapse all whitespace to one ASCII space",
    "punctuation": "retain other punctuation; term matches require token boundaries",
    "phrase_rule": "match the complete normalized token sequence with standalone boundaries; words may be separated only by normalized whitespace",
    "wildcards": "no runtime wildcard, stemming, or lemmatization; every wildcard is materialized as the explicit forms below",
    "acronyms": "all terms use standalone token boundaries, including EPS, MBSE, SysML, PCDU, PMAD, MIL, SIL, PIL, and HIL"
  },
