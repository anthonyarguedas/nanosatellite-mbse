  "results": [
    {
      "paperId": "10.2514/6.2026-3129",
      "doi": "10.2514/6.2026-3129",
      "title": "On-Orbit Digital Twin for Spacecraft Battery State and Health Estimation",
      "authors": [
        {
          "name": "Patnaik, Ayush"
        },
        {
          "name": "Fogelquist, Jackson"
        },
        {
          "name": "Zufall, Adam"
        },
        {
          "name": "Robinson, Stephen K."
        },
        {
          "name": "Lin, Xinfan"
        }
      ],
      "year": 2026,
      "abstract": "Lithium-ion batteries are mission-critical for nearly every modern spacecraft, yet their on-orbit management remains dominated by conservative, heuristic flight rules that sacrifice usable energy and operational flexibility to avoid degradation. This paper presents a lightweight battery digital-twin framework built around a dual extended Kalman filter (Dual-EKF) coupled with an equivalent-circuit model. A fast filter tracks state of charge (SOC) at every measurement sample, while a slow filter estimates capacity for real-time state-of-health (SOH) monitoring. On-board battery capacity forecasts are correlated with periodic reference performance tests (RPTs) and compared to the digital twin prediction. The framework is validated in the laboratory on EEMB LIR-2032 coin cells and currently on orbit aboard the Proteus Space Mercury One spacecraft, which carries a dedicated cycling payload with three Li-ion coin cells. Ground testing achieves a voltage-prediction RMSE below 5 mV and capacity estimation within 2% of RPT-derived values; preliminary on-orbit results show consistent SOC convergence, capacity-fade trends in line with ground priors, and graceful behavior under telemetry dropouts. We also outline a short future-work direction: a Gaussian-process-based lithium plating detector that would add degradation-mechanism awareness to the digital twin, enabling operators to distinguish aging from damaging plating events.",
      "citationCount": 0,
      "openAccess_pdf": {},
      "url": "https://arc.aiaa.org/doi/10.2514/6.2026-3129",
      "source": "AIAA Aerospace Research Central (ARC)",
      "publicationTitle": "ASCEND 2026",
      "publicationDate": "2026/05/13",
