  "results": [
    {
      "paperId": "10.2514/6.2023-4680",
      "doi": "10.2514/6.2023-4680",
      "title": "Digitally-assisted Development of a Space Robotic Arm for Small Satellites Applications",
      "authors": [
        {
          "name": "Molinar, Juan"
        },
        {
          "name": "Garcia, Julio"
        },
        {
          "name": "Robles, Roberto"
        },
        {
          "name": "Mendoza, Christopher"
        },
        {
          "name": "Reyes, Julio"
        },
        {
          "name": "Choudhuri, Ahsan"
        },
        {
          "name": "Flores-Abad, Angel"
        }
      ],
      "year": 2023,
      "abstract": "In-space servicing, assembly, and manufacturing (ISAM) expands space-based capabilities by extending satellite lifespans and decoupling spacecraft design from launch vehicle constraints. Robotic systems are proposed to support multiple aspects of ISAM missions, from capture and manipulation to manufacturing and repair. Consequently, the rapid development and testing of diverse robotic platforms is imperative to meet the evolving demands of the new space enterprise. This paper proposes a digital engineering framework to expedite the design, development, testing, and operation analysis of space robotic platforms. Digital engineering design tools are employed to optimize design for space environment operations; additionally, traditional manufacturing methods are streamlined with integrated wireless communication; IoT (Internet of thing) capabilities enable cloud-based modification to adjust to dynamic design requirements. Leveraging Amazon Web Services cloud-based servers, a digital twin of the robotic arm will be developed to assist the project's life cycle, from design to evaluation and test. AWS IoT communication protocols enable near real-time transmission of robotic arm sensor data to its digital twin. Siemens NX CAE (Computer Aided Engineering) facilitates photorealistic physics-based simulation, optimizing robotic arm control and motion planning. The paper details the digital engineering implementation of a two-degree-of-freedom robotic arm featuring piezoelectric rotary motors, applied in a zero gravity simulation air-bearing table study.",
      "citationCount": 0,
