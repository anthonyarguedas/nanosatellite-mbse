    {
      "paperId": "10.2514/6.2025-1656",
      "doi": "10.2514/6.2025-1656",
      "title": "Digital Engineering for Cubesats With Semantic Web Technologies",
      "authors": [
        {
          "name": "Gregory, Joe R."
        },
        {
