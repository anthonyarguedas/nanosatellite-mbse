  "results": [
    {
      "paperId": "10.2514/6.2023-4676",
      "doi": "10.2514/6.2023-4676",
      "title": "The Economic Case for an Orbital Satellite Factory",
      "authors": [
        {
          "name": "Trujillo, Alejandro E."
        },
        {
          "name": "Tu, Anh"
        },
        {
          "name": "Rome, Jacob"
        },
        {
          "name": "Goyal, Vinay"
        },
        {
          "name": "Strizzi, Jon"
        }
      ],
      "year": 2023,
      "abstract": "In-Space Servicing, Assembly and Manufacturing (ISAM) is part of the United States National Strategy and an essential piece of future space architectures. Manufacturing on orbit is one of the elements of ISAM that requires significant investment and research. There is wide interest from government actors, as demonstrated by DARPA?s NOM4D project and NASA?s upcoming OSAM-1 and OSAM-2 efforts, and from venture-backed companies that are working to develop, demonstrate, and spur economic growth in ISAM. A novel Orbital Satellite Factory (OSF) concept is introduced that would autonomously manufacture and assemble small satellites in LEO from a persistent platform. The intent of this effort is to use the OSF concept as a notional reference architecture to identify critical capabilities and enabling technologies for ISAM applications, via an OSF technology roadmap. In an effort to better understand the value proposition of the OSF concept, this paper will (1) postulate a variety of use cases for the capabilities enabled by the orbital factory and its underlying technologies; and (2) develop a method to quantify the economic case for OSF using a notional satellite manufacturing scenario. We find that, though the OSF business case is initially weak, several sensitivities exist which can improve this picture ? among these are initial government investment/assistance, the target market of manufacturable satellites, and the total addressable demand for on-orbit manufactured satellites.",
      "citationCount": 0,
      "openAccess_pdf": {},
      "url": "https://arc.aiaa.org/doi/10.2514/6.2023-4676",
      "source": "AIAA Aerospace Research Central (ARC)",
