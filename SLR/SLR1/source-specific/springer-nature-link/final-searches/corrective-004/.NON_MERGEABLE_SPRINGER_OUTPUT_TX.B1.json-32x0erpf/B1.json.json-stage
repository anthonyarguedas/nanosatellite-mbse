      "url": "https://link.springer.com/chapter/10.1007/978-3-319-13350-8_28",
      "source": "Springer Nature Link",
      "rank": 18,
      "publicationTitle": "Computing with New Resources",
      "publicationDate": "2014",
      "publicationDateSourceTag": "Springer rendered search-result Date published",
