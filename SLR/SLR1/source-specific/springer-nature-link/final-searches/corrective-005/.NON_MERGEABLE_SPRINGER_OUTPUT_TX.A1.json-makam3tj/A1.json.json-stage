    {
      "paperId": "/article/10.1007/s42423-021-00085-2",
      "doi": "10.1007/s42423-021-00085-2",
      "title": "Challenges of the SAR-Enabled Microsatellite Concept INFANTE",
      "authors": [
        {
          "name": "José P. Ferreira, Nuno Andrada, ... Sérgio Cunha"
        }
      ],
      "year": 2021,
      "abstract": "The INFANTE project is a public–private initiative arising from the experience of Portuguese companies and R&D institutes in developing critical subsystems for space missions over the last 20 years. Using such building blocks, TEKEVER leads a consortium of 20+ entities currently developing a technology demonstrator microsatellite for Earth Observation. This paper addresses a set of technical challenges faced in the conceptualization of a satellite-borne SAR, along with new project-level approaches within the framework of new space while managing a large consortium of partners.",
      "abstract_not_available": false,
      "snippet": "The INFANTE project is a public–private initiative arising from the experience of Portuguese companies and R&D institutes in developing critical...",
