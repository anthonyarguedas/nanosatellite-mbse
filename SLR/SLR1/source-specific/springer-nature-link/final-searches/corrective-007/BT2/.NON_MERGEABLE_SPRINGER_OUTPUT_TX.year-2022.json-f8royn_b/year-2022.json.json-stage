      "source": "Springer Nature Link",
      "rank": 18,
      "publicationTitle": "The International Journal of Advanced Manufacturing Technology",
      "publicationDate": "31 May 2022",
      "publicationDateSourceTag": "Springer rendered search-result Date published",
