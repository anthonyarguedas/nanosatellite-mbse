      "url": "https://link.springer.com/chapter/10.1007/978-981-99-4098-1_46",
      "source": "Springer Nature Link",
      "rank": 14,
      "publicationTitle": "Proceedings of the 7th International Symposium of Space Optical Instruments and Applications",
      "publicationDate": "2023",
