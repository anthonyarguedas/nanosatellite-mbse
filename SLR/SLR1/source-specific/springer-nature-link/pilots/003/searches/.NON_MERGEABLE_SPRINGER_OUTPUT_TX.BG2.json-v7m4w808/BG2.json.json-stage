      "exactDateFilterStatus": "included",
      "query": "(\"CubeSat\" OR \"CubeSats\" OR \"cube sat\" OR \"cube sats\" OR \"cube-sat\" OR \"cube-sats\" OR \"cube satellite\" OR \"cube satellites\" OR \"nanosat\" OR \"nanosats\" OR \"nanosatellite\" OR \"nanosatellites\" OR \"nano-sat\" OR \"nano-sats\" OR \"nano sat\" OR \"nano sats\" OR \"nano-satellite\" OR \"nano-satellites\" OR \"nano satellite\" OR \"nano satellites\" OR \"SmallSat\" OR \"SmallSats\" OR \"small satellite\" OR \"small satellites\" OR \"small sat\" OR \"small sats\") AND (\"reference architecture\" OR \"reference architectures\" OR \"domain model\" OR \"domain models\" OR \"metamodel\" OR \"metamodels\" OR \"meta-model\" OR \"meta-models\" OR (\"product-line\" AND \"model\") OR (\"product-line\" AND \"models\") OR (\"product line\" AND \"model\") OR (\"product line\" AND \"models\") OR (\"product-family\" AND \"model\") OR (\"product-family\" AND \"models\") OR (\"product family\" AND \"model\") OR (\"product family\" AND \"models\") OR (\"variation point\" AND \"model\") OR (\"variation point\" AND \"models\") OR (\"variation point\" AND \"architecture\") OR (\"variation point\" AND \"architectures\") OR (\"variation points\" AND \"model\") OR (\"variation points\" AND \"models\") OR (\"variation points\" AND \"architecture\") OR (\"variation points\" AND \"architectures\"))"
