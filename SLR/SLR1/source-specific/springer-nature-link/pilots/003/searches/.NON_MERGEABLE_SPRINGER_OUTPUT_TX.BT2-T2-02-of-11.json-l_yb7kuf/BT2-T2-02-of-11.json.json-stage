      "query": "(\"CubeSat\" OR \"CubeSats\" OR \"cube sat\" OR \"cube sats\" OR \"cube-sat\" OR \"cube-sats\" OR \"cube satellite\" OR \"cube satellites\" OR \"nanosat\" OR \"nanosats\" OR \"nanosatellite\" OR \"nanosatellites\" OR \"nano-sat\" OR \"nano-sats\" OR \"nano sat\" OR \"nano sats\" OR \"nano-satellite\" OR \"nano-satellites\" OR \"nano satellite\" OR \"nano satellites\" OR \"SmallSat\" OR \"SmallSats\" OR \"small satellite\" OR \"small satellites\" OR \"small sat\" OR \"small sats\") AND (\"system model\" OR \"systems model\" OR \"system modeling\" OR \"systems modeling\" OR \"system modelling\" OR \"systems modelling\" OR \"reference model\" OR \"reference models\" OR \"digital engineering\" OR \"object-oriented systems model\" OR \"object-oriented systems models\" OR \"model-based system design\" OR \"model based system design\" OR \"model-based systems design\" OR \"model based systems design\" OR \"system architecture model\" OR \"system architecture models\" OR \"systems architecture model\" OR \"systems architecture models\" OR \"integrated system model\" OR \"integrated system models\" OR \"integrated systems model\" OR \"integrated systems models\" OR \"system-level model\" OR \"system-level models\" OR \"system level model\" OR \"system level models\" OR \"digital thread\" OR \"digital threads\" OR \"digital twin\" OR \"digital twins\") AND ((\"tailors\" AND \"model\") OR (\"tailors\" AND \"models\") OR (\"tailors\" AND \"architecture\") OR (\"tailors\" AND \"architectures\") OR (\"tailored\" AND \"model\") OR (\"tailored\" AND \"models\") OR (\"tailored\" AND \"architecture\") OR (\"tailored\" AND \"architectures\") OR (\"tailoring\" AND \"model\") OR (\"tailoring\" AND \"models\") OR (\"tailoring\" AND \"architecture\") OR (\"tailoring\" AND \"architectures\") OR (\"customize\" AND \"model\") OR (\"customize\" AND \"models\") OR (\"customize\" AND \"architecture\") OR (\"customize\" AND \"architectures\") OR (\"customizes\" AND \"model\") OR 