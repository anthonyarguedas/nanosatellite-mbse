      "url": "https://link.springer.com/rwe/10.1007/978-3-030-27486-3_84-1",
      "source": "Springer Nature Link",
      "rank": 49,
      "publicationTitle": "Handbook of Model-Based Systems Engineering",
      "publicationDate": "2022",
