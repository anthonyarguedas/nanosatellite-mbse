      "sourcePublicationDatePrecision": "day",
      "sourcePublicationDateConflict": false,
      "detailPublicationDate": "2024-03-20",
      "detailPublicationDateSourceTag": "Published",
      "detailPublicationDateText": "Published: 20 March 2024",
