(version 1)
# Generated only from explicitly approved dimensions. No electrical conversion or PCB generation.
# EPS-07 | sources: synthetic
(rule "EPS_POWER_track_width"
  (condition "A.NetName == 'EPS_BUS'")
  (constraint track_width (min 0.8mm) (opt 0.8mm)))
# EPS-07 | sources: synthetic
(rule "EPS_POWER_via_diameter"
  (condition "A.NetName == 'EPS_BUS'")
  (constraint via_diameter (min 0.8mm) (opt 0.8mm)))
# EPS-07 | sources: synthetic
(rule "EPS_POWER_via_drill"
  (condition "A.Type == 'Via' && (A.NetName == 'EPS_BUS')")
  (constraint hole_size (min 0.4mm) (opt 0.4mm) (max 0.4mm)))
# EPS-03 | sources: synthetic
(rule "EPS_POWER_clearance"
  (condition "(A.NetName == 'EPS_BUS' || B.NetName == 'EPS_BUS')")
  (constraint clearance (min 0.5mm)))
# EPS-20 | sources: synthetic
(rule "board_edge_clearance"
  (constraint edge_clearance (min 0.5mm)))
