// Controlled report model. Trace records are published in final_report/traceability/.
package FrameworkVerification {
private import FrameworkDomain::*;
private import VerificationCases::*;
verification <'V01'> V01 { subject framework : Framework; objective { verify FrameworkRequirements::FR_01; } doc /* PLANNED, NOT EXECUTED. Round-trip a quantitative requirement and a qualitative demonstration requirement, including source, condition or quantity, applicable units and criterion. An inapplicable field retains rationale. An absent criterion remains unresolved and cannot acquire a verified label. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V01"; sourceText = "Round-trip a quantitative requirement and a qualitative demonstration requirement, including source, condition or quantity, applicable units and criterion. An inapplicable field retains rationale. An absent criterion remains unresolved and cannot acquire a verified label."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-01"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V02'> V02 { subject framework : Framework; objective { verify FrameworkRequirements::FR_02; } doc /* PLANNED, NOT EXECUTED. Inspect the learning package and demonstrate the workflow from a declared clean start. Measure learner effort and errors without imposing an unagreed time limit. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::demo); } }
@SourceRecord { identifier = "V02"; sourceText = "Inspect the learning package and demonstrate the workflow from a declared clean start. Measure learner effort and errors without imposing an unagreed time limit."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-02"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V03'> V03 { subject framework : Framework; objective { verify FrameworkRequirements::FR_03; } doc /* PLANNED, NOT EXECUTED. For subsystem and component fixtures retrieve the chosen method and its source, conditions, tailoring decision, and excluded alternatives. A catalogue entry does not assert standards compliance. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::demo); } }
@SourceRecord { identifier = "V03"; sourceText = "For subsystem and component fixtures retrieve the chosen method and its source, conditions, tailoring decision, and excluded alternatives. A catalogue entry does not assert standards compliance."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-03"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V04'> V04 { subject framework : Framework; objective { verify FrameworkRequirements::FR_04; } doc /* PLANNED, NOT EXECUTED. Compare both query directions with the fixture relation set. Missing, ambiguous and stale endpoints remain visible. */ metadata VerificationMethod { kind = (VerificationMethodKind::test); } }
@SourceRecord { identifier = "V04"; sourceText = "Compare both query directions with the fixture relation set. Missing, ambiguous and stale endpoints remain visible."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-04"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V05'> V05 { subject framework : Framework; objective { verify FrameworkRequirements::FR_05; } doc /* PLANNED, NOT EXECUTED. Use seeded cross-subsystem and component changes. Compare the returned impact set and unresolved coverage with an adjudicated reference. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V05"; sourceText = "Use seeded cross-subsystem and component changes. Compare the returned impact set and unresolved coverage with an adjudicated reference."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-05"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V06'> V06 { subject framework : Framework; objective { verify FrameworkRequirements::FR_06; } doc /* PLANNED, NOT EXECUTED. Exercise a failed verification gate followed by correction. Preserve the prior baseline and prevent stale results from appearing current. */ metadata VerificationMethod { kind = (VerificationMethodKind::test); } }
@SourceRecord { identifier = "V06"; sourceText = "Exercise a failed verification gate followed by correction. Preserve the prior baseline and prevent stale results from appearing current."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-06"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V07'> V07 { subject framework : Framework; objective { verify FrameworkRequirements::FR_07; } doc /* PLANNED, NOT EXECUTED. Reconstruct two revisions after a change and compare their manifests and contents. Attempted overwrite cannot erase the retained prior baseline. */ metadata VerificationMethod { kind = (VerificationMethodKind::test); } }
@SourceRecord { identifier = "V07"; sourceText = "Reconstruct two revisions after a change and compare their manifests and contents. Attempted overwrite cannot erase the retained prior baseline."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-07"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V08'> V08 { subject framework : Framework; objective { verify FrameworkRequirements::FR_08; } doc /* PLANNED, NOT EXECUTED. Inject unit, sign, identifier and time-base mismatches. Reject incompatible transfers without replacing controlled content. Record unsupported or lossy mappings. */ metadata VerificationMethod { kind = (VerificationMethodKind::test); } }
@SourceRecord { identifier = "V08"; sourceText = "Inject unit, sign, identifier and time-base mismatches. Reject incompatible transfers without replacing controlled content. Record unsupported or lossy mappings."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-08"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V09'> V09 { subject framework : Framework; objective { verify FrameworkRequirements::FR_09; } doc /* PLANNED, NOT EXECUTED. Trace an analytical and a supplied measurement result to every applicable configuration item. An unknown identity remains a gap and blocks a contradictory validity claim. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V09"; sourceText = "Trace an analytical and a supplied measurement result to every applicable configuration item. An unknown identity remains a gap and blocks a contradictory validity claim."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-09"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V10'> V10 { subject framework : Framework; objective { verify FrameworkRequirements::FR_10; } doc /* PLANNED, NOT EXECUTED. An independent participant replays a baseline from a clean declared environment. Retain logs, seeds when relevant, failures and comparison verdicts. Tolerances are fixed before replay. */ metadata VerificationMethod { kind = (VerificationMethodKind::demo, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V10"; sourceText = "An independent participant replays a baseline from a clean declared environment. Retain logs, seeds when relevant, failures and comparison verdicts. Tolerances are fixed before replay."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-10"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V11'> V11 { subject framework : Framework; objective { verify FrameworkRequirements::FR_11; } doc /* PLANNED, NOT EXECUTED. Seed each status including a critical finding. A claim affected by unresolved critical evidence cannot receive an unqualified supported or verified status. */ metadata VerificationMethod { kind = (VerificationMethodKind::test); } }
@SourceRecord { identifier = "V11"; sourceText = "Seed each status including a critical finding. A claim affected by unresolved critical evidence cannot receive an unqualified supported or verified status."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-11"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V12'> V12 { subject framework : Framework; objective { verify FrameworkRequirements::FR_12; } doc /* PLANNED, NOT EXECUTED. Compare two alternative assemblies and one component substitution with a reference BOM. Candidate alternatives remain distinct. Missing part data is reported. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V12"; sourceText = "Compare two alternative assemblies and one component substitution with a reference BOM. Candidate alternatives remain distinct. Missing part data is reported."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-12"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V13'> V13 { subject framework : Framework; objective { verify FrameworkRequirements::FR_13; } doc /* PLANNED, NOT EXECUTED. Recalculate a sourced-price fixture after a quantity and part change. Match reference arithmetic and preserve unknown costs. Do not import historical project costs as new framework measurements. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V13"; sourceText = "Recalculate a sourced-price fixture after a quantity and part change. Match reference arithmetic and preserve unknown costs. Do not import historical project costs as new framework measurements."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-13"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V14'> V14 { subject framework : Framework; objective { verify FrameworkRequirements::FR_14; } doc /* PLANNED, NOT EXECUTED. Compare candidates with a failing requirement and incomplete evidence. Keep feasibility and unknown status separate from ranking. Any preference weights are declared before results. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V14"; sourceText = "Compare candidates with a failing requirement and incomplete evidence. Keep feasibility and unknown status separate from ranking. Any preference weights are declared before results."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-14"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V15'> V15 { subject framework : Framework; objective { verify FrameworkRequirements::FR_15; } doc /* PLANNED, NOT EXECUTED. Instantiate the representation in two contrasting cases and trace a requirement through function, allocation, interface and analysis. An extension retains its relation to the generic core. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::demo); } }
@SourceRecord { identifier = "V15"; sourceText = "Instantiate the representation in two contrasting cases and trace a requirement through function, allocation, interface and analysis. An extension retains its relation to the generic core."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-15"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V16'> V16 { subject framework : Framework; objective { verify FrameworkRequirements::FR_16; } doc /* PLANNED, NOT EXECUTED. Use a fixture whose average budget passes while a coupled load and illumination event creates a transient shortage. Inspect inputs, interactions and event timing against a reference calculation. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V16"; sourceText = "Use a fixture whose average budget passes while a coupled load and illumination event creates a transient shortage. Inspect inputs, interactions and event timing against a reference calculation."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-16"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V17'> V17 { subject framework : Framework; objective { verify FrameworkRequirements::FR_17; } doc /* PLANNED, NOT EXECUTED. Derive a fixture allocation from datasheet and supplied measurement inputs using a declared method. Preserve assumptions and flag unsupported ranges and undecided pass/fail values. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V17"; sourceText = "Derive a fixture allocation from datasheet and supplied measurement inputs using a declared method. Preserve assumptions and flag unsupported ranges and undecided pass/fail values."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-17"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V18'> V18 { subject framework : Framework; objective { verify FrameworkRequirements::FR_18; } doc /* PLANNED, NOT EXECUTED. Every electrical, thermal, EMC and CAD exchange profile required by the frozen minimum shall complete its reference request/result exchange and declared identity, quantity, unit, meaning and revision checks. Retain unsupported mappings and development gaps. A missing required profile remains not verified or undetermined and cannot pass V18. A narrower minimum requires a reviewed scope disposition before evaluation. */ metadata VerificationMethod { kind = (VerificationMethodKind::demo, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V18"; sourceText = "Every electrical, thermal, EMC and CAD exchange profile required by the frozen minimum shall complete its reference request/result exchange and declared identity, quantity, unit, meaning and revision checks. Retain unsupported mappings and development gaps. A missing required profile remains not verified or undetermined and cannot pass V18. A narrower minimum requires a reviewed scope disposition before evaluation."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-18"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V19'> V19 { subject framework : Framework; objective { verify FrameworkRequirements::FR_19; } doc /* PLANNED, NOT EXECUTED. Retain stimulus, conditions, expected response, outputs and status for nominal and failure fixtures. Unsupported behavior and physical validation needs are explicit, including COTS evidence gaps. */ metadata VerificationMethod { kind = (VerificationMethodKind::demo, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V19"; sourceText = "Retain stimulus, conditions, expected response, outputs and status for nominal and failure fixtures. Unsupported behavior and physical validation needs are explicit, including COTS evidence gaps."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-19"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V20'> V20 { subject framework : Framework; objective { verify FrameworkRequirements::FR_20; } doc /* PLANNED, NOT EXECUTED. Replay fresh and aged battery fixtures under different load and temperature profiles. Verify coupling and provenance. Missing aging mechanisms and latent-state uncertainty remain visible. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::demo); } }
@SourceRecord { identifier = "V20"; sourceText = "Replay fresh and aged battery fixtures under different load and temperature profiles. Verify coupling and provenance. Missing aging mechanisms and latent-state uncertainty remain visible."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-20"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V21'> V21 { subject framework : Framework; objective { verify FrameworkRequirements::FR_21; } doc /* PLANNED, NOT EXECUTED. Exercise an in-domain and an extrapolated claim. Separate calibration from validation data where available. Flag untested domains and absent error limits. Prediction accuracy limits require prior agreement. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V21"; sourceText = "Exercise an in-domain and an extrapolated claim. Separate calibration from validation data where available. Flag untested domains and absent error limits. Prediction accuracy limits require prior agreement."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-21"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V22'> V22 { subject framework : Framework; objective { verify FrameworkRequirements::FR_22; } doc /* PLANNED, NOT EXECUTED. Apply a measurement fixture, compare the declared calibration result with a reference, retain both parameter revisions, and flag analyses affected by drift or update. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V22"; sourceText = "Apply a measurement fixture, compare the declared calibration result with a reference, retain both parameter revisions, and flag analyses affected by drift or update."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-22"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V23'> V23 { subject framework : Framework; objective { verify FrameworkRequirements::FR_23; } doc /* PLANNED, NOT EXECUTED. Profile a declared executable model and replay timestamped input/output fixtures. Real-time suitability remains unresolved until the applicable hardware and deadline are verified. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V23"; sourceText = "Profile a declared executable model and replay timestamped input/output fixtures. Real-time suitability remains unresolved until the applicable hardware and deadline are verified."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-23"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V24'> V24 { subject framework : Framework; objective { verify FrameworkRequirements::FR_24; } doc /* PLANNED, NOT EXECUTED. Replay a baseline and a changed policy against the same fixture conditions. A model prediction cannot be labeled a demonstrated hardware improvement. Retain pending SIL, HIL or hardware evidence. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V24"; sourceText = "Replay a baseline and a changed policy against the same fixture conditions. A model prediction cannot be labeled a demonstrated hardware improvement. Retain pending SIL, HIL or hardware evidence."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-24"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V25'> V25 { subject framework : Framework; objective { verify FrameworkRequirements::FR_25; } doc /* PLANNED, NOT EXECUTED. Use nominal, degrading, noisy and injected-fault fixtures. Retain residuals and diagnoses with TP, FP and FN against an expert reference. No pre-threshold detection capability is presumed. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V25"; sourceText = "Use nominal, degrading, noisy and injected-fault fixtures. Retain residuals and diagnoses with TP, FP and FN against an expert reference. No pre-threshold detection capability is presumed."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-25"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V26'> V26 { subject framework : Framework; objective { verify FrameworkRequirements::FR_26; } doc /* PLANNED, NOT EXECUTED. Compare the declared RAM variable and requirement set with a reference. Report analysis, inspection, demonstration or test rationale without forcing every claim to use analysis. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V26"; sourceText = "Compare the declared RAM variable and requirement set with a reference. Report analysis, inspection, demonstration or test rationale without forcing every claim to use analysis."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-26"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V27'> V27 { subject framework : Framework; objective { verify FrameworkRequirements::FR_27; } doc /* PLANNED, NOT EXECUTED. Generate an FMEA, fault tree or other justified representation for a reference design and its changed variant. Compare entities and dependencies with an expert model. Missing probabilities cannot become factual reliability estimates. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V27"; sourceText = "Generate an FMEA, fault tree or other justified representation for a reference design and its changed variant. Compare entities and dependencies with an expert model. Missing probabilities cannot become factual reliability estimates."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-27"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V28'> V28 { subject framework : Framework; objective { verify FrameworkRequirements::FR_28; } doc /* PLANNED, NOT EXECUTED. Inspect quantitative analysis/test and qualitative inspection/demonstration fixtures against their method-specific fields. Check the applicable quantity or observable condition, criterion, expected response and evidence. An inapplicable field retains rationale. Missing mandatory fields, failed gates and unresolved criteria remain explicit and prevent an unsupported verdict. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V28"; sourceText = "Inspect quantitative analysis/test and qualitative inspection/demonstration fixtures against their method-specific fields. Check the applicable quantity or observable condition, criterion, expected response and evidence. An inapplicable field retains rationale. Missing mandatory fields, failed gates and unresolved criteria remain explicit and prevent an unsupported verdict."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-28"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V29'> V29 { subject framework : Framework; objective { verify FrameworkRequirements::FR_29; } doc /* PLANNED, NOT EXECUTED. A technician or qualified proxy checks a fixture proposal against a declared completeness checklist and identifies how equipment interacts with the DUT. Facility feasibility remains a separate decision. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::demo); } }
@SourceRecord { identifier = "V29"; sourceText = "A technician or qualified proxy checks a fixture proposal against a declared completeness checklist and identifies how equipment interacts with the DUT. Facility feasibility remains a separate decision."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-29"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V30'> V30 { subject framework : Framework; objective { verify FrameworkRequirements::FR_30; } doc /* PLANNED, NOT EXECUTED. Use a safe virtual fault fixture and an incomplete physical proposal. Missing limits or approval status block a ready-for-physical-execution label. The framework does not authorize laboratory operations. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V30"; sourceText = "Use a safe virtual fault fixture and an incomplete physical proposal. Missing limits or approval status block a ready-for-physical-execution label. The framework does not authorize laboratory operations."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-30"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V31'> V31 { subject framework : Framework; objective { verify FrameworkRequirements::FR_31; } doc /* PLANNED, NOT EXECUTED. Align a known timestamp fixture and expose injected skew and missing timing metadata. Report alignment error or uncertainty against the agreed profile, with no invented global limit. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V31"; sourceText = "Align a known timestamp fixture and expose injected skew and missing timing metadata. Report alignment error or uncertainty against the agreed profile, with no invented global limit."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-31"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V32'> V32 { subject framework : Framework; objective { verify FrameworkRequirements::FR_32; } doc /* PLANNED, NOT EXECUTED. Inject missing samples, inactive sensors and invalid values. Do not treat inactive invalid readings as valid measurements. Match the fixture quality verdict and retained raw data. */ metadata VerificationMethod { kind = (VerificationMethodKind::test); } }
@SourceRecord { identifier = "V32"; sourceText = "Inject missing samples, inactive sensors and invalid values. Do not treat inactive invalid readings as valid measurements. Match the fixture quality verdict and retained raw data."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-32"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V33'> V33 { subject framework : Framework; objective { verify FrameworkRequirements::FR_33; } doc /* PLANNED, NOT EXECUTED. Compare model, flight and ground fixtures against a shared contract. Detect a changed definition in one representation and report every affected mapping. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V33"; sourceText = "Compare model, flight and ground fixtures against a shared contract. Detect a changed definition in one representation and report every affected mapping."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-33"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V34'> V34 { subject framework : Framework; objective { verify FrameworkRequirements::FR_34; } doc /* PLANNED, NOT EXECUTED. Round-trip or validate reference message and port mappings in both profiles. Declare framework version and unsupported exports. Architecture or dictionary generation is distinct from mission-specific functionality. */ metadata VerificationMethod { kind = (VerificationMethodKind::demo, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V34"; sourceText = "Round-trip or validate reference message and port mappings in both profiles. Declare framework version and unsupported exports. Architecture or dictionary generation is distinct from mission-specific functionality."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-34"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V35'> V35 { subject framework : Framework; objective { verify FrameworkRequirements::FR_35; } doc /* PLANNED, NOT EXECUTED. Replay nominal, rejected and recovery sequences with a qualified software reference. Confirm functional flow and ownership without claiming deployment of flight software. */ metadata VerificationMethod { kind = (VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V35"; sourceText = "Replay nominal, rejected and recovery sequences with a qualified software reference. Confirm functional flow and ownership without claiming deployment of flight software."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-35"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V36'> V36 { subject framework : Framework; objective { verify FrameworkRequirements::FR_36; } doc /* PLANNED, NOT EXECUTED. Inspect a build/deployment profile and reference resource records. Distinguish measurements, estimates and unknown target compatibility. Check against mission-supplied allocations when available. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::analyze, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V36"; sourceText = "Inspect a build/deployment profile and reference resource records. Distinguish measurements, estimates and unknown target compatibility. Check against mission-supplied allocations when available."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-36"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V37'> V37 { subject framework : Framework; objective { verify FrameworkRequirements::FR_37; } doc /* PLANNED, NOT EXECUTED. Compare generated views with a fixture model and apply a declared reviewer task checklist. Assess correctness and readability without proliferating requirement, measure, scenario or state diagrams. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::demo); } }
@SourceRecord { identifier = "V37"; sourceText = "Compare generated views with a fixture model and apply a declared reviewer task checklist. Assess correctness and readability without proliferating requirement, measure, scenario or state diagrams."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-37"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V38'> V38 { subject framework : Framework; objective { verify FrameworkRequirements::FR_38; } doc /* PLANNED, NOT EXECUTED. An independent reviewer locates the designated claims and evidence and records findings and outcomes. Keep author status, reviewer outcome and approval authority distinct. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::demo); } }
@SourceRecord { identifier = "V38"; sourceText = "An independent reviewer locates the designated claims and evidence and records findings and outcomes. Keep author status, reviewer outcome and approval authority distinct."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-38"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V39'> V39 { subject framework : Framework; objective { verify FrameworkRequirements::FR_39; } doc /* PLANNED, NOT EXECUTED. Demonstrate the minimum workflow from a clean declared environment. Record wall-clock time separately from active person-hours and state the cost period and inclusions. Unknown cost stays unknown. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::demo); } }
@SourceRecord { identifier = "V39"; sourceText = "Demonstrate the minimum workflow from a clean declared environment. Record wall-clock time separately from active person-hours and state the cost period and inclusions. Unknown cost stays unknown."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-39"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification <'V40'> V40 { subject framework : Framework; objective { verify FrameworkRequirements::FR_40; } doc /* PLANNED, NOT EXECUTED. Complete the same declared workflow in both cases without undeclared or post hoc core changes. If the core changes, rebaseline and rerun both cases before a reuse claim. No implementation or successful outcome is asserted here. */ metadata VerificationMethod { kind = (VerificationMethodKind::inspect, VerificationMethodKind::demo, VerificationMethodKind::test); } }
@SourceRecord { identifier = "V40"; sourceText = "Complete the same declared workflow in both cases without undeclared or post hoc core changes. If the core changes, rebaseline and rerun both cases before a reuse claim. No implementation or successful outcome is asserted here."; sourceLocator = "final_report/traceability/framework-baseline.json#verification_cases:FR-40"; status = "planned, not executed, no observed verdict"; citationRecord = ""; }
verification def EPSVerification { subject eps : EPSHardware; doc /* Reserved subject for engineered EPS verification. No acceptance or flight qualification verdict is asserted. */ }
verification def SoftwareVerification { subject software : FlightSoftware; doc /* Reserved subject for operational software verification, distinct from framework verification. */ }
verification def DeliverableAssessment { subject deliverables : ResearchDeliverables; doc /* Reserved subject for project indicator/deadline assessment. It is outside framework and EPS acceptance. */ }

}
