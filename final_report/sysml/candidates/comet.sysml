#intendedRealization allocation allocate_FR_40_COM_S01 allocate FrameworkRequirements::FR_40 to physical.COM_S01;
@PhysicalRecord { identifier = "allocate_FR_40_COM_S01"; recordJSON = "{\"requirement_id\":\"FR-40\",\"title\":\"Contrasting-case reuse\",\"requirement_text\":\"The framework shall apply an identified common core to two predefined contrasting EPS cases using declared parameters, mappings and extensions and retain case outcomes and any core changes.\",\"logical_component_ids\":[\"L09\",\"L01\",\"L08\"],\"physical_component_ids\":[\"COM-S01\",\"COM-S02\",\"COM-S15\",\"COM-D02\",\"COM-D04\",\"COM-D12\",\"COM-D18\",\"COM-D09\",\"COM-P01\",\"COM-P07\"],\"realization_mechanism\":\"D18 fixes two contrasting case profiles and one core manifest before execution. Native Study Models derive from the pinned template. S15 checks case parameters/mappings/extensions against the core. P07 retains outcomes and forces both cases to rerun after a core change.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"native template/case pattern plus transferable tailoring\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E04\",\"COM-E08\",\"COM-E09\"],\"source_locators\":[{\"evidence_id\":\"COM-E04\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[4,5],\"section\":\"4.2 and first 4.2.1\",\"source_maturity\":\"Implemented tutorial architecture\",\"allocation_evidence_role\":\"native template/case pattern plus transferable tailoring\"},{\"evidence_id\":\"COM-E08\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[2,5,6],\"section\":\"2.1, 2.2, 5, 6\",\"source_maturity\":\"Student pilot\",\"allocation_evidence_role\":\"native template/case pattern plus transferable tailoring\"},{\"evidence_id\":\"COM-E09\",\"source_id\":\"citation-2362\",\"source_path\":\"SLR/SLR1/pdfs/citation-reports/citation-report-2362/citation-report-2362.md\",\"physical_pdf_pages\":[2,4,5],\"section\":\"CSRM, CSRM Application, Mission-specific CubeSat Model, Transition\",\"source_maturity\":\"Reference model guidance\",\"allocation_evidence_role\":\"native template/case pattern plus transferable tailoring\"}],\"verification_id\":\"V40\",\"verification_method\":\"I,D,T\",\"verification_fixture_observation\":\"Complete the same declared workflow in both cases without undeclared or post hoc core changes. If the core changes, rebaseline and rerun both cases before a reuse claim. No implementation or successful outcome is asserted here.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-40\",\"implementation_gap\":\"Contrasts, allowable extensions and complete same-core case workflows must be agreed and demonstrated.\",\"boundary_authority_note\":\"Case adaptation differs from core change. Undeclared or post hoc fixes cannot earn successful reuse credit.\",\"mission_need_ids\":[\"MN-11\"],\"mission_requirement_ids\":[\"MR-11\"],\"execution_host_ids\":[\"COM-H01\",\"COM-H02\",\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P01\":[\"Systems engineer\",\"Participant acting in declared engineering role\"],\"COM-P07\":[\"Independent reproducer/reviewer\",\"Framework evaluator\"]}}"; status = "proposed comparison description, not implemented or verified"; }
