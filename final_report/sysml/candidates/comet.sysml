@PhysicalRecord { identifier = "COM-D11"; recordJSON = "{\"id\":\"COM-D11\",\"name\":\"BOM, cost, derivation and comparison workbooks\",\"kind\":\"persistent data\",\"nodes\":[\"COM-N4\",\"COM-N3\"],\"status\":\"proposed, implementation and verification pending\",\"responsibility\":\"Versioned Excel sheets join selected COMET occurrences and quantities to catalogue IDs. Price sources/dates/currencies, non-component categories, uncertainty, unknown cells, derivation formulas and common EPS comparison basis stay explicit.\",\"storage_host_ids\":[\"COM-H01\",\"COM-H03\"],\"backup_host_ids\":[\"COM-H04\"],\"storage_rule\":\"Listed hosts distinguish editable working native files from digest-bound released copies. H03 is accepted manifest/artifact custody. H04 backup is checked by restore, not presumed.\"}"; status = "proposed, implementation and verification pending"; }
item <'COM-D12'> COM_D12 : DataResource;
@PhysicalRecord { identifier = "COM-D12"; recordJSON = "{\"id\":\"COM-D12\",\"name\":\"Generic EPS architecture and software service contracts\",\"kind\":\"persistent data\",\"nodes\":[\"COM-N3\"],\"status\":\"proposed, implementation and verification pending\",\"responsibility\":\"Companion function/logical/physical allocations, interfaces, transitions and extension records linked to COMET equipment/categories/states. One software dictionary plus separate cFS/F-Prime mapping profiles, command guards/effects/recovery roles and target configuration.\",\"parent_component_id\":\"COM-D05\",\"storage_host_ids\":[\"COM-H03\"],\"backup_host_ids\":[\"COM-H04\"],\"storage_rule\":\"Listed hosts distinguish editable working native files from digest-bound released copies. H03 is accepted manifest/artifact custody. H04 backup is checked by restore, not presumed.\"}"; status = "proposed, implementation and verification pending"; }
item <'COM-D13'> COM_D13 : DataResource;
@PhysicalRecord { identifier = "COM-D13"; recordJSON = "{\"id\":\"COM-D13\",\"name\":\"Scenario, exchange and execution profiles\",\"kind\":\"persistent data\",\"nodes\":[\"COM-N3\",\"COM-N4\"],\"status\":\"proposed, implementation and verification pending\",\"responsibility\":\"Named electrical/thermal/EMC/CAD/orbit/battery/RAM external-service contracts, variables/units/frames/clocks, schedules, policy/fault cases, coupling/fidelity/runtime settings, requested outputs and unsupported checks.\",\"parent_component_id\":\"COM-D06\",\"storage_host_ids\":[\"COM-H03\"],\"backup_host_ids\":[\"COM-H04\"],\"storage_rule\":\"Listed hosts distinguish editable working native files from digest-bound released copies. H03 is accepted manifest/artifact custody. H04 backup is checked by restore, not presumed.\"}"; status = "proposed, implementation and verification pending"; }
item <'COM-D14'> COM_D14 : DataResource;
@PhysicalRecord { identifier = "COM-D14"; recordJSON = "{\"id\":\"COM-D14\",\"name\":\"Model applicability, calibration and observation records\",\"kind\":\"persistent data\",\"nodes\":[\"COM-N3\"],\"status\":\"proposed, implementation and verification pending\",\"responsibility\":\"Use/domain/validation/error/uncertainty records, measurement quality and clock mappings, separate calibration/validation dataset identities, parameter proposals, residuals, masks, alternative diagnoses and affected uses.\",\"parent_component_id\":\"COM-D06\",\"storage_host_ids\":[\"COM-H03\"],\"backup_host_ids\":[\"COM-H04\"],\"storage_rule\":\"Listed hosts distinguish editable working native files from digest-bound released copies. H03 is accepted manifest/artifact custody. H04 backup is checked by restore, not presumed.\"}"; status = "proposed, implementation and verification pending"; }
item <'COM-D15'> COM_D15 : DataResource;
@PhysicalRecord { identifier = "COM-D15"; recordJSON = "{\"id\":\"COM-D15\",\"name\":\"RAM coverage and transformation records\",\"kind\":\"persistent data\",\"nodes\":[\"COM-N3\"],\"status\":\"proposed, implementation and verification pending\",\"responsibility\":\"Requirement-variable/method coverage, function/component/failure dependencies and reviewed FMEA row transformation rules. Failure/repair/recovery sources and missing probabilities remain visible.\",\"parent_component_id\":\"COM-D05\",\"storage_host_ids\":[\"COM-H03\"],\"backup_host_ids\":[\"COM-H04\"],\"storage_rule\":\"Listed hosts distinguish editable working native files from digest-bound released copies. H03 is accepted manifest/artifact custody. H04 backup is checked by restore, not presumed.\"}"; status = "proposed, implementation and verification pending"; }
item <'COM-D16'> COM_D16 : DataResource;
@PhysicalRecord { identifier = "COM-D16"; recordJSON = "{\"id\":\"COM-D16\",\"name\":\"Verification, facility and safety specifications\",\"kind\":\"persistent data\",\"nodes\":[\"COM-N3\"],\"status\":\"proposed, implementation and verification pending\",\"responsibility\":\"Analysis/inspection/demonstration/test records with subject, requirement, DUT baseline, setup, stimuli, evidence variables, criteria, hazards, limits, isolation, aborts and external facility review/readiness status.\",\"parent_component_id\":\"COM-D05\",\"storage_host_ids\":[\"COM-H03\"],\"backup_host_ids\":[\"COM-H04\"],\"storage_rule\":\"Listed hosts distinguish editable working native files from digest-bound released copies. H03 is accepted manifest/artifact custody. H04 backup is checked by restore, not presumed.\"}"; status = "proposed, implementation and verification pending"; }
item <'COM-D17'> COM_D17 : DataResource;
@PhysicalRecord { identifier = "COM-D17"; recordJSON = "{\"id\":\"COM-D17\",\"name\":\"Sourced method catalogue and guided examples\",\"kind\":\"persistent data\",\"nodes\":[\"COM-N3\",\"COM-N1\"],\"status\":\"proposed, implementation and verification pending\",\"responsibility\":\"Methods/standards/activity templates with source version, applicability, tailoring and rejected alternatives. Worked COMET/Excel EPS tasks include numerical and qualitative requirements, trace gaps and reviewed lessons.\",\"parent_component_id\":\"COM-D09\",\"storage_host_ids\":[\"COM-H03\"],\"backup_host_ids\":[\"COM-H04\"],\"storage_rule\":\"Listed hosts distinguish editable working native files from digest-bound released copies. H03 is accepted manifest/artifact custody. H04 backup is checked by restore, not presumed.\"}"; status = "proposed, implementation and verification pending"; }
item <'COM-D18'> COM_D18 : DataResource;
@PhysicalRecord { identifier = "COM-D18"; recordJSON = "{\"id\":\"COM-D18\",\"name\":\"Case/core and evaluation declarations\",\"kind\":\"persistent data\",\"nodes\":[\"COM-N3\"],\"status\":\"proposed, implementation and verification pending\",\"responsibility\":\"Frozen reusable core manifest, two predefined case profiles and allowed extensions. Task/correctness oracle, prerequisites/licenses/dependencies, elapsed versus active effort, actual direct costs/scope, failures and rerun obligations.\",\"parent_component_id\":\"COM-D09\",\"storage_host_ids\":[\"COM-H03\"],\"backup_host_ids\":[\"COM-H04\"],\"storage_rule\":\"Listed hosts distinguish editable working native files from digest-bound released copies. H03 is accepted manifest/artifact custody. H04 backup is checked by restore, not presumed.\"}"; status = "proposed, implementation and verification pending"; }
action <'COM-P08'> COM_P08 : OperatingProcedure;
@PhysicalRecord { identifier = "COM-P08"; recordJSON = "{\"id\":\"COM-P08\",\"name\":\"Method and criterion adjudication\",\"kind\":\"procedure\",\"nodes\":[\"COM-N1\",\"COM-N3\"],\"status\":\"proposed, implementation and verification pending\",\"responsibility\":\"Systems engineer and EPS engineer choose sourced methods, document applicability and qualitative or quantitative criteria, and justify not-applicable fields. Technician supplies facility-specific constraints without framework authorization.\",\"performers\":[\"Systems engineer\",\"EPS engineer\",\"Technician for supplied facility constraints\"],\"instruction_storage_host_ids\":[\"COM-H03\"],\"user_access_host_ids\":[\"COM-H01\"],\"execution_rule\":\"External people perform supplied framework procedures in named roles. No additional employee or approval is presumed.\"}"; status = "proposed, implementation and verification pending"; }
action <'COM-P09'> COM_P09 : OperatingProcedure;
@PhysicalRecord { identifier = "COM-P09"; recordJSON = "{\"id\":\"COM-P09\",\"name\":\"Calibration and model-applicability review\",\"kind\":\"procedure\",\"nodes\":[\"COM-N3\",\"COM-N4\"],\"status\":\"proposed, implementation and verification pending\",\"responsibility\":\"EPS engineer and qualified modeling reviewer fix intended use and comparison rules, review fitting/validation data, accept or reject parameter proposals and identify claims requiring reanalysis.\",\"performers\":[\"EPS engineer\",\"Qualified modeling reviewer\"],\"instruction_storage_host_ids\":[\"COM-H03\"],\"user_access_host_ids\":[\"COM-H01\"],\"execution_rule\":\"External people perform supplied framework procedures in named roles. No additional employee or approval is presumed.\"}"; status = "proposed, implementation and verification pending"; }
action <'COM-P10'> COM_P10 : OperatingProcedure;
@PhysicalRecord { identifier = "COM-P10"; recordJSON = "{\"id\":\"COM-P10\",\"name\":\"RAM dependency and coverage review\",\"kind\":\"procedure\",\"nodes\":[\"COM-N3\",\"COM-N4\"],\"status\":\"proposed, implementation and verification pending\",\"responsibility\":\"Systems engineer and qualified RAM reviewer check variables, failure/recovery dependencies and generated FMEA rows against a reference. Unknown failure inputs block unsupported quantitative claims.\",\"performers\":[\"Systems engineer\",\"Qualified RAM reviewer\"],\"instruction_storage_host_ids\":[\"COM-H03\"],\"user_access_host_ids\":[\"COM-H01\"],\"execution_rule\":\"External people perform supplied framework procedures in named roles. No additional employee or approval is presumed.\"}"; status = "proposed, implementation and verification pending"; }
}
