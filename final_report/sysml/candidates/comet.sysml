#intendedRealization allocation allocate_FR_39_COM_S02 allocate FrameworkRequirements::FR_39 to physical.COM_S02;
@PhysicalRecord { identifier = "allocate_FR_39_COM_S02"; recordJSON = "{\"requirement_id\":\"FR-39\",\"title\":\"Minimum adoption and measurement package\",\"requirement_text\":\"The framework shall declare prerequisites, resource footprint, licenses, dependencies and learning instructions for its minimum workflow and record adoption, adaptation, change, reproduction and direct-cost observations under one evaluation protocol.\",\"logical_component_ids\":[\"L09\",\"L01\",\"L08\"],\"physical_component_ids\":[\"COM-S02\",\"COM-S03\",\"COM-S11\",\"COM-S15\",\"COM-D17\",\"COM-D18\",\"COM-D09\",\"COM-P01\",\"COM-P07\"],\"realization_mechanism\":\"D18 declares the minimum COMET/Excel/companion workflow, hosts, licenses and external profiles. P07 logs correctness, elapsed and active task effort and actual direct costs with period/inclusions. D17 supplies setup and learning steps.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"native dependency/tutorial basis and overhead context\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E01\",\"COM-E08\",\"COM-E13\"],\"source_locators\":[{\"evidence_id\":\"COM-E01\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[3],\"section\":\"3.2\",\"source_maturity\":\"Reported platform configuration\",\"allocation_evidence_role\":\"native dependency/tutorial basis and overhead context\"},{\"evidence_id\":\"COM-E08\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[2,5,6],\"section\":\"2.1, 2.2, 5, 6\",\"source_maturity\":\"Student pilot\",\"allocation_evidence_role\":\"native dependency/tutorial basis and overhead context\"},{\"evidence_id\":\"COM-E13\",\"source_id\":\"review-0522\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0522/review-report-0522.md\",\"physical_pdf_pages\":[1,2,3],\"section\":\"1 and 1.1\",\"source_maturity\":\"Literature argument\",\"allocation_evidence_role\":\"native dependency/tutorial basis and overhead context\"}],\"verification_id\":\"V39\",\"verification_method\":\"I,D\",\"verification_fixture_observation\":\"Demonstrate the minimum workflow from a clean declared environment. Record wall-clock time separately from active person-hours and state the cost period and inclusions. Unknown cost stays unknown.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-39\",\"implementation_gap\":\"Current prerequisites, costs and clean-start tasks are unverified. Observation capture needs implementation.\",\"boundary_authority_note\":\"Unknown costs remain unknown. Literature questionnaire ratings supply no framework performance or effort values.\",\"mission_need_ids\":[\"MN-11\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-11\",\"MR-09\"],\"execution_host_ids\":[\"COM-H01\",\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P01\":[\"Systems engineer\",\"Participant acting in declared engineering role\"],\"COM-P07\":[\"Independent reproducer/reviewer\",\"Framework evaluator\"]}}"; status = "proposed comparison description, not implemented or verified"; }
