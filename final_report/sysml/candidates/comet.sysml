#intendedRealization allocation allocate_FR_17_COM_S03 allocate FrameworkRequirements::FR_17 to physical.COM_S03;
@PhysicalRecord { identifier = "allocate_FR_17_COM_S03"; recordJSON = "{\"requirement_id\":\"FR-17\",\"title\":\"Requirement parameter derivation\",\"requirement_text\":\"The framework shall record how sourced component power and thermal characteristics and subsystem behavior become EPS or component requirement parameters, including units, uncertainties, allowable ranges and criterion decisions.\",\"logical_component_ids\":[\"L02\",\"L04\"],\"physical_component_ids\":[\"COM-S03\",\"COM-S13\",\"COM-D03\",\"COM-D11\",\"COM-D10\",\"COM-D17\",\"COM-P08\"],\"realization_mechanism\":\"A derivation worksheet binds sourced electrical/thermal values and behavior assumptions to formulas, units, uncertainty and allowable ranges. The accepted derivation reference becomes a proposed EPS/component criterion or allocation in the requirement record.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"native parameter/budget and requirement basis\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E04\",\"COM-E06\",\"COM-E07\"],\"source_locators\":[{\"evidence_id\":\"COM-E04\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[4,5],\"section\":\"4.2 and first 4.2.1\",\"source_maturity\":\"Implemented tutorial architecture\",\"allocation_evidence_role\":\"native parameter/budget and requirement basis\"},{\"evidence_id\":\"COM-E06\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"first 4.2.1\",\"source_maturity\":\"Reported linking and numerical checking\",\"allocation_evidence_role\":\"native parameter/budget and requirement basis\"},{\"evidence_id\":\"COM-E07\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"Model Catalogue subsection, also numbered 4.2.1 in source\",\"source_maturity\":\"Reported catalogue\",\"allocation_evidence_role\":\"native parameter/budget and requirement basis\"}],\"verification_id\":\"V17\",\"verification_method\":\"A,T\",\"verification_fixture_observation\":\"Derive a fixture allocation from datasheet and supplied measurement inputs using a declared method. Preserve assumptions and flag unsupported ranges and undecided pass/fail values.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-17\",\"implementation_gap\":\"Derivation templates, source-condition checks and unsupported-range flags need implementation.\",\"boundary_authority_note\":\"An engineer decides allowable values and criterion meaning. Missing measurement evidence is not replaced by a datasheet assumption.\",\"mission_need_ids\":[\"MN-01\",\"MN-02\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-02\",\"MR-04\"],\"execution_host_ids\":[\"COM-H01\",\"COM-H03\"],\"storage_host_ids\":[\"COM-H01\",\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P08\":[\"Systems engineer\",\"EPS engineer\",\"Technician for supplied facility constraints\"]}}"; status = "proposed comparison description, not implemented or verified"; }
