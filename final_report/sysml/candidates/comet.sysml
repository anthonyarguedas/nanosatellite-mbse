#intendedRealization allocation allocate_FR_15_COM_S01 allocate FrameworkRequirements::FR_15 to physical.COM_S01;
@PhysicalRecord { identifier = "allocate_FR_15_COM_S01"; recordJSON = "{\"requirement_id\":\"FR-15\",\"title\":\"Reusable EPS representation\",\"requirement_text\":\"The framework shall provide a configurable generic EPS representation covering requirements, functions, logical and physical elements, interfaces, modes and states, with case-specific parameter and extension records.\",\"logical_component_ids\":[\"L03\"],\"physical_component_ids\":[\"COM-S01\",\"COM-S02\",\"COM-S13\",\"COM-D01\",\"COM-D02\",\"COM-D04\",\"COM-D12\",\"COM-D18\",\"COM-P01\"],\"realization_mechanism\":\"A tailored COMET template provides categorized equipment, parameters, requirements and categorical states. D12 supplies the reusable function/logical/physical allocation, interface and transition subset with stable joins and case extension records.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"native template/category pattern plus transferable CSRM\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E03\",\"COM-E04\",\"COM-E05\",\"COM-E09\"],\"source_locators\":[{\"evidence_id\":\"COM-E03\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[4,6],\"section\":\"4.1 and 7\",\"source_maturity\":\"Implemented categorization bridge\",\"allocation_evidence_role\":\"native template/category pattern plus transferable CSRM\"},{\"evidence_id\":\"COM-E04\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[4,5],\"section\":\"4.2 and first 4.2.1\",\"source_maturity\":\"Implemented tutorial architecture\",\"allocation_evidence_role\":\"native template/category pattern plus transferable CSRM\"},{\"evidence_id\":\"COM-E05\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"first 4.2.1\",\"source_maturity\":\"Reported native capability\",\"allocation_evidence_role\":\"native template/category pattern plus transferable CSRM\"},{\"evidence_id\":\"COM-E09\",\"source_id\":\"citation-2362\",\"source_path\":\"SLR/SLR1/pdfs/citation-reports/citation-report-2362/citation-report-2362.md\",\"physical_pdf_pages\":[2,4,5],\"section\":\"CSRM, CSRM Application, Mission-specific CubeSat Model, Transition\",\"source_maturity\":\"Reference model guidance\",\"allocation_evidence_role\":\"native template/category pattern plus transferable CSRM\"}],\"verification_id\":\"V15\",\"verification_method\":\"I,D\",\"verification_fixture_observation\":\"Instantiate the representation in two contrasting cases and trace a requirement through function, allocation, interface and analysis. An extension retains its relation to the generic core.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-15\",\"implementation_gap\":\"Generic EPS behavior, full allocations/interfaces and extension checks are not delivered by the reported hardware-category bridge.\",\"boundary_authority_note\":\"COMET remains the study center. Companion fields extend its schema under one field-authority map.\",\"mission_need_ids\":[\"MN-04\",\"MN-11\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-11\"],\"execution_host_ids\":[\"COM-H01\",\"COM-H02\",\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P01\":[\"Systems engineer\",\"Participant acting in declared engineering role\"]}}"; status = "proposed comparison description, not implemented or verified"; }
