#intendedRealization allocation allocate_FR_01_COM_S01 allocate FrameworkRequirements::FR_01 to physical.COM_S01;
@PhysicalRecord { identifier = "allocate_FR_01_COM_S01"; recordJSON = "{\"requirement_id\":\"FR-01\",\"title\":\"Requirement record\",\"requirement_text\":\"The framework shall retain each requirement as an identified record with source need, parent, rationale, observable quantities or conditions and applicable units, owner, verification method, criterion, and resolution status.\",\"logical_component_ids\":[\"L02\"],\"physical_component_ids\":[\"COM-S01\",\"COM-S02\",\"COM-S13\",\"COM-D04\",\"COM-D10\",\"COM-P01\",\"COM-P08\"],\"realization_mechanism\":\"COMET requirement entries are joined by stable ID to a declared extension schema. S13 checks source need, parent, rationale, observable quantity or condition, applicable units, owner, method, criterion and resolution status. Qualitative and justified not-applicable fields are retained.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"native requirement links only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E06\"],\"source_locators\":[{\"evidence_id\":\"COM-E06\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"first 4.2.1\",\"source_maturity\":\"Reported linking and numerical checking\",\"allocation_evidence_role\":\"native requirement links only\"}],\"verification_id\":\"V01\",\"verification_method\":\"I,T\",\"verification_fixture_observation\":\"Round-trip a quantitative requirement and a qualitative demonstration requirement, including source, condition or quantity, applicable units and criterion. An inapplicable field retains rationale. An absent criterion remains unresolved and cannot acquire a verified label.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-01\",\"implementation_gap\":\"Extension schema, native field mapping and unresolved-status gate must be implemented and round-trip tested.\",\"boundary_authority_note\":\"Engineers own criterion meaning. Completeness does not establish truth. Qualitative demonstration requirements are allowed.\",\"mission_need_ids\":[\"MN-01\",\"MN-02\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-02\"],\"execution_host_ids\":[\"COM-H01\",\"COM-H02\",\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P01\":[\"Systems engineer\",\"Participant acting in declared engineering role\"],\"COM-P08\":[\"Systems engineer\",\"EPS engineer\",\"Technician for supplied facility constraints\"]}}"; status = "proposed comparison description, not implemented or verified"; }
