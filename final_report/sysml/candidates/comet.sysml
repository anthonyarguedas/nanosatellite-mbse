@PhysicalRecord { identifier = "FR-35"; recordJSON = "{\"requirement_id\":\"FR-35\",\"title\":\"Command and recovery contract\",\"requirement_text\":\"The framework shall specify and check EPS command preconditions, order, expected effects, rejection and failure behavior, mode transitions and recovery responsibilities across EPS, telemetry, fault-management and safe-mode functions.\",\"logical_component_ids\":[\"L03\",\"L05\",\"L07\"],\"physical_component_ids\":[\"COM-S09\",\"COM-S16\",\"COM-S18\",\"COM-D12\",\"COM-D13\",\"COM-D16\",\"COM-D07\",\"COM-P05\"],\"realization_mechanism\":\"Contract assertions specify command guards/order/effects/completion/rejection/timeouts, mode transitions and EPS/telemetry/fault/safe-mode recovery ownership. S16 coordinates nominal/rejected/recovery replay against a qualified software reference. S18 retains outcomes.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"project proposal only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V35\",\"verification_method\":\"A,T\",\"verification_fixture_observation\":\"Replay nominal, rejected and recovery sequences with a qualified software reference. Confirm functional flow and ownership without claiming deployment of flight software.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-35\",\"implementation_gap\":\"Sequence assertion rules, mission behavior bindings and qualified reference cases remain open.\",\"boundary_authority_note\":\"Sequence checks exercise engineered software artifacts. They do not operate flight hardware or assert deployed software.\",\"mission_need_ids\":[\"MN-08\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-08\",\"MR-04\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P05\":[\"EPS engineer\",\"Qualified analysis or flight/ground software specialist\"]}}"; status = "proposed comparison description, not implemented or verified"; }
