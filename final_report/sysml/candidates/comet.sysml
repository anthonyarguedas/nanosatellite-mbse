#intendedRealization allocation allocate_FR_04_COM_S05 allocate FrameworkRequirements::FR_04 to physical.COM_S05;
@PhysicalRecord { identifier = "allocate_FR_04_COM_S05"; recordJSON = "{\"requirement_id\":\"FR-04\",\"title\":\"Bidirectional trace retrieval\",\"requirement_text\":\"The framework shall retrieve applicable links from needs and requirements to design decisions, model inputs, verification criteria and results, and retrieve the reverse paths.\",\"logical_component_ids\":[\"L02\",\"L08\"],\"physical_component_ids\":[\"COM-S05\",\"COM-S14\",\"COM-S15\",\"COM-D04\",\"COM-D10\",\"COM-D07\",\"COM-D08\",\"COM-P04\"],\"realization_mechanism\":\"S14 queries the registered typed edge index in both directions from native requirements through decisions, model inputs, criteria and run results. S05 maps COMET links. Missing, ambiguous and stale endpoint revisions remain query findings.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"native links and transferable V&V relationships\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E06\",\"COM-E10\"],\"source_locators\":[{\"evidence_id\":\"COM-E06\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"first 4.2.1\",\"source_maturity\":\"Reported linking and numerical checking\",\"allocation_evidence_role\":\"native links and transferable V&V relationships\"},{\"evidence_id\":\"COM-E10\",\"source_id\":\"citation-2362\",\"source_path\":\"SLR/SLR1/pdfs/citation-reports/citation-report-2362/citation-report-2362.md\",\"physical_pdf_pages\":[5,6],\"section\":\"MSM Validation and Verification, CSRM Validation, Next Steps\",\"source_maturity\":\"Relationship pattern\",\"allocation_evidence_role\":\"native links and transferable V&V relationships\"}],\"verification_id\":\"V04\",\"verification_method\":\"T\",\"verification_fixture_observation\":\"Compare both query directions with the fixture relation set. Missing, ambiguous and stale endpoints remain visible.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-04\",\"implementation_gap\":\"Typed relation types, stable endpoint mapping and reverse-query tests need development.\",\"boundary_authority_note\":\"L02 owns trace meaning. L08 registers exact revisions without creating a competing requirement master.\",\"mission_need_ids\":[\"MN-02\",\"MN-10\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-10\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P04\":[\"Framework maintainer\",\"Designated domain reviewer\"]}}"; status = "proposed comparison description, not implemented or verified"; }
