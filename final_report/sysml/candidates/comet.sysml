@PhysicalRecord { identifier = "allocate_FR_27_COM_S08"; recordJSON = "{\"requirement_id\":\"FR-27\",\"title\":\"RAM model generation\",\"requirement_text\":\"The framework shall generate a declared RAM analysis representation from identified functions, components and failure dependencies with traceable transformation rules and sourced or missing reliability data.\",\"logical_component_ids\":[\"L04\",\"L05\",\"L08\"],\"physical_component_ids\":[\"COM-S08\",\"COM-S16\",\"COM-S15\",\"COM-D04\",\"COM-D12\",\"COM-D15\",\"COM-D13\",\"COM-D07\",\"COM-P10\"],\"realization_mechanism\":\"S08 applies reviewed function/component/failure-dependency rules to registered study/contract revisions to emit identified FMEA rows and change differences. Probability-dependent calculations use only a separately declared IF-03 RAM service with sourced inputs.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"project proposal only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V27\",\"verification_method\":\"A,T\",\"verification_fixture_observation\":\"Generate an FMEA, fault tree or other justified representation for a reference design and its changed variant. Compare entities and dependencies with an expert model. Missing probabilities cannot become factual reliability estimates.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-27\",\"implementation_gap\":\"FMEA transformation/reference model and optional quantitative RAM service profile are unimplemented.\",\"boundary_authority_note\":\"Missing reliability/repair inputs remain unknown. Generated structure does not establish numerical RAM.\",\"mission_need_ids\":[\"MN-06\"],\"mission_requirement_ids\":[\"MR-06\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P10\":[\"Systems engineer\",\"Qualified RAM reviewer\"]}}"; status = "proposed comparison description, not implemented or verified"; }
