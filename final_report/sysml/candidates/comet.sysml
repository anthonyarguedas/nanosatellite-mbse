@PhysicalRecord { identifier = "allocate_FR_37_COM_S02"; recordJSON = "{\"requirement_id\":\"FR-37\",\"title\":\"Readable design views\",\"requirement_text\":\"The framework shall produce filtered context, structure, interface and selected-design views from controlled EPS records with identifiers, units, legends and links to the represented baseline.\",\"logical_component_ids\":[\"L09\"],\"physical_component_ids\":[\"COM-S02\",\"COM-S11\",\"COM-D04\",\"COM-D12\",\"COM-D08\",\"COM-P07\"],\"realization_mechanism\":\"S11 filters registered equipment/function/interface/allocation records to generate a few baseline-linked context, structure, interface and selected-design views. IDs, units and legends resolve to source records. IME product-tree views remain available.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"reported readable product-tree/grouped parameters basis\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E04\"],\"source_locators\":[{\"evidence_id\":\"COM-E04\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[4,5],\"section\":\"4.2 and first 4.2.1\",\"source_maturity\":\"Implemented tutorial architecture\",\"allocation_evidence_role\":\"reported readable product-tree/grouped parameters basis\"}],\"verification_id\":\"V37\",\"verification_method\":\"I,D\",\"verification_fixture_observation\":\"Compare generated views with a fixture model and apply a declared reviewer task checklist. Assess correctness and readability without proliferating requirement, measure, scenario or state diagrams.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-37\",\"implementation_gap\":\"Rich-view generation and reviewer correctness/readability tasks need implementation.\",\"boundary_authority_note\":\"Views are projections, not duplicate authorities. No requirement/measure/state/scenario diagram proliferation is proposed.\",\"mission_need_ids\":[\"MN-10\"],\"mission_requirement_ids\":[\"MR-10\"],\"execution_host_ids\":[\"COM-H01\",\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P07\":[\"Independent reproducer/reviewer\",\"Framework evaluator\"]}}"; status = "proposed comparison description, not implemented or verified"; }
