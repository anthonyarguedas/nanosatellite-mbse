@PhysicalRecord { identifier = "allocate_FR_20_COM_S16"; recordJSON = "{\"requirement_id\":\"FR-20\",\"title\":\"Battery model coupling\",\"requirement_text\":\"The framework shall integrate identified battery electrical, thermal and degradation models with mission loads and retain the states, health and lifetime outputs, assumptions and uncertainty supported by each model.\",\"logical_component_ids\":[\"L05\",\"L06\",\"L04\"],\"physical_component_ids\":[\"COM-S16\",\"COM-S07\",\"COM-S17\",\"COM-D03\",\"COM-D06\",\"COM-D13\",\"COM-D14\",\"COM-D07\",\"COM-P05\",\"COM-P09\"],\"realization_mechanism\":\"A battery coupling profile names electrical, thermal and degradation model revisions, terminal/thermal variables, SOC/SOH definitions, initial health, mission load and numerical exchange steps. Returned energy/health/lifetime estimates retain assumptions and uncertainty.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"project proposal only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V20\",\"verification_method\":\"A,D\",\"verification_fixture_observation\":\"Replay fresh and aged battery fixtures under different load and temperature profiles. Verify coupling and provenance. Missing aging mechanisms and latent-state uncertainty remain visible.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-20\",\"implementation_gap\":\"Battery model selection, supported aging mechanisms, coupling checks and fresh/aged references are unresolved.\",\"boundary_authority_note\":\"Battery models are engineered artifacts executed by an external service. Inferred internal states remain estimates.\",\"mission_need_ids\":[\"MN-05\"],\"mission_requirement_ids\":[\"MR-05\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P05\":[\"EPS engineer\",\"Qualified analysis or flight/ground software specialist\"],\"COM-P09\":[\"EPS engineer\",\"Qualified modeling reviewer\"]}}"; status = "proposed comparison description, not implemented or verified"; }
