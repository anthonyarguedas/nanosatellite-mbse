@PhysicalRecord { identifier = "allocate_FR_24_COM_S16"; recordJSON = "{\"requirement_id\":\"FR-24\",\"title\":\"Controller policy assessment\",\"requirement_text\":\"The framework shall compare designated charging and power-management policies under declared load, thermal, health, electrical and timing conditions with safety constraints and policy-specific outcome evidence.\",\"logical_component_ids\":[\"L05\",\"L06\",\"L07\"],\"physical_component_ids\":[\"COM-S16\",\"COM-S07\",\"COM-S17\",\"COM-S18\",\"COM-D13\",\"COM-D14\",\"COM-D16\",\"COM-D07\",\"COM-P05\",\"COM-P09\"],\"realization_mechanism\":\"Two policy requests share load, thermal, health, electrical and timing conditions while changing only the declared charging/power policy. Safety and outcome criteria are separate references. S17/S18 retain prediction, policy and pending hardware evidence statuses.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"project proposal only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V24\",\"verification_method\":\"A,T\",\"verification_fixture_observation\":\"Replay a baseline and a changed policy against the same fixture conditions. A model prediction cannot be labeled a demonstrated hardware improvement. Retain pending SIL, HIL or hardware evidence.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-24\",\"implementation_gap\":\"Policy models, controlled-comparison fixtures and credible safety/benefit evidence are unresolved.\",\"boundary_authority_note\":\"Simulation outcomes are not demonstrated hardware improvement. No actuation or hazardous test is performed by the framework.\",\"mission_need_ids\":[\"MN-05\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-04\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P05\":[\"EPS engineer\",\"Qualified analysis or flight/ground software specialist\"],\"COM-P09\":[\"EPS engineer\",\"Qualified modeling reviewer\"]}}"; status = "proposed comparison description, not implemented or verified"; }
