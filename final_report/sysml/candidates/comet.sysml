@PhysicalRecord { identifier = "allocate_FR_31_COM_S10"; recordJSON = "{\"requirement_id\":\"FR-31\",\"title\":\"Evidence timing\",\"requirement_text\":\"The framework shall record the time base, sampling and synchronization rules and known measurement, calculation and output delays for applied stimuli, responses and telemetry.\",\"logical_component_ids\":[\"L06\",\"L08\"],\"physical_component_ids\":[\"COM-S10\",\"COM-S15\",\"COM-D13\",\"COM-D14\",\"COM-D07\",\"COM-P06\"],\"realization_mechanism\":\"S10 applies the declared clock-origin/scale mapping, sampling/resampling and skew/delay rules to stimulus, response and telemetry times. It preserves raw timestamps and reports alignment uncertainty and missing metadata. S15 binds the timing profile revision.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"project proposal only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V31\",\"verification_method\":\"A,T\",\"verification_fixture_observation\":\"Align a known timestamp fixture and expose injected skew and missing timing metadata. Report alignment error or uncertainty against the agreed profile, with no invented global limit.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-31\",\"implementation_gap\":\"Time alignment rules, skew fixtures and uncertainty reporting are unimplemented.\",\"boundary_authority_note\":\"Delay and allowable alignment error are profile specific. Supplied records do not imply live instrument control.\",\"mission_need_ids\":[\"MN-07\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-09\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P06\":[\"EPS engineer\",\"Testing facility technician or qualified proxy\"]}}"; status = "proposed comparison description, not implemented or verified"; }
