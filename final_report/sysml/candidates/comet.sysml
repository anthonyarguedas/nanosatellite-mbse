@PhysicalRecord { identifier = "allocate_FR_07_COM_S05"; recordJSON = "{\"requirement_id\":\"FR-07\",\"title\":\"Controlled baselines\",\"requirement_text\":\"The framework shall retain identified, retrievable baselines of engineering records, case configuration, and evidence with revision history and distinct identities for accepted successors.\",\"logical_component_ids\":[\"L08\"],\"physical_component_ids\":[\"COM-S05\",\"COM-S15\",\"COM-S12\",\"COM-D04\",\"COM-D08\",\"COM-D07\",\"COM-P04\"],\"realization_mechanism\":\"S05 exports the native study/reference/workbook subset. S15 binds content digests, source revisions and exact companion records into an accepted manifest. S12 retains distinct successors with backup and tested reconstruction.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"native persistence and study configuration basis\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E01\",\"COM-E04\"],\"source_locators\":[{\"evidence_id\":\"COM-E01\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[3],\"section\":\"3.2\",\"source_maturity\":\"Reported platform configuration\",\"allocation_evidence_role\":\"native persistence and study configuration basis\"},{\"evidence_id\":\"COM-E04\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[4,5],\"section\":\"4.2 and first 4.2.1\",\"source_maturity\":\"Implemented tutorial architecture\",\"allocation_evidence_role\":\"native persistence and study configuration basis\"}],\"verification_id\":\"V07\",\"verification_method\":\"T\",\"verification_fixture_observation\":\"Reconstruct two revisions after a change and compare their manifests and contents. Attempted overwrite cannot erase the retained prior baseline.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-07\",\"implementation_gap\":\"Complete export scope, retained history, overwrite prevention and restore checks are unverified.\",\"boundary_authority_note\":\"The framework owns baseline custody. A Git revision or COMET synchronization alone is not the retention policy.\",\"mission_need_ids\":[\"MN-02\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-09\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P04\":[\"Framework maintainer\",\"Designated domain reviewer\"]}}"; status = "proposed comparison description, not implemented or verified"; }
