@PhysicalRecord { identifier = "allocate_FR_14_COM_S03"; recordJSON = "{\"requirement_id\":\"FR-14\",\"title\":\"EPS candidate comparison\",\"requirement_text\":\"The framework shall produce a comparison of designated EPS architectures using a common requirement, assumption, evidence and criterion basis with feasibility status, raw measures, uncertainty and decision rationale.\",\"logical_component_ids\":[\"L05\",\"L04\",\"L02\"],\"physical_component_ids\":[\"COM-S03\",\"COM-S16\",\"COM-S14\",\"COM-D11\",\"COM-D13\",\"COM-D07\",\"COM-D10\",\"COM-P02\",\"COM-P05\"],\"realization_mechanism\":\"A comparison worksheet pins the same requirements, assumptions, scenarios and criterion revisions for each EPS candidate. S16 registers raw measures and uncertainty. Feasibility/unknown status is evaluated before any user-declared preference rationale.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"native budgets, state values and compliance basis\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E04\",\"COM-E05\",\"COM-E06\"],\"source_locators\":[{\"evidence_id\":\"COM-E04\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[4,5],\"section\":\"4.2 and first 4.2.1\",\"source_maturity\":\"Implemented tutorial architecture\",\"allocation_evidence_role\":\"native budgets, state values and compliance basis\"},{\"evidence_id\":\"COM-E05\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"first 4.2.1\",\"source_maturity\":\"Reported native capability\",\"allocation_evidence_role\":\"native budgets, state values and compliance basis\"},{\"evidence_id\":\"COM-E06\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"first 4.2.1\",\"source_maturity\":\"Reported linking and numerical checking\",\"allocation_evidence_role\":\"native budgets, state values and compliance basis\"}],\"verification_id\":\"V14\",\"verification_method\":\"A,T\",\"verification_fixture_observation\":\"Compare candidates with a failing requirement and incomplete evidence. Keep feasibility and unknown status separate from ranking. Any preference weights are declared before results.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-14\",\"implementation_gap\":\"Common-basis comparison sheets and feasibility/evidence joining need implementation.\",\"boundary_authority_note\":\"This compares engineered EPS designs, not framework candidates. No weights or winner are supplied here.\",\"mission_need_ids\":[\"MN-03\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-03\",\"MR-04\"],\"execution_host_ids\":[\"COM-H01\",\"COM-H03\"],\"storage_host_ids\":[\"COM-H01\",\"COM-H03\"],\"procedure_performers\":{\"COM-P02\":[\"EPS engineer\",\"Project manager\"],\"COM-P05\":[\"EPS engineer\",\"Qualified analysis or flight/ground software specialist\"]}}"; status = "proposed comparison description, not implemented or verified"; }
