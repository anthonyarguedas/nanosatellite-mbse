@PhysicalRecord { identifier = "FR-08"; recordJSON = "{\"requirement_id\":\"FR-08\",\"title\":\"Semantic transfers\",\"requirement_text\":\"The framework shall check transferred identifiers, structure, quantities, units, polarity, time bases, interface meanings, and provenance against a declared contract and retain explicit rejection findings.\",\"logical_component_ids\":[\"L08\"],\"physical_component_ids\":[\"COM-S05\",\"COM-S15\",\"COM-D01\",\"COM-D05\",\"COM-D13\",\"COM-D08\",\"COM-P04\"],\"realization_mechanism\":\"S15 checks declared ID/structure/quantity mappings, dimensions, scale/offset, polarity, frames, clock bases, interface meaning and producer provenance before S05 accepts an exchange. Rejected source packages and findings are quarantined.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"limited native shared/category semantics\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E02\",\"COM-E03\"],\"source_locators\":[{\"evidence_id\":\"COM-E02\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[3],\"section\":\"3.1\",\"source_maturity\":\"Reported conceptual semantics\",\"allocation_evidence_role\":\"limited native shared/category semantics\"},{\"evidence_id\":\"COM-E03\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[4,6],\"section\":\"4.1 and 7\",\"source_maturity\":\"Implemented categorization bridge\",\"allocation_evidence_role\":\"limited native shared/category semantics\"}],\"verification_id\":\"V08\",\"verification_method\":\"T\",\"verification_fixture_observation\":\"Inject unit, sign, identifier and time-base mismatches. Reject incompatible transfers without replacing controlled content. Record unsupported or lossy mappings.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-08\",\"implementation_gap\":\"Selected COMET exchange mechanism and full transformation checks are unverified. Lossy mappings require explicit rejection.\",\"boundary_authority_note\":\"OCDT API evidence is excluded. No unsupported field is silently dropped or overwritten.\",\"mission_need_ids\":[\"MN-02\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-09\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P04\":[\"Framework maintainer\",\"Designated domain reviewer\"]}}"; status = "proposed comparison description, not implemented or verified"; }
