#intendedRealization allocation allocate_FR_03_COM_S13 allocate FrameworkRequirements::FR_03 to physical.COM_S13;
@PhysicalRecord { identifier = "allocate_FR_03_COM_S13"; recordJSON = "{\"requirement_id\":\"FR-03\",\"title\":\"Method applicability\",\"requirement_text\":\"The framework shall retain a source-linked catalogue of requirement derivation and verification methods, standards, and activity templates with applicability, tailoring rationale, and limitations.\",\"logical_component_ids\":[\"L01\",\"L07\"],\"physical_component_ids\":[\"COM-S13\",\"COM-D17\",\"COM-D16\",\"COM-P08\"],\"realization_mechanism\":\"A source/version-linked method catalogue records applicability, tailoring, limits and excluded alternatives. S13 checks that selected requirement-derivation and verification templates resolve to the applicable entry.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"partial requirements and transferable V&V pattern\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E06\",\"COM-E10\"],\"source_locators\":[{\"evidence_id\":\"COM-E06\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"first 4.2.1\",\"source_maturity\":\"Reported linking and numerical checking\",\"allocation_evidence_role\":\"partial requirements and transferable V&V pattern\"},{\"evidence_id\":\"COM-E10\",\"source_id\":\"citation-2362\",\"source_path\":\"SLR/SLR1/pdfs/citation-reports/citation-report-2362/citation-report-2362.md\",\"physical_pdf_pages\":[5,6],\"section\":\"MSM Validation and Verification, CSRM Validation, Next Steps\",\"source_maturity\":\"Relationship pattern\",\"allocation_evidence_role\":\"partial requirements and transferable V&V pattern\"}],\"verification_id\":\"V03\",\"verification_method\":\"I,D\",\"verification_fixture_observation\":\"For subsystem and component fixtures retrieve the chosen method and its source, conditions, tailoring decision, and excluded alternatives. A catalogue entry does not assert standards compliance.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-03\",\"implementation_gap\":\"Populate/review method catalogue and selection checks for subsystem and component contexts.\",\"boundary_authority_note\":\"Method selection remains engineer judgment. A referenced standard is not a compliance verdict.\",\"mission_need_ids\":[\"MN-01\",\"MN-07\",\"MN-11\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-07\",\"MR-11\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P08\":[\"Systems engineer\",\"EPS engineer\",\"Technician for supplied facility constraints\"]}}"; status = "proposed comparison description, not implemented or verified"; }
