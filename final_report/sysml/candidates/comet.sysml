@PhysicalRecord { identifier = "allocate_FR_28_COM_S13"; recordJSON = "{\"requirement_id\":\"FR-28\",\"title\":\"Verification activity record\",\"requirement_text\":\"The framework shall retain each EPS or component verification activity with requirement, method, DUT baseline, applicable quantities or observable conditions, inputs, expected response, criterion, evidence variables and status. An inapplicable field shall retain its rationale.\",\"logical_component_ids\":[\"L07\"],\"physical_component_ids\":[\"COM-S13\",\"COM-S18\",\"COM-D10\",\"COM-D16\",\"COM-P06\",\"COM-P08\"],\"realization_mechanism\":\"Method-specific verification records link requirement and criterion to DUT baseline, quantities/conditions, inputs, expected response, raw evidence variables and status. S18 checks fields for analysis, inspection, demonstration and test while retaining failed and unresolved gates.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"transferable V&V relationships and native numeric links\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E10\",\"COM-E06\"],\"source_locators\":[{\"evidence_id\":\"COM-E10\",\"source_id\":\"citation-2362\",\"source_path\":\"SLR/SLR1/pdfs/citation-reports/citation-report-2362/citation-report-2362.md\",\"physical_pdf_pages\":[5,6],\"section\":\"MSM Validation and Verification, CSRM Validation, Next Steps\",\"source_maturity\":\"Relationship pattern\",\"allocation_evidence_role\":\"transferable V&V relationships and native numeric links\"},{\"evidence_id\":\"COM-E06\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"first 4.2.1\",\"source_maturity\":\"Reported linking and numerical checking\",\"allocation_evidence_role\":\"transferable V&V relationships and native numeric links\"}],\"verification_id\":\"V28\",\"verification_method\":\"I,T\",\"verification_fixture_observation\":\"Inspect quantitative analysis/test and qualitative inspection/demonstration fixtures against their method-specific fields. Check the applicable quantity or observable condition, criterion, expected response and evidence. An inapplicable field retains rationale. Missing mandatory fields, failed gates and unresolved criteria remain explicit and prevent an unsupported verdict.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-28\",\"implementation_gap\":\"Detailed activity schemas and method-specific completeness checks need development.\",\"boundary_authority_note\":\"The record names its subject. Framework V01-V40 are separate from EPS requirement evidence verdicts.\",\"mission_need_ids\":[\"MN-07\",\"MN-01\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-01\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P06\":[\"EPS engineer\",\"Testing facility technician or qualified proxy\"],\"COM-P08\":[\"Systems engineer\",\"EPS engineer\",\"Technician for supplied facility constraints\"]}}"; status = "proposed comparison description, not implemented or verified"; }
