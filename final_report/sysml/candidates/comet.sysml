#intendedRealization allocation allocate_FR_29_COM_S18 allocate FrameworkRequirements::FR_29 to physical.COM_S18;
@PhysicalRecord { identifier = "allocate_FR_29_COM_S18"; recordJSON = "{\"requirement_id\":\"FR-29\",\"title\":\"Facility proposal\",\"requirement_text\":\"The framework shall produce a technician-readable verification proposal that specifies conditions, equipment and fixture identities, DUT connections, stimulus sequence, observations and evidence-generation procedure.\",\"logical_component_ids\":[\"L07\",\"L09\"],\"physical_component_ids\":[\"COM-S18\",\"COM-S11\",\"COM-D12\",\"COM-D16\",\"COM-D18\",\"COM-P06\"],\"realization_mechanism\":\"S11 renders a baseline-linked facility proposal from S18-checked setup/equipment/fixture identities, DUT connections, stimulus sequence and acquisition steps. Technician/proxy findings return as named dispositions.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"transferable activity-document relationships only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E10\"],\"source_locators\":[{\"evidence_id\":\"COM-E10\",\"source_id\":\"citation-2362\",\"source_path\":\"SLR/SLR1/pdfs/citation-reports/citation-report-2362/citation-report-2362.md\",\"physical_pdf_pages\":[5,6],\"section\":\"MSM Validation and Verification, CSRM Validation, Next Steps\",\"source_maturity\":\"Relationship pattern\",\"allocation_evidence_role\":\"transferable activity-document relationships only\"}],\"verification_id\":\"V29\",\"verification_method\":\"I,D\",\"verification_fixture_observation\":\"A technician or qualified proxy checks a fixture proposal against a declared completeness checklist and identifies how equipment interacts with the DUT. Facility feasibility remains a separate decision.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-29\",\"implementation_gap\":\"Facility templates, readable rendering and technician completeness checks are not implemented or reviewed.\",\"boundary_authority_note\":\"The facility decides feasibility and authorization. A generated proposal is not permission to execute.\",\"mission_need_ids\":[\"MN-07\"],\"mission_requirement_ids\":[\"MR-07\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P06\":[\"EPS engineer\",\"Testing facility technician or qualified proxy\"]}}"; status = "proposed comparison description, not implemented or verified"; }
