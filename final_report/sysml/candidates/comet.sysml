@PhysicalRecord { identifier = "FR-26"; recordJSON = "{\"requirement_id\":\"FR-26\",\"title\":\"RAM requirement coverage\",\"requirement_text\":\"The framework shall identify the RAM variables and failure assumptions applicable to designated EPS and spacecraft requirements and report their verification-method coverage and gaps.\",\"logical_component_ids\":[\"L02\",\"L04\",\"L07\"],\"physical_component_ids\":[\"COM-S13\",\"COM-S08\",\"COM-S18\",\"COM-D10\",\"COM-D03\",\"COM-D15\",\"COM-D16\",\"COM-P08\",\"COM-P10\"],\"realization_mechanism\":\"A RAM worksheet maps mission-defined variables and failure/recovery assumptions to requirements and verification methods. S08 checks covered and missing items, while S18 retains inspection/analysis/demonstration/test rationale per obligation.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"project proposal only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V26\",\"verification_method\":\"I,T\",\"verification_fixture_observation\":\"Compare the declared RAM variable and requirement set with a reference. Report analysis, inspection, demonstration or test rationale without forcing every claim to use analysis.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-26\",\"implementation_gap\":\"RAM variable/reference set, coverage rules and method adjudication are missing.\",\"boundary_authority_note\":\"The framework reports coverage, not achieved reliability. It does not force all RAM claims into analysis.\",\"mission_need_ids\":[\"MN-06\",\"MN-01\"],\"mission_requirement_ids\":[\"MR-06\",\"MR-01\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P08\":[\"Systems engineer\",\"EPS engineer\",\"Technician for supplied facility constraints\"],\"COM-P10\":[\"Systems engineer\",\"Qualified RAM reviewer\"]}}"; status = "proposed comparison description, not implemented or verified"; }
