#intendedRealization allocation allocate_FR_13_COM_S03 allocate FrameworkRequirements::FR_13 to physical.COM_S03;
@PhysicalRecord { identifier = "allocate_FR_13_COM_S03"; recordJSON = "{\"requirement_id\":\"FR-13\",\"title\":\"Financial estimate\",\"requirement_text\":\"The framework shall derive a revision-linked financial estimate from the BOM and declared additional cost categories while retaining price source, date, currency, quantity, estimate basis, uncertainty and missing data.\",\"logical_component_ids\":[\"L04\"],\"physical_component_ids\":[\"COM-S03\",\"COM-S04\",\"COM-D03\",\"COM-D11\",\"COM-P02\"],\"realization_mechanism\":\"A financial worksheet joins BOM quantities with dated sourced prices and declared currency/estimate basis. Separate rows cover non-component cost categories. Formulas propagate unknown cells and uncertainty rather than inserting zero costs.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"native parts catalogue only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E07\"],\"source_locators\":[{\"evidence_id\":\"COM-E07\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"Model Catalogue subsection, also numbered 4.2.1 in source\",\"source_maturity\":\"Reported catalogue\",\"allocation_evidence_role\":\"native parts catalogue only\"}],\"verification_id\":\"V13\",\"verification_method\":\"A,T\",\"verification_fixture_observation\":\"Recalculate a sourced-price fixture after a quantity and part change. Match reference arithmetic and preserve unknown costs. Do not import historical project costs as new framework measurements.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-13\",\"implementation_gap\":\"Cost fields, category/formula rules, quote freshness review and arithmetic fixtures are absent.\",\"boundary_authority_note\":\"Project manager owns financial assumptions. EPS costs and framework direct-use costs remain separate.\",\"mission_need_ids\":[\"MN-03\"],\"mission_requirement_ids\":[\"MR-03\"],\"execution_host_ids\":[\"COM-H01\"],\"storage_host_ids\":[\"COM-H01\",\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P02\":[\"EPS engineer\",\"Project manager\"]}}"; status = "proposed comparison description, not implemented or verified"; }
