@PhysicalRecord { identifier = "allocate_FR_21_COM_S17"; recordJSON = "{\"requirement_id\":\"FR-21\",\"title\":\"Intended-use credibility\",\"requirement_text\":\"The framework shall associate each analytical verification claim with the model intended use, tested validity domain, calibration and validation evidence, uncertainty and acceptable prediction-error rule.\",\"logical_component_ids\":[\"L06\",\"L07\"],\"physical_component_ids\":[\"COM-S17\",\"COM-S18\",\"COM-D06\",\"COM-D14\",\"COM-D16\",\"COM-D07\",\"COM-P09\"],\"realization_mechanism\":\"S17 compares each claim/scenario against the declared use/domain, calibration and independent validation references, error rule and uncertainty. S18 permits only scoped admissibility and retains missing limits or extrapolation.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"project proposal only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V21\",\"verification_method\":\"I,T\",\"verification_fixture_observation\":\"Exercise an in-domain and an extrapolated claim. Separate calibration from validation data where available. Flag untested domains and absent error limits. Prediction accuracy limits require prior agreement.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-21\",\"implementation_gap\":\"Credibility checks, valid datasets and purpose-specific error rules require development and domain review.\",\"boundary_authority_note\":\"L06 owns applicability meaning and L07 evidence admissibility. A fit or registered result is not validation.\",\"mission_need_ids\":[\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-09\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P09\":[\"EPS engineer\",\"Qualified modeling reviewer\"]}}"; status = "proposed comparison description, not implemented or verified"; }
