#intendedRealization allocation allocate_FR_12_COM_S01 allocate FrameworkRequirements::FR_12 to physical.COM_S01;
@PhysicalRecord { identifier = "allocate_FR_12_COM_S01"; recordJSON = "{\"requirement_id\":\"FR-12\",\"title\":\"Candidate BOM\",\"requirement_text\":\"The framework shall generate and revise a candidate-specific BOM from identified physical design items with assembly, quantities, part identifiers, variant and selection status, and source revision.\",\"logical_component_ids\":[\"L04\"],\"physical_component_ids\":[\"COM-S01\",\"COM-S03\",\"COM-S04\",\"COM-D03\",\"COM-D04\",\"COM-D11\",\"COM-P02\"],\"realization_mechanism\":\"Selected study occurrences and assembly quantities populate a candidate-keyed Excel BOM sheet. Catalogue ID, part, variant, selection and source revision are preserved. Substitution refreshes only the relevant candidate rows.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"native catalogue and equipment basis\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E04\",\"COM-E07\"],\"source_locators\":[{\"evidence_id\":\"COM-E04\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[4,5],\"section\":\"4.2 and first 4.2.1\",\"source_maturity\":\"Implemented tutorial architecture\",\"allocation_evidence_role\":\"native catalogue and equipment basis\"},{\"evidence_id\":\"COM-E07\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"Model Catalogue subsection, also numbered 4.2.1 in source\",\"source_maturity\":\"Reported catalogue\",\"allocation_evidence_role\":\"native catalogue and equipment basis\"}],\"verification_id\":\"V12\",\"verification_method\":\"A,T\",\"verification_fixture_observation\":\"Compare two alternative assemblies and one component substitution with a reference BOM. Candidate alternatives remain distinct. Missing part data is reported.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-12\",\"implementation_gap\":\"Quantity/assembly traversal and revision-linked BOM formula/query profile need development.\",\"boundary_authority_note\":\"Catalogue definitions differ from design occurrences. EPS engineer accepts selected parts and quantities.\",\"mission_need_ids\":[\"MN-03\"],\"mission_requirement_ids\":[\"MR-03\"],\"execution_host_ids\":[\"COM-H01\",\"COM-H02\"],\"storage_host_ids\":[\"COM-H01\",\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P02\":[\"EPS engineer\",\"Project manager\"]}}"; status = "proposed comparison description, not implemented or verified"; }
