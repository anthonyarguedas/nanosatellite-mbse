@PhysicalRecord { identifier = "PA-COM"; recordJSON = "{\"id\":\"PA-COM\",\"name\":\"COMET concurrent engineering with assurance and analysis services\",\"baseline_head\":\"b826d9915407bbd861d8d39b2558048f3d534bdc\",\"maturity\":{\"native_core\":\"Published tutorial implementation and student pilot\",\"complete_candidate\":\"Proposed architecture with unimplemented and unverified extensions\",\"performance_observations\":null,\"requirement_allocations\":\"Design-stage allocations to reviewed FR-01..40 and final L01..L09, all V01..V40 planned and pending\",\"winner_decision\":null,\"empirical_eligibility\":\"not demonstrated\",\"satisfaction_status\":\"pending\"},\"boundary\":{\"system_being_developed\":\"EPS engineering framework\",\"specification_rule\":\"Study requirements describe the engineered EPS. Requirements on the framework remain in the common OOSEM specification\",\"included\":[\"COMET workspace\",\"reusable methods and reference assets\",\"companion contracts\",\"assurance and evidence controls\",\"execution interfaces\",\"operating procedures\"],\"engineered_artifacts\":[\"EPS hardware designs\",\"case-specific EPS/battery/controller models\",\"flight software\",\"ground software\",\"EPS verification evidence\"],\"external_resources\":[\"stakeholders\",\"facility equipment\",\"DUT\",\"OBC/controller target\",\"specialist tools and source data\"],\"supersedes\":[\"old external model master boundary\",\"old logical component identifiers and assignments\",\"old estimates and ranking\"],\"hosting_rule\":\"Hosting location does not remove framework responsibility for identity, controlled acceptance, and retention\",\"specialist_tool_policy\":\"All specialist electrical/thermal/EMC/CAD/orbit/battery/controller/calibration/RAM solvers are external controlled services under IF-03. Framework-owned adapters/profiles coordinate them. Excel is an integrated declared dependency. Service products and operator hosts require checked exchange profiles.\",\"physical_execution_rule\":\"Facility authorization, instrument/DUT physical execution and flight operation are external. Core coordinates virtual services and supplied data only.\"},\"sources\":[{\"id\":\"review-0876\",\"citation_key\":\"deutsch2022comet\",\"title\":\"Development of a Concurrent Engineering Tutorial as part of the ESA_Lab@ initiative\",\"authors\":[\"Marlon Deutsch\",\"Jennifer Hoffmann\",\"Reinhold Bertrand\"],\"year\":2022,\"path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"page_basis\":\"Physical PDF pages from Markdown PDF_PAGE markers\",\"verification\":\"Full source read and Figures 2, 4, 5, 6 inspected\",\"claims\":[{\"id\":\"COM-E01\",\"pages\":[3],\"section\":\"3.2\",\"claim\":\"Open source COMET server, IME, and Excel add-in with regular client-server synchronization\",\"maturity\":\"Reported platform configuration\",\"limits\":\"No current version, API, security enforcement, automation, backups, license dependency details, or numeric timing guarantee\"},{\"id\":\"COM-E02\",\"pages\":[3],\"section\":\"3.1\",\"figures\":[2],\"claim\":\"Subsystem references equipment owned by an element or instrument. Limited decomposition considered adequate for conceptual phases 0/A\",\"maturity\":\"Reported conceptual semantics\",\"limits\":\"Does not establish inability to extend for later phases\"},{\"id\":\"COM-E03\",\"pages\":[4,6],\"section\":\"4.1 and 7\",\"figures\":[4],\"claim\":\"CSRM hardware components mapped to COMET Categories and Equipment super-category in Site Directory\",\"maturity\":\"Implemented categorization bridge\",\"limits\":\"Not a demonstrated full behavior, requirement, interface, or V&V mapping\"},{\"id\":\"COM-E04\",\"pages\":[4,5],\"section\":\"4.2 and first 4.2.1\",\"figures\":[5],\"claim\":\"Reusable Template, Catalogue, and Study Models with Domains of Expertise, owners, grouped parameters, and mass/power budgets\",\"maturity\":\"Implemented tutorial architecture\",\"limits\":\"Ownership attribution does not prove access enforcement or immutable releases\"},{\"id\":\"COM-E05\",\"pages\":[5],\"section\":\"first 4.2.1\",\"figures\":[6],\"claim\":\"Finite State Lists and state-dependent parameters with categorical On/Safe and Illuminated/Eclipse example\",\"maturity\":\"Reported native capability\",\"limits\":\"No executable transitions, time integration, or controller dynamics established\"},{\"id\":\"COM-E06\",\"pages\":[5],\"section\":\"first 4.2.1\",\"claim\":\"Requirement links and automated numerical compliance checks. Draft CDS integration and student-derived mission requirements\",\"maturity\":\"Reported linking and numerical checking\",\"limits\":\"Requirement quality, complete criteria, RAM and technician procedures remain additions. Standard applicability and revision need review\"},{\"id\":\"COM-E07\",\"pages\":[5],\"section\":\"Model Catalogue subsection, also numbered 4.2.1 in source\",\"claim\":\"Generic equipment and specific COTS/assemblies with linked data sheets copied into studies\",\"maturity\":\"Reported catalogue\",\"limits\":\"No procurement BOM or financial workflow established\"},{\"id\":\"COM-E08\",\"pages\":[2,5,6],\"section\":\"2.1, 2.2, 5, 6\",\"figures\":[7],\"claim\":\"Training material, moderated sessions, student CubeSat pilot and usability/applicability questionnaires\",\"maturity\":\"Student pilot\",\"limits\":\"No framework learning, effort, price, reproduction, or detection benchmark\"}]},{\"id\":\"citation-2362\",\"citation_key\":\"kaslow2019csrm\",\"title\":\"Developing a CubeSat System MBSE Reference Model: Interim Status #5\",\"authors\":[\"David Kaslow\",\"Philip T. Cahill\",\"Rodger Frank\"],\"year\":2019,\"path\":\"SLR/SLR1/pdfs/citation-reports/citation-report-2362/citation-report-2362.md\",\"page_basis\":\"Physical PDF pages from Markdown PDF_PAGE markers\",\"verification\":\"Full source read\",\"claims\":[{\"id\":\"COM-E09\",\"pages\":[2,4,5],\"section\":\"CSRM, CSRM Application, Mission-specific CubeSat Model, Transition\",\"claim\":\"Reusable logical space and ground architecture, stakeholder/measure/requirement/architecture/use-case relationships and mission tailoring\",\"maturity\":\"Reference model guidance\",\"limits\":\"Mission content remains team responsibility. No automatic COMET or current SysML v2 implementation established\"},{\"id\":\"COM-E10\",\"pages\":[5,6],\"section\":\"MSM Validation and Verification, CSRM Validation, Next Steps\",\"claim\":\"V&V activity properties and relationships can link plans, procedures, results and status. Power/weight/cost parametrics had not been added\",\"maturity\":\"Relationship pattern\",\"limits\":\"No executable COMET V&V or cost calculations established\"}]},{\"id\":\"review-1277\",\"citation_key\":\"review-1277\",\"title\":\"Spacecraft Interface Management in Concurrent Engineering Sessions\",\"authors\":[\"Philipp M. Fischer\",\"Caroline Lange\",\"Volker Maiwald\",\"Sascha Müller\",\"Andrii Kovalov\",\"Janis Häseker\",\"Thomas Gärtner\",\"Andreas Gerndt\"],\"year\":2019,\"path\":\"SLR/SLR1/pdfs/review-reports/review-report-1277/review-report-1277.md\",\"page_basis\":\"Physical PDF pages from Markdown PDF_PAGE markers\",\"verification\":\"Full source read\",\"claims\":[{\"id\":\"COM-E11\",\"pages\":[4,5,6,7],\"section\":\"3.1-3.3, 4, 5, 6\",\"claim\":\"Virtual Satellite implemented owned interface ends, connections, power voltage information, typed data interfaces and data-rate summaries in S2TEP\",\"maturity\":\"Implemented different-platform pattern\",\"limits\":\"Not COMET feature, permissions, cFS/F-Prime evidence. Redundancy semantics remain ambiguous\"},{\"id\":\"COM-E12\",\"pages\":[3],\"section\":\"2.2\",\"claim\":\"OCDT uses generic REST API for external calculation exchange\",\"maturity\":\"Different-platform context only\",\"limits\":\"Excluded as proof of COMET API\"}]},{\"id\":\"review-0522\",\"citation_key\":\"kanavouras2024lightweight\",\"title\":\"Building a Lightweight Data Management Tool for Small Satellite Missions\",\"authors\":[\"Konstantinos Kanavouras\",\"Alexander Bühler\",\"Andreas M. Hein\"],\"year\":2024,\"path\":\"SLR/SLR1/pdfs/review-reports/review-report-0522/review-report-0522.md\",\"page_basis\":\"Physical PDF pages from Markdown PDF_PAGE markers\",\"verification\":\"Full source read\",\"claims\":[{\"id\":\"COM-E13\",\"pages\":[1,2,3],\"section\":\"1 and 1.1\",\"claim\":\"Small-team MBSE setup/maintenance overhead and classification of COMET as informal engineering data platform\",\"maturity\":\"Literature argument\",\"limits\":\"No COMET-specific measured effort or cost\"},{\"id\":\"COM-E14\",\"pages\":[5,9,10],\"section\":\"2.0.1, 3.2, 4\",\"claim\":\"Separate lightweight concept excludes requirement/test/failure management and proposes richer parameter workflows and time-variable representations\",\"maturity\":\"Separate concept and early prototype\",\"limits\":\"Its API, workflows, and dynamic parameter proposal are not COMET evidence\"}]}],\"nodes\":[{\"id\":\"COM-N1\",\"name\":\"Participant and review\",\"partitioning_basis\":\"Human interaction and learning\",\"responsibilities\":[\"Requirement guidance\",\"Role-specific access\",\"Onboarding\",\"Readable review\",\"Technician package delivery\",\"Findings input\"],\"maturity\":\"Native clients plus proposed workflow\"},{\"id\":\"COM-N2\",\"name\":\"Study and reference\",\"partitioning_basis\":\"Central collaboration and parameter ownership\",\"responsibilities\":[\"Template/catalogue instantiation\",\"Reference definitions\",\"Shared parameters\",\"Requirements and links\",\"Categorical states\",\"Equipment alternatives\",\"BOM/cost records\",\"Companion contract identities\"],\"maturity\":\"Reported native study pattern plus proposed extensions\"},{\"id\":\"COM-N3\",\"name\":\"Assurance and evidence\",\"partitioning_basis\":\"Acceptance and custody independent of editable working records\",\"responsibilities\":[\"Criteria completeness\",\"Semantic assurance\",\"Trace checks\",\"Release control\",\"Change impact\",\"Evidence invalidation\",\"Provenance\",\"Reproduction coordination\",\"Credibility status\",\"Review generation\",\"Framework evaluation\"],\"maturity\":\"Proposed\"},{\"id\":\"COM-N4\",\"name\":\"Engineering execution\",\"partitioning_basis\":\"Execution environments and dynamics independent of collaboration update rate\",\"responsibilities\":[\"Spreadsheet budgets/compliance\",\"Dynamic EPS/battery/controller analysis\",\"Calibration\",\"RAM analysis\",\"cFS/F-Prime checks\",\"Sequences and target profiling\",\"Measurement ingestion\"],\"maturity\":\"Reported Excel surface plus proposed adapters\",\"restriction\":\"COMET synchronization stays outside controller timing loops\"}],\"logical_responsibilities\":[{\"id\":\"COM-L01\",\"node\":\"COM-N1\",\"capability\":\"Guided requirement authoring, onboarding and role-specific review\",\"status\":\"native access plus proposed quality and communication behavior\"},{\"id\":\"COM-L02\",\"node\":\"COM-N2\",\"capability\":\"Reusable template/catalogue/study configuration and reference semantics\",\"status\":\"reported native basis\"},{\"id\":\"COM-L03\",\"node\":\"COM-N2\",\"capability\":\"Requirements, shared parameters, states, equipment/BOM/cost representation\",\"status\":\"native representation plus proposed BOM/cost extensions\"},{\"id\":\"COM-L04\",\"node\":\"COM-N3\",\"capability\":\"Criteria/trace completeness, standards applicability and semantic assurance\",\"status\":\"proposed\"},{\"id\":\"COM-L05\",\"node\":\"COM-N3\",\"capability\":\"Release/change authority, provenance, evidence invalidation and reproduction coordination\",\"status\":\"proposed\"},{\"id\":\"COM-L06\",\"node\":\"COM-N3\",\"capability\":\"Review generation, credibility status and framework evaluation custody\",\"status\":\"proposed\"},{\"id\":\"COM-L07\",\"node\":\"COM-N4\",\"capability\":\"Spreadsheet budgets and numerical compliance\",\"status\":\"reported native basis\"},{\"id\":\"COM-L08\",\"node\":\"COM-N4\",\"capability\":\"Dynamic EPS/battery/controller models, calibration, uncertainty and RAM execution\",\"status\":\"proposed adapters and controlled workflows\"},{\"id\":\"COM-L09\",\"node\":\"COM-N4\",\"capability\":\"Common software definitions, cFS/F-Prime mappings, sequences/builds and target resources\",\"status\":\"proposed\"},{\"id\":\"COM-L10\",\"node\":\"COM-N4\",\"capability\":\"Safe measurement ingestion, time/validity checks and evidence feedback\",\"status\":\"proposed\"}],\"authority_rules\":[{\"record\":\"Study fields supported by native schema\",\"authority\":\"COMET editable study and accepted released snapshot\",\"rule\":\"Owners propose. Designated reviewer accepts. Synchronization alone does not release\"},{\"record\":\"Rich behavior, timing, interfaces and common software definitions\",\"authority\":\"Versioned companion contract\",\"rule\":\"One authority per field with stable links and derived views. Optional mission SysML model can supply records. Reject unsupported semantic loss\"},{\"record\":\"Reusable core assets\",\"authority\":\"Framework maintainer release\",\"rule\":\"Pin template/catalogue/reference/schema versions. Record mission tailoring and catalogue origin. Keep core changes distinct\"},{\"record\":\"BOM and cost\",\"authority\":\"EPS engineer for equipment/quantities, project manager for financial sources/assumptions\",\"rule\":\"Unknown prices remain unknown. Separate EPS mission cost from framework cost and adoption\"},{\"record\":\"Models and analysis outputs\",\"authority\":\"Qualified domain owners approve purpose, inputs, validity and interpretation\",\"rule\":\"Outputs and measurements are proposals. Preserve raw data and superseded baselines\"},{\"record\":\"Evidence release\",\"authority\":\"Controlled manifest plus designated acceptance procedure\",\"rule\":\"Bind study, companion, workbook, solver/build/models/software/data/raw outputs/criteria/decisions. Invalidate affected evidence on change. Block incomplete or conflicting releases\"},{\"record\":\"Hardware activity safety\",\"authority\":\"Applicable testing facility procedure and technician review\",\"rule\":\"Review DUT/equipment/fixtures/calibration/limits/interlocks/abort/timestamps. Simulated safety does not authorize hazardous hardware injection\"},{\"record\":\"Framework evaluation\",\"authority\":\"Frozen common protocol and framework core\",\"rule\":\"Use both contrasting cases. Distinguish core changes from permitted tailoring. Separate framework verification, EPS verification and research deliverable assessment\"}],\"concern_coverage\":[{\"family\":\"Requirements learning and criteria\",\"native_evidence\":[\"COM-E06\",\"COM-E08\"],\"proposals\":[\"Reviewed examples\",\"Author guidance\",\"Measurable variables/ranges/conditions\",\"Standards applicability\",\"Method/evidence completeness\",\"Failed-gate decision links\"],\"nodes\":[\"COM-N1\",\"COM-N2\",\"COM-N3\"],\"checks\":[\"COM-CHK-05\",\"COM-CHK-08\"],\"credit\":\"Partial native basis, additions unverified\"},{\"family\":\"BOM, EPS alternatives and financial cost\",\"native_evidence\":[\"COM-E04\",\"COM-E07\"],\"proposals\":[\"Variant/quantity BOM\",\"Source revisions\",\"Dated quotes/currency/basis\",\"Uncertainty and non-component costs\",\"Change dependencies\",\"Consistent mission comparison basis\"],\"nodes\":[\"COM-N2\",\"COM-N3\",\"COM-N4\"],\"checks\":[\"COM-CHK-02\",\"COM-CHK-04\",\"COM-CHK-05\"],\"credit\":\"Catalogue/budget basis, financial assurance unverified\"},{\"family\":\"Reliability, availability and maintainability\",\"native_evidence\":[\"COM-E04\",\"COM-E09\"],\"proposals\":[\"Failure/propagation records\",\"Recovery/repair assumptions\",\"RAM criteria and measures\",\"Analysis exports and uncertainty\",\"Physical evidence needs\"],\"nodes\":[\"COM-N2\",\"COM-N3\",\"COM-N4\"],\"checks\":[\"COM-CHK-05\",\"COM-CHK-06\"],\"credit\":\"No native RAM engine established\"},{\"family\":\"Technician-ready V&V and safety\",\"native_evidence\":[\"COM-E06\",\"COM-E10\"],\"proposals\":[\"DUT/component identity\",\"Environment/stimuli/equipment/connections\",\"Calibration/ranges/steps/criteria\",\"Raw variables\",\"Interlocks and abort rules\",\"Time/delay/sensor-validity records\",\"Failed-evidence design links\",\"Separate hardware approval\"],\"nodes\":[\"COM-N1\",\"COM-N3\",\"COM-N4\"],\"checks\":[\"COM-CHK-05\",\"COM-CHK-06\"],\"credit\":\"Generic relationship basis, safety and procedure usability unverified\"},{\"family\":\"Dynamic coupled EPS/battery/controller credibility\",\"native_evidence\":[\"COM-E05\"],\"proposals\":[\"Attitude/irradiance/load/thermal/electrical coupling\",\"Battery SOC/SOH/aging\",\"Mode transitions and controller timing\",\"Calibration and held-out measurements\",\"Validity range and uncertainty\",\"Anomaly/fault/degradation/sensor-error discrimination\",\"Separate prediction and control-policy evidence\",\"COTS/EMC/geometry specialist evidence where needed\"],\"nodes\":[\"COM-N3\",\"COM-N4\"],\"checks\":[\"COM-CHK-03\",\"COM-CHK-06\"],\"credit\":\"State-dependent parameters only. Dynamic credibility unverified\"},{\"family\":\"Semantics, provenance, reproduction and change\",\"native_evidence\":[\"COM-E01\",\"COM-E03\",\"COM-E04\"],\"proposals\":[\"Identifier/type/unit/state/interface mappings\",\"Field authority\",\"Versioned releases and raw provenance\",\"Workbook/tool environment reconstruction\",\"Stale-evidence invalidation\",\"Reviewed measurement feedback\"],\"nodes\":[\"COM-N2\",\"COM-N3\",\"COM-N4\"],\"checks\":[\"COM-CHK-01\",\"COM-CHK-02\",\"COM-CHK-03\",\"COM-CHK-04\"],\"credit\":\"Limited native shared semantics, full chain unverified\"},{\"family\":\"cFS/F-Prime common definitions, sequences and resource budgets\",\"native_evidence\":[],\"pattern_evidence\":[\"COM-E11\"],\"proposals\":[\"One command/telemetry/event/parameter contract\",\"Units/encoding/IDs/preconditions/effects/validity\",\"Separate publish-subscribe and typed-connection mappings\",\"Safe-mode/fault/recovery ownership\",\"Versioned OS/OBC/build configuration\",\"Measured CPU/memory/timing/power\"],\"nodes\":[\"COM-N3\",\"COM-N4\"],\"checks\":[\"COM-CHK-04\",\"COM-CHK-07\"],\"credit\":\"No native COMET integration established\"},{\"family\":\"Readable reviews and communication\",\"native_evidence\":[\"COM-E04\",\"COM-E06\",\"COM-E07\"],\"proposals\":[\"Concern-to-evidence tables\",\"Decision summaries\",\"Baseline labels\",\"Findings/dispositions\",\"Few context/structure/interface/selected views\"],\"nodes\":[\"COM-N1\",\"COM-N3\"],\"checks\":[\"COM-CHK-05\",\"COM-CHK-08\"],\"credit\":\"Native readable source grouping, review workflow unverified\"},{\"family\":\"Adoption and team resources\",\"native_evidence\":[\"COM-E01\",\"COM-E08\"],\"context_evidence\":[\"COM-E13\"],\"proposals\":[\"Small template subset\",\"Role-specific learning exercises\",\"Declared licenses/dependencies/hosts\",\"Maintenance and recovery instructions\",\"Frozen-core contrasting cases\",\"Observed effort and direct costs\"],\"nodes\":[\"COM-N1\",\"COM-N2\",\"COM-N3\",\"COM-N4\"],\"checks\":[\"COM-CHK-01\",\"COM-CHK-03\",\"COM-CHK-08\"],\"credit\":\"Pilot motivates applicability. Quantitative benefit unknown\"}],\"proposals\":[{\"id\":\"COM-PR01\",\"name\":\"Companion assurance contract\",\"scope\":\"Rich semantics absent from native study model, single authority per field and explicit mappings\",\"components\":[\"COM-S05\",\"COM-S06\",\"COM-S12\",\"COM-D05\"]},{\"id\":\"COM-PR02\",\"name\":\"Configuration, change and evidence control\",\"scope\":\"Released snapshots, source/version/digest manifests, invalidation, reviewed feedback and reproduction\",\"components\":[\"COM-S06\",\"COM-S12\",\"COM-D07\",\"COM-D08\",\"COM-P04\",\"COM-P07\"]},{\"id\":\"COM-PR03\",\"name\":\"EPS assurance and discipline execution\",\"scope\":\"Dynamic purpose-specific model credibility, RAM and technician evidence without requiring a replica for every study\",\"components\":[\"COM-S07\",\"COM-S08\",\"COM-S10\",\"COM-D06\",\"COM-P05\",\"COM-P06\"]},{\"id\":\"COM-PR04\",\"name\":\"Common software interface and sequence checks\",\"scope\":\"Definitions and separate cFS/F-Prime mappings/builds/profiling. Complete generated flight code is outside minimum promise\",\"components\":[\"COM-S09\",\"COM-D05\",\"COM-P05\"]},{\"id\":\"COM-PR05\",\"name\":\"Requirement/BOM/cost and adoption workflows\",\"scope\":\"Guided verifiable authoring, financial provenance, readable reviews and real observations\",\"components\":[\"COM-S11\",\"COM-D03\",\"COM-D09\",\"COM-P01\",\"COM-P02\",\"COM-P07\"]}],\"limitations\":[\"The complete candidate has no demonstrated implementation or satisfaction verdict\",\"COMET selected-release API/import/export, permissions, snapshot, automation and licenses require direct checks\",\"OCDT REST and Virtual Satellite interface/rights evidence are not COMET proof\",\"CSRM category mapping is narrower than full semantic interoperability\",\"Finite state lists do not establish executable transitions or coupled dynamics\",\"BOM/cost, RAM, technician safety, provenance/reproduction/change assurance and software integrations are proposed\",\"Excel dependencies and solver environments affect access, reconstruction and adoption\",\"Coupled battery/controller validity, timing, degradation and policy benefit require measurements and qualified criteria\",\"Conceptual phases 0/A describe demonstrated scope. Later-phase extensions are possible but unverified\",\"No numeric hours, prices, thresholds, performance estimates, scores, stakeholder approval or winner are inferred from literature\"],\"method_references\":[{\"title\":\"A Practical Guide to SysML\",\"section\":\"17.3.5\",\"physical_pdf_pages\":[468,469,470,479,480,489,490,491,492],\"use\":\"Logical node distribution, physical software/data/hardware/procedures and partitioning rationale\"},{\"title\":\"CubeSat Handbook: From Mission Design to Operations\",\"section\":\"Part One I.3, I.4.1, I.5-I.5.2\",\"physical_pdf_pages\":[24,25,26,27,29,30,32,33,34,35],\"use\":\"Review/evidence maturation, verifiable requirement writing and cost provenance/uncertainty\",\"restriction\":\"Illustrative numeric costs/margins not adopted\"}],\"retrieval\":{\"mode\":\"jev\",\"reranker\":\"jev\",\"top_k_requested\":12,\"query\":\"COMET concurrent engineering CubeSat template model catalogue state dependent parameters requirements compliance evidence integration limitations\",\"status\":\"HTTP 402, no API credits, zero results\",\"fallback\":\"All four assigned source Markdown files read directly\",\"record\":\"retrieval.json\",\"cache_warning\":\"See SEARCH-WARNING.md for unintended failed-search metadata row caused by import-bound constructor default. Local wrapper corrected, not rerun\",\"current_turn\":\"No searches made. Original source records retained unchanged. The orchestrator review states the earlier failed-query cache metadata was restored to baseline.\"},\"review_baseline\":{\"registry_path\":\"/tmp/eps-oosem.wmUVTQ/concerns/concerns.json\",\"review_decisions_path\":\"/tmp/eps-oosem.wmUVTQ/review-decisions.md\",\"logical_responsibilities_path\":\"/tmp/eps-oosem.wmUVTQ/architecture/architecture.md\",\"registry_sha256\":\"c5e3f6ba36e32229b419ed0279493b3e45c98fd7490a9aa410caf257d8c12096\",\"review_decisions_sha256\":\"6e42ec8bf1986736f7a32083d08312a8355f05b7fda4502ab6d9cadaf5f959cd\",\"framework_requirements\":[{\"id\":\"FR-01\",\"title\":\"Requirement record\",\"text\":\"The framework shall retain each requirement as an identified record with source need, parent, rationale, observable quantities or conditions and applicable units, owner, verification method, criterion, and resolution status.\",\"mission_need_ids\":[\"MN-01\",\"MN-02\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-02\"],\"logical_capability_ids\":[\"L02\"],\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Round-trip a quantitative requirement and a qualitative demonstration requirement, including source, condition or quantity, applicable units and criterion. An inapplicable field retains rationale. An absent criterion remains unresolved and cannot acquire a verified label.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-01\",\"C-SE-03.3\",\"C-SE-05.1\",\"C-EPS-04.3\",\"C-EPS-04.3.1\",\"C-EPS-04.3.2\"],\"source_lines\":[31,57,73,119,120,121],\"field_rule\":\"Every not-applicable field needs a rationale. Completeness establishes neither technical truth nor safety approval.\"},{\"id\":\"FR-02\",\"title\":\"Learning and templates\",\"text\":\"The framework shall provide requirement and traceability templates, worked EPS examples, and a guided reference workflow that covers writing criteria, linking evidence, and interpreting gaps.\",\"mission_need_ids\":[\"MN-01\",\"MN-11\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-11\"],\"logical_capability_ids\":[\"L01\",\"L09\"],\"verification_method\":\"I,D\",\"proposed_acceptance\":\"Inspect the learning package and demonstrate the workflow from a declared clean start. Measure learner effort and errors without imposing an unagreed time limit.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-01\",\"C-PM-01.1\",\"C-SE-01.1\",\"C-SE-01.1.1\",\"C-EPS-02.1\",\"C-NE-02\",\"C-NE-02.4\",\"C-NE-02.4.1\",\"C-NE-02.4.2\"],\"source_lines\":[31,32,49,50,111,163,168,169,170]},{\"id\":\"FR-03\",\"title\":\"Method applicability\",\"text\":\"The framework shall retain a source-linked catalogue of requirement derivation and verification methods, standards, and activity templates with applicability, tailoring rationale, and limitations.\",\"mission_need_ids\":[\"MN-01\",\"MN-07\",\"MN-11\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-07\",\"MR-11\"],\"logical_capability_ids\":[\"L01\",\"L07\"],\"verification_method\":\"I,D\",\"proposed_acceptance\":\"For subsystem and component fixtures retrieve the chosen method and its source, conditions, tailoring decision, and excluded alternatives. A catalogue entry does not assert standards compliance.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-03.3.1.3\",\"C-SE-03.3.1.3.1\",\"C-SE-03.3.1.3.2\",\"C-SE-03.4\",\"C-SE-03.4.1\",\"C-SE-03.4.2\",\"C-SE-05.2.1.1\",\"C-EPS-04.4\",\"C-EPS-04.4.1\",\"C-EPS-04.4.2\",\"C-EPS-04.4.4\",\"C-EPS-04.4.4.1\"],\"source_lines\":[61,62,63,64,65,66,76,122,123,124,127,128]},{\"id\":\"FR-04\",\"title\":\"Bidirectional trace retrieval\",\"text\":\"The framework shall retrieve applicable links from needs and requirements to design decisions, model inputs, verification criteria and results, and retrieve the reverse paths.\",\"mission_need_ids\":[\"MN-02\",\"MN-10\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-10\"],\"logical_capability_ids\":[\"L02\",\"L08\"],\"verification_method\":\"T\",\"proposed_acceptance\":\"Compare both query directions with the fixture relation set. Missing, ambiguous and stale endpoints remain visible.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-01\",\"C-SE-02\",\"C-SE-02.1\",\"C-EPS-02\",\"C-EPS-03\",\"C-EPS-03.1\",\"C-EPS-03.2\"],\"source_lines\":[48,51,52,110,112,113,114]},{\"id\":\"FR-05\",\"title\":\"Change impact\",\"text\":\"The framework shall identify the requirements, EPS and non-EPS allocations, BOMs, models, software definitions, procedures, and evidence affected by a designated change.\",\"mission_need_ids\":[\"MN-02\",\"MN-03\",\"MN-08\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-03\",\"MR-08\"],\"logical_capability_ids\":[\"L02\",\"L08\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Use seeded cross-subsystem and component changes. Compare the returned impact set and unresolved coverage with an adjudicated reference.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-02.1.2\",\"C-SE-01\",\"C-SE-03\",\"C-SE-03.1\",\"C-SE-03.1.1\",\"C-SE-03.2\",\"C-SE-04\",\"C-SE-04.1\",\"C-SE-04.1.1\",\"C-SE-09\",\"C-SE-09.1\",\"C-SE-09.2\",\"C-SE-09.2.1\",\"C-EPS-01\",\"C-EPS-01.1\",\"C-EPS-04\",\"C-EPS-04.1\",\"C-EPS-04.1.1\",\"C-EPS-04.2\",\"C-NE-02.1\"],\"source_lines\":[37,48,53,54,55,56,69,70,71,91,92,93,94,103,104,115,116,117,118,164]},{\"id\":\"FR-06\",\"title\":\"Change disposition\",\"text\":\"The framework shall issue a successor baseline for an accepted change that retains its request and failed-gate context and marks affected evidence as regenerated, stale, or unresolved.\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-07\"],\"logical_capability_ids\":[\"L02\",\"L08\"],\"verification_method\":\"T\",\"proposed_acceptance\":\"Exercise a failed verification gate followed by correction. Preserve the prior baseline and prevent stale results from appearing current.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-02.1.2\",\"C-SE-03\",\"C-SE-03.1\",\"C-SE-03.1.1\",\"C-SE-04\",\"C-SE-04.1\",\"C-SE-04.1.1\",\"C-SE-07.3\",\"C-EPS-03\",\"C-EPS-03.1\",\"C-EPS-03.2\",\"C-EPS-04\",\"C-EPS-04.1\",\"C-EPS-04.1.1\"],\"source_lines\":[37,53,54,55,69,70,71,86,112,113,114,115,116,117]},{\"id\":\"FR-07\",\"title\":\"Controlled baselines\",\"text\":\"The framework shall retain identified, retrievable baselines of engineering records, case configuration, and evidence with revision history and distinct identities for accepted successors.\",\"mission_need_ids\":[\"MN-02\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-09\"],\"logical_capability_ids\":[\"L08\"],\"verification_method\":\"T\",\"proposed_acceptance\":\"Reconstruct two revisions after a change and compare their manifests and contents. Attempted overwrite cannot erase the retained prior baseline.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-05.1\",\"C-SE-07\",\"C-EPS-05.4\",\"C-NE-01.2\"],\"source_lines\":[43,82,137,162]},{\"id\":\"FR-08\",\"title\":\"Semantic transfers\",\"text\":\"The framework shall check transferred identifiers, structure, quantities, units, polarity, time bases, interface meanings, and provenance against a declared contract and retain explicit rejection findings.\",\"mission_need_ids\":[\"MN-02\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-09\"],\"logical_capability_ids\":[\"L08\"],\"verification_method\":\"T\",\"proposed_acceptance\":\"Inject unit, sign, identifier and time-base mismatches. Reject incompatible transfers without replacing controlled content. Record unsupported or lossy mappings.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-05\",\"C-PM-05.1\",\"C-SE-07\",\"C-SE-07.1\",\"C-SE-07.1.1\",\"C-EPS-04.4.4.2\",\"C-EPS-05.4\",\"C-NE-01.2\"],\"source_lines\":[42,43,82,83,84,129,137,162]},{\"id\":\"FR-09\",\"title\":\"Result provenance\",\"text\":\"The framework shall associate each result with its producer, method, requirement and decision, design and hardware configuration, software and model versions, parameter set, input data, environment, and raw output.\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-09\"],\"logical_capability_ids\":[\"L08\",\"L06\"],\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Trace an analytical and a supplied measurement result to every applicable configuration item. An unknown identity remains a gap and blocks a contradictory validity claim.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-05.1\",\"C-SE-07\",\"C-SE-07.2\",\"C-EPS-05.4\",\"C-NE-01.2\"],\"source_lines\":[43,82,85,137,162]},{\"id\":\"FR-10\",\"title\":\"Independent replay\",\"text\":\"The framework shall provide controlled instructions and dependencies to reconstruct and execute a designated analysis and compare its raw outputs using declared result-specific rules and tolerances.\",\"mission_need_ids\":[\"MN-09\"],\"mission_requirement_ids\":[\"MR-09\"],\"logical_capability_ids\":[\"L05\",\"L08\",\"L09\"],\"verification_method\":\"D,T\",\"proposed_acceptance\":\"An independent participant replays a baseline from a clean declared environment. Retain logs, seeds when relevant, failures and comparison verdicts. Tolerances are fixed before replay.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-04\"],\"source_lines\":[41]},{\"id\":\"FR-11\",\"title\":\"Evidence and discrepancy status\",\"text\":\"The framework shall report missing, rejected, stale, out-of-domain, failed, and unresolved evidence with its affected claim, criticality rationale, owner and disposition.\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-10\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-10\"],\"logical_capability_ids\":[\"L02\",\"L07\",\"L09\"],\"verification_method\":\"T\",\"proposed_acceptance\":\"Seed each status including a critical finding. A claim affected by unresolved critical evidence cannot receive an unqualified supported or verified status.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-05.1\",\"C-SE-07\",\"C-EPS-05.4\",\"C-NE-01.2\"],\"source_lines\":[43,82,137,162]},{\"id\":\"FR-12\",\"title\":\"Candidate BOM\",\"text\":\"The framework shall generate and revise a candidate-specific BOM from identified physical design items with assembly, quantities, part identifiers, variant and selection status, and source revision.\",\"mission_need_ids\":[\"MN-03\"],\"mission_requirement_ids\":[\"MR-03\"],\"logical_capability_ids\":[\"L04\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Compare two alternative assemblies and one component substitution with a reference BOM. Candidate alternatives remain distinct. Missing part data is reported.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-02\",\"C-PM-02.1\",\"C-PM-02.1.1\",\"C-PM-02.1.2\"],\"source_lines\":[34,35,36,37]},{\"id\":\"FR-13\",\"title\":\"Financial estimate\",\"text\":\"The framework shall derive a revision-linked financial estimate from the BOM and declared additional cost categories while retaining price source, date, currency, quantity, estimate basis, uncertainty and missing data.\",\"mission_need_ids\":[\"MN-03\"],\"mission_requirement_ids\":[\"MR-03\"],\"logical_capability_ids\":[\"L04\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Recalculate a sourced-price fixture after a quantity and part change. Match reference arithmetic and preserve unknown costs. Do not import historical project costs as new framework measurements.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-02\",\"C-PM-02.1.2\"],\"source_lines\":[34,37]},{\"id\":\"FR-14\",\"title\":\"EPS candidate comparison\",\"text\":\"The framework shall produce a comparison of designated EPS architectures using a common requirement, assumption, evidence and criterion basis with feasibility status, raw measures, uncertainty and decision rationale.\",\"mission_need_ids\":[\"MN-03\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-03\",\"MR-04\"],\"logical_capability_ids\":[\"L05\",\"L04\",\"L02\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Compare candidates with a failing requirement and incomplete evidence. Keep feasibility and unknown status separate from ranking. Any preference weights are declared before results.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-02.1.1\",\"C-SE-03.2\",\"C-EPS-01\",\"C-EPS-01.1\",\"C-EPS-04.2\"],\"source_lines\":[36,56,103,104,118]},{\"id\":\"FR-15\",\"title\":\"Reusable EPS representation\",\"text\":\"The framework shall provide a configurable generic EPS representation covering requirements, functions, logical and physical elements, interfaces, modes and states, with case-specific parameter and extension records.\",\"mission_need_ids\":[\"MN-04\",\"MN-11\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-11\"],\"logical_capability_ids\":[\"L03\"],\"verification_method\":\"I,D\",\"proposed_acceptance\":\"Instantiate the representation in two contrasting cases and trace a requirement through function, allocation, interface and analysis. An extension retains its relation to the generic core.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[],\"source_lines\":[]},{\"id\":\"FR-16\",\"title\":\"Dynamic mission composition\",\"text\":\"The framework shall compose time-dependent subsystem demand, duty cycles, schedules and mode transitions with orbit, attitude, irradiance, eclipse, thermal conditions and EPS supply and protection behavior.\",\"mission_need_ids\":[\"MN-04\",\"MN-05\",\"MN-08\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-05\",\"MR-08\"],\"logical_capability_ids\":[\"L05\",\"L03\",\"L04\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Use a fixture whose average budget passes while a coupled load and illumination event creates a transient shortage. Inspect inputs, interactions and event timing against a reference calculation.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-03.3.1.2\",\"C-SE-06\",\"C-SE-06.1\",\"C-SE-06.2\",\"C-EPS-01.1.4\",\"C-NE-01.1\",\"C-NE-01.1.1\"],\"source_lines\":[60,79,80,81,108,159,160]},{\"id\":\"FR-17\",\"title\":\"Requirement parameter derivation\",\"text\":\"The framework shall record how sourced component power and thermal characteristics and subsystem behavior become EPS or component requirement parameters, including units, uncertainties, allowable ranges and criterion decisions.\",\"mission_need_ids\":[\"MN-01\",\"MN-02\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-02\",\"MR-04\"],\"logical_capability_ids\":[\"L02\",\"L04\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Derive a fixture allocation from datasheet and supplied measurement inputs using a declared method. Preserve assumptions and flag unsupported ranges and undecided pass/fail values.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-03\",\"C-SE-03.3\",\"C-SE-03.3.1\",\"C-SE-03.3.1.1\",\"C-SE-03.3.1.2\",\"C-SE-03.3.1.3\",\"C-SE-03.3.1.3.1\",\"C-SE-03.3.1.3.2\",\"C-SE-04\",\"C-EPS-04\",\"C-EPS-04.3\",\"C-EPS-04.3.1\",\"C-EPS-04.3.2\"],\"source_lines\":[53,57,58,59,60,61,62,63,69,115,119,120,121]},{\"id\":\"FR-18\",\"title\":\"Discipline model integration\",\"text\":\"The framework shall exchange identified EPS component and design data with declared electrical, thermal, EMC and CAD analysis tools and retain model mappings, applicable outputs and unsupported checks.\",\"mission_need_ids\":[\"MN-04\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-07\"],\"logical_capability_ids\":[\"L03\",\"L05\",\"L08\"],\"verification_method\":\"D,T\",\"proposed_acceptance\":\"Every electrical, thermal, EMC and CAD exchange profile required by the frozen minimum shall complete its reference request/result exchange and declared identity, quantity, unit, meaning and revision checks. Retain unsupported mappings and development gaps. A missing required profile remains not verified or undetermined and cannot pass V18. A narrower minimum requires a reviewed scope disposition before evaluation.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-03\",\"C-PM-03.1\",\"C-SE-03.3.1\",\"C-SE-03.3.1.1\",\"C-EPS-01.1.1\",\"C-EPS-04.4.4.2\"],\"source_lines\":[38,39,58,59,105,129]},{\"id\":\"FR-19\",\"title\":\"Early verification scenarios\",\"text\":\"The framework shall execute or coordinate declared virtual EPS and component verification scenarios for dynamic loads, supply changes, protection events, rare faults, and controller electrical and timing constraints.\",\"mission_need_ids\":[\"MN-04\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-07\"],\"logical_capability_ids\":[\"L05\",\"L07\"],\"verification_method\":\"D,T\",\"proposed_acceptance\":\"Retain stimulus, conditions, expected response, outputs and status for nominal and failure fixtures. Unsupported behavior and physical validation needs are explicit, including COTS evidence gaps.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-03\",\"C-PM-03.1\",\"C-PM-03.1.1\",\"C-SE-03.2\",\"C-SE-06\",\"C-SE-06.1\",\"C-SE-06.2\",\"C-EPS-01\",\"C-EPS-01.1\",\"C-EPS-01.1.1\",\"C-EPS-01.1.2\",\"C-EPS-01.1.3\",\"C-EPS-01.1.4\",\"C-EPS-01.1.5\",\"C-EPS-04.2\",\"C-NE-01\",\"C-NE-01.1\",\"C-NE-01.1.1\",\"C-NE-01.1.2\",\"C-TFT-01.4\",\"C-TFT-01.4.1\"],\"source_lines\":[38,39,40,56,79,80,81,103,104,105,106,107,108,109,118,158,159,160,161,182,183]},{\"id\":\"FR-20\",\"title\":\"Battery model coupling\",\"text\":\"The framework shall integrate identified battery electrical, thermal and degradation models with mission loads and retain the states, health and lifetime outputs, assumptions and uncertainty supported by each model.\",\"mission_need_ids\":[\"MN-05\"],\"mission_requirement_ids\":[\"MR-05\"],\"logical_capability_ids\":[\"L05\",\"L06\",\"L04\"],\"verification_method\":\"A,D\",\"proposed_acceptance\":\"Replay fresh and aged battery fixtures under different load and temperature profiles. Verify coupling and provenance. Missing aging mechanisms and latent-state uncertainty remain visible.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-08\",\"C-SE-08.1\",\"C-SE-08.2\",\"C-SE-08.3\",\"C-EPS-05\",\"C-EPS-05.3\",\"C-EPS-05.3.1\",\"C-EPS-06\",\"C-EPS-06.1\",\"C-EPS-06.2\",\"C-EPS-06.3\"],\"source_lines\":[87,88,89,90,130,135,136,138,139,140,141]},{\"id\":\"FR-21\",\"title\":\"Intended-use credibility\",\"text\":\"The framework shall associate each analytical verification claim with the model intended use, tested validity domain, calibration and validation evidence, uncertainty and acceptable prediction-error rule.\",\"mission_need_ids\":[\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-09\"],\"logical_capability_ids\":[\"L06\",\"L07\"],\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Exercise an in-domain and an extrapolated claim. Separate calibration from validation data where available. Flag untested domains and absent error limits. Prediction accuracy limits require prior agreement.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-03\",\"C-PM-03.1\",\"C-PM-04\",\"C-SE-06\",\"C-SE-06.1\",\"C-SE-06.2\",\"C-SE-08\",\"C-SE-08.1\",\"C-SE-08.2\",\"C-SE-08.3\",\"C-EPS-01.1.1\",\"C-EPS-05\",\"C-EPS-05.1\",\"C-EPS-05.1.1\",\"C-EPS-05.2\",\"C-EPS-05.2.1\",\"C-EPS-06\",\"C-EPS-06.1\",\"C-EPS-06.2\",\"C-EPS-06.3\",\"C-EPS-07\",\"C-EPS-07.1\",\"C-EPS-07.2\",\"C-EPS-08\",\"C-EPS-08.1\"],\"source_lines\":[38,39,41,79,80,81,87,88,89,90,105,130,131,132,133,134,138,139,140,141,142,143,144,145,146]},{\"id\":\"FR-22\",\"title\":\"Model update workflow\",\"text\":\"The framework shall use supplied measurements to create an identified calibration or parameter-update record with data quality, prior and revised parameters, residuals and affected analyses.\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-09\"],\"logical_capability_ids\":[\"L06\",\"L04\",\"L02\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Apply a measurement fixture, compare the declared calibration result with a reference, retain both parameter revisions, and flag analyses affected by drift or update.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-04\",\"C-SE-07.3\",\"C-SE-08.1\",\"C-EPS-05\",\"C-EPS-05.1\",\"C-EPS-05.1.1\",\"C-EPS-05.2\",\"C-EPS-05.2.1\"],\"source_lines\":[41,86,88,130,131,132,133,134]},{\"id\":\"FR-23\",\"title\":\"Fidelity and execution contract\",\"text\":\"The framework shall record the selected model fidelity, execution environment, time step, measured or estimated runtime and interface delays for each declared SIL or HIL interaction profile.\",\"mission_need_ids\":[\"MN-05\",\"MN-07\",\"MN-08\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-07\",\"MR-08\"],\"logical_capability_ids\":[\"L05\",\"L06\"],\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Profile a declared executable model and replay timestamped input/output fixtures. Real-time suitability remains unresolved until the applicable hardware and deadline are verified.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-03.1.1\",\"C-EPS-01.1.2\",\"C-EPS-01.1.3\",\"C-EPS-05.3\",\"C-EPS-05.3.1\",\"C-NE-02.5\",\"C-NE-02.5.1\",\"C-NE-02.5.2\",\"C-TFT-02.3\",\"C-TFT-02.3.1\"],\"source_lines\":[40,106,107,135,136,171,172,173,187,188]},{\"id\":\"FR-24\",\"title\":\"Controller policy assessment\",\"text\":\"The framework shall compare designated charging and power-management policies under declared load, thermal, health, electrical and timing conditions with safety constraints and policy-specific outcome evidence.\",\"mission_need_ids\":[\"MN-05\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-04\"],\"logical_capability_ids\":[\"L05\",\"L06\",\"L07\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Replay a baseline and a changed policy against the same fixture conditions. A model prediction cannot be labeled a demonstrated hardware improvement. Retain pending SIL, HIL or hardware evidence.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-EPS-01.1.2\",\"C-EPS-01.1.3\",\"C-EPS-08\",\"C-EPS-08.1\"],\"source_lines\":[106,107,145,146]},{\"id\":\"FR-25\",\"title\":\"Anomaly assessment\",\"text\":\"The framework shall compare time-correlated EPS telemetry with modeled expected behavior while retaining operating mode, model validity, degradation and sensor uncertainty, and alternative fault explanations.\",\"mission_need_ids\":[\"MN-05\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-04\"],\"logical_capability_ids\":[\"L06\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Use nominal, degrading, noisy and injected-fault fixtures. Retain residuals and diagnoses with TP, FP and FN against an expert reference. No pre-threshold detection capability is presumed.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-EPS-07\",\"C-EPS-07.1\",\"C-EPS-07.2\"],\"source_lines\":[142,143,144]},{\"id\":\"FR-26\",\"title\":\"RAM requirement coverage\",\"text\":\"The framework shall identify the RAM variables and failure assumptions applicable to designated EPS and spacecraft requirements and report their verification-method coverage and gaps.\",\"mission_need_ids\":[\"MN-06\",\"MN-01\"],\"mission_requirement_ids\":[\"MR-06\",\"MR-01\"],\"logical_capability_ids\":[\"L02\",\"L04\",\"L07\"],\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Compare the declared RAM variable and requirement set with a reference. Report analysis, inspection, demonstration or test rationale without forcing every claim to use analysis.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-05\",\"C-SE-05.1\",\"C-SE-05.2\",\"C-SE-05.2.1\",\"C-SE-05.2.1.1\"],\"source_lines\":[72,73,74,75,76]},{\"id\":\"FR-27\",\"title\":\"RAM model generation\",\"text\":\"The framework shall generate a declared RAM analysis representation from identified functions, components and failure dependencies with traceable transformation rules and sourced or missing reliability data.\",\"mission_need_ids\":[\"MN-06\"],\"mission_requirement_ids\":[\"MR-06\"],\"logical_capability_ids\":[\"L04\",\"L05\",\"L08\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Generate an FMEA, fault tree or other justified representation for a reference design and its changed variant. Compare entities and dependencies with an expert model. Missing probabilities cannot become factual reliability estimates.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-05\",\"C-SE-05.2\",\"C-SE-05.2.1\",\"C-SE-05.2.1.2\",\"C-SE-05.2.1.2.1\"],\"source_lines\":[72,74,75,77,78]},{\"id\":\"FR-28\",\"title\":\"Verification activity record\",\"text\":\"The framework shall retain each EPS or component verification activity with requirement, method, DUT baseline, applicable quantities or observable conditions, inputs, expected response, criterion, evidence variables and status. An inapplicable field shall retain its rationale.\",\"mission_need_ids\":[\"MN-07\",\"MN-01\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-01\"],\"logical_capability_ids\":[\"L07\"],\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Inspect quantitative analysis/test and qualitative inspection/demonstration fixtures against their method-specific fields. Check the applicable quantity or observable condition, criterion, expected response and evidence. An inapplicable field retains rationale. Missing mandatory fields, failed gates and unresolved criteria remain explicit and prevent an unsupported verdict.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-03.2\",\"C-SE-03.3\",\"C-SE-03.4\",\"C-SE-03.4.1\",\"C-SE-03.4.2\",\"C-SE-03.4.3\",\"C-SE-03.4.3.1\",\"C-SE-05.2\",\"C-SE-05.2.1\",\"C-SE-05.2.1.1\",\"C-EPS-01\",\"C-EPS-01.1\",\"C-EPS-03\",\"C-EPS-03.1\",\"C-EPS-03.2\",\"C-EPS-04.2\",\"C-EPS-04.3\",\"C-EPS-04.3.1\",\"C-EPS-04.3.2\",\"C-EPS-04.4\",\"C-EPS-04.4.1\",\"C-EPS-04.4.2\",\"C-EPS-04.4.3\",\"C-EPS-04.4.3.1\",\"C-EPS-04.4.4\",\"C-EPS-04.4.4.1\",\"C-EPS-04.4.4.2\",\"C-NE-01\",\"C-NE-01.1\",\"C-TFT-01\",\"C-TFT-01.1\",\"C-TFT-02\",\"C-TFT-02.1\",\"C-TFT-02.2\"],\"source_lines\":[56,57,64,65,66,67,68,74,75,76,103,104,112,113,114,118,119,120,121,122,123,124,125,126,127,128,129,158,159,178,179,184,185,186]},{\"id\":\"FR-29\",\"title\":\"Facility proposal\",\"text\":\"The framework shall produce a technician-readable verification proposal that specifies conditions, equipment and fixture identities, DUT connections, stimulus sequence, observations and evidence-generation procedure.\",\"mission_need_ids\":[\"MN-07\"],\"mission_requirement_ids\":[\"MR-07\"],\"logical_capability_ids\":[\"L07\",\"L09\"],\"verification_method\":\"I,D\",\"proposed_acceptance\":\"A technician or qualified proxy checks a fixture proposal against a declared completeness checklist and identifies how equipment interacts with the DUT. Facility feasibility remains a separate decision.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-03.4.3\",\"C-SE-03.4.3.1\",\"C-EPS-01.1.4\",\"C-EPS-04.4.3\",\"C-EPS-04.4.3.1\",\"C-TFT-01\",\"C-TFT-01.1\",\"C-TFT-01.3\",\"C-TFT-02\",\"C-TFT-02.1\",\"C-TFT-02.2\"],\"source_lines\":[67,68,108,125,126,178,179,181,184,185,186]},{\"id\":\"FR-30\",\"title\":\"Safety declaration\",\"text\":\"The framework shall include hazards, battery and electronics operating limits, fault-injection envelope, isolation, abort conditions and responsible safety-review status in each proposed physical verification activity.\",\"mission_need_ids\":[\"MN-07\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-04\"],\"logical_capability_ids\":[\"L07\"],\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Use a safe virtual fault fixture and an incomplete physical proposal. Missing limits or approval status block a ready-for-physical-execution label. The framework does not authorize laboratory operations.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-EPS-01.1.5\",\"C-TFT-01\",\"C-TFT-01.2\",\"C-TFT-01.4\",\"C-TFT-01.4.1\"],\"source_lines\":[109,178,180,182,183]},{\"id\":\"FR-31\",\"title\":\"Evidence timing\",\"text\":\"The framework shall record the time base, sampling and synchronization rules and known measurement, calculation and output delays for applied stimuli, responses and telemetry.\",\"mission_need_ids\":[\"MN-07\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-09\"],\"logical_capability_ids\":[\"L06\",\"L08\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Align a known timestamp fixture and expose injected skew and missing timing metadata. Report alignment error or uncertainty against the agreed profile, with no invented global limit.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-03.4.3\",\"C-SE-03.4.3.1\",\"C-EPS-03\",\"C-EPS-03.1\",\"C-EPS-03.2\",\"C-EPS-04.4.3\",\"C-EPS-04.4.3.1\",\"C-EPS-04.4.4\",\"C-EPS-04.4.4.1\",\"C-TFT-02\",\"C-TFT-02.1\",\"C-TFT-02.2\",\"C-TFT-02.3\",\"C-TFT-02.3.1\"],\"source_lines\":[67,68,112,113,114,125,126,127,128,184,185,186,187,188]},{\"id\":\"FR-32\",\"title\":\"Telemetry quality\",\"text\":\"The framework shall check expected telemetry channels, units, timestamps, completeness and sensor validity conditions and preserve raw samples, invalid values and processing masks.\",\"mission_need_ids\":[\"MN-07\",\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-05\",\"MR-09\"],\"logical_capability_ids\":[\"L06\",\"L08\"],\"verification_method\":\"T\",\"proposed_acceptance\":\"Inject missing samples, inactive sensors and invalid values. Do not treat inactive invalid readings as valid measurements. Match the fixture quality verdict and retained raw data.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-03.4.3\",\"C-SE-03.4.3.1\",\"C-EPS-03\",\"C-EPS-03.1\",\"C-EPS-03.2\",\"C-EPS-04.4.3\",\"C-EPS-04.4.3.1\",\"C-EPS-04.4.4\",\"C-EPS-04.4.4.1\",\"C-EPS-07\",\"C-EPS-07.1\",\"C-EPS-07.2\",\"C-TFT-02\",\"C-TFT-02.1\",\"C-TFT-02.2\",\"C-TFT-02.4\",\"C-TFT-02.4.1\"],\"source_lines\":[67,68,112,113,114,125,126,127,128,142,143,144,184,185,186,189,190]},{\"id\":\"FR-33\",\"title\":\"Shared software definitions\",\"text\":\"The framework shall retain revision-linked EPS command, telemetry, event and parameter definitions with identifiers, types, units, ranges and encodings mapped to hardware, functional software and ground dictionaries.\",\"mission_need_ids\":[\"MN-08\",\"MN-02\"],\"mission_requirement_ids\":[\"MR-08\",\"MR-02\"],\"logical_capability_ids\":[\"L03\"],\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Compare model, flight and ground fixtures against a shared contract. Detect a changed definition in one representation and report every affected mapping.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-09\",\"C-SE-09.1\",\"C-SE-09.2\",\"C-SE-09.2.1\",\"C-SE-09.3\",\"C-SE-10\",\"C-SE-10.1\",\"C-SE-10.2\",\"C-EPS-09\",\"C-EPS-09.1\",\"C-EPS-09.2\",\"C-NE-02\",\"C-NE-02.1\",\"C-NE-02.2\"],\"source_lines\":[91,92,93,94,95,96,97,98,147,148,149,163,164,165]},{\"id\":\"FR-34\",\"title\":\"Flight framework mapping\",\"text\":\"The framework shall produce or coordinate checked mappings of the EPS software contract to declared cFS software-bus and F-Prime typed-connection profiles and identify behavior and implementation gaps.\",\"mission_need_ids\":[\"MN-08\"],\"mission_requirement_ids\":[\"MR-08\"],\"logical_capability_ids\":[\"L03\",\"L05\"],\"verification_method\":\"D,T\",\"proposed_acceptance\":\"Round-trip or validate reference message and port mappings in both profiles. Declare framework version and unsupported exports. Architecture or dictionary generation is distinct from mission-specific functionality.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-09\",\"C-SE-09.1\",\"C-SE-09.2\",\"C-SE-09.2.1\",\"C-SE-09.3\",\"C-EPS-09\",\"C-EPS-09.1\",\"C-EPS-09.2\",\"C-NE-02\",\"C-NE-02.1\",\"C-NE-02.2\",\"C-NE-02.3\",\"C-NE-02.3.1\"],\"source_lines\":[91,92,93,94,95,147,148,149,163,164,165,166,167]},{\"id\":\"FR-35\",\"title\":\"Command and recovery contract\",\"text\":\"The framework shall specify and check EPS command preconditions, order, expected effects, rejection and failure behavior, mode transitions and recovery responsibilities across EPS, telemetry, fault-management and safe-mode functions.\",\"mission_need_ids\":[\"MN-08\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-08\",\"MR-04\"],\"logical_capability_ids\":[\"L03\",\"L05\",\"L07\"],\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Replay nominal, rejected and recovery sequences with a qualified software reference. Confirm functional flow and ownership without claiming deployment of flight software.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-10\",\"C-SE-10.1\",\"C-SE-10.2\",\"C-EPS-10\",\"C-EPS-10.1\",\"C-NE-01.1.2\",\"C-NE-02\"],\"source_lines\":[96,97,98,150,151,161,163]},{\"id\":\"FR-36\",\"title\":\"Target integration assessment\",\"text\":\"The framework shall retain a versioned OBC, operating-system, flight-framework and toolchain configuration with compatibility evidence and processor, memory, timing and power budget evidence for EPS functions.\",\"mission_need_ids\":[\"MN-08\",\"MN-05\"],\"mission_requirement_ids\":[\"MR-08\",\"MR-05\"],\"logical_capability_ids\":[\"L03\",\"L04\",\"L05\"],\"verification_method\":\"I,A,T\",\"proposed_acceptance\":\"Inspect a build/deployment profile and reference resource records. Distinguish measurements, estimates and unknown target compatibility. Check against mission-supplied allocations when available.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-NE-02\",\"C-NE-02.4\",\"C-NE-02.4.1\",\"C-NE-02.4.2\",\"C-NE-02.5\",\"C-NE-02.5.1\",\"C-NE-02.5.2\"],\"source_lines\":[163,168,169,170,171,172,173]},{\"id\":\"FR-37\",\"title\":\"Readable design views\",\"text\":\"The framework shall produce filtered context, structure, interface and selected-design views from controlled EPS records with identifiers, units, legends and links to the represented baseline.\",\"mission_need_ids\":[\"MN-10\"],\"mission_requirement_ids\":[\"MR-10\"],\"logical_capability_ids\":[\"L09\"],\"verification_method\":\"I,D\",\"proposed_acceptance\":\"Compare generated views with a fixture model and apply a declared reviewer task checklist. Assess correctness and readability without proliferating requirement, measure, scenario or state diagrams.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-02\",\"C-SE-02.1\",\"C-EPS-11\",\"C-EPS-11.1\"],\"source_lines\":[51,52,152,153]},{\"id\":\"FR-38\",\"title\":\"Review package\",\"text\":\"The framework shall assemble the designated requirement, decision, design, evidence, assumptions, uncertainty, validity limits, findings and dispositions into a baseline-linked review package.\",\"mission_need_ids\":[\"MN-10\",\"MN-02\"],\"mission_requirement_ids\":[\"MR-10\",\"MR-02\"],\"logical_capability_ids\":[\"L09\",\"L02\",\"L08\"],\"verification_method\":\"I,D\",\"proposed_acceptance\":\"An independent reviewer locates the designated claims and evidence and records findings and outcomes. Keep author status, reviewer outcome and approval authority distinct.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-SE-02\",\"C-SE-02.1\",\"C-EPS-11\",\"C-EPS-11.1\"],\"source_lines\":[51,52,152,153]},{\"id\":\"FR-39\",\"title\":\"Minimum adoption and measurement package\",\"text\":\"The framework shall declare prerequisites, resource footprint, licenses, dependencies and learning instructions for its minimum workflow and record adoption, adaptation, change, reproduction and direct-cost observations under one evaluation protocol.\",\"mission_need_ids\":[\"MN-11\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-11\",\"MR-09\"],\"logical_capability_ids\":[\"L09\",\"L01\",\"L08\"],\"verification_method\":\"I,D\",\"proposed_acceptance\":\"Demonstrate the minimum workflow from a clean declared environment. Record wall-clock time separately from active person-hours and state the cost period and inclusions. Unknown cost stays unknown.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-01\",\"C-PM-01.2\",\"C-PM-05\",\"C-SE-01.1\",\"C-SE-01.1.1\",\"C-EPS-02.1\",\"C-NE-02.4\",\"C-NE-02.4.1\",\"C-NE-02.4.2\"],\"source_lines\":[31,33,42,49,50,111,168,169,170]},{\"id\":\"FR-40\",\"title\":\"Contrasting-case reuse\",\"text\":\"The framework shall apply an identified common core to two predefined contrasting EPS cases using declared parameters, mappings and extensions and retain case outcomes and any core changes.\",\"mission_need_ids\":[\"MN-11\"],\"mission_requirement_ids\":[\"MR-11\"],\"logical_capability_ids\":[\"L09\",\"L01\",\"L08\"],\"verification_method\":\"I,D,T\",\"proposed_acceptance\":\"Complete the same declared workflow in both cases without undeclared or post hoc core changes. If the core changes, rebaseline and rerun both cases before a reuse claim. No implementation or successful outcome is asserted here.\",\"status\":\"proposed, verification pending\",\"source_concern_ids\":[\"C-PM-05\"],\"source_lines\":[42]}],\"mission_needs\":[{\"id\":\"MN-01\",\"title\":\"Write and maintain verifiable requirements\",\"text\":\"Enable engineers to learn requirement writing and maintain sourced, verifiable requirements with reusable templates and verification criteria.\",\"mission_requirement_id\":\"MR-01\",\"mission_requirement\":\"The EPS engineering enterprise shall produce reviewable framework-supported EPS and component requirements whose source, observable quantities or conditions, verification method, criterion, and unresolved decisions are explicit.\",\"moe_id\":\"MOE-01\",\"moe\":\"Requirement authoring and update effort (person-hours). Report defects found by a qualified reviewer and completeness against the declared requirement record schema.\",\"framework_requirement_ids\":[\"FR-01\",\"FR-02\",\"FR-03\",\"FR-17\"]},{\"id\":\"MN-02\",\"title\":\"Maintain a consistent evidence chain through changes\",\"text\":\"Keep needs, requirements, design decisions, subsystem allocations, models, software interfaces, and verification evidence consistent as EPS and other subsystem designs change.\",\"mission_requirement_id\":\"MR-02\",\"mission_requirement\":\"The enterprise shall identify the affected evidence for each designated change and issue a successor baseline with regenerated or explicitly stale evidence and retained discrepancy status.\",\"moe_id\":\"MOE-02\",\"moe\":\"Correct change turnaround (elapsed hours) and active effort. On a blinded reference set report TP, FP, FN and affected-artifact accuracy against a qualified reviewer. Faster incomplete changes receive no comparative credit.\",\"framework_requirement_ids\":[\"FR-04\",\"FR-05\",\"FR-06\",\"FR-07\",\"FR-08\",\"FR-09\",\"FR-11\"]},{\"id\":\"MN-03\",\"title\":\"Maintain candidate BOMs and financial estimates\",\"text\":\"Maintain bills of materials and cost estimates across EPS candidate architectures and controlled design changes.\",\"mission_requirement_id\":\"MR-03\",\"mission_requirement\":\"The enterprise shall obtain a revision-linked BOM and financial estimate for each designated EPS candidate, with sourced prices, quantities, assumptions, uncertainty, and missing cost data visible.\",\"moe_id\":\"MOE-03\",\"moe\":\"BOM and cost update effort (person-hours). Report differences from a reference BOM and estimate, missing priced items, and estimate uncertainty. This is separate from framework operating cost.\",\"framework_requirement_ids\":[\"FR-12\",\"FR-13\",\"FR-14\"]},{\"id\":\"MN-04\",\"title\":\"Expose early EPS design and interaction problems\",\"text\":\"Assess dynamic mission loads, energy shortages, thermal and EMC concerns, subsystem interactions, component choices, and controller constraints before hardware fabrication.\",\"mission_requirement_id\":\"MR-04\",\"mission_requirement\":\"The enterprise shall justify designated early EPS decisions using time-dependent mission and component analyses with explicit interface conditions, applicable constraints, and unsupported checks visible.\",\"moe_id\":\"MOE-04\",\"moe\":\"Coverage of decision-relevant checks and known issues found in reference fixtures. Report analysis turnaround and effort. Physical EPS defect reduction remains an empirical outcome outside framework acceptance.\",\"framework_requirement_ids\":[\"FR-15\",\"FR-16\",\"FR-17\",\"FR-18\",\"FR-19\"]},{\"id\":\"MN-05\",\"title\":\"Establish model and policy credibility\",\"text\":\"Use EPS and battery models with documented calibration, validity domains, electrothermal and aging assumptions, uncertainty, and evidence appropriate to the intended decision.\",\"mission_requirement_id\":\"MR-05\",\"mission_requirement\":\"The enterprise shall distinguish predictions supported within a documented model validity domain from extrapolation and shall distinguish a predicted control-policy benefit from a demonstrated hardware benefit.\",\"moe_id\":\"MOE-05\",\"moe\":\"Intended decisions covered by applicable model evidence. Report voltage, temperature, energy, health or lifetime residuals in their own units, uncertainty, runtime, and parameter-update delay. Limits require agreement for each intended use.\",\"framework_requirement_ids\":[\"FR-20\",\"FR-21\",\"FR-22\",\"FR-23\",\"FR-24\",\"FR-25\"]},{\"id\":\"MN-06\",\"title\":\"Support RAM requirement coverage and analysis\",\"text\":\"Identify RAM variables in requirements and generate reusable RAM analysis models from the evolving EPS and spacecraft design.\",\"mission_requirement_id\":\"MR-06\",\"mission_requirement\":\"The enterprise shall relate designated RAM claims to requirements, design failure dependencies, generated analysis models, input assumptions, and verification evidence or explicit gaps.\",\"moe_id\":\"MOE-06\",\"moe\":\"RAM model preparation effort and coverage of the declared failure and requirement set. Report model generation differences from an expert reference. No framework verdict establishes achieved spacecraft RAM.\",\"framework_requirement_ids\":[\"FR-26\",\"FR-27\"]},{\"id\":\"MN-07\",\"title\":\"Prepare feasible, safe and informative verification\",\"text\":\"Define EPS and component verification activities with usable procedures, conditions, equipment and DUT interfaces, safety information, observable variables, and valid synchronized telemetry.\",\"mission_requirement_id\":\"MR-07\",\"mission_requirement\":\"The enterprise shall provide a reviewable verification proposal and evidence contract for each designated activity, with feasibility and safety decisions reserved to the responsible engineers and testing facility.\",\"moe_id\":\"MOE-07\",\"moe\":\"Proposal preparation and technician clarification effort. Report missing proposal fields, evidence completeness, invalid samples, and synchronization uncertainty. Physical fault limits and timing tolerances require facility agreement.\",\"framework_requirement_ids\":[\"FR-28\",\"FR-29\",\"FR-30\",\"FR-31\",\"FR-32\"]},{\"id\":\"MN-08\",\"title\":\"Engineer consistent EPS flight and ground software integration\",\"text\":\"Keep command, telemetry, event, parameter, mode and recovery definitions consistent with EPS hardware and support cFS and F-Prime mappings and target resource assessment.\",\"mission_requirement_id\":\"MR-08\",\"mission_requirement\":\"The enterprise shall produce revision-linked EPS software integration contracts, framework-specific mappings, command and mode checks, and processor, memory, timing and power evidence for the declared target configuration.\",\"moe_id\":\"MOE-08\",\"moe\":\"Interface discrepancy detection and integration effort on common reference fixtures. Report dictionary and behavior coverage, configuration compatibility status, and target resource estimates or measurements. Unverified target deployment stays explicit.\",\"framework_requirement_ids\":[\"FR-33\",\"FR-34\",\"FR-35\",\"FR-36\"]},{\"id\":\"MN-09\",\"title\":\"Reproduce and reuse evidence for analysis and troubleshooting\",\"text\":\"Enable independent reproduction and reuse of early EPS analysis and later supplied measurements without losing configuration or validity context.\",\"mission_requirement_id\":\"MR-09\",\"mission_requirement\":\"The enterprise shall permit an independent participant to reconstruct each designated analysis from its controlled baseline and evaluate agreement using result-specific comparison rules fixed before execution.\",\"moe_id\":\"MOE-09\",\"moe\":\"Successful designated reproductions / attempted designated reproductions, independent active effort, and reconstruction gaps. Agreement limits are result-specific. Reduced use of physical replicas is a future hypothesis.\",\"framework_requirement_ids\":[\"FR-07\",\"FR-08\",\"FR-09\",\"FR-10\",\"FR-21\",\"FR-22\",\"FR-31\",\"FR-32\"]},{\"id\":\"MN-10\",\"title\":\"Communicate designs and justification clearly\",\"text\":\"Provide readable design views and requirement-to-design-to-evidence reviews with visible assumptions, limitations, and finding dispositions.\",\"mission_requirement_id\":\"MR-10\",\"mission_requirement\":\"The enterprise shall provide a controlled review package from which a reviewer can locate the designated design, decision rationale, applicable evidence, and unresolved findings.\",\"moe_id\":\"MOE-10\",\"moe\":\"Review preparation effort and reviewer task completion, interpretation accuracy, and clarification effort on a fixed task set. Readability needs a reviewer protocol, not an invented visual score.\",\"framework_requirement_ids\":[\"FR-37\",\"FR-38\"]},{\"id\":\"MN-11\",\"title\":\"Adopt and reuse the framework within team resources\",\"text\":\"Provide a declared minimum environment, learning path and reusable core suitable for contrasting EPS contexts, with adoption, adaptation and direct operating burdens visible.\",\"mission_requirement_id\":\"MR-11\",\"mission_requirement\":\"The enterprise shall complete the declared reference workflow in two contrasting EPS cases using an identified common core, declared case adaptations, and independently reconstructable environment instructions.\",\"moe_id\":\"MOE-11\",\"moe\":\"Adoption and case adaptation effort (active person-hours), direct framework cost (CAD over a declared period), and case completion status. Report required computing, licenses and services. Resource ceilings require stakeholder agreement.\",\"framework_requirement_ids\":[\"FR-02\",\"FR-03\",\"FR-39\",\"FR-40\"]}],\"interface_source\":\"/tmp/eps-oosem.wmUVTQ/concerns/baseline-addendum.md Sec. 8\",\"verification_source\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases\"},\"resource_declarations\":[{\"id\":\"COM-H01\",\"role\":\"Participant/client and Excel execution host\",\"declaration\":\"IME/Excel/add-in versions, OS compatibility, workbook settings/macros/external links and license access. Source of editable workbook before released capture. No resource size or cost estimate.\",\"components\":[\"COM-S02\",\"COM-S03\",\"COM-S04\",\"COM-D11\"],\"status\":\"selected platform and footprint unverified\"},{\"id\":\"COM-H02\",\"role\":\"COMET working-model server/storage\",\"declaration\":\"COMET server/database versions, users/domain owner mapping, reference data, native export completeness, network access, backup and selected deployment. Working store is not final evidence authority.\",\"components\":[\"COM-S01\",\"COM-D01\",\"COM-D02\",\"COM-D03\",\"COM-D04\"],\"status\":\"deployment and release/export semantics unverified\"},{\"id\":\"COM-H03\",\"role\":\"Assurance/adapter module execution and accepted artifact custody\",\"declaration\":\"One proposed Python process/module environment and controlled repository/artifact store. Pinned interpreter/libraries, source revisions, access policy, manifest digests and tool-service credentials handled outside retained public packages. Can share physical equipment with H01/H02 without changing authority.\",\"components\":[\"COM-S05\",\"COM-S06\",\"COM-S07\",\"COM-S08\",\"COM-S09\",\"COM-S10\",\"COM-S11\",\"COM-S12\",\"COM-D01\",\"COM-D02\",\"COM-D03\",\"COM-D04\",\"COM-D05\",\"COM-D06\",\"COM-D07\",\"COM-D08\",\"COM-D09\",\"COM-S13\",\"COM-S14\",\"COM-S15\",\"COM-S16\",\"COM-S17\",\"COM-S18\",\"COM-D10\",\"COM-D11\",\"COM-D12\",\"COM-D13\",\"COM-D14\",\"COM-D15\",\"COM-D16\",\"COM-D17\",\"COM-D18\"],\"status\":\"modules/storage/footprint unimplemented and unmeasured\"},{\"id\":\"COM-H04\",\"role\":\"Network and backup/recovery resource\",\"declaration\":\"Transfer access, backup destination, retained baseline policy, consistency checks and restore procedure. A distinct logical backup declaration does not imply a new hardware purchase.\",\"components\":[\"COM-S12\",\"COM-D07\",\"COM-D08\",\"COM-D18\"],\"status\":\"recovery not demonstrated\"}],\"dependency_declarations\":[{\"id\":\"COM-DEP-01\",\"name\":\"COMET server, IME, add-in and ECSS reference configuration\",\"placement\":\"integrated declared platform dependency on H01/H02\",\"interfaces\":[\"IF-01\"],\"evidence\":[\"COM-E01\",\"COM-E02\",\"COM-E03\",\"COM-E04\"],\"required_checks\":\"Select release, license/dependencies/platforms, supported exchange, ownership enforcement, export completeness and client synchronization. OCDT API excluded.\",\"status\":\"reported lineage, current deployment unknown\"},{\"id\":\"COM-DEP-02\",\"name\":\"Microsoft Excel\",\"placement\":\"integrated dependency COM-S03 on H01\",\"interfaces\":[\"IF-01\",\"IF-06\"],\"evidence\":[\"COM-E01\"],\"required_checks\":\"License/access/version, workbook external links/calculation settings/macros and independent reconstruction.\",\"status\":\"reported lineage, selected environment unverified\"},{\"id\":\"COM-DEP-03\",\"name\":\"Proposed Python module runtime\",\"placement\":\"integrated runner dependency on H03\",\"interfaces\":[],\"evidence\":[],\"required_checks\":\"Pin interpreter/module versions and schema/quantity/time processing libraries. No package or performance assumed validated.\",\"status\":\"proposed\"},{\"id\":\"COM-DEP-04\",\"name\":\"Git and retained artifact storage\",\"placement\":\"integrated companion custody dependency COM-S12 on H03/H04\",\"interfaces\":[\"IF-06\"],\"evidence\":[],\"required_checks\":\"Field authority, content digests, source revisions, retention/access protection, export/restore and artifact availability.\",\"status\":\"proposed\"},{\"id\":\"COM-DEP-05\",\"name\":\"Specialist discipline and calibration services\",\"placement\":\"external controlled services under IF-03. Operator/supplier execution hosts named per D13 profile, outside core inventory\",\"interfaces\":[\"IF-03\"],\"evidence\":[],\"required_checks\":\"Declare electrical/thermal/EMC/CAD/orbit/battery/controller/calibration/RAM product/version, supported behavior, request/result and frame/unit/clock contracts, residual unsupported checks, raw artifacts, environment and repeatability access.\",\"status\":\"products, checked profiles and physical hosts unresolved\"},{\"id\":\"COM-DEP-06\",\"name\":\"cFS/F-Prime build, reference software and resource assessment services\",\"placement\":\"external controlled IF-04 services, target/build hosts named per D12-D13. Flight/ground software and OBC are engineered artifacts/resources\",\"interfaces\":[\"IF-04\"],\"evidence\":[],\"required_checks\":\"Pin framework/OBC/OS/toolchain, typed and bus profile mappings, contract test interface and supplied measured/estimated resource records. No full software generation or flight operation.\",\"status\":\"profiles and target configuration unresolved\"},{\"id\":\"COM-DEP-07\",\"name\":\"Facility technician disposition and supplied observations\",\"placement\":\"external IF-05 authority/data source. Facility owns instruments, protections and physical execution\",\"interfaces\":[\"IF-05\"],\"evidence\":[],\"required_checks\":\"Proposal/setup identities, calibration/timing/quality metadata, responsible safety status and controlled data import. No live/hazardous execution within core.\",\"status\":\"facility-specific contract and approval pending\"}],\"interface_realizations\":[{\"id\":\"IF-01\",\"name\":\"Engineering use\",\"physical_component_ids\":[\"COM-S02\",\"COM-S03\",\"COM-S13\",\"COM-S14\",\"COM-S11\"],\"node_ids\":[\"COM-N1\",\"COM-N2\",\"COM-N3\"],\"contract_owner_and_failure_rule\":\"Engineering roles submit identified requirement/design/decision records and receive guidance, impact, budgets and reviews. Owners review proposed changes. Invalid records remain findings, not accepted updates.\",\"status\":\"proposed interface realization, verification pending\"},{\"id\":\"IF-02\",\"name\":\"Source knowledge and components\",\"physical_component_ids\":[\"COM-D03\",\"COM-D17\",\"COM-S15\",\"COM-P02\",\"COM-P08\"],\"node_ids\":[\"COM-N2\",\"COM-N3\"],\"contract_owner_and_failure_rule\":\"Source owners/operators supply versioned datasheets, quotes, methods and limits. Profiles retain producer/source identity and unknowns. Supplier truth and qualification stay external.\",\"status\":\"proposed interface realization, verification pending\"},{\"id\":\"IF-03\",\"name\":\"Discipline execution\",\"physical_component_ids\":[\"COM-S07\",\"COM-S08\",\"COM-S16\",\"COM-S17\",\"COM-S15\",\"COM-D13\"],\"node_ids\":[\"COM-N4\",\"COM-N3\"],\"contract_owner_and_failure_rule\":\"Framework adapters coordinate external specialist services. Typed frozen inputs return raw outputs, environment/runtime/limitations. Rejected mappings or unsupported checks remain open. No default solver chosen.\",\"status\":\"proposed interface realization, verification pending\"},{\"id\":\"IF-04\",\"name\":\"EPS software engineering\",\"physical_component_ids\":[\"COM-S09\",\"COM-S16\",\"COM-S15\",\"COM-D12\",\"COM-D13\"],\"node_ids\":[\"COM-N4\",\"COM-N3\"],\"contract_owner_and_failure_rule\":\"Shared contract/version/profile inputs return checked cFS/F-Prime projections, sequence/build/resource findings. Unsupported behavior and target compatibility remain explicit. Mission implementation is external engineered work.\",\"status\":\"proposed interface realization, verification pending\"},{\"id\":\"IF-05\",\"name\":\"Facility planning and supplied evidence\",\"physical_component_ids\":[\"COM-S18\",\"COM-S11\",\"COM-S10\",\"COM-S17\",\"COM-D16\",\"COM-P06\"],\"node_ids\":[\"COM-N1\",\"COM-N3\",\"COM-N4\"],\"contract_owner_and_failure_rule\":\"Baseline-linked proposals receive technician/safety disposition and supplied observations. The core validates readiness and data quality. Missing safety fields block handoff. The facility alone authorizes and executes physical work.\",\"status\":\"proposed interface realization, verification pending\"},{\"id\":\"IF-06\",\"name\":\"Independent review and evaluation\",\"physical_component_ids\":[\"COM-S11\",\"COM-S15\",\"COM-S16\",\"COM-D07\",\"COM-D18\",\"COM-P07\"],\"node_ids\":[\"COM-N1\",\"COM-N3\",\"COM-N4\"],\"contract_owner_and_failure_rule\":\"Named review/replay tasks yield reconstructable packages, replay findings and correctness/effort/cost observations. Failed dependency access and inconclusive results are retained. Reviewer authority and project assessment stay separate.\",\"status\":\"proposed interface realization, verification pending\"}],\"common_logical_realization_map\":[{\"logical_component_id\":\"L01\",\"name\":\"Engineering guidance and knowledge\",\"candidate_node_ids\":[\"COM-N1\",\"COM-N3\"],\"physical_component_ids\":[\"COM-D17\",\"COM-S13\",\"COM-P01\",\"COM-P08\"],\"control_and_data_placement\":\"Sourced methods/examples in D17, queried through IME/review packages. Framework maintainer reviews lessons. No standard compliance is inferred.\",\"procedure_performers\":{\"COM-P01\":[\"Systems engineer\",\"Participant acting in declared engineering role\"],\"COM-P08\":[\"Systems engineer\",\"EPS engineer\",\"Technician for supplied facility constraints\"]},\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"status\":\"design coverage only, no verified eligibility\"},{\"logical_component_id\":\"L02\",\"name\":\"Needs, requirements and decision governance\",\"candidate_node_ids\":[\"COM-N2\",\"COM-N3\"],\"physical_component_ids\":[\"COM-S01\",\"COM-S02\",\"COM-D04\",\"COM-D10\",\"COM-S13\",\"COM-S14\",\"COM-P03\",\"COM-P04\"],\"control_and_data_placement\":\"Native study requirements and owned parameter changes join typed decision/trace extensions. Systems engineer coordinates human dispositions. S14 scopes impact, never silently accepts it.\",\"procedure_performers\":{\"COM-P03\":[\"Systems engineer\",\"EPS/non-EPS domain owners\"],\"COM-P04\":[\"Framework maintainer\",\"Designated domain reviewer\"]},\"execution_host_ids\":[\"COM-H01\",\"COM-H02\",\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"status\":\"design coverage only, no verified eligibility\"},{\"logical_component_id\":\"L03\",\"name\":\"Architecture and service contracts\",\"candidate_node_ids\":[\"COM-N2\",\"COM-N3\",\"COM-N4\"],\"physical_component_ids\":[\"COM-D01\",\"COM-D02\",\"COM-D04\",\"COM-D12\",\"COM-S05\",\"COM-S09\",\"COM-P05\"],\"control_and_data_placement\":\"COMET owns supported equipment/category/state fields. D12 owns rich functions/allocations/interfaces/transitions and one software contract. Explicit field maps and adapters preserve joins.\",\"procedure_performers\":{\"COM-P05\":[\"EPS engineer\",\"Qualified analysis or flight/ground software specialist\"]},\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"status\":\"design coverage only, no verified eligibility\"},{\"logical_component_id\":\"L04\",\"name\":\"Component and lifecycle characterization\",\"candidate_node_ids\":[\"COM-N2\",\"COM-N4\",\"COM-N3\"],\"physical_component_ids\":[\"COM-D03\",\"COM-D04\",\"COM-D11\",\"COM-D15\",\"COM-S03\",\"COM-S04\",\"COM-S08\",\"COM-P02\",\"COM-P10\"],\"control_and_data_placement\":\"Catalogue and selected occurrences feed Excel BOM/cost/derivation sheets and RAM input records. EPS engineer owns component meaning, project manager prices, RAM reviewer dependencies.\",\"procedure_performers\":{\"COM-P02\":[\"EPS engineer\",\"Project manager\"],\"COM-P10\":[\"Systems engineer\",\"Qualified RAM reviewer\"]},\"execution_host_ids\":[\"COM-H01\",\"COM-H03\"],\"storage_host_ids\":[\"COM-H01\",\"COM-H02\",\"COM-H03\"],\"status\":\"design coverage only, no verified eligibility\"},{\"logical_component_id\":\"L05\",\"name\":\"Scenario and analysis orchestration\",\"candidate_node_ids\":[\"COM-N4\",\"COM-N3\"],\"physical_component_ids\":[\"COM-S03\",\"COM-S04\",\"COM-S07\",\"COM-S08\",\"COM-S09\",\"COM-S16\",\"COM-D11\",\"COM-D13\",\"COM-D07\",\"COM-P05\",\"COM-P07\"],\"control_and_data_placement\":\"Excel executes budget arithmetic. S16 assembles time-indexed requests and external-service runs from frozen profiles. Returned results and replay logs enter released bundles. No live flight actuation.\",\"procedure_performers\":{\"COM-P05\":[\"EPS engineer\",\"Qualified analysis or flight/ground software specialist\"],\"COM-P07\":[\"Independent reproducer/reviewer\",\"Framework evaluator\"]},\"execution_host_ids\":[\"COM-H01\",\"COM-H03\"],\"storage_host_ids\":[\"COM-H01\",\"COM-H03\"],\"status\":\"design coverage only, no verified eligibility\"},{\"logical_component_id\":\"L06\",\"name\":\"Model credibility and observation reconciliation\",\"candidate_node_ids\":[\"COM-N4\",\"COM-N3\"],\"physical_component_ids\":[\"COM-S10\",\"COM-S17\",\"COM-D06\",\"COM-D14\",\"COM-D07\",\"COM-P09\"],\"control_and_data_placement\":\"Quality/time-aligned observations and named calibration results produce residuals, applicability and parameter proposals. Qualified reviewers accept validity scope. Prior parameters and raw observations remain retained.\",\"procedure_performers\":{\"COM-P09\":[\"EPS engineer\",\"Qualified modeling reviewer\"]},\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"status\":\"design coverage only, no verified eligibility\"},{\"logical_component_id\":\"L07\",\"name\":\"Verification specification and safety\",\"candidate_node_ids\":[\"COM-N3\",\"COM-N1\"],\"physical_component_ids\":[\"COM-S13\",\"COM-S18\",\"COM-D16\",\"COM-S11\",\"COM-P06\",\"COM-P08\"],\"control_and_data_placement\":\"Method-specific activity records and safety gates produce readable proposals and scoped evidence verdicts. The external facility owns safety permission and physical execution.\",\"procedure_performers\":{\"COM-P06\":[\"EPS engineer\",\"Testing facility technician or qualified proxy\"],\"COM-P08\":[\"Systems engineer\",\"EPS engineer\",\"Technician for supplied facility constraints\"]},\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"status\":\"design coverage only, no verified eligibility\"},{\"logical_component_id\":\"L08\",\"name\":\"Information and configuration authority\",\"candidate_node_ids\":[\"COM-N3\",\"COM-N2\"],\"physical_component_ids\":[\"COM-S05\",\"COM-S12\",\"COM-S15\",\"COM-D01\",\"COM-D07\",\"COM-D08\",\"COM-P04\"],\"control_and_data_placement\":\"S15 binds exact native/companion revisions and validates transfers. S12 retains accepted manifests/artifacts and rejected findings. Human authority controls releases. Native working stores do not compete with custody.\",\"procedure_performers\":{\"COM-P04\":[\"Framework maintainer\",\"Designated domain reviewer\"]},\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"status\":\"design coverage only, no verified eligibility\"},{\"logical_component_id\":\"L09\",\"name\":\"Case workspace and technical review\",\"candidate_node_ids\":[\"COM-N1\",\"COM-N2\",\"COM-N3\"],\"physical_component_ids\":[\"COM-S02\",\"COM-S03\",\"COM-S11\",\"COM-D04\",\"COM-D08\",\"COM-D18\",\"COM-P01\",\"COM-P03\",\"COM-P07\"],\"control_and_data_placement\":\"IME/Excel remain primary study interaction. Derived packages expose scope, traces, findings and costs. D18 records core/case/evaluation context. Reviewers record outcomes without implied approval.\",\"procedure_performers\":{\"COM-P01\":[\"Systems engineer\",\"Participant acting in declared engineering role\"],\"COM-P03\":[\"Systems engineer\",\"EPS/non-EPS domain owners\"],\"COM-P07\":[\"Independent reproducer/reviewer\",\"Framework evaluator\"]},\"execution_host_ids\":[\"COM-H01\",\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"status\":\"design coverage only, no verified eligibility\"}],\"domain_field_authorities\":[{\"fields\":\"COMET-supported requirement and study fields, selected occurrences and quantities\",\"working_authority\":\"COM-D04\",\"rule\":\"D10 contains only unsupported extensions or typed references. Field mapping chooses one authoring source before exchange.\"},{\"fields\":\"Component/type and datasheet/source identity\",\"working_authority\":\"COM-D03\",\"rule\":\"Occurrences and selections reference catalogue definitions. D11 cost references do not duplicate editable catalogue prices.\"},{\"fields\":\"Dated prices, financial assumptions, BOM/cost and derivation workbook formulas\",\"working_authority\":\"COM-D11\",\"rule\":\"Catalogue/study records reference workbook price/estimate revisions. Project manager owns financial assumptions. BOM occurrences derive from D04.\"},{\"fields\":\"Rich function/allocation/interface/transition and common software definitions\",\"working_authority\":\"COM-D12\",\"rule\":\"Only fields absent from the native schema are authored here. Native equipment/state fields are referenced, not copied as competing masters.\"},{\"fields\":\"Scenario and external-service exchange settings\",\"working_authority\":\"COM-D13\",\"rule\":\"Requests bind exact registered model and source versions. External tool artifacts retain their native authoring source.\"},{\"fields\":\"Model applicability, calibration proposals and observation assessments\",\"working_authority\":\"COM-D14\",\"rule\":\"Parameter updates remain proposals until owner disposition. Raw observations and prior versions remain retained.\"},{\"fields\":\"RAM mappings and verification/facility/safety specifications\",\"working_authority\":\"COM-D15 and COM-D16 respectively\",\"rule\":\"Container D05 owns no duplicate facts. Safety permission and physical work remain external.\"},{\"fields\":\"Accepted revision identity and evidence custody\",\"working_authority\":\"COM-D08 and COM-D07 manifests through COM-S15/COM-S12\",\"rule\":\"Released snapshots reference exact domain/native artifacts. Custody is distinct from domain meaning and editable authoring.\"}],\"candidate_local_ids_rule\":\"COM-L01..COM-L10 retain their original candidate-local meaning. They are not common L01..L09. The common realization map and review-decisions mapping govern current allocations.\",\"allocation_status\":\"Every reviewed leaf has a specific intended realization and implementation gap. This is architectural design coverage, not implemented eligibility, satisfaction or measured performance.\",\"review_open_issues\":[\"The selected COMET release and complete export/import/ownership/snapshot behavior remain unresolved. Source-native ownership is not enforcement proof.\",\"The category/template/state bridge does not supply rich EPS behavior or software semantics. Companion contracts and mappings need development without duplicate field masters.\",\"Specialist service products, host configurations and checked electrical/thermal/EMC/CAD/orbit/battery/controller/calibration/RAM profiles are unselected. Their explicit development gaps remain part of design coverage.\",\"Excel licenses, workbook dependencies, external-service availability and clean reconstruction are unverified.\",\"Calibration/validation data, purpose-specific error rules, facility-approved limits and actual target software/resource profiles remain unresolved.\",\"Generic container IDs and narrowly added record/module IDs have a containment relationship, not duplicated field authority. No extra server or microservice is implied.\",\"No implementation or empirical framework verdict is present. All V01..V40 are planned. No candidate preference is inferred.\"]}"; status = "proposed comparison description, not implemented or verified"; }
