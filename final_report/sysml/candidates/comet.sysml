#intendedRealization allocation allocate_FR_06_COM_S14 allocate FrameworkRequirements::FR_06 to physical.COM_S14;
@PhysicalRecord { identifier = "allocate_FR_06_COM_S14"; recordJSON = "{\"requirement_id\":\"FR-06\",\"title\":\"Change disposition\",\"requirement_text\":\"The framework shall issue a successor baseline for an accepted change that retains its request and failed-gate context and marks affected evidence as regenerated, stale, or unresolved.\",\"logical_component_ids\":[\"L02\",\"L08\"],\"physical_component_ids\":[\"COM-S14\",\"COM-S15\",\"COM-S12\",\"COM-D10\",\"COM-D08\",\"COM-D07\",\"COM-P04\"],\"realization_mechanism\":\"An accepted change disposition binds its request and failed-gate evidence to a new manifest. S14 marks each affected evidence reference regenerated, stale or unresolved. S15 retains the prior native snapshot and companion revisions.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"native editable synchronization only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E01\"],\"source_locators\":[{\"evidence_id\":\"COM-E01\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[3],\"section\":\"3.2\",\"source_maturity\":\"Reported platform configuration\",\"allocation_evidence_role\":\"native editable synchronization only\"}],\"verification_id\":\"V06\",\"verification_method\":\"T\",\"verification_fixture_observation\":\"Exercise a failed verification gate followed by correction. Preserve the prior baseline and prevent stale results from appearing current.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-06\",\"implementation_gap\":\"Acceptance guards, immutable snapshot retention and stale/regenerated status transitions need implementation.\",\"boundary_authority_note\":\"Human acceptance precedes successor release. A changed criterion cannot retroactively pass a failed result.\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-07\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P04\":[\"Framework maintainer\",\"Designated domain reviewer\"]}}"; status = "proposed comparison description, not implemented or verified"; }
