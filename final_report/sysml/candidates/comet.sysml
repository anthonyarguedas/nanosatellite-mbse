@PhysicalRecord { identifier = "allocate_FR_25_COM_S10"; recordJSON = "{\"requirement_id\":\"FR-25\",\"title\":\"Anomaly assessment\",\"requirement_text\":\"The framework shall compare time-correlated EPS telemetry with modeled expected behavior while retaining operating mode, model validity, degradation and sensor uncertainty, and alternative fault explanations.\",\"logical_component_ids\":[\"L06\"],\"physical_component_ids\":[\"COM-S10\",\"COM-S17\",\"COM-D12\",\"COM-D14\",\"COM-D07\",\"COM-P09\"],\"realization_mechanism\":\"S10 preserves valid time-correlated channels and operating/active-unit context. S17 applies declared residual/error rules to expected versus observed behavior, retaining degradation/noise/fault hypotheses and expert-reference TP/FP/FN observations.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"project proposal only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V25\",\"verification_method\":\"A,T\",\"verification_fixture_observation\":\"Use nominal, degrading, noisy and injected-fault fixtures. Retain residuals and diagnoses with TP, FP and FN against an expert reference. No pre-threshold detection capability is presumed.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-25\",\"implementation_gap\":\"Model predictions, observation alignment and expert-labeled anomaly fixtures require development.\",\"boundary_authority_note\":\"A residual is not a confirmed fault. Pre-threshold detection performance remains unmeasured.\",\"mission_need_ids\":[\"MN-05\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-04\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P09\":[\"EPS engineer\",\"Qualified modeling reviewer\"]}}"; status = "proposed comparison description, not implemented or verified"; }
