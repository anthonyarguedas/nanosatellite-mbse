@PhysicalRecord { identifier = "allocate_FR_34_COM_S09"; recordJSON = "{\"requirement_id\":\"FR-34\",\"title\":\"Flight framework mapping\",\"requirement_text\":\"The framework shall produce or coordinate checked mappings of the EPS software contract to declared cFS software-bus and F-Prime typed-connection profiles and identify behavior and implementation gaps.\",\"logical_component_ids\":[\"L03\",\"L05\"],\"physical_component_ids\":[\"COM-S09\",\"COM-S16\",\"COM-D12\",\"COM-D13\",\"COM-D07\",\"COM-P05\"],\"realization_mechanism\":\"Two named S09 mapping profiles project the same service contract to cFS software-bus messages and F-Prime typed ports/connections. Export/round-trip fixtures record framework versions, unmapped fields and behavior gaps, then coordinate external reference-build checks.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"project proposal only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V34\",\"verification_method\":\"D,T\",\"verification_fixture_observation\":\"Round-trip or validate reference message and port mappings in both profiles. Declare framework version and unsupported exports. Architecture or dictionary generation is distinct from mission-specific functionality.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-34\",\"implementation_gap\":\"Both profile rule sets and declared-version toolchain validation need development.\",\"boundary_authority_note\":\"No native COMET exporter or complete flight functionality is established. IF-04 build services are external controlled dependencies.\",\"mission_need_ids\":[\"MN-08\"],\"mission_requirement_ids\":[\"MR-08\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P05\":[\"EPS engineer\",\"Qualified analysis or flight/ground software specialist\"]}}"; status = "proposed comparison description, not implemented or verified"; }
