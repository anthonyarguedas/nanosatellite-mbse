#intendedRealization allocation allocate_FR_18_COM_S05 allocate FrameworkRequirements::FR_18 to physical.COM_S05;
@PhysicalRecord { identifier = "allocate_FR_18_COM_S05"; recordJSON = "{\"requirement_id\":\"FR-18\",\"title\":\"Discipline model integration\",\"requirement_text\":\"The framework shall exchange identified EPS component and design data with declared electrical, thermal, EMC and CAD analysis tools and retain model mappings, applicable outputs and unsupported checks.\",\"logical_component_ids\":[\"L03\",\"L05\",\"L08\"],\"physical_component_ids\":[\"COM-S05\",\"COM-S07\",\"COM-S15\",\"COM-D12\",\"COM-D13\",\"COM-D06\",\"COM-D07\",\"COM-P05\"],\"realization_mechanism\":\"The adapter profile records electrical, thermal, EMC and CAD endpoints, native artifact revisions, parameter/result mappings and unsupported checks. S15 validates the transfer. S07 submits a frozen service request or logs the operator-assisted exchange.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"Excel calculation and limited categorization basis only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E01\",\"COM-E03\"],\"source_locators\":[{\"evidence_id\":\"COM-E01\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[3],\"section\":\"3.2\",\"source_maturity\":\"Reported platform configuration\",\"allocation_evidence_role\":\"Excel calculation and limited categorization basis only\"},{\"evidence_id\":\"COM-E03\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[4,6],\"section\":\"4.1 and 7\",\"source_maturity\":\"Implemented categorization bridge\",\"allocation_evidence_role\":\"Excel calculation and limited categorization basis only\"}],\"verification_id\":\"V18\",\"verification_method\":\"D,T\",\"verification_fixture_observation\":\"Every electrical, thermal, EMC and CAD exchange pro