#intendedRealization allocation allocate_FR_02_COM_S02 allocate FrameworkRequirements::FR_02 to physical.COM_S02;
@PhysicalRecord { identifier = "allocate_FR_02_COM_S02"; recordJSON = "{\"requirement_id\":\"FR-02\",\"title\":\"Learning and templates\",\"requirement_text\":\"The framework shall provide requirement and traceability templates, worked EPS examples, and a guided reference workflow that covers writing criteria, linking evidence, and interpreting gaps.\",\"logical_component_ids\":[\"L01\",\"L09\"],\"physical_component_ids\":[\"COM-S02\",\"COM-S03\",\"COM-D02\",\"COM-D17\",\"COM-D18\",\"COM-P01\"],\"realization_mechanism\":\"A training Study Model, requirement/trace templates and worked Excel/COMET EPS tasks guide the clean-start workflow through criteria, evidence linking and gap interpretation. P01 records learner errors and reviewed corrections.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"reported tutorial pattern\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E08\",\"COM-E04\"],\"source_locators\":[{\"evidence_id\":\"COM-E08\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[2,5,6],\"section\":\"2.1, 2.2, 5, 6\",\"source_maturity\":\"Student pilot\",\"allocation_evidence_role\":\"reported tutorial pattern\"},{\"evidence_id\":\"COM-E04\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[4,5],\"section\":\"4.2 and first 4.2.1\",\"source_maturity\":\"Implemented tutorial architecture\",\"allocation_evidence_role\":\"reported tutorial pattern\"}],\"verification_id\":\"V02\",\"verification_method\":\"I,D\",\"verification_fixture_observation\":\"Inspect the learning package and demonstrate the workflow from a declared clean start. Measure learner effort and errors without imposing an unagreed time limit.\",\"verification_subject\":\"EPS engineering f