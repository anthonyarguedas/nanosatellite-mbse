@PhysicalRecord { identifier = "allocate_FR_22_COM_S17"; recordJSON = "{\"requirement_id\":\"FR-22\",\"title\":\"Model update workflow\",\"requirement_text\":\"The framework shall use supplied measurements to create an identified calibration or parameter-update record with data quality, prior and revised parameters, residuals and affected analyses.\",\"logical_component_ids\":[\"L06\",\"L04\",\"L02\"],\"physical_component_ids\":[\"COM-S17\",\"COM-S07\",\"COM-S14\",\"COM-D03\",\"COM-D14\",\"COM-D07\",\"COM-D10\",\"COM-P09\"],\"realization_mechanism\":\"A qualified calibration request binds supplied quality-checked measurements to a named method and fitting objective. S17 stores prior/revised parameters and residuals. S14 identifies affected catalogue/model uses and analyses before owner disposition.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"project proposal only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V22\",\"verification_method\":\"A,T\",\"verification_fixture_observation\":\"Apply a measurement fixture, compare the declared calibration result with a reference, retain both parameter revisions, and flag analyses affected by drift or update.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-22\",\"implementation_gap\":\"Calibration method/reference result, input-quality gate and impacted-use checks are unimplemented.\",\"boundary_authority_note\":\"Measurements propose a revision. They never automatically replace accepted component/model parameters.\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-09\"],\"execution_host_ids\