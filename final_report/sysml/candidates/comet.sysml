@PhysicalRecord { identifier = "FR-32"; recordJSON = "{\"requirement_id\":\"FR-32\",\"title\":\"Telemetry quality\",\"requirement_text\":\"The framework shall check expected telemetry channels, units, timestamps, completeness and sensor validity conditions and preserve raw samples, invalid values and processing masks.\",\"logical_component_ids\":[\"L06\",\"L08\"],\"physical_component_ids\":[\"COM-S10\",\"COM-S15\",\"COM-D12\",\"COM-D14\",\"COM-D07\",\"COM-P06\"],\"realization_mechanism\":\"S10 checks contract-declared channels, dimensions, timestamps and expected sampling against raw observation packages. Validity/active-unit masks preserve missing, inactive and invalid samples without replacing them by zero or treating them as measurements.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"project proposal only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V32\",\"verification_method\":\"T\",\"verification_fixture_observation\":\"Inject missing samples, inactive sensors and invalid values. Do not treat inactive invalid readings as valid measurements. Match the fixture quality verdict and retained raw data.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-32\",\"implementation_gap\":\"Channel completeness/validity checks and retained raw/mask fixtures need implementation.\",\"boundary_authority_note\":\"Quality status differs from provenance acceptance and model applicability. Facility capture remains external.\",\"mission_need_ids\":[\"MN-07\",\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-05\",\"MR-09\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H03\"],\"procedure_performers\":{\"COM-P06\":[\"EPS engineer\",\"Testing facility technician or qualified proxy\"]}}"; status = "proposed comparison description, not implemented or verified"; }
