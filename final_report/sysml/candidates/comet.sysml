#intendedRealization allocation allocate_FR_16_COM_S16 allocate FrameworkRequirements::FR_16 to physical.COM_S16;
@PhysicalRecord { identifier = "allocate_FR_16_COM_S16"; recordJSON = "{\"requirement_id\":\"FR-16\",\"title\":\"Dynamic mission composition\",\"requirement_text\":\"The framework shall compose time-dependent subsystem demand, duty cycles, schedules and mode transitions with orbit, attitude, irradiance, eclipse, thermal conditions and EPS supply and protection behavior.\",\"logical_component_ids\":[\"L05\",\"L03\",\"L04\"],\"physical_component_ids\":[\"COM-S16\",\"COM-S07\",\"COM-D04\",\"COM-D12\",\"COM-D13\",\"COM-D06\",\"COM-P05\"],\"realization_mechanism\":\"S16 binds COMET operating values to time-indexed duty cycles, schedules and transitions from D13. A checked IF-03 request composes orbit/attitude/irradiance/eclipse/thermal/load histories with supply and protection model inputs.\",\"maturity_evidence_status\":{\"allocation\":\"proposed design-stage realization, unimplemented and unverified\",\"source_support\":\"categorical state values only\",\"eligibility\":\"not demonstrated\",\"satisfaction\":\"pending\"},\"evidence_ids\":[\"COM-E05\"],\"source_locators\":[{\"evidence_id\":\"COM-E05\",\"source_id\":\"review-0876\",\"source_path\":\"SLR/SLR1/pdfs/review-reports/review-report-0876/review-report-0876.md\",\"physical_pdf_pages\":[5],\"section\":\"first 4.2.1\",\"source_maturity\":\"Reported native capability\",\"allocation_evidence_role\":\"categorical state values only\"}],\"verification_id\":\"V16\",\"verification_method\":\"A,T\",\"verification_fixture_observation\":\"Use a fixture whose average budget passes while a coupled load and illumination event creates a transient shortage. Inspect inputs, interactions and event timing against a reference calculation.\",\"verification_subject\":\"EPS engineering framework implementation\",\"verification_status\":\"planned, not executed\",\"verification_source_locator\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases row FR-16\",\"implementation_gap\":\"Dynamic scheduling, event/coupling contracts and reference shortage fixtures are proposed. No native time integrator is established.\",\"boundary_authority_note\":\"Specialist coupled execution is an external controlled service. COMET synchronization stays outside controller loops.\",\"mission_need_ids\":[\"MN-04\",\"MN-05\",\"MN-08\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-05\",\"MR-08\"],\"execution_host_ids\":[\"COM-H03\"],\"storage_host_ids\":[\"COM-H02\",\"COM-H03\"],\"procedure_performers\":{\"COM-P05\":[\"EPS engineer\",\"Qualified analysis or flight/ground software specialist\"]}}"; status = "proposed comparison description, not implemented or verified"; }
