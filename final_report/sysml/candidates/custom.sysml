#intendedRealization allocation allocate_FR_40_CDT_M13 allocate FrameworkRequirements::FR_40 to physical.CDT_M13;
@PhysicalRecord { identifier = "allocate_FR_40_CDT_M13"; recordJSON = "{\"requirement_id\":\"FR-40\",\"requirement_title\":\"Contrasting-case reuse\",\"logical_component_ids\":[\"L09\",\"L01\",\"L08\"],\"primary_logical_owner_id\":\"L09\",\"physical_component_ids\":[\"CDT-M13\",\"CDT-C1\",\"CDT-S01\",\"CDT-S02\",\"CDT-S04\",\"CDT-S10\",\"CDT-P1\",\"CDT-P7\"],\"realization_mechanism\":\"Freeze the common library, modules and protocol. Instantiate two predefined contrasting cases from declared parameters/mappings/extensions. Record adapter/core hashes, outcomes and every core change.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E01\",\"CDT-E04\",\"CDT-E20\"],\"source_locators\":[{\"evidence_id\":\"CDT-E01\",\"source_key\":\"citation-2362\",\"locator\":\"`citation-2362`, pp. 2–5, CSRM, CSRM Application, and Transition sections\",\"source_maturity\":\"reference_model\"},{\"evidence_id\":\"CDT-E04\",\"source_key\":\"review-0602\",\"locator\":\"`review-0602`, pp. 14–21, Sections 3.3–6\",\"source_maturity\":\"software_proof_of_concept\"},{\"evidence_id\":\"CDT-E20\",\"source_key\":\"psr-0024\",\"locator\":\"`psr-0024`, pp. 14–18, Sections 8.2–9 and Tables 13–14\",\"source_maturity\":\"review_synthesis\"}],\"verification_id\":\"V40\",\"verification_method\":\"I,D,T\",\"planned_acceptance\":\"Complete the same declared workflow in both cases without undeclared or post hoc core changes. If the core changes, rebaseline and rerun both cases before a reuse claim. No implementation or successful outcome is asserted here.\",\"implementation_gap\":\"Neither case is executed. Contrast choices and permitted extensions must be fixed before trial.\",\"boundary_authority_note\":\"Undeclared/post hoc code or core changes cannot be hidden as tailoring. Correcting the core requires rebaseline and repeat of both cases.\",\"boundary_interface_ids\":[\"IF-01\",\"IF-06\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-11\"],\"mission_requirement_ids\":[\"MR-11\"],\"moe_ids\":[\"MOE-11\"]}"; status = "proposed comparison description, not implemented or verified"; }
