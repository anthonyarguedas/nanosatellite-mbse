@PhysicalRecord { identifier = "FR-11"; recordJSON = "{\"requirement_id\":\"FR-11\",\"requirement_title\":\"Evidence and discrepancy status\",\"logical_component_ids\":[\"L02\",\"L07\",\"L09\"],\"primary_logical_owner_id\":\"L02\",\"physical_component_ids\":[\"CDT-M04\",\"CDT-S03\",\"CDT-S07\",\"CDT-S08\",\"CDT-S10\",\"CDT-P1\"],\"realization_mechanism\":\"Status compiler joins missing/rejected/stale/out-of-domain/failed/unresolved evidence to affected claims, criticality rationale, owner and dispositions. Critical open findings block unqualified labels.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E16\",\"CDT-E20\",\"CDT-E02\"],\"source_locators\":[{\"evidence_id\":\"CDT-E16\",\"source_key\":\"review-1251\",\"locator\":\"`review-1251`, pp. 22–24 and 31–32, Sections 4.1–5.1 and 6–7\",\"source_maturity\":\"qualification_telemetry_replay\"},{\"evidence_id\":\"CDT-E20\",\"source_key\":\"psr-0024\",\"locator\":\"`psr-0024`, pp. 14–18, Sections 8.2–9 and Tables 13–14\",\"source_maturity\":\"review_synthesis\"},{\"evidence_id\":\"CDT-E02\",\"source_key\":\"citation-2362\",\"locator\":\"`citation-2362`, pp. 5–6, MSM Verification and Validation\",\"source_maturity\":\"reference_model\"}],\"verification_id\":\"V11\",\"verification_method\":\"T\",\"planned_acceptance\":\"Seed each status including a critical finding. A claim affected by unresolved critical evidence cannot receive an unqualified supported or verified status.\",\"implementation_gap\":\"Cross-domain admissibility/status rules and critical-finding fixtures need development.\",\"boundary_authority_note\":\"L07 assesses admissibility. L02 dispositions claims. A complete manifest grants no approval.\",\"boundary_interface_ids\":[\"IF-01\",\"IF-06\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-10\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-10\"],\"moe_ids\":[\"MOE-02\",\"MOE-05\",\"MOE-10\"]}"; status = "proposed comparison description, not implemented or verified"; }
