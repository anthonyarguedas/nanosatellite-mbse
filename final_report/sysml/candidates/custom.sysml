@PhysicalRecord { identifier = "FR-35"; recordJSON = "{\"requirement_id\":\"FR-35\",\"requirement_title\":\"Command and recovery contract\",\"logical_component_ids\":[\"L03\",\"L05\",\"L07\"],\"primary_logical_owner_id\":\"L03\",\"physical_component_ids\":[\"CDT-M12\",\"CDT-M06\",\"CDT-M11\",\"CDT-S01\",\"CDT-S06\",\"CDT-S08\",\"CDT-P5\"],\"realization_mechanism\":\"Sequence assessor executes declared offline precondition/order/effect/acknowledgement/timeout/rejection models and checks EPS, housekeeping, FDIR and safe-mode ownership and recovery priorities.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E18\",\"CDT-E19\"],\"source_locators\":[{\"evidence_id\":\"CDT-E18\",\"source_key\":\"review-0853\",\"locator\":\"`review-0853`, pp. 10–14 and 16, Sections 3–5\",\"source_maturity\":\"architecture_generation_proof_of_concept\"},{\"evidence_id\":\"CDT-E19\",\"source_key\":\"citation-0136\",\"locator\":\"`citation-0136`, pp. 7–9 and 12–15, Sections III.A.3, IV.A.1, V, and VI\",\"source_maturity\":\"embedded_software_flatsat_case\"}],\"verification_id\":\"V35\",\"verification_method\":\"A,T\",\"planned_acceptance\":\"Replay nominal, rejected and recovery sequences with a qualified software reference. Confirm functional flow and ownership without claiming deployment of flight software.\",\"implementation_gap\":\"Guard/effect model and nominal/rejected/recovery fixtures are proposed.\",\"boundary_authority_note\":\"Offline checks establish contract conformance only. Mission functions and deployed recovery behavior require software-team verification.\",\"boundary_interface_ids\":[\"IF-04\",\"IF-03\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-08\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-08\",\"MR-04\"],\"moe_ids\":[\"MOE-04\",\"MOE-08\"]}"; status = "proposed comparison description, not implemented or verified"; }
