@PhysicalRecord { identifier = "FR-30"; recordJSON = "{\"requirement_id\":\"FR-30\",\"requirement_title\":\"Safety declaration\",\"logical_component_ids\":[\"L07\"],\"primary_logical_owner_id\":\"L07\",\"physical_component_ids\":[\"CDT-M11\",\"CDT-S08\",\"CDT-P4\"],\"realization_mechanism\":\"Safety completeness gate requires sourced operating/fault bounds, hazard and isolation records, abort/recovery and responsible review status before any ready-for-physical-handoff label.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E07\",\"CDT-E11\",\"CDT-E20\"],\"source_locators\":[{\"evidence_id\":\"CDT-E07\",\"source_key\":\"handpicked-0003\",\"locator\":\"`handpicked-0003`, pp. 11 and 13–14, Sections 8.1 and 8.1.6\",\"source_maturity\":\"laboratory_case_partial_qualification\"},{\"evidence_id\":\"CDT-E11\",\"source_key\":\"handpicked-0001\",\"locator\":\"`handpicked-0001`, pp. 7–9, System Implementation and Evaluation\",\"source_maturity\":\"preprint_dataset_evaluation\"},{\"evidence_id\":\"CDT-E20\",\"source_key\":\"psr-0024\",\"locator\":\"`psr-0024`, pp. 14–18, Sections 8.2–9 and Tables 13–14\",\"source_maturity\":\"review_synthesis\"}],\"verification_id\":\"V30\",\"verification_method\":\"I,T\",\"planned_acceptance\":\"Use a safe virtual fault fixture and an incomplete physical proposal. Missing limits or approval status block a ready-for-physical-execution label. The framework does not authorize laboratory operations.\",\"implementation_gap\":\"Hazard records and release-blocking tests are proposed. Qualified physical limits are external evidence gaps.\",\"boundary_authority_note\":\"The core cannot command hazardous hardware. Facility approval cannot be fabricated by satisfying a schema.\",\"boundary_interface_ids\":[\"IF-05\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-07\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-04\"],\"moe_ids\":[\"MOE-04\",\"MOE-07\"]}"; status = "proposed comparison description, not implemented or verified"; }
#plannedVerification dependency planned_FR_30_V30 from obligation_FR_30 to FrameworkVerification::V30;
@PhysicalRecord { identifier = "planned_FR_30_V30"; recordJSON = "{\"status\":\"planned, not executed\"}"; status = "proposed comparison description, not implemented or verified"; }
#intendedRealization allocation allocate_FR_31_CDT_M09 allocate FrameworkRequirements::FR_31 to physical.CDT_M09;
@PhysicalRecord { identifier = "allocate_FR_31_CDT_M09"; recordJSON = "{\"requirement_id\":\"FR-31\",\"requirement_title\":\"Evidence timing\",\"logical_component_ids\":[\"L06\",\"L08\"],\"primary_logical_owner_id\":\"L06\",\"physical_component_ids\":[\"CDT-M09\",\"CDT-M03\",\"CDT-S07\",\"CDT-S08\",\"CDT-P3\"],\"realization_mechanism\":\"Clock reconciler records stimulus/sample/receipt time origins, sampling/interpolation, offset/drift and known measurement/calculation/output delays. Preserve alignment residuals and missing timing metadata.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E08\",\"CDT-E14\",\"CDT-E16\"],\"source_locators\":[{\"evidence_id\":\"CDT-E08\",\"source_key\":\"handpicked-0003\",\"locator\":\"`handpicked-0003`, p. 14 and Figs. 25–26 on pp. 18–19, Section 8.1.7\",\"source_maturity\":\"laboratory_case_partial_qualification\"},{\"evidence_id\":\"CDT-E14\",\"source_key\":\"review-0573\",\"locator\":\"`review-0573`, pp. 3–12, Sections 2–4\",\"source_maturity\":\"hardware_correlation_chil_phil_case\"},{\"evidence_id\":\"CDT-E16\",\"source_key\":\"review-1251\",\"locator\":\"`review-1251`, pp. 22–24 and 31–32, Sections 4.1–5.1 and 6–7\",\"source_maturity\":\"qualification_telemetry_replay\"}],\"verification_id\":\"V31\",\"verification_method\":\"A,T\",\"planned_acceptance\":\"Align a known timestamp fixture and expose injected skew and missing timing metadata. Report alignment error or uncertainty against the agreed profile, with no invented global limit.\",\"implementation_gap\":\"Time conversion, uncertainty and injected-skew reference fixtures need implementation.\",\"boundary_authority_note\":\"Numerical step and wall-clock/physical delay remain distinct. Limits are interaction-profile specific.\",\"boundary_interface_ids\":[\"IF-03\",\"IF-05\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-07\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-09\"],\"moe_ids\":[\"MOE-07\",\"MOE-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
