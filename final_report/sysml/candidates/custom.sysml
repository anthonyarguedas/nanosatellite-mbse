#intendedRealization allocation allocate_FR_18_CDT_C6 allocate FrameworkRequirements::FR_18 to physical.CDT_C6;
@PhysicalRecord { identifier = "allocate_FR_18_CDT_C6"; recordJSON = "{\"requirement_id\":\"FR-18\",\"requirement_title\":\"Discipline model integration\",\"logical_component_ids\":[\"L03\",\"L05\",\"L08\"],\"primary_logical_owner_id\":\"L03\",\"physical_component_ids\":[\"CDT-C6\",\"CDT-M03\",\"CDT-S01\",\"CDT-S04\",\"CDT-P3\"],\"realization_mechanism\":\"Discipline profiles package native circuit, thermal, EMC and CAD revisions with field/port/quantity/frame mappings for external controlled services. Validate imported applicable results and record each unsupported check.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E05\",\"CDT-E04\",\"CDT-E12\"],\"source_locators\":[{\"evidence_id\":\"CDT-E05\",\"source_key\":\"handpicked-0003\",\"locator\":\"`handpicked-0003`, pp. 2–5, Sections 2–5\",\"source_maturity\":\"laboratory_case_partial_qualification\"},{\"evidence_id\":\"CDT-E04\",\"source_key\":\"review-0602\",\"locator\":\"`review-0602`, pp. 14–21, Sections 3.3–6\",\"source_maturity\":\"software_proof_of_concept\"},{\"evidence_id\":\"CDT-E12\",\"source_key\":\"handpicked-0002\",\"locator\":\"`handpicked-0002`, slides/PDF pp. 8–18\",\"source_maturity\":\"workshop_presentation_proof_of_concept\"}],\"verification_id\":\"V18\",\"verification_method\":\"D,T\",\"planned_acceptance\":\"Every electrical, thermal, EMC and CAD exchange profile required by the frozen minimum shall complete its reference request/result exchange and declared identity, quantity, unit, meaning and revision checks. Retain unsupported mappings and development gaps. A missing required profile remains not verified or undetermined and cannot pass V18. A narrower minimum requires a reviewed scope disposition before evaluation.\",\"implementation_gap\":\"Electrical, thermal, EMC and CAD product/version profiles and adapters remain unimplemented. Each outstanding profile is explicitly a gap.\",\"boundary_authority_note\":\"Specialist services are external through IF-03. CPU battery/EPS dependencies are integrated and separately declared.\",\"boundary_interface_ids\":[\"IF-03\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-04\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-07\"],\"moe_ids\":[\"MOE-04\",\"MOE-07\"]}"; status = "proposed comparison description, not implemented or verified"; }
#intendedRealization allocation allocate_FR_18_CDT_M03 allocate FrameworkRequirements::FR_18 to physical.CDT_M03;
