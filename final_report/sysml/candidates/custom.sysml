@PhysicalRecord { identifier = "FR-19"; recordJSON = "{\"requirement_id\":\"FR-19\",\"requirement_title\":\"Early verification scenarios\",\"logical_component_ids\":[\"L05\",\"L07\"],\"primary_logical_owner_id\":\"L05\",\"physical_component_ids\":[\"CDT-M06\",\"CDT-M07\",\"CDT-M11\",\"CDT-C5\",\"CDT-S06\",\"CDT-S08\",\"CDT-P3\"],\"realization_mechanism\":\"Virtual scenario library defines nominal loads, supply/protection changes, rare faults and modeled controller electrical/timing assumptions. Capture stimulus, expected response, internal states and unresolved behavior.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E07\",\"CDT-E08\",\"CDT-E14\"],\"source_locators\":[{\"evidence_id\":\"CDT-E07\",\"source_key\":\"handpicked-0003\",\"locator\":\"`handpicked-0003`, pp. 11 and 13–14, Sections 8.1 and 8.1.6\",\"source_maturity\":\"laboratory_case_partial_qualification\"},{\"evidence_id\":\"CDT-E08\",\"source_key\":\"handpicked-0003\",\"locator\":\"`handpicked-0003`, p. 14 and Figs. 25–26 on pp. 18–19, Section 8.1.7\",\"source_maturity\":\"laboratory_case_partial_qualification\"},{\"evidence_id\":\"CDT-E14\",\"source_key\":\"review-0573\",\"locator\":\"`review-0573`, pp. 3–12, Sections 2–4\",\"source_maturity\":\"hardware_correlation_chil_phil_case\"}],\"verification_id\":\"V19\",\"verification_method\":\"D,T\",\"planned_acceptance\":\"Retain stimulus, conditions, expected response, outputs and status for nominal and failure fixtures. Unsupported behavior and physical validation needs are explicit, including COTS evidence gaps.\",\"implementation_gap\":\"Virtual models, COTS fault coverage and controller timing validation are pending.\",\"boundary_authority_note\":\"The core has no physical command endpoint. HIL and hazardous device execution remain external.\",\"boundary_interface_ids\":[\"IF-03\",\"IF-05\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-04\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-07\"],\"moe_ids\":[\"MOE-04\",\"MOE-07\"]}"; status = "proposed comparison description, not implemented or verified"; }
