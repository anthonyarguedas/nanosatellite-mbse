@PhysicalRecord { identifier = "allocate_FR_17_CDT_M01"; recordJSON = "{\"requirement_id\":\"FR-17\",\"requirement_title\":\"Requirement parameter derivation\",\"logical_component_ids\":[\"L02\",\"L04\"],\"primary_logical_owner_id\":\"L02\",\"physical_component_ids\":[\"CDT-M01\",\"CDT-M05\",\"CDT-S03\",\"CDT-S05\",\"CDT-S06\",\"CDT-P1\"],\"realization_mechanism\":\"Derivation worksheet binds each requirement parameter to component source, behavior, declared budget method, unit conversion, uncertainty, allowable range and human criterion decision.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E05\",\"CDT-E06\",\"CDT-E22\"],\"source_locators\":[{\"evidence_id\":\"CDT-E05\",\"source_key\":\"handpicked-0003\",\"locator\":\"`handpicked-0003`, pp. 2–5, Sections 2–5\",\"source_maturity\":\"laboratory_case_partial_qualification\"},{\"evidence_id\":\"CDT-E06\",\"source_key\":\"handpicked-0003\",\"locator\":\"`handpicked-0003`, pp. 4 and 6–8, Sections 3 and 6.2\",\"source_maturity\":\"laboratory_case_partial_qualification\"},{\"evidence_id\":\"CDT-E22\",\"source_key\":\"cubesat-handbook-part-i\",\"locator\":\"CubeSat Handbook, Part I, I.3–I.5, physical PDF pp. 22–37\",\"source_maturity\":\"domain_method_guidance\"}],\"verification_id\":\"V17\",\"verification_method\":\"A,T\",\"planned_acceptance\":\"Derive a fixture allocation from datasheet and supplied measurement inputs using a declared method. Preserve assumptions and flag unsupported ranges and undecided pass/fail values.\",\"implementation_gap\":\"Native derivation links, uncertainty propagation and unsupported-range checks need development.\",\"boundary_authority_note\":\"Engineers justify criteria. A datasheet rating or copied paper margin is not an automatic mission requirement.\",\"boundary_interface_ids\":[\"IF-01\",\"IF-02\",\"IF-03\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not