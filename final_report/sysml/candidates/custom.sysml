#intendedRealization allocation allocate_FR_13_CDT_M05 allocate FrameworkRequirements::FR_13 to physical.CDT_M05;
@PhysicalRecord { identifier = "allocate_FR_13_CDT_M05"; recordJSON = "{\"requirement_id\":\"FR-13\",\"requirement_title\":\"Financial estimate\",\"logical_component_ids\":[\"L04\"],\"primary_logical_owner_id\":\"L04\",\"physical_component_ids\":[\"CDT-M05\",\"CDT-S05\",\"CDT-S06\",\"CDT-P2\"],\"realization_mechanism\":\"Scoped reducer combines BOM quantities, dated supplier prices/currency and declared extra categories. Preserve estimates, uncertainty and unknown-priced items in the revision-linked rollup.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E02\",\"CDT-E22\"],\"source_locators\":[{\"evidence_id\":\"CDT-E02\",\"source_key\":\"citation-2362\",\"locator\":\"`citation-2362`, pp. 5–6, MSM Verification and Validation\",\"source_maturity\":\"reference_model\"},{\"evidence_id\":\"CDT-E22\",\"source_key\":\"cubesat-handbook-part-i\",\"locator\":\"CubeSat Handbook, Part I, I.3–I.5, physical PDF pp. 22–37\",\"source_maturity\":\"domain_method_guidance\"}],\"verification_id\":\"V13\",\"verification_method\":\"A,T\",\"planned_acceptance\":\"Recalculate a sourced-price fixture after a quantity and part change. Match reference arithmetic and preserve unknown costs. Do not import historical project costs as new framework measurements.\",\"implementation_gap\":\"Currency/basis and missing-cost policies plus reference arithmetic fixtures need implementation.\",\"boundary_authority_note\":\"EPS acquisition estimates differ from framework direct usage cost. Source prices are supplied evidence.\",\"boundary_interface_ids\":[\"IF-01\",\"IF-02\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-03\"],\"mission_requirement_ids\":[\"MR-03\"],\"moe_ids\":[\"MOE-03\"]}"; status = "proposed comparison description, not implemented