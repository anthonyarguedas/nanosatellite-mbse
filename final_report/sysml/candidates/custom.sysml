@PhysicalRecord { identifier = "allocate_FR_28_CDT_M11"; recordJSON = "{\"requirement_id\":\"FR-28\",\"requirement_title\":\"Verification activity record\",\"logical_component_ids\":[\"L07\"],\"primary_logical_owner_id\":\"L07\",\"physical_component_ids\":[\"CDT-M11\",\"CDT-S03\",\"CDT-S08\",\"CDT-P4\"],\"realization_mechanism\":\"Method-specific activity editor retains subject/DUT baseline, requirement, quantities or observations, conditions, inputs, expected response, criterion, evidence variables and unexecuted/failed/inconclusive status.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E02\",\"CDT-E05\",\"CDT-E22\"],\"source_locators\":[{\"evidence_id\":\"CDT-E02\",\"source_key\":\"citation-2362\",\"locator\":\"`citation-2362`, pp. 5–6, MSM Verification and Validation\",\"source_maturity\":\"reference_model\"},{\"evidence_id\":\"CDT-E05\",\"source_key\":\"handpicked-0003\",\"locator\":\"`handpicked-0003`, pp. 2–5, Sections 2–5\",\"source_maturity\":\"laboratory_case_partial_qualification\"},{\"evidence_id\":\"CDT-E22\",\"source_key\":\"cubesat-handbook-part-i\",\"locator\":\"CubeSat Handbook, Part I, I.3–I.5, physical PDF pp. 22–37\",\"source_maturity\":\"domain_method_guidance\"}],\"verification_id\":\"V28\",\"verification_method\":\"I,T\",\"planned_acceptance\":\"Inspect quantitative analysis/test and qualitative inspection/demonstration fixtures against their method-specific fields. Check the applicable quantity or observable condition, criterion, expected response and evidence. An inapplicable field retains rationale. Missing mandatory fields, failed gates and unresolved criteria remain explicit and prevent an unsupported verdict.\",\"implementation_gap\":\"Field profiles for all four methods and failed-gate fixtures are pending.\",\"boundary_authority_note\":\"Every activity names framework versus EPS/component subject. Physical EPS qualification is not framework acceptance.\",\"boundary_interface_ids\":[\"IF-01\",\"IF-05\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-07\",\"MN-01\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-01\"],\"moe_ids\":[\"MOE-01\",\"MOE-07\"]}"; status = "proposed comparison description, not implemented or verified"; }
