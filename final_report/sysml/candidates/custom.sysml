#intendedRealization allocation allocate_FR_30_CDT_M11 allocate FrameworkRequirements::FR_30 to physical.CDT_M11;
@PhysicalRecord { identifier = "allocate_FR_30_CDT_M11"; recordJSON = "{\"requirement_id\":\"FR-30\",\"requirement_title\":\"Safety declaration\",\"logical_component_ids\":[\"L07\"],\"primary_logical_owner_id\":\"L07\",\"physical_component_ids\":[\"CDT-M11\",\"CDT-S08\",\"CDT-P4\"],\"realization_mechanism\":\"Safety completeness gate requires sourced operating/fault bounds, hazard and isolation records, abort/recovery and responsible review status before any ready-for-physical-handoff label.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E07\",\"CDT-E11\",\"CDT-E20\"],\"source_locators\":[{\"evidence_id\":\"CDT-E07\",\"source_key\":\"handpicked-0003\",\"locator\":\"`handpicked-0003`, pp. 11 and 13–14, Sections 8.1 and 8.1.6\",\"source_maturity\":\"laboratory_case_partial_qualification\"},{\"evidence_id\":\"CDT-E11\",\"source_key\":\"handpicked-0001\",\"locator\":\"`handpicked-0001`, pp. 7–9, System Implementation and Evaluation\",\"source_maturity\":\"preprint_dataset_evaluation\"},{\"evidence_id\":\"CDT-E20\",\"source_key\":\"psr-0024\",\"locator\":\"`psr-0024`, pp. 14–18, Sections 8.2–9 and Tables 13–14\",\"source_maturity\":\"review_synthesis\"}],\"verification_id\":\"V30\",\"verification_method\":\"I,T\",\"planned_acceptance\":\"Use a safe virtual fault fixture and an incomplete physical proposal. Missing limits or approval status block a ready-for-physical-execution label. The framework does not authorize laboratory operations.\",\"implementation_gap\":\"Hazard records and release-blocking tests are proposed. Qualified physical limits are external evidence gaps.\",\"boundary_authority_note\":\"The core cannot command hazardous hardware. Facility approval cannot be fabricated by satisfying a schema.\",\"boundary_interface_ids\":[\"IF-05\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-07\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-04\"],\"moe_ids\":[\"MOE-04\",\"MOE-07\"]}"; status = "proposed comparison description, not implemented or verified"; }
