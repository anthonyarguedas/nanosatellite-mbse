@PhysicalRecord { identifier = "allocate_FR_06_CDT_M03"; recordJSON = "{\"requirement_id\":\"FR-06\",\"requirement_title\":\"Change disposition\",\"logical_component_ids\":[\"L02\",\"L08\"],\"primary_logical_owner_id\":\"L02\",\"physical_component_ids\":[\"CDT-M03\",\"CDT-M04\",\"CDT-C3\",\"CDT-S03\",\"CDT-S04\",\"CDT-P1\"],\"realization_mechanism\":\"Release gate records the change request and failed criterion context, commits a successor manifest, and marks each affected result regenerated, stale or unresolved without erasing its predecessor.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E02\",\"CDT-E20\"],\"source_locators\":[{\"evidence_id\":\"CDT-E02\",\"source_key\":\"citation-2362\",\"locator\":\"`citation-2362`, pp. 5–6, MSM Verification and Validation\",\"source_maturity\":\"reference_model\"},{\"evidence_id\":\"CDT-E20\",\"source_key\":\"psr-0024\",\"locator\":\"`psr-0024`, pp. 14–18, Sections 8.2–9 and Tables 13–14\",\"source_maturity\":\"review_synthesis\"}],\"verification_id\":\"V06\",\"verification_method\":\"T\",\"planned_acceptance\":\"Exercise a failed verification gate followed by correction. Preserve the prior baseline and prevent stale results from appearing current.\",\"implementation_gap\":\"Release guards, dependency invalidation and immutable retention need tests.\",\"boundary_authority_note\":\"Changing a criterion cannot relabel an earlier failed result as passed.\",\"boundary_interface_ids\":[\"IF-01\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-07\"],\"moe_ids\":[\"MOE-02\",\"MOE-05\",\"MOE-07\"]}"; status = "proposed comparison description, not implemented or verified"; }
