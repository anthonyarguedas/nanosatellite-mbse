#intendedRealization allocation allocate_FR_32_CDT_M09 allocate FrameworkRequirements::FR_32 to physical.CDT_M09;
@PhysicalRecord { identifier = "allocate_FR_32_CDT_M09"; recordJSON = "{\"requirement_id\":\"FR-32\",\"requirement_title\":\"Telemetry quality\",\"logical_component_ids\":[\"L06\",\"L08\"],\"primary_logical_owner_id\":\"L06\",\"physical_component_ids\":[\"CDT-M09\",\"CDT-M03\",\"CDT-S07\",\"CDT-S04\",\"CDT-P3\"],\"realization_mechanism\":\"Observation validator checks expected channels, native units, timestamp order/completeness and mode/active-unit sensor conditions. Keep immutable raw values and explicit processing masks.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E16\",\"CDT-E08\"],\"source_locators\":[{\"evidence_id\":\"CDT-E16\",\"source_key\":\"review-1251\",\"locator\":\"`review-1251`, pp. 22–24 and 31–32, Sections 4.1–5.1 and 6–7\",\"source_maturity\":\"qualification_telemetry_replay\"},{\"evidence_id\":\"CDT-E08\",\"source_key\":\"handpicked-0003\",\"locator\":\"`handpicked-0003`, p. 14 and Figs. 25–26 on pp. 18–19, Section 8.1.7\",\"source_maturity\":\"laboratory_case_partial_qualification\"}],\"verification_id\":\"V32\",\"verification_method\":\"T\",\"planned_acceptance\":\"Inject missing samples, inactive sensors and invalid values. Do not treat inactive invalid readings as valid measurements. Match the fixture quality verdict and retained raw data.\",\"implementation_gap\":\"Telemetry schema, invalid/inactive handling and missing-data fixtures are pending.\",\"boundary_authority_note\":\"Inactive or unavailable readings stay recorded and cannot be treated as valid zero measurements.\",\"boundary_interface_ids\":[\"IF-05\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-07\",\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-05\",\"MR-09\"],\"moe_ids\":[\"MOE-05\",\"MOE-07\",\"MOE-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
