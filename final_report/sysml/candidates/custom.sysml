item <'CDT-C1'> CDT_C1 : DataResource;
@PhysicalRecord { identifier = "CDT-C1"; recordJSON = "{\"id\":\"CDT-C1\",\"name\":\"CSRM-derived EPS library\",\"kind_and_placement\":\"Persistent SysML v2 data, PN1\",\"activation\":\"mandatory_core\",\"scope_and_maturity\":\"Audited reference subset, glossary, requirement examples, tailoring rules, EPS functions, ports, properties, mission modes, and trace relations. Partial assets exist. Usable library completion is proposed.\",\"execution_node_ids\":[\"CDT-PN1\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"]}"; status = "Audited reference subset, glossary, requirement examples, tailoring rules, EPS functions, ports, properties, mission modes, and trace relations. Partial assets exist. Usable library completion is proposed."; }
part <'CDT-C2'> CDT_C2 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-C2"; recordJSON = "{\"id\":\"CDT-C2\",\"name\":\"Textual SysML v2 workbench\",\"kind_and_placement\":\"Software, PN1\",\"activation\":\"mandatory_core\",\"scope_and_maturity\":\"Native editor, parser, syntax and semantic checking, queries, stable model identity, and readable table export. Toolchain and license choice must be fixed. Requirement quality guidance and domain checks are proposed additions.\",\"execution_node_ids\":[\"CDT-PN1\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"]}"; status = "Native editor, parser, syntax and semantic checking, queries, stable model identity, and readable table export. Toolchain and license choice must be fixed. Requirement quality guidance and domain checks are proposed additions."; }
part <'CDT-C3'> CDT_C3 : CompositeResource;
@PhysicalRecord { identifier = "CDT-C3"; recordJSON = "{\"id\":\"CDT-C3\",\"name\":\"Controlled records and release store\",\"kind_and_placement\":\"Software and persistent data, PN1\",\"activation\":\"mandatory_core\",\"scope_and_maturity\":\"Git-controlled text and manifests, immutable released identities, file checksums for large evidence, backup, access rules, and a rebuildable index. CAD, FMUs, scenes, and time series are linked by revision and hash. Product selection beyond Git is open.\",\"execution_node_ids\":[\"CDT-PN1\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"]}"; status = "Git-controlled text and manifests, immutable released identities, file checksums for large evidence, backup, access rules, and a rebuildable index. CAD, FMUs, scenes, and time series are linked by revision and hash. Product selection beyond Git is open."; }
part <'CDT-C4'> CDT_C4 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-C4"; recordJSON = "{\"id\":\"CDT-C4\",\"name\":\"Python workflow and contract checker\",\"kind_and_placement\":\"Software, PN2\",\"activation\":\"mandatory_core\",\"scope_and_maturity\":\"One small package for parameter extraction, dependency checks, adapter calls, result validation, provenance, criteria evaluation, and report generation. Typed exchange files are generated views. Most assurance logic is proposed.\",\"execution_node_ids\":[\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"]}"; status = "One small package for parameter extraction, dependency checks, adapter calls, result validation, provenance, criteria evaluation, and report generation. Typed exchange files are generated views. Most assurance logic is proposed."; }
part <'CDT-C5'> CDT_C5 : CompositeResource;
@PhysicalRecord { identifier = "CDT-C5"; recordJSON = "{\"id\":\"CDT-C5\",\"name\":\"EPS and battery analysis pack\",\"kind_and_placement\":\"Software and model data, PN2\",\"activation\":\"mandatory_core\",\"scope_and_maturity\":\"Orbit/attitude input histories, solar generation, mode-dependent loads, conversion losses, battery state, temperature, and protection transitions. Include a CPU PyBaMM connector and a simpler dynamic model. Aging state assumptions are mandatory. Detailed degradation models are activated only with decision-specific evidence. New models require correlation.\",\"execution_node_ids\":[\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"reviewed_scope\":\"CPU EPS/battery models include a mandatory offline identified degradation-model integration path and fresh/aged fixtures. Detailed fidelity remains purpose-specific. This corrects the earlier allowance for fixed aging assumptions alone. Implementation and representative model validity remain pending.\"}"; status = "Orbit/attitude input histories, solar generation, mode-dependent loads, conversion losses, battery state, temperature, and protection transitions. Include a CPU PyBaMM connector and a simpler dynamic model. Aging state assumptions are mandatory. Detailed degradation models are activated only with decision-specific evidence. New models require correlation."; }
part <'CDT-C6'> CDT_C6 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-C6"; recordJSON = "{\"id\":\"CDT-C6\",\"name\":\"Domain and FMI adapters\",\"kind_and_placement\":\"Software, PN2\",\"activation\":\"mandatory_core\",\"scope_and_maturity\":\"A bounded adapter set for the selected orbit, circuit, thermal, EMC, and battery tools. Include one pinned FMI/FMU import path with an explicit master algorithm and supported capabilities. Retain import and result packages when proprietary solvers run elsewhere. Proposed integration.\",\"execution_node_ids\":[\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"reviewed_scope\":\"FMI and CPU battery coupling are integrated dependencies. Electrical, thermal, EMC, CAD and orbit/attitude profiles coordinate explicitly external controlled specialist services through IF-03. Every product/version, mapping and unsupported check is declared before use.\"}"; status = "A bounded adapter set for the selected orbit, circuit, thermal, EMC, and battery tools. Include one pinned FMI/FMU import path with an explicit master algorithm and supported capabilities. Retain import and result packages when proprietary solvers run elsewhere. Proposed integration."; }
part <'CDT-C7'> CDT_C7 : CompositeResource;
@PhysicalRecord { identifier = "CDT-C7"; recordJSON = "{\"id\":\"CDT-C7\",\"name\":\"Flight and ground software interface profiles\",\"kind_and_placement\":\"Software and persistent data, PN1/PN2\",\"activation\":\"mandatory_core\",\"scope_and_maturity\":\"One declared release profile each for cFS and F Prime. Maintain hardware-to-software mappings, commands, telemetry, events, parameters, command sequences, and target resource evidence. Generate or compare only supported definition artifacts. Proposed native SysML v2 integration.\",\"execution_node_ids\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"]}"; status = "One declared release profile each for cFS and F Prime. Maintain hardware-to-software mappings, commands, telemetry, events, parameters, command sequences, and target resource evidence. Generate or compare only supported definition artifacts. Proposed native SysML v2 integration."; }
item <'CDT-C8'> CDT_C8 : DataResource;
@PhysicalRecord { identifier = "CDT-C8"; recordJSON = "{\"id\":\"CDT-C8\",\"name\":\"Engineering records and view templates\",\"kind_and_placement\":\"Persistent data and Python report modules, PN1/PN2\",\"activation\":\"mandatory_core\",\"scope_and_maturity\":\"Requirements worksheets, BOM and quote records, RAM/FMEA records, verification control tables, technician procedures, credibility records, review packages, and discrepancy records. Proposed templates, not an additional workflow platform.\",\"execution_node_ids\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"]}"; status = "Requirements worksheets, BOM and quote records, RAM/FMEA records, verification control tables, technician procedures, credibility records, review packages, and discrepancy records. Proposed templates, not an additional workflow platform."; }
action <'CDT-P1'> CDT_P1 : OperatingProcedure;
@PhysicalRecord { identifier = "CDT-P1"; recordJSON = "{\"id\":\"CDT-P1\",\"name\":\"Tailor and accept an engineering baseline\",\"kind\":\"operational_procedure\",\"activation\":\"mandatory_core\",\"performer_and_output\":\"Systems Engineer with EPS and non-EPS contributors. Check provenance, requirement quality, quantities, applicability, interface meanings, and tailoring differences.\",\"maturity\":\"proposed\",\"procedure_id\":\"CDT-P1\",\"performer_roles\":[\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"}"; status = "proposed"; }
action <'CDT-P2'> CDT_P2 : OperatingProcedure;
@PhysicalRecord { identifier = "CDT-P2"; recordJSON = "{\"id\":\"CDT-P2\",\"name\":\"Maintain candidates, BOM, and cost basis\",\"kind\":\"operational_procedure\",\"activation\":\"mandatory_core\",\"performer_and_output\":\"EPS Engineer and Project Manager. Regenerate quantities and trace each quoted value to supplier, date, currency, scope, and uncertainty. Unknown cost stays visible.\",\"maturity\":\"proposed\",\"procedure_id\":\"CDT-P2\",\"performer_roles\":[\"EPS Engineer\",\"Project Manager\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"}"; status = "proposed"; }
action <'CDT-P3'> CDT_P3 : OperatingProcedure;
@PhysicalRecord { identifier = "CDT-P3"; recordJSON = "{\"id\":\"CDT-P3\",\"name\":\"Select models and execute/reproduce analyses\",\"kind\":\"operational_procedure\",\"activation\":\"mandatory_core\",\"performer_and_output\":\"EPS Engineer with qualified model reviewer. Declare fidelity, applicability, parameters, solver settings, data quality, criteria, and reproduction tolerance before use.\",\"maturity\":\"proposed\",\"procedure_id\":\"CDT-P3\",\"performer_roles\":[\"EPS Engineer\",\"Systems Engineer or Non-EPS Engineer acting as qualified model/RAM reviewer\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\",\"CDT-H3\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"}"; status = "proposed"; }
action <'CDT-P4'> CDT_P4 : OperatingProcedure;
@PhysicalRecord { identifier = "CDT-P4"; recordJSON = "{\"id\":\"CDT-P4\",\"name\":\"Prepare a V&V and safe fault plan\",\"kind\":\"operational_procedure\",\"activation\":\"mandatory_core\",\"performer_and_output\":\"Systems Engineer and EPS Engineer prepare. The Testing Facility Technician reviews feasibility, interfaces, equipment, and safety. Execution authorization remains with the external facility.\",\"maturity\":\"proposed\",\"procedure_id\":\"CDT-P4\",\"performer_roles\":[\"Systems Engineer\",\"EPS Engineer\",\"Testing Facility Technician for proposal review only\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"external facility only\",\"status\":\"proposed_procedure_not_observed\"}"; status = "proposed"; }
action <'CDT-P5'> CDT_P5 : OperatingProcedure;
@PhysicalRecord { identifier = "CDT-P5"; recordJSON = "{\"id\":\"CDT-P5\",\"name\":\"Review software contracts and sequences\",\"kind\":\"operational_procedure\",\"activation\":\"mandatory_core\",\"performer_and_output\":\"EPS and flight/ground software contributors confirm meanings, conditions, expected effects, mode priorities, and target budgets. Unsupported exports remain open discrepancies.\",\"maturity\":\"proposed\",\"procedure_id\":\"CDT-P5\",\"performer_roles\":[\"EPS Engineer\",\"Non-EPS Engineer acting as flight/ground software contributor\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"}"; status = "proposed"; }
action <'CDT-P6'> CDT_P6 : OperatingProcedure;
@PhysicalRecord { identifier = "CDT-P6"; recordJSON = "{\"id\":\"CDT-P6\",\"name\":\"Release evidence and onboard users\",\"kind\":\"operational_procedure\",\"activation\":\"mandatory_core\",\"performer_and_output\":\"Responsible reviewers record decisions and unresolved findings. New users complete a small guided task. The framework maintainer records installation, training, and support effort.\",\"maturity\":\"proposed\",\"procedure_id\":\"CDT-P6\",\"performer_roles\":[\"Project Manager or Systems Engineer for release\",\"Relevant engineers as learners/reviewers\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"}"; status = "proposed"; }
part <'CDT-X1'> CDT_X1 : CompositeResource { action procedure : OperatingProcedure; }
@PhysicalRecord { identifier = "CDT-X1"; recordJSON = "{\"id\":\"CDT-X1\",\"name\":\"OpenUSD mapping and view package\",\"kind\":\"software_data_and_procedure_extension\",\"activation\":\"optional_decision_specific_profile\",\"responsibility\":\"Map accepted SysML identities to geometry, prims, units, frames, and selected result variables. Export and mapping checks can run headlessly where supported. Geometry is an EPS design artifact.\",\"burden_and_limit\":\"Asset preparation and mapping verification. A scene is a derived view, never the authority for requirements or pass/fail.\",\"maturity\":\"proposed_candidate_integration\",\"execution_node_ids\":[\"CDT-PN3\"],\"execution_host_ids\":[\"CDT-H4\"],\"storage_host_ids\":[\"CDT-H2\"]}"; status = "proposed_candidate_integration"; }
part <'CDT-X2'> CDT_X2 : CompositeResource { action procedure : OperatingProcedure; }
@PhysicalRecord { identifier = "CDT-X2"; recordJSON = "{\"id\":\"CDT-X2\",\"name\":\"NVIDIA Omniverse Kit review extension\",\"kind\":\"software_data_and_procedure_extension\",\"activation\":\"optional_decision_specific_profile\",\"responsibility\":\"Use a GPU scene when spatial arrangement, deployment geometry, solar exposure, or shared visual review matters. Bind measured, simulated, and predicted values with explicit labels.\",\"burden_and_limit\":\"Compatible NVIDIA GPU, driver, OS, Kit release, content licenses, and support. Full collaboration infrastructure is optional.\",\"maturity\":\"proposed_candidate_integration\",\"execution_node_ids\":[\"CDT-PN3\"],\"execution_host_ids\":[\"CDT-H4\"],\"storage_host_ids\":[\"CDT-H2\"]}"; status = "proposed_candidate_integration"; }
part <'CDT-X3'> CDT_X3 : CompositeResource { action procedure : OperatingProcedure; }
@PhysicalRecord { identifier = "CDT-X3"; recordJSON = "{\"id\":\"CDT-X3\",\"name\":\"Isaac controlled scenario adapter\",\"kind\":\"software_data_and_procedure_extension\",\"activation\":\"optional_decision_specific_profile\",\"responsibility\":\"Use robotics, contact, or actuator scenarios when motion changes EPS demand or energy availability. Return time-stamped actions and states to a calibrated electrical load model.\",\"burden_and_limit\":\"Robotics modeling and GPU burden. Isaac is not an orbital, radiation, EMC, or electrochemical solver. Electrical power is not inferred directly from rendered motion.\",\"maturity\":\"proposed_candidate_integration\",\"execution_node_ids\":[\"CDT-PN3\"],\"execution_host_ids\":[\"CDT-H4\"],\"storage_host_ids\":[\"CDT-H2\"]}"; status = "proposed_candidate_integration"; }
part <'CDT-X4'> CDT_X4 : CompositeResource { action procedure : OperatingProcedure; }
@PhysicalRecord { identifier = "CDT-X4"; recordJSON = "{\"id\":\"CDT-X4\",\"name\":\"USD/FMI/EPS coupling\",\"kind\":\"software_data_and_procedure_extension\",\"activation\":\"optional_decision_specific_profile\",\"responsibility\":\"Bind an FMU and EPS/battery results to the scenario clock through Python. Retain the master configuration, initialization, events, step sizes, and synchronization evidence.\",\"burden_and_limit\":\"Proposed CubeSat coupling using a reported proof-of-concept pattern. Clock stability and numerical error require independent validation.\",\"maturity\":\"proposed_candidate_integration\",\"execution_node_ids\":[\"CDT-PN3\"],\"execution_host_ids\":[\"CDT-H4\"],\"storage_host_ids\":[\"CDT-H2\"]}"; status = "proposed_candidate_integration"; }
part <'CDT-X5'> CDT_X5 : CompositeResource { action procedure : OperatingProcedure; }
@PhysicalRecord { identifier = "CDT-X5"; recordJSON = "{\"id\":\"CDT-X5\",\"name\":\"External SIL, HIL, and telemetry expansion\",\"kind\":\"software_data_and_procedure_extension\",\"activation\":\"external_future_scope\",\"responsibility\":\"Reuse accepted dictionaries, plans, model validity records, and result schemas when a later project adds controller or power hardware.\",\"burden_and_limit\":\"HIL instruments, interfaces, protective hardware, facility approval, timing validation, and cybersecurity are additional external work. Flight operation and autonomous control remain excluded.\",\"maturity\":\"proposed_candidate_integration\",\"execution_node_ids\":[\"external_future_host\"],\"execution_host_ids\":[\"external_future_target_not_core\"],\"storage_host_ids\":[\"CDT-H2\"]}"; status = "proposed_candidate_integration"; }
part <'CDT-H1'> CDT_H1 : HostResource;
@PhysicalRecord { identifier = "CDT-H1"; recordJSON = "{\"id\":\"CDT-H1\",\"name\":\"CPU host\",\"kind\":\"hardware_resource\",\"activation\":\"mandatory_core\",\"scope\":\"Compatible CPU computer for the selected SysML toolchain, Python, and solvers. Existing resource reuse permitted. Sizing unresolved.\"}"; status = "proposed realization, no observed verdict"; }
part <'CDT-H2'> CDT_H2 : HostResource;
@PhysicalRecord { identifier = "CDT-H2"; recordJSON = "{\"id\":\"CDT-H2\",\"name\":\"Persistent storage and separate backup\",\"kind\":\"hardware_or_hosted_resource\",\"activation\":\"mandatory_core\",\"scope\":\"Controlled files, hashes, access, export, and backup/recovery. Capacity and product unresolved.\"}"; status = "proposed realization, no observed verdict"; }
part <'CDT-H3'> CDT_H3 : HostResource;
@PhysicalRecord { identifier = "CDT-H3"; recordJSON = "{\"id\":\"CDT-H3\",\"name\":\"Clean independent reproduction environment\",\"kind\":\"verification_environment\",\"activation\":\"mandatory_verification_resource\",\"scope\":\"A separate clean environment available to an independent reviewer. It need not be a purchased permanent framework node.\"}"; status = "proposed realization, no observed verdict"; }
part <'CDT-H4'> CDT_H4 : HostResource;
@PhysicalRecord { identifier = "CDT-H4"; recordJSON = "{\"id\":\"CDT-H4\",\"name\":\"Compatible NVIDIA GPU environment\",\"kind\":\"hardware_resource\",\"activation\":\"optional_scene_and_isaac\",\"scope\":\"GPU, driver, OS, memory, and selected Kit/Isaac releases require compatibility, resource, and license checks. No numerical sizing asserted.\"}"; status = "proposed realization, no observed verdict"; }
part <'CDT-M01'> CDT_M01 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M01"; recordJSON = "{\"id\":\"CDT-M01\",\"name\":\"Requirement guidance and applicability editor\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C2\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN1\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S01\",\"CDT-S02\",\"CDT-S03\"],\"scope\":\"Requirement fields, qualitative conditions, applicable-unit rationale, worked EPS examples, sourced method selection, and unresolved criterion checks.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M02'> CDT_M02 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M02"; recordJSON = "{\"id\":\"CDT-M02\",\"name\":\"Semantic trace and change-impact query engine\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C4\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S01\",\"CDT-S03\",\"CDT-S04\",\"CDT-S05\"],\"scope\":\"Query native SysML relationships and registered artifact dependencies in both directions. Traverse EPS/load/software/BOM/plan links and report missing edges.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M03'> CDT_M03 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M03"; recordJSON = "{\"id\":\"CDT-M03\",\"name\":\"Baseline registration and semantic transfer gate\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C4\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S04\"],\"scope\":\"Check exact IDs, hashes, schema, quantity kinds, scale/offset, polarity, frames, time bases and mappings. Quarantine incompatible submissions. C3 commits accepted releases.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M04'> CDT_M04 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M04"; recordJSON = "{\"id\":\"CDT-M04\",\"name\":\"Evidence-status and decision compiler\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C4\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S03\",\"CDT-S04\",\"CDT-S07\",\"CDT-S08\"],\"scope\":\"Combine currency, quality, applicability, criterion and finding records into separate claim-status reports. Preserve failed-gate context and human dispositions.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M05'> CDT_M05 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M05"; recordJSON = "{\"id\":\"CDT-M05\",\"name\":\"Occurrence BOM and scoped cost reducer\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C4\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S01\",\"CDT-S05\",\"CDT-S06\"],\"scope\":\"Traverse selected architecture occurrences and assembly quantities. Sum sourced prices and declared extra categories without replacing unknown prices with zero.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M06'> CDT_M06 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M06"; recordJSON = "{\"id\":\"CDT-M06\",\"name\":\"Mission scenario and EPS comparison harness\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C4\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S01\",\"CDT-S05\",\"CDT-S06\",\"CDT-S08\"],\"scope\":\"Compose demand histories, duty cycles, schedules, mode and protection events with environment histories. Freeze common EPS candidate criteria and retain raw runs and comparison limits.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M07'> CDT_M07 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M07"; recordJSON = "{\"id\":\"CDT-M07\",\"name\":\"Battery and FMI coupling controller\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C6\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S06\",\"CDT-S07\"],\"scope\":\"Couple the simpler EPS model and CPU PyBaMM electrical/thermal/identified-aging models. Manage FMI initialization, events, step policy, conservation and coupling checks.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M08'> CDT_M08 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M08"; recordJSON = "{\"id\":\"CDT-M08\",\"name\":\"Credibility, calibration and residual assessor\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C4\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S05\",\"CDT-S06\",\"CDT-S07\",\"CDT-S08\"],\"scope\":\"Register intended use and validity. Execute a declared bounded calibration recipe, preserve prior/proposed parameters and independent validation basis, and report residuals, hypotheses and uncertainty.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M09'> CDT_M09 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M09"; recordJSON = "{\"id\":\"CDT-M09\",\"name\":\"Observation quality and clock reconciler\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C4\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S04\",\"CDT-S07\",\"CDT-S08\"],\"scope\":\"Retain raw channels, calibration and active-unit mappings. Apply validity masks, clock transforms, skew/latency checks and declared alignment rules without filling missing samples as zero.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M10'> CDT_M10 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M10"; recordJSON = "{\"id\":\"CDT-M10\",\"name\":\"RAM coverage and FMEA transformer\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C4\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S01\",\"CDT-S03\",\"CDT-S05\",\"CDT-S06\",\"CDT-S08\"],\"scope\":\"Generate a qualitative FMEA and dependency representation from functions, occurrences and explicit failure/propagation rules. Report RAM method coverage and missing rates or recovery evidence.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M11'> CDT_M11 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M11"; recordJSON = "{\"id\":\"CDT-M11\",\"name\":\"Verification proposal and readiness compiler\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C4\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S03\",\"CDT-S07\",\"CDT-S08\"],\"scope\":\"Apply inspection/analysis/demonstration/test field profiles. Generate technician setup, DUT/equipment connections and evidence procedures. Block readiness for missing limits, isolation, aborts or review status.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M12'> CDT_M12 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M12"; recordJSON = "{\"id\":\"CDT-M12\",\"name\":\"EPS service mapping and sequence assessor\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C7\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S01\",\"CDT-S06\",\"CDT-S09\"],\"scope\":\"Check hardware/function/ground definition mappings against pinned cFS and F Prime profiles. Validate port/message definitions, simulate declared command guards/effects/recovery, and import target resource evidence.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
part <'CDT-M13'> CDT_M13 : SoftwareResource;
@PhysicalRecord { identifier = "CDT-M13"; recordJSON = "{\"id\":\"CDT-M13\",\"name\":\"Case, review and adoption packager\",\"kind\":\"software_module\",\"parent_component_id\":\"CDT-C8\",\"activation\":\"mandatory_core\",\"execution_node_id\":\"CDT-PN2\",\"execution_host_ids\":[\"CDT-H1\"],\"persistent_data_ids\":[\"CDT-S02\",\"CDT-S03\",\"CDT-S04\",\"CDT-S05\",\"CDT-S07\",\"CDT-S08\",\"CDT-S10\"],\"scope\":\"Render baseline-linked tables and bounded structure/interface views. Package replay instructions, core/case declarations, findings, task observations and actual resource/cost evidence.\",\"maturity\":\"proposed_development_item\",\"implementation_status\":\"not_implemented_or_verified_by_this_work\"}"; status = "proposed_development_item"; }
item <'CDT-S01'> CDT_S01 : DataResource;
@PhysicalRecord { identifier = "CDT-S01"; recordJSON = "{\"id\":\"CDT-S01\",\"name\":\"Controlled generic and case SysML v2 EPS model\",\"kind\":\"persistent_data\",\"parent_component_id\":\"CDT-C1\",\"activation\":\"mandatory_core\",\"logical_owner_id\":\"L03\",\"storage_node_id\":\"CDT-PN1\",\"storage_host_ids\":[\"CDT-H2\"],\"scope\":\"Native architecture, functions, occurrence bindings, interfaces, modes, states and shared service definitions. Case extensions reference the generic core. Requirements refer to S03.\",\"maturity\":\"proposed_schema_and_instance_content\"}"; status = "proposed_schema_and_instance_content"; }
item <'CDT-S02'> CDT_S02 : DataResource;
@PhysicalRecord { identifier = "CDT-S02"; recordJSON = "{\"id\":\"CDT-S02\",\"name\":\"Guidance, method and tailoring library\",\"kind\":\"persistent_data\",\"parent_component_id\":\"CDT-C1\",\"activation\":\"mandatory_core\",\"logical_owner_id\":\"L01\",\"storage_node_id\":\"CDT-PN1\",\"storage_host_ids\":[\"CDT-H2\"],\"scope\":\"Versioned source-linked examples, method applicability, exclusions, reviewed lessons and permitted case profiles. It does not assert standard compliance.\",\"maturity\":\"proposed_schema_and_instance_content\"}"; status = "proposed_schema_and_instance_content"; }
item <'CDT-S03'> CDT_S03 : DataResource;
@PhysicalRecord { identifier = "CDT-S03"; recordJSON = "{\"id\":\"CDT-S03\",\"name\":\"Requirement, decision and discrepancy records\",\"kind\":\"persistent_data\",\"parent_component_id\":\"CDT-C8\",\"activation\":\"mandatory_core\",\"logical_owner_id\":\"L02\",\"storage_node_id\":\"CDT-PN1\",\"storage_host_ids\":[\"CDT-H2\"],\"scope\":\"Identified needs/requirements, qualitative conditions or quantities, criteria references, rationale, semantic dependencies, affected claims, findings and dispositions.\",\"maturity\":\"proposed_schema_and_instance_content\"}"; status = "proposed_schema_and_instance_content"; }
item <'CDT-S04'> CDT_S04 : DataResource;
@PhysicalRecord { identifier = "CDT-S04"; recordJSON = "{\"id\":\"CDT-S04\",\"name\":\"Registration, mapping and released-baseline manifests\",\"kind\":\"persistent_data\",\"parent_component_id\":\"CDT-C3\",\"activation\":\"mandatory_core\",\"logical_owner_id\":\"L08\",\"storage_node_id\":\"CDT-PN1\",\"storage_host_ids\":[\"CDT-H2\"],\"scope\":\"Exact artifact revisions, schema/transform versions, hashes, identities, accepted/quarantined status, domain ownership, native mappings, environment lock files and run provenance. Rebuildable query indexes are projections.\",\"maturity\":\"proposed_schema_and_instance_content\"}"; status = "proposed_schema_and_instance_content"; }
item <'CDT-S05'> CDT_S05 : DataResource;
@PhysicalRecord { identifier = "CDT-S05"; recordJSON = "{\"id\":\"CDT-S05\",\"name\":\"Component, quote and lifecycle characterization\",\"kind\":\"persistent_data\",\"parent_component_id\":\"CDT-C8\",\"activation\":\"mandatory_core\",\"logical_owner_id\":\"L04\",\"storage_node_id\":\"CDT-PN1\",\"storage_host_ids\":[\"CDT-H2\"],\"scope\":\"Sourced rated/measured characteristics, component variants, quote scope/date/currency, occurrence quantities, failure modes, rate/exposure and recovery assumptions with unknowns. Derived BOM/FMEA outputs reference these inputs.\",\"maturity\":\"proposed_schema_and_instance_content\"}"; status = "proposed_schema_and_instance_content"; }
item <'CDT-S06'> CDT_S06 : DataResource;
@PhysicalRecord { identifier = "CDT-S06"; recordJSON = "{\"id\":\"CDT-S06\",\"name\":\"Frozen scenario, analysis and run packages\",\"kind\":\"persistent_data\",\"parent_component_id\":\"CDT-C5\",\"activation\":\"mandatory_core\",\"logical_owner_id\":\"L05\",\"storage_node_id\":\"CDT-PN1\",\"storage_host_ids\":[\"CDT-H2\"],\"scope\":\"Selected model/parameter/design/software revisions, initial state, history/event definitions, numerical settings, common comparison basis, raw outputs, logs, runtime observations and predefined result comparison rules.\",\"maturity\":\"proposed_schema_and_instance_content\"}"; status = "proposed_schema_and_instance_content"; }
item <'CDT-S07'> CDT_S07 : DataResource;
@PhysicalRecord { identifier = "CDT-S07"; recordJSON = "{\"id\":\"CDT-S07\",\"name\":\"Credibility, parameter and observation records\",\"kind\":\"persistent_data\",\"parent_component_id\":\"CDT-C8\",\"activation\":\"mandatory_core\",\"logical_owner_id\":\"L06\",\"storage_node_id\":\"CDT-PN1\",\"storage_host_ids\":[\"CDT-H2\"],\"scope\":\"Intended use, domains, calibration and validation identities, prior/proposed parameter sets, raw observation links, time/quality masks, residuals, diagnostic alternatives, uncertainty and applicability. Fitted values never overwrite component ratings.\",\"maturity\":\"proposed_schema_and_instance_content\"}"; status = "proposed_schema_and_instance_content"; }
item <'CDT-S08'> CDT_S08 : DataResource;
@PhysicalRecord { identifier = "CDT-S08"; recordJSON = "{\"id\":\"CDT-S08\",\"name\":\"Verification, facility and safety specifications\",\"kind\":\"persistent_data\",\"parent_component_id\":\"CDT-C8\",\"activation\":\"mandatory_core\",\"logical_owner_id\":\"L07\",\"storage_node_id\":\"CDT-PN1\",\"storage_host_ids\":[\"CDT-H2\"],\"scope\":\"Method-specific criterion and capture contracts, DUT/equipment/pinout identities, conditions, sequence, operating/fault bounds, hazards, isolation, abort/recovery and responsible review status. EPS and framework subjects remain distinct.\",\"maturity\":\"proposed_schema_and_instance_content\"}"; status = "proposed_schema_and_instance_content"; }
item <'CDT-S09'> CDT_S09 : DataResource;
@PhysicalRecord { identifier = "CDT-S09"; recordJSON = "{\"id\":\"CDT-S09\",\"name\":\"Target software profiles and resource ledger\",\"kind\":\"persistent_data\",\"parent_component_id\":\"CDT-C7\",\"activation\":\"mandatory_core\",\"logical_owner_id\":\"L03\",\"storage_node_id\":\"CDT-PN1\",\"storage_host_ids\":[\"CDT-H2\"],\"scope\":\"Mappings from authoritative S01 service fields to selected cFS/F Prime versions, encodings, ground dictionaries, handwritten artifact links, OBC/OS/compiler profiles and measured/estimated/unknown budgets. Exported dictionaries are projections.\",\"maturity\":\"proposed_schema_and_instance_content\"}"; status = "proposed_schema_and_instance_content"; }
item <'CDT-S10'> CDT_S10 : DataResource;
@PhysicalRecord { identifier = "CDT-S10"; recordJSON = "{\"id\":\"CDT-S10\",\"name\":\"Case, review and framework evaluation records\",\"kind\":\"persistent_data\",\"parent_component_id\":\"CDT-C8\",\"activation\":\"mandatory_core\",\"logical_owner_id\":\"L09\",\"storage_node_id\":\"CDT-PN1\",\"storage_host_ids\":[\"CDT-H2\"],\"scope\":\"Frozen core manifest, permitted case adaptations, reviewer tasks and findings, lesson proposals, wall-clock and active effort observations, sourced direct costs and outcome limitations.\",\"maturity\":\"proposed_schema_and_instance_content\"}"; status = "proposed_schema_and_instance_content"; }
action <'CDT-P7'> CDT_P7 : OperatingProcedure;
@PhysicalRecord { identifier = "CDT-P7"; recordJSON = "{\"id\":\"CDT-P7\",\"name\":\"Framework evaluation and constrained case tailoring\",\"kind\":\"operational_procedure\",\"activation\":\"mandatory_verification_procedure\",\"performer_roles\":[\"Systems Engineer acting as framework evaluator\",\"Qualified independent reproducer\",\"Project Manager for cost scope\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\",\"CDT-H3\"],\"data_ids\":[\"CDT-S10\",\"CDT-S04\"],\"scope\":\"Freeze the core and protocol before two contrasting cases. Declare participants and correctness references. Record actual tasks and case adaptations. Any core correction requires a visible successor and reevaluation of both cases.\",\"maturity\":\"proposed\",\"procedure_id\":\"CDT-P7\",\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"}"; status = "proposed"; }
ref part <'external_future_target_not_core'> external_future_target_not_core : HostResource;
@PhysicalRecord { identifier = "external_future_target_not_core"; recordJSON = "{\"id\":\"external_future_target_not_core\",\"name\":\"external_future_target_not_core\",\"status\":\"external or undeclared resource reference from source inventory, availability unknown\"}"; status = "external or undeclared resource reference from source inventory, availability unknown"; }
}
