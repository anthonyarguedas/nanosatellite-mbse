@PhysicalRecord { identifier = "allocate_FR_21_CDT_M08"; recordJSON = "{\"requirement_id\":\"FR-21\",\"requirement_title\":\"Intended-use credibility\",\"logical_component_ids\":[\"L06\",\"L07\"],\"primary_logical_owner_id\":\"L06\",\"physical_component_ids\":[\"CDT-M08\",\"CDT-M04\",\"CDT-S07\",\"CDT-S08\",\"CDT-P3\"],\"realization_mechanism\":\"Applicability assessor binds analytical claims to intended use, tested load/temperature/health/mode domains, distinct calibration/validation data, residual metrics and prior error/uncertainty rules.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E11\",\"CDT-E16\",\"CDT-E20\"],\"source_locators\":[{\"evidence_id\":\"CDT-E11\",\"source_key\":\"handpicked-0001\",\"locator\":\"`handpicked-0001`, pp. 7–9, System Implementation and Evaluation\",\"source_maturity\":\"preprint_dataset_evaluation\"},{\"evidence_id\":\"CDT-E16\",\"source_key\":\"review-1251\",\"locator\":\"`review-1251`, pp. 22–24 and 31–32, Sections 4.1–5.1 and 6–7\",\"source_maturity\":\"qualification_telemetry_replay\"},{\"evidence_id\":\"CDT-E20\",\"source_key\":\"psr-0024\",\"locator\":\"`psr-0024`, pp. 14–18, Sections 8.2–9 and Tables 13–14\",\"source_maturity\":\"review_synthesis\"}],\"verification_id\":\"V21\",\"verification_method\":\"I,T\",\"planned_acceptance\":\"Exercise an in-domain and an extrapolated claim. Separate calibration from validation data where available. Flag untested domains and absent error limits. Prediction accuracy limits require prior agreement.\",\"implementation_gap\":\"Applicability logic, holdout provenance and agreed use-specific prediction limits need development.\",\"boundary_authority_note\":\"In-domain evidence can support only its named EPS decision. Extrapolation remains visible and cannot gain an unqualified label.\",\"boundary_interface_ids\":[\"IF-03\",\"IF-05\",\"IF-06\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-09\"],\"moe_ids\":[\"MOE-05\",\"MOE-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
