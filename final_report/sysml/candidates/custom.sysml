@PhysicalRecord { identifier = "allocate_FR_25_CDT_M08"; recordJSON = "{\"requirement_id\":\"FR-25\",\"requirement_title\":\"Anomaly assessment\",\"logical_component_ids\":[\"L06\"],\"primary_logical_owner_id\":\"L06\",\"physical_component_ids\":[\"CDT-M08\",\"CDT-M09\",\"CDT-S07\",\"CDT-S06\",\"CDT-P3\"],\"realization_mechanism\":\"Expected/observed comparator applies mode/active-unit validity, declared sensor/model tolerances and aging context, retaining residuals and alternative model, fault, external-supply or measurement explanations.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E16\"],\"source_locators\":[{\"evidence_id\":\"CDT-E16\",\"source_key\":\"review-1251\",\"locator\":\"`review-1251`, pp. 22–24 and 31–32, Sections 4.1–5.1 and 6–7\",\"source_maturity\":\"qualification_telemetry_replay\"}],\"verification_id\":\"V25\",\"verification_method\":\"A,T\",\"planned_acceptance\":\"Use nominal, degrading, noisy and injected-fault fixtures. Retain residuals and diagnoses with TP, FP and FN against an expert reference. No pre-threshold detection capability is presumed.\",\"implementation_gap\":\"Diagnostic rules, expert-reference fixtures and TP/FP/FN assessment are unimplemented.\",\"boundary_authority_note\":\"A residual is a hypothesis. No confirmed physical fault or pre-threshold detection performance is presumed.\",\"boundary_interface_ids\":[\"IF-05\",\"IF-06\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-05\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-04\"],\"moe_ids\":[\"MOE-04\",\"MOE-05\"]}"; status = "proposed comparison description, not implemented or verified"; }
