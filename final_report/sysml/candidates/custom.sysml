@PhysicalRecord { identifier = "allocate_FR_39_CDT_H3"; recordJSON = "{\"requirement_id\":\"FR-39\",\"requirement_title\":\"Minimum adoption and measurement package\",\"logical_component_ids\":[\"L09\",\"L01\",\"L08\"],\"primary_logical_owner_id\":\"L09\",\"physical_component_ids\":[\"CDT-M13\",\"CDT-S02\",\"CDT-S04\",\"CDT-S10\",\"CDT-P6\",\"CDT-P7\",\"CDT-H1\",\"CDT-H2\",\"CDT-H3\"],\"realization_mechanism\":\"Core environment manifest lists pinned editor/runtime/solver profiles, resources, license conditions and learning tasks. Evaluation ledger records observed adoption/adaptation/change/replay effort and sourced direct cost for each active profile.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E04\",\"CDT-E20\",\"CDT-E22\"],\"source_locators\":[{\"evidence_id\":\"CDT-E04\",\"source_key\":\"review-0602\",\"locator\":\"`review-0602`, pp. 14–21, Sections 3.3–6\",\"source_maturity\":\"software_proof_of_concept\"},{\"evidence_id\":\"CDT-E20\",\"source_key\":\"psr-0024\",\"locator\":\"`psr-0024`, pp. 14–18, Sections 8.2–9 and Tables 13–14\",\"source_maturity\":\"review_synthesis\"},{\"evidence_id\":\"CDT-E22\",\"source_key\":\"cubesat-handbook-part-i\",\"locator\":\"CubeSat Handbook, Part I, I.3–I.5, physical PDF pp. 22–37\",\"source_maturity\":\"domain_method_guidance\"}],\"verification_id\":\"V39\",\"verification_method\":\"I,D\",\"planned_acceptance\":\"Demonstrate the minimum workflow from a clean declared environment. Record wall-clock time separately from active person-hours and state the cost period and inclusions. Unknown cost stays unknown.\",\"implementation_gap\":\"Actual dependency/license compatibility and clean-start trials are unresolved. No resource size, cost or effort is known.\",\"boundary_authority_note\":\"Optional GPU/Isaac and future HIL burdens are declared separately. Existing resources are not assumed free or newly purchased.\",\"boundary_interface_ids\":[\"IF-01\",\"IF-02\",\"IF-06\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-11\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-11\",\"MR-09\"],\"moe_ids\":[\"MOE-09\",\"MOE-11\"]}"; status = "proposed comparison description, not implemented or verified"; }
