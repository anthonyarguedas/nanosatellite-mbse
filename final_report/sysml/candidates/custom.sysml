@PhysicalRecord { identifier = "allocate_FR_34_CDT_M12"; recordJSON = "{\"requirement_id\":\"FR-34\",\"requirement_title\":\"Flight framework mapping\",\"logical_component_ids\":[\"L03\",\"L05\"],\"primary_logical_owner_id\":\"L03\",\"physical_component_ids\":[\"CDT-M12\",\"CDT-C6\",\"CDT-S09\",\"CDT-S06\",\"CDT-P5\"],\"realization_mechanism\":\"Separate pinned profiles validate cFS application/message/software-bus ownership and F Prime component/typed-port/topology mapping. Build-service responses report unsupported exports and mission behavior gaps.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E17\",\"CDT-E18\",\"CDT-E19\"],\"source_locators\":[{\"evidence_id\":\"CDT-E17\",\"source_key\":\"review-0853\",\"locator\":\"`review-0853`, pp. 7–10 and 16–17, Sections 3 and 5\",\"source_maturity\":\"architecture_generation_proof_of_concept\"},{\"evidence_id\":\"CDT-E18\",\"source_key\":\"review-0853\",\"locator\":\"`review-0853`, pp. 10–14 and 16, Sections 3–5\",\"source_maturity\":\"architecture_generation_proof_of_concept\"},{\"evidence_id\":\"CDT-E19\",\"source_key\":\"citation-0136\",\"locator\":\"`citation-0136`, pp. 7–9 and 12–15, Sections III.A.3, IV.A.1, V, and VI\",\"source_maturity\":\"embedded_software_flatsat_case\"}],\"verification_id\":\"V34\",\"verification_method\":\"D,T\",\"planned_acceptance\":\"Round-trip or validate reference message and port mappings in both profiles. Declare framework version and unsupported exports. Architecture or dictionary generation is distinct from mission-specific functionality.\",\"implementation_gap\":\"Release-specific cFS and F Prime schemas, fixtures and build/validation service contracts remain to be chosen and tested.\",\"boundary_authority_note\":\"No complete flight software generation is claimed. Target implementations are engineered artifacts through IF-04.\",\"boundary_interface_ids\":[\"IF-04\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-08\"],\"mission_requirement_ids\":[\"MR-08\"],\"moe_ids\":[\"MOE-08\"]}"; status = "proposed comparison description, not implemented or verified"; }
