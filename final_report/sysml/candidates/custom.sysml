#intendedRealization allocation allocate_FR_10_CDT_M06 allocate FrameworkRequirements::FR_10 to physical.CDT_M06;
@PhysicalRecord { identifier = "allocate_FR_10_CDT_M06"; recordJSON = "{\"requirement_id\":\"FR-10\",\"requirement_title\":\"Independent replay\",\"logical_component_ids\":[\"L05\",\"L08\",\"L09\"],\"primary_logical_owner_id\":\"L05\",\"physical_component_ids\":[\"CDT-M06\",\"CDT-M13\",\"CDT-S04\",\"CDT-S06\",\"CDT-P3\",\"CDT-P7\",\"CDT-H3\"],\"realization_mechanism\":\"Replay pack resolves locked runtime/solver dependencies, exact inputs and instructions in a separate clean environment. A result comparator applies the previously released variable-specific rules and tolerances.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E03\",\"CDT-E04\",\"CDT-E20\"],\"source_locators\":[{\"evidence_id\":\"CDT-E03\",\"source_key\":\"review-1563\",\"locator\":\"`review-1563`, pp. 4–5 and 10–13, Sections 4–6\",\"source_maturity\":\"simulation_proof_of_concept\"},{\"evidence_id\":\"CDT-E04\",\"source_key\":\"review-0602\",\"locator\":\"`review-0602`, pp. 14–21, Sections 3.3–6\",\"source_maturity\":\"software_proof_of_concept\"},{\"evidence_id\":\"CDT-E20\",\"source_key\":\"psr-0024\",\"locator\":\"`psr-0024`, pp. 14–18, Sections 8.2–9 and Tables 13–14\",\"source_maturity\":\"review_synthesis\"}],\"verification_id\":\"V10\",\"verification_method\":\"D,T\",\"planned_acceptance\":\"An independent participant replays a baseline from a clean declared environment. Retain logs, seeds when relevant, failures and comparison verdicts. Tolerances are fixed before replay.\",\"implementation_gap\":\"Environment reconstruction, tool/license availability and comparator fixtures are pending.\",\"boundary_authority_note\":\"Independent replay does not prove the EPS model is accurate. No operational replica replacement is credited.\",\"boundary_interface_ids\":[\"IF-03\",\"IF-06\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-09\"],\"mission_requirement_ids\":[\"MR-09\"],\"moe_ids\":[\"MOE-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
