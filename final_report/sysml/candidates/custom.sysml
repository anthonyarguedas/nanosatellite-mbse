#intendedRealization allocation allocate_FR_20_CDT_M07 allocate FrameworkRequirements::FR_20 to physical.CDT_M07;
@PhysicalRecord { identifier = "allocate_FR_20_CDT_M07"; recordJSON = "{\"requirement_id\":\"FR-20\",\"requirement_title\":\"Battery model coupling\",\"logical_component_ids\":[\"L05\",\"L06\",\"L04\"],\"primary_logical_owner_id\":\"L05\",\"physical_component_ids\":[\"CDT-M07\",\"CDT-M08\",\"CDT-C5\",\"CDT-C6\",\"CDT-S06\",\"CDT-S07\"],\"realization_mechanism\":\"CPU coupling integrates a simple EPS model with identified PyBaMM electrical, lumped thermal and aging submodels. Fresh/aged fixture profiles expose state/health/lifetime outputs only when supported and retain omitted mechanisms.\",\"maturity_evidence_status\":\"reported_or_synthesized_pattern_plus_proposed_realization\",\"evidence_ids\":[\"CDT-E11\",\"CDT-E15\",\"CDT-E06\"],\"source_locators\":[{\"evidence_id\":\"CDT-E11\",\"source_key\":\"handpicked-0001\",\"locator\":\"`handpicked-0001`, pp. 7–9, System Implementation and Evaluation\",\"source_maturity\":\"preprint_dataset_evaluation\"},{\"evidence_id\":\"CDT-E15\",\"source_key\":\"review-0573\",\"locator\":\"`review-0573`, pp. 4, 7–8, and 13–14, Sections 2 and 5\",\"source_maturity\":\"hardware_correlation_chil_phil_case\"},{\"evidence_id\":\"CDT-E06\",\"source_key\":\"handpicked-0003\",\"locator\":\"`handpicked-0003`, pp. 4 and 6–8, Sections 3 and 6.2\",\"source_maturity\":\"laboratory_case_partial_qualification\"}],\"verification_id\":\"V20\",\"verification_method\":\"A,D\",\"planned_acceptance\":\"Replay fresh and aged battery fixtures under different load and temperature profiles. Verify coupling and provenance. Missing aging mechanisms and latent-state uncertainty remain visible.\",\"implementation_gap\":\"Mandatory offline aging integration and representative fresh/aged correlation are not implemented. A fixed aging parameter alone cannot close this leaf.\",\"boundary_authority_note\":\"SOC/SOH/lifetime are model-dependent estimates. Dataset results do not establish CubeSat pack validity.\",\"boundary_interface_ids\":[\"IF-03\",\"IF-05\"],\"design_coverage\":\"specific_intended_realization_with_explicit_gap\",\"verification_status\":\"planned_not_executed\",\"satisfaction_status\":\"not_established\",\"eligibility_status\":\"not_established\",\"mission_need_ids\":[\"MN-05\"],\"mission_requirement_ids\":[\"MR-05\"],\"moe_ids\":[\"MOE-05\"]}"; status = "proposed comparison description, not implemented or verified"; }
