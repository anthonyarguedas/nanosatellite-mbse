// Reviewed lineage PA-CDT. Native candidate technology remains distinct from this SysML comparison description.
package CandidateCDT {
private import FrameworkDomain::*;
private import PhysicalVocabulary::*;
doc /* CSRM digital thread for EPS engineering. Complete implementation and empirical framework verification remain pending. The source record packages preserve native technologies, authority rules, resource/performance profiles, uncertainties and maturity. */
item candidateProfile : EngineeringArtifact;
@PhysicalRecord { identifier = "PA-CDT"; recordJSON = "{\"id\":\"PA-CDT\",\"name\":\"CSRM digital thread for EPS engineering\",\"baseline_head\":\"b826d9915407bbd861d8d39b2558048f3d534bdc\",\"status\":\"author_reviewed_design_allocations_proposed_implementation_and_verification_pending\",\"system_of_interest\":\"EPS engineering framework\",\"boundary\":{\"included\":[\"requirements guidance\",\"engineering model development\",\"analysis integration\",\"configuration and evidence control\",\"verification planning\",\"review and adoption support\"],\"engineered_artifacts\":[\"EPS hardware\",\"EPS firmware\",\"spacecraft flight software\",\"ground software\"],\"external_or_future\":[\"physical testing facility and execution authorization\",\"HIL and flight target hardware execution\",\"flight operations and operational control\",\"domain contributor source truth and supplied measurements\",\"declared external specialist and software build services\"],\"integrated_dependencies\":[\"native SysML v2 toolchain\",\"Python runtime\",\"Git and custody mechanisms\",\"CPU PyBaMM and simpler EPS models\",\"FMI runtime\",\"declared calibration solver\"]},\"id_policy\":\"FR, MN, MR, MOE, L, IF and V IDs follow the reviewed common baseline. All physical and evidence IDs are CDT-scoped. Candidate-local original IDs are retained.\",\"activation_policy\":\"Mandatory CPU core. Optional Omniverse/OpenUSD/Isaac/GPU fidelity for decision-specific profiles. Future HIL external. No selection credit for undemonstrated optional capabilities.\",\"sources\":[{\"key\":\"citation-2362\",\"report_bib_key\":\"kaslow2019csrm\",\"title\":\"Developing a CubeSat System MBSE Reference Model - Interim Status #5\",\"path\":\"SLR/SLR1/pdfs/citation-reports/citation-report-2362/citation-report-2362.md\",\"maturity\":\"reference_model\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E01\",\"supported_claim\":\"CSRM supplies reusable space and ground logical architecture and relationships among stakeholders, requirements, architecture, measures, and use cases. Mission teams prune, extend, or replace content.\",\"locator\":\"`citation-2362`, pp. 2–5, CSRM, CSRM Application, and Transition sections\",\"maturity_and_limit\":\"Reported SysML v1 reference model. It is a tailoring basis, not a ready EPS requirements set.\"},{\"id\":\"E02\",\"supported_claim\":\"The mission model is maintained as a central design baseline. Component power, weight, cost, and performance can roll up. Verification activities can reference plans, procedures, results, and status.\",\"locator\":\"`citation-2362`, pp. 5–6, MSM Verification and Validation\",\"maturity_and_limit\":\"Reported modeling pattern. The paper says power, weight, and cost parametrics had not been added to CSRM, p. 6. BOM and cost automation remain proposed.\"}]},{\"key\":\"review-1563\",\"report_bib_key\":null,\"title\":\"Integrated Model-Based Systems Engineering (MBSE) Applied to the Simulation of a CubeSat Mission\",\"path\":\"SLR/SLR1/pdfs/review-reports/review-report-1563/review-report-1563.md\",\"maturity\":\"simulation_proof_of_concept\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E03\",\"supported_claim\":\"SysML behavior called STK, MATLAB, and Java analyses through ModelCenter and MBSE Analyzer. Returned time histories supported solar area and battery capacity trades and mission requirement checks.\",\"locator\":\"`review-1563`, pp. 4–5 and 10–13, Sections 4–6\",\"maturity_and_limit\":\"Reported simulation proof of concept. It concentrates on energy and data, with several other subsystems simplified. It does not validate a Python or SysML v2 bridge.\"}]},{\"key\":\"review-0602\",\"report_bib_key\":\"luccisano2024formalization\",\"title\":\"Open-Source Data Formalization through Model-Based Systems Engineering for Concurrent Preliminary Design of CubeSats\",\"path\":\"SLR/SLR1/pdfs/review-reports/review-report-0602/review-report-0602.md\",\"maturity\":\"software_proof_of_concept\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E04\",\"supported_claim\":\"A Python parser extracts model data, requirements lists, and dependency graphs and can write analysis updates back. Its demonstrated parser is Gaphor specific.\",\"locator\":\"`review-0602`, pp. 14–21, Sections 3.3–6\",\"maturity_and_limit\":\"Reported software proof of concept on a theoretical academic mission. The paper identifies missing safe/off-nominal and early orbit coverage. Parser code is GPLv3.\"}]},{\"key\":\"handpicked-0003\",\"report_bib_key\":\"handpicked-0003\",\"title\":\"A Framework for sizing, designing, and testing of Electrical Power System for nanosatellites: A case study of a 3U university Cubesat\",\"path\":\"SLR/SLR1/pdfs/handpicked-reports/handpicked-report-0003/handpicked-report-0003.md\",\"maturity\":\"laboratory_case_partial_qualification\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E05\",\"supported_claim\":\"EPS development proceeds through mission definition, preliminary power budget, topology and component selection, and functional and environmental verification. Thermal and EMC analyses precede fabrication.\",\"locator\":\"`handpicked-0003`, pp. 2–5, Sections 2–5\",\"maturity_and_limit\":\"Reported lifecycle method with one 3U hardware case. Useful procedure structure. It does not establish this framework's trace or reproduction services.\"},{\"id\":\"E06\",\"supported_claim\":\"A mission simulation relates attitude and communication modes to solar generation, load peaks, and battery discharge. Battery sizing considers mission cycles and depth of discharge.\",\"locator\":\"`handpicked-0003`, pp. 4 and 6–8, Sections 3 and 6.2\",\"maturity_and_limit\":\"Reported sizing and simulation case. Its empirical aging equation, margins, topology, and thresholds require independent applicability checks. They are not generic framework constants.\"},{\"id\":\"E07\",\"supported_claim\":\"Battery protection is simulated in LTspice before experimental overcurrent and undervoltage/overvoltage checks. The equipment setup identifies power supply, electronic loads, multimeter, and oscilloscope.\",\"locator\":\"`handpicked-0003`, pp. 11 and 13–14, Sections 8.1 and 8.1.6\",\"maturity_and_limit\":\"Reported laboratory mechanism. A simulated fault is useful for planning. It does not establish a universally safe hardware injection limit.\"},{\"id\":\"E08\",\"supported_claim\":\"The telemetry test couples STK attitude data to an OBC, records dynamic ADCS current, and checks timestamped telemetry identities, uptime, channel currents, modes, and temperatures.\",\"locator\":\"`handpicked-0003`, p. 14 and Figs. 25–26 on pp. 18–19, Section 8.1.7\",\"maturity_and_limit\":\"Reported HIL case, external to the current project scope. Sampling and mission behavior are case specific.\"},{\"id\":\"E09\",\"supported_claim\":\"Thermal vacuum results are reported through referenced work. EMC, radiation, and mechanical qualification tests were not performed and are future work. Data are confidential.\",\"locator\":\"`handpicked-0003`, pp. 16–18, Section 8.2 and Data availability\",\"maturity_and_limit\":\"Partial qualification. The conclusion's broader flight readiness wording should not conceal these explicit limits.\"}]},{\"key\":\"handpicked-0001\",\"report_bib_key\":\"handpicked-0001\",\"title\":\"Towards Intelligent Systems for Battery Management: A Five-Tier Digital Twin Architecture\",\"path\":\"SLR/SLR1/pdfs/handpicked-reports/handpicked-report-0001/handpicked-report-0001.md\",\"maturity\":\"preprint_dataset_evaluation\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E10\",\"supported_claim\":\"Omniverse supplies a USD scene, semantic identities, units, coordinate frames, telemetry and simulation bindings, and read/write visualization APIs.\",\"locator\":\"`handpicked-0001`, pp. 3–5, Architecture Overview and Virtual 3D Environment Module\",\"maturity_and_limit\":\"Reported battery architecture and visualization. Transfer to CubeSat geometry and interfaces is proposed.\"},{\"id\":\"E11\",\"supported_claim\":\"PyBaMM electrochemical and lumped thermal models are calibrated against XJTU battery data. SOH prediction and an uncertainty proxy are evaluated. The dataset includes a satellite-use profile.\",\"locator\":\"`handpicked-0001`, pp. 7–9, System Implementation and Evaluation\",\"maturity_and_limit\":\"Reported dataset evaluation in a 2025 preprint. It does not demonstrate a CubeSat pack, radiation effects, safe hardware control, or the full autonomous closed loop. Its errors do not transfer to this candidate.\"}]},{\"key\":\"handpicked-0002\",\"report_bib_key\":\"handpicked-0002\",\"title\":\"Physics-Based Digital Twins for Co-Simulation\",\"path\":\"SLR/SLR1/pdfs/handpicked-reports/handpicked-report-0002/handpicked-report-0002.md\",\"maturity\":\"workshop_presentation_proof_of_concept\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E12\",\"supported_claim\":\"The presentation combines Python, OpenModelica, Kit extensions, FMI/FMU, and external solvers. Isaac examples include UUV battery consumption and energy tracking for a lunar robot.\",\"locator\":\"`handpicked-0002`, slides/PDF pp. 8–18\",\"maturity_and_limit\":\"Workshop demonstration and architectural patterns. The examples are not CubeSat EPS validation.\"},{\"id\":\"E13\",\"supported_claim\":\"USD plus FMI integration is described as an MVP and open sample proof of concept. Standard and implementation work is in progress.\",\"locator\":\"`handpicked-0002`, slides/PDF pp. 20–24\",\"maturity_and_limit\":\"Explicitly immature integration. FMI itself and proposed USD bindings have different maturity. Compatibility and clock behavior require checks.\"}]},{\"key\":\"review-0573\",\"report_bib_key\":\"review-0573\",\"title\":\"Implementation of a 6U CubeSat Electrical Power System Digital Twin\",\"path\":\"SLR/SLR1/pdfs/review-reports/review-report-0573/review-report-0573.md\",\"maturity\":\"hardware_correlation_chil_phil_case\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E14\",\"supported_claim\":\"A 6U EPS model represents solar arrays, regulators, battery, PDU, and loads. Python updates inputs. A simplified one-array/one-regulator model is compared with hardware before CHIL and PHIL demonstrations. The complete model is then used for an orbit simulation.\",\"locator\":\"`review-0573`, pp. 3–12, Sections 2–4\",\"maturity_and_limit\":\"Reported laboratory correlation of a simplified EPS model on Typhoon HIL. It supports an assurance sequence, not the new implementation's real-time capability.\"},{\"id\":\"E15\",\"supported_claim\":\"The 6U model fixes battery temperature and health, simplifies switching converters and PDU loads, and omits solar and battery degradation and cell balancing.\",\"locator\":\"`review-0573`, pp. 4, 7–8, and 13–14, Sections 2 and 5\",\"maturity_and_limit\":\"Explicit model limits. This source alone cannot justify coupled thermal or lifetime predictions. Replacing physical mission replicas remains a possibility.\"}]},{\"key\":\"review-1251\",\"report_bib_key\":\"review-1251\",\"title\":\"Model-Based Fault Detection and Diagnosis for Spacecraft with an Application for the SONATE Triple Cube Nano-Satellite\",\"path\":\"SLR/SLR1/pdfs/review-reports/review-report-1251/review-report-1251.md\",\"maturity\":\"qualification_telemetry_replay\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E16\",\"supported_claim\":\"SONATE diagnosis compares expected behavior with telemetry. Calibration, tolerance intervals, state-dependent valid values, and conditional component mappings are required. Poor models produce false positives and negatives.\",\"locator\":\"`review-1251`, pp. 22–24 and 31–32, Sections 4.1–5.1 and 6–7\",\"maturity_and_limit\":\"Reported replay and manipulated qualification telemetry experiments. An apparent transceiver fault was an unmodeled external supply, pp. 25–26. Onboard use and automatic recalibration were future work.\"}]},{\"key\":\"review-0853\",\"report_bib_key\":\"review-0853\",\"title\":\"Architecture Framework Standardization for Satellite Software Generation Using MBSE and F Prime\",\"path\":\"SLR/SLR1/pdfs/review-reports/review-report-0853/review-report-0853.md\",\"maturity\":\"architecture_generation_proof_of_concept\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E17\",\"supported_claim\":\"SysML hardware and software groupings can differ. A MagicDraw plugin exports F Prime architecture, while mission functionality and command, telemetry, event, and parameter definitions need separate work in the reported workflow.\",\"locator\":\"`review-0853`, pp. 7–10 and 16–17, Sections 3 and 5\",\"maturity_and_limit\":\"Reported architecture generation proof of concept. It does not provide a native SysML v2 generator. Current F Prime support must be checked against a pinned release.\"},{\"id\":\"E18\",\"supported_claim\":\"Software view products include command conditions and impacts, dictionaries, interface descriptions, software requirements, model cohesion, and V&V plans. F Prime typed connections and cFS publish-subscribe require different mappings.\",\"locator\":\"`review-0853`, pp. 10–14 and 16, Sections 3–5\",\"maturity_and_limit\":\"Reported framework distinctions and proposed view taxonomy. No general cross-framework code generator is validated.\"}]},{\"key\":\"citation-0136\",\"report_bib_key\":\"citation-0136\",\"title\":\"CubeSat Flight Software: Insights and a Case Study\",\"path\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0136/citation-report-0136.md\",\"maturity\":\"embedded_software_flatsat_case\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E19\",\"supported_claim\":\"The PHI-Demo software separates EPS control, telemetry collection, FDIR, and script management. Resource checks include CPU, memory, and task traces. Processor and OS choice affect power.\",\"locator\":\"`citation-0136`, pp. 7–9 and 12–15, Sections III.A.3, IV.A.1, V, and VI\",\"maturity_and_limit\":\"Reported embedded software and FlatSat case. The selected implementation is FreeRTOS based, not a validation of cFS or F Prime. Version-specific OS claims need current checking.\"}]},{\"key\":\"psr-0024\",\"report_bib_key\":\"rostamnia2026digitaltwin\",\"title\":\"Digital Twin Models for Space Robotics: Objectives, Applications, and Challenges\",\"path\":\"SLR/SLR1/pdfs/psr-reports/psr-report-0024.md\",\"maturity\":\"review_synthesis\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E20\",\"supported_claim\":\"Digital thread continuity requires explicit coupling and synchronization, model validity, uncertainty, contracts, configuration control, data quality, and integration V&V. Higher fidelity increases computing and validation effort.\",\"locator\":\"`psr-0024`, pp. 14–18, Sections 8.2–9 and Tables 13–14\",\"maturity_and_limit\":\"Review synthesis and design principles. It establishes research gaps and mechanisms, not this framework's benefits.\"}]},{\"key\":\"oosem-guide\",\"report_bib_key\":\"friedenthal2014practical\",\"title\":\"A Practical Guide to SysML, Third Edition\",\"path\":\"/Users/antho/agent-tools/books/library/A practical guide to SysML (includes OOSEM)\",\"maturity\":\"method_guidance\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E21\",\"supported_claim\":\"Physical architecture includes software, hardware, persistent data, and procedures. Node partitioning can follow organizational responsibility. Logical distribution precedes technology allocation.\",\"locator\":\"Friedenthal et al., Section 17.3.5, PDF pp. 468–480 and 486–495\",\"maturity_and_limit\":\"OOSEM method guidance. It permits cohosted services and procedure realizations.\"}]},{\"key\":\"cubesat-handbook-part-i\",\"report_bib_key\":null,\"title\":\"CubeSat Handbook: Systems engineering applied to CubeSats, Part I\",\"path\":\"/Users/antho/agent-tools/books/library/CubeSat Handbook - From Mission Design to Operations\",\"maturity\":\"domain_method_guidance\",\"verification\":\"central_claims_checked_in_source_markdown\",\"evidence\":[{\"id\":\"E22\",\"supported_claim\":\"CubeSat requirements should be atomic, quantified, feasible, necessary, and verifiable. Review packages mature requirements, interfaces, budgets, AIV plans, and verification records. Costs include effort, facilities, supplies, and uncertainty.\",\"locator\":\"*CubeSat Handbook*, Part I, Sections 1.3–1.5, PDF pp. 22–37\",\"maturity_and_limit\":\"Domain method guidance. Requirements examples and cost heuristics are not adopted as thresholds or estimates.\"}]},{\"key\":\"baseline-csrm-conversion\",\"path\":[\"csrm-sysmlv2/README.md\",\"csrm-sysmlv2/PENDING.md\"],\"maturity\":\"documented_partial_repository_asset\",\"supported_claim\":\"Partial native conversion and source audits exist. Relevant requirement, stakeholder, behavior, V&V, quantity, and runtime evaluation work remains. Documented semantic checks were not rerun.\",\"source_baseline\":\"b826d9915407bbd861d8d39b2558048f3d534bdc\"}],\"nodes\":[{\"id\":\"CDT-LN1\",\"level\":\"logical\",\"name\":\"Engineering definition and configuration\",\"responsibilities\":\"Requirements guidance, stakeholder and mission context, EPS structure and interfaces, component catalog, BOM, cost basis, hardware/software mappings, dictionaries, baseline identities, dependency and change records\",\"rationale\":\"Requirements and design edits need one controlled semantic baseline. Fast edits must identify dependent budgets, evidence, and software artifacts.\",\"status\":\"proposed_product_neutral_distribution\"},{\"id\":\"CDT-LN2\",\"level\":\"logical\",\"name\":\"Analysis execution and model assurance\",\"responsibilities\":\"Dynamic load/environment histories, EPS and battery calculations, specialist tool adapters, RAM analysis inputs, model calibration and validity, uncertainty, fault scenarios, telemetry quality, independent reproduction packages\",\"rationale\":\"Analyses need isolated, replaceable tools and reproducible inputs. Calculation success and decision credibility are separate judgments.\",\"status\":\"proposed_product_neutral_distribution\"},{\"id\":\"CDT-LN3\",\"level\":\"logical\",\"name\":\"Verification planning and decision communication\",\"responsibilities\":\"Pass/fail criteria, tailored method and standard records, technician packages, safety and interface review, evidence interpretation, discrepancy disposition, readable review views, onboarding and adoption observations\",\"rationale\":\"V&V plans must serve EPS, non-EPS, and technician roles. Human acceptance and safety authority remain explicit.\",\"status\":\"proposed_product_neutral_distribution\"},{\"id\":\"CDT-PN1\",\"level\":\"physical\",\"name\":\"Engineering workspace and controlled store\",\"activation\":\"mandatory_core\",\"logical_nodes\":[\"CDT-LN1\",\"CDT-LN3\"],\"resources\":[\"CDT-H1\",\"CDT-H2\"],\"cohosting\":\"May share a CPU computer with PN2. Access and released identities remain distinct.\"},{\"id\":\"CDT-PN2\",\"level\":\"physical\",\"name\":\"Isolated Python analysis workspace\",\"activation\":\"mandatory_core\",\"logical_nodes\":[\"CDT-LN2\"],\"resources\":[\"CDT-H1\",\"CDT-H2\"],\"isolation\":\"Declared environment and bounded adapters. No initial physical command path.\"},{\"id\":\"CDT-PN3\",\"level\":\"physical\",\"name\":\"Omniverse and Isaac extension workspace\",\"activation\":\"optional_decision_specific_profile\",\"logical_nodes\":[\"CDT-LN2\",\"CDT-LN3\"],\"resources\":[\"CDT-H4\"],\"maturity\":\"proposed_integration_using_separate_reported_mechanisms\"}],\"logical_responsibilities\":[{\"name\":\"Requirements guidance and reference tailoring\",\"node\":\"CDT-LN1\",\"components\":[\"CDT-C1\",\"CDT-C2\",\"CDT-P1\"],\"status\":\"proposed_responsibility\"},{\"name\":\"Engineering baseline, trace and change impact\",\"node\":\"CDT-LN1\",\"components\":[\"CDT-C2\",\"CDT-C3\",\"CDT-C4\",\"CDT-P1\",\"CDT-P6\"],\"status\":\"proposed_responsibility\"},{\"name\":\"Candidate, COTS, BOM and cost information\",\"node\":\"CDT-LN1\",\"components\":[\"CDT-C1\",\"CDT-C8\",\"CDT-P2\"],\"status\":\"proposed_responsibility\"},{\"name\":\"RAM inputs and dependency models\",\"node\":\"CDT-LN1\",\"cooperating_node\":\"CDT-LN2\",\"components\":[\"CDT-C4\",\"CDT-C8\",\"CDT-P3\"],\"status\":\"proposed_responsibility\"},{\"name\":\"Typed solver exchange and FMI master scheduling\",\"node\":\"CDT-LN2\",\"components\":[\"CDT-C4\",\"CDT-C6\",\"CDT-P3\"],\"status\":\"proposed_responsibility\"},{\"name\":\"Dynamic EPS and battery assurance\",\"node\":\"CDT-LN2\",\"components\":[\"CDT-C5\",\"CDT-C6\",\"CDT-P3\"],\"status\":\"proposed_responsibility\"},{\"name\":\"Credibility, telemetry quality, diagnosis and virtual faults\",\"node\":\"CDT-LN2\",\"components\":[\"CDT-C4\",\"CDT-C5\",\"CDT-C6\",\"CDT-P3\",\"CDT-P4\"],\"status\":\"proposed_responsibility\"},{\"name\":\"Reproduction and evidence packaging\",\"node\":\"CDT-LN2\",\"components\":[\"CDT-C3\",\"CDT-C4\",\"CDT-P3\",\"CDT-H3\"],\"status\":\"proposed_responsibility\"},{\"name\":\"Software contract, ground definitions and sequence consistency\",\"node\":\"CDT-LN1\",\"cooperating_node\":\"CDT-LN3\",\"components\":[\"CDT-C7\",\"CDT-P5\"],\"status\":\"proposed_responsibility\"},{\"name\":\"Criteria, methods and technician-ready planning\",\"node\":\"CDT-LN3\",\"components\":[\"CDT-C8\",\"CDT-P4\"],\"status\":\"proposed_responsibility\"},{\"name\":\"Review, discrepancy disposition and adoption\",\"node\":\"CDT-LN3\",\"components\":[\"CDT-C8\",\"CDT-P6\"],\"status\":\"proposed_responsibility\"},{\"name\":\"Optional spatial and robotics coupling\",\"node\":\"CDT-LN2\",\"cooperating_node\":\"CDT-LN3\",\"components\":[\"CDT-X1\",\"CDT-X2\",\"CDT-X3\",\"CDT-X4\"],\"status\":\"proposed_optional_responsibility\"}],\"interfaces\":[{\"name\":\"Reference content to case model\",\"contract\":\"Source version and license, selected subset, terminology, tailoring decisions, stable IDs, native quantities, and exceptions\",\"authority\":\"CSRM is reference content. Accepted mission-specific requirements and designs are controlled in the case baseline. Source defects and deliberate changes remain distinct.\"},{\"name\":\"Other subsystem/CAD/circuit inputs to model\",\"contract\":\"Supplier, revision, conditions, port meaning, units, mode/duty or time history, thermal assumptions, calibration, and validity\",\"authority\":\"Domain contributors own supplied engineering claims. Import checks cover the mapping. They do not establish physical truth.\"},{\"name\":\"SysML v2 to Python\",\"contract\":\"Baseline hash, element and parameter IDs, typed quantities, units, reference frames, source/model revisions, uncertainty, and declared assumptions\",\"authority\":\"Generated JSON or tabular inputs are derived exchange views. Conversion omissions block affected verdicts. Editing a derived view does not silently edit the model.\"},{\"name\":\"Python to domain solver/FMU\",\"contract\":\"Initial state, load/environment history, solver/version, parameter and model hashes, clock, steps, event handling, supported FMI capabilities, and limits\",\"authority\":\"Python owns workflow and master scheduling. Domain solvers own their equations. FMUs are executable inputs that require isolation and license/provenance checks.\"},{\"name\":\"Solver to evidence and criteria\",\"contract\":\"Raw results, units, timestamps, quality flags, computation status, convergence/coupling checks, uncertainty, and criterion version\",\"authority\":\"A completed run is not an accepted EPS verification result. Missing validity or failed checks yields an unresolved result.\"},{\"name\":\"SysML/Python to OpenUSD/Omniverse/Isaac\",\"contract\":\"ID-to-prim bindings, frames, units, geometry and mapping revisions, quantity sources, scenario/seed, and clock policy\",\"authority\":\"Scenes display and simulate declared aspects. Reverse edits create change requests. Scene overlays cannot approve requirements or hardware faults.\"},{\"name\":\"Model to cFS/F Prime and ground artifacts\",\"contract\":\"Framework/target release, hardware/software allocation, identifiers, types, units, encodings, units conversions, limits, commands, telemetry, events, parameters, sequences, and unsupported mappings\",\"authority\":\"Accepted interface definitions are the contract. Flight/ground build tools validate their target artifacts. Generated architecture does not imply implemented mission behavior.\"},{\"name\":\"Plan to testing facility and results back\",\"contract\":\"DUT/software revision, wiring, equipment and limits, hazards, sequence, criteria, sampling/time synchronization, data schema, abort/recovery, and responsible reviewers\",\"authority\":\"The facility controls execution authorization. Imported measurements become immutable evidence. Calibration proposals create reviewed parameter changes.\"}],\"authority_rules\":[\"Accepted case definitions and immutable released evidence are authoritative. CSRM is reference content.\",\"Derived JSON, tables, USD scenes, and solver results cannot silently change the model. Reverse updates use reviewed change requests.\",\"A run completion is distinct from a credible EPS requirement verdict. Invalid or inapplicable evidence remains unresolved.\",\"The external facility controls physical execution authorization. No physical command path is enabled initially.\",\"Framework verification, EPS verification and project deliverable assessment have separate subjects and acceptance records.\"],\"proposals\":[{\"id\":\"CDT-D01\",\"scope\":\"mandatory_core\",\"development\":\"Complete the audited EPS-relevant native SysML v2 CSRM subset and requirement coaching content. Preserve source defects and modeling choices separately.\",\"maturity\":\"partial_asset_plus_proposed_completion\"},{\"id\":\"CDT-D02\",\"scope\":\"mandatory_core\",\"development\":\"Implement stable identities, domain quantities, controlled Git/file baselines, validity and stale-evidence rules, backup, and export.\",\"maturity\":\"proposed_candidate_services\"},{\"id\":\"CDT-D03\",\"scope\":\"mandatory_core\",\"development\":\"Build the small Python orchestration package, typed contracts, provenance, dependency checks, criterion evaluation, and reproduction packaging.\",\"maturity\":\"reported_bridge_pattern_plus_proposed_assurance\"},{\"id\":\"CDT-D04\",\"scope\":\"mandatory_core\",\"development\":\"Integrate dynamic EPS and battery models with a CPU PyBaMM path, a simpler model, specialist tools, and one pinned FMI runtime. Establish decision-specific validity and independent correlation.\",\"maturity\":\"separate_reported_mechanisms_plus_proposed_coupling\"},{\"id\":\"CDT-D05\",\"scope\":\"mandatory_core\",\"development\":\"Create BOM/cost, RAM, applicability, V&V and technician-ready record templates with change propagation.\",\"maturity\":\"proposed_methods_and_automation\"},{\"id\":\"CDT-D06\",\"scope\":\"mandatory_core\",\"development\":\"Develop separate cFS and F Prime definition profiles and flight/ground consistency checks. Demonstrate one EPS definition and nominal/fault sequence per pinned profile.\",\"maturity\":\"proposed_native_integration\"},{\"id\":\"CDT-D07\",\"scope\":\"optional_activation\",\"development\":\"Retain OpenUSD semantic mappings, Omniverse Kit review extension, Isaac scenario adapter, and USD/FMI/EPS coupling. Activate only for decisions requiring scene or robotics evidence.\",\"maturity\":\"proposed_stack_using_workshop_and_battery_patterns\"},{\"id\":\"CDT-D08\",\"scope\":\"external_future\",\"development\":\"Later extend to SIL, HIL and telemetry using separate hardware, timing, safety and authorization evidence. Exclude operational control from the initial framework.\",\"maturity\":\"future_scope\"},{\"id\":\"CDT-D09\",\"scope\":\"comparison_and_verification\",\"development\":\"Freeze a common core and use the same correctness-first measurement protocol for contrasting cases and candidate comparison. Record actual effort, acquired costs, and uncertainties by active profile.\",\"maturity\":\"proposed_empirical_evaluation\"}],\"limitations\":[\"No source validates the combined CSRM/SysML v2/Python/Omniverse/Isaac/FMI/EPS/battery framework.\",\"CSRM native conversion is partial. Semantic tool checks do not evaluate constraints or establish domain completeness.\",\"Requirements learning, BOM/cost, RAM, technician plans and software definition services require proposed development and human review.\",\"Handpicked-0003 reports partial qualification. EMC, radiation and mechanical testing remained future work. Its data are confidential.\",\"Battery dataset calibration does not establish CubeSat pack lifetime, radiation behavior, hazardous fault safety or policy effectiveness.\",\"Review-0573 omits degradation/balancing and fixes battery temperature and health. Its hardware timing results cannot be imported as PA-CDT performance.\",\"USD/FMI integration is presented as a proof of concept. Pinned runtime capabilities, coupling stability, event handling and scene timing are unresolved.\",\"Native SysML v2 to cFS/F Prime export is proposed. Modern generator schemas and OS compatibility require release-specific validation. Mission behavior remains externally implemented.\",\"Host or GPU simulations do not prove OBC CPU, memory, timing or power budgets.\",\"Core and GPU extension resource/license costs, adoption effort, maintenance burden, reproduction effort and detection accuracy are unmeasured.\",\"HIL, physical fault injection, flight operation, replica replacement and autonomous control are external or future scope.\",\"Jev retrieval failed before ranked chunks were returned. No vendor license, package installation, numerical model, compiled software fixture or stakeholder trial was checked.\"],\"ranking\":{\"status\":\"not_performed\",\"scores\":null,\"winner\":null,\"rationale\":\"Unknown implementation, resource and empirical measures prevent a justified performance ranking. Expanded concerns and common correctness gates should govern later comparison.\"},\"retrieval\":{\"query\":\"CubeSat EPS model-based lifecycle verification: dynamic electrothermal battery model credibility, fault injection and consistent hardware flight software command telemetry interfaces\",\"mode\":\"jev\",\"reranker\":\"jev\",\"top_k_requested\":12,\"status\":\"failed\",\"results\":[],\"chunks_inspected\":0,\"attempts\":[{\"wrapper\":\"/tmp/eps-oosem.wmUVTQ/search-isolated.py\",\"status\":\"wrapper_error\",\"error\":\"TypeError: main() missing 1 required positional argument: args\"},{\"wrapper\":\"/tmp/eps-oosem.wmUVTQ/custom/search-isolated-fixed.py\",\"cache\":\"/tmp/eps-oosem.wmUVTQ/custom/search-cache/noul-index.sqlite3\",\"status\":\"service_error\",\"error\":\"HTTP 402: organization has no available TypeSafe API credits\",\"new_chunk_evaluations\":0}],\"fallback\":\"Direct inspection of the eleven assigned source Markdown documents, relevant OOSEM and CubeSat Handbook sections, and the baseline CSRM conversion documentation. No additional search was attempted.\",\"limitations\":\"There are no ranked retrieval results. The twelve-chunk inspection rule could not be applied. Central claims were checked in original source Markdown with PDF page markers.\"},\"reviewed_common_baseline\":{\"concerns_json\":\"/tmp/eps-oosem.wmUVTQ/concerns/concerns.json\",\"concerns_sha256\":\"c5e3f6ba36e32229b419ed0279493b3e45c98fd7490a9aa410caf257d8c12096\",\"review_decisions\":\"/tmp/eps-oosem.wmUVTQ/review-decisions.md\",\"review_decisions_sha256\":\"6e42ec8bf1986736f7a32083d08312a8355f05b7fda4502ab6d9cadaf5f959cd\",\"architecture\":\"/tmp/eps-oosem.wmUVTQ/architecture/architecture.md\",\"verification_ledger\":\"/tmp/eps-oosem.wmUVTQ/final_report/traceability/framework-baseline.json#verification_cases\"},\"original_research_candidate_sha256\":\"0d570fe2ecf20c5151e0a86f318068e9f48a3cefdde10b03788fe328be4b0e5c\",\"baseline_corrections\":[{\"id\":\"FR-01\",\"correction\":\"Observable quantities or conditions and applicable units. A not-applicable field retains a rationale.\"},{\"id\":\"MN-01/MR-01\",\"correction\":\"Sourced, verifiable requirements and observable quantities or conditions.\"},{\"id\":\"logical_mapping\",\"correction\":\"Final nine L01–L09 mapping replaces all draft LC targets.\"},{\"id\":\"book_locator\",\"correction\":\"Reviewed evidence catalog uses Handbook I.3–I.5 and aguado2021cubesatse. Original source records are retained unchanged.\"}],\"common_logical_component_map\":[{\"logical_component_id\":\"L01\",\"name\":\"Engineering guidance and knowledge\",\"candidate_logical_node_ids\":[\"CDT-LN1\"],\"physical_component_ids\":[\"CDT-C1\",\"CDT-C2\",\"CDT-M01\",\"CDT-S02\",\"CDT-P1\",\"CDT-P6\"],\"control_placement\":\"Method/guidance proposals are controlled at PN1. User edits and lessons require review.\",\"data_component_ids\":[\"CDT-S02\"],\"data_storage_host_ids\":[\"CDT-H2\"],\"requirement_ids\":[\"FR-02\",\"FR-03\",\"FR-39\",\"FR-40\"],\"allocation_status\":\"proposed_not_verified\"},{\"logical_component_id\":\"L02\",\"name\":\"Needs, requirements and decision governance\",\"candidate_logical_node_ids\":[\"CDT-LN1\"],\"physical_component_ids\":[\"CDT-C2\",\"CDT-M01\",\"CDT-M02\",\"CDT-M04\",\"CDT-S03\",\"CDT-P1\"],\"control_placement\":\"Requirement and decision authority is PN1. Impact/status computations run at PN2 and return proposals, not automatic dispositions.\",\"data_component_ids\":[\"CDT-S03\"],\"data_storage_host_ids\":[\"CDT-H2\"],\"requirement_ids\":[\"FR-01\",\"FR-04\",\"FR-05\",\"FR-06\",\"FR-11\",\"FR-14\",\"FR-17\",\"FR-22\",\"FR-26\",\"FR-38\"],\"allocation_status\":\"proposed_not_verified\"},{\"logical_component_id\":\"L03\",\"name\":\"Architecture and service contracts\",\"candidate_logical_node_ids\":[\"CDT-LN1\"],\"physical_component_ids\":[\"CDT-C1\",\"CDT-C2\",\"CDT-C7\",\"CDT-M12\",\"CDT-S01\",\"CDT-S09\",\"CDT-P5\"],\"control_placement\":\"Native structure and service contract are authoritative at PN1. PN2 checks generated target mappings and sequences.\",\"data_component_ids\":[\"CDT-S01\",\"CDT-S09\"],\"data_storage_host_ids\":[\"CDT-H2\"],\"requirement_ids\":[\"FR-15\",\"FR-16\",\"FR-18\",\"FR-33\",\"FR-34\",\"FR-35\",\"FR-36\"],\"allocation_status\":\"proposed_not_verified\"},{\"logical_component_id\":\"L04\",\"name\":\"Component and lifecycle characterization\",\"candidate_logical_node_ids\":[\"CDT-LN1\",\"CDT-LN2\"],\"physical_component_ids\":[\"CDT-M05\",\"CDT-M10\",\"CDT-S05\",\"CDT-P2\",\"CDT-P3\"],\"control_placement\":\"Characterization/quote/failure input revisions are owned at PN1. PN2 generates derived BOM/cost and qualitative RAM representations.\",\"data_component_ids\":[\"CDT-S05\"],\"data_storage_host_ids\":[\"CDT-H2\"],\"requirement_ids\":[\"FR-12\",\"FR-13\",\"FR-14\",\"FR-16\",\"FR-17\",\"FR-20\",\"FR-22\",\"FR-26\",\"FR-27\",\"FR-36\"],\"allocation_status\":\"proposed_not_verified\"},{\"logical_component_id\":\"L05\",\"name\":\"Scenario and analysis orchestration\",\"candidate_logical_node_ids\":[\"CDT-LN2\"],\"physical_component_ids\":[\"CDT-C4\",\"CDT-C5\",\"CDT-C6\",\"CDT-M06\",\"CDT-M07\",\"CDT-S06\",\"CDT-P3\"],\"control_placement\":\"PN2 controls frozen run execution and clock/coupling policy. PN1 manifests bind exact input/output identity.\",\"data_component_ids\":[\"CDT-S06\"],\"data_storage_host_ids\":[\"CDT-H2\"],\"requirement_ids\":[\"FR-10\",\"FR-14\",\"FR-16\",\"FR-18\",\"FR-19\",\"FR-20\",\"FR-23\",\"FR-24\",\"FR-27\",\"FR-34\",\"FR-35\",\"FR-36\"],\"allocation_status\":\"proposed_not_verified\"},{\"logical_component_id\":\"L06\",\"name\":\"Model credibility and observation reconciliation\",\"candidate_logical_node_ids\":[\"CDT-LN2\"],\"physical_component_ids\":[\"CDT-M08\",\"CDT-M09\",\"CDT-S07\",\"CDT-P3\"],\"control_placement\":\"PN2 computes calibration/quality/residual reports. Human applicability and proposed parameter changes are stored through PN1 registration.\",\"data_component_ids\":[\"CDT-S07\"],\"data_storage_host_ids\":[\"CDT-H2\"],\"requirement_ids\":[\"FR-09\",\"FR-20\",\"FR-21\",\"FR-22\",\"FR-23\",\"FR-24\",\"FR-25\",\"FR-31\",\"FR-32\"],\"allocation_status\":\"proposed_not_verified\"},{\"logical_component_id\":\"L07\",\"name\":\"Verification specification and safety\",\"candidate_logical_node_ids\":[\"CDT-LN3\"],\"physical_component_ids\":[\"CDT-M11\",\"CDT-M04\",\"CDT-S08\",\"CDT-P4\"],\"control_placement\":\"PN1 owns the verification specification and review record. PN2 compiles completeness/readiness reports. Facility authorization is external.\",\"data_component_ids\":[\"CDT-S08\"],\"data_storage_host_ids\":[\"CDT-H2\"],\"requirement_ids\":[\"FR-03\",\"FR-11\",\"FR-19\",\"FR-21\",\"FR-24\",\"FR-26\",\"FR-28\",\"FR-29\",\"FR-30\",\"FR-35\"],\"allocation_status\":\"proposed_not_verified\"},{\"logical_component_id\":\"L08\",\"name\":\"Information and configuration authority\",\"candidate_logical_node_ids\":[\"CDT-LN1\"],\"physical_component_ids\":[\"CDT-C3\",\"CDT-M03\",\"CDT-S04\",\"CDT-H2\"],\"control_placement\":\"PN1 controls accepted manifests, identities and custody. PN2 validates submissions. Domain owners retain field meaning.\",\"data_component_ids\":[\"CDT-S04\"],\"data_storage_host_ids\":[\"CDT-H2\"],\"requirement_ids\":[\"FR-04\",\"FR-05\",\"FR-06\",\"FR-07\",\"FR-08\",\"FR-09\",\"FR-10\",\"FR-18\",\"FR-27\",\"FR-31\",\"FR-32\",\"FR-38\",\"FR-39\",\"FR-40\"],\"allocation_status\":\"proposed_not_verified\"},{\"logical_component_id\":\"L09\",\"name\":\"Case workspace and technical review\",\"candidate_logical_node_ids\":[\"CDT-LN3\"],\"physical_component_ids\":[\"CDT-C2\",\"CDT-M13\",\"CDT-S10\",\"CDT-P6\",\"CDT-P7\"],\"control_placement\":\"PN1 presents role-oriented text, tables and bounded views. PN2 packages derived reviews and replays. Human findings remain distinct from author status.\",\"data_component_ids\":[\"CDT-S10\"],\"data_storage_host_ids\":[\"CDT-H2\"],\"requirement_ids\":[\"FR-02\",\"FR-10\",\"FR-11\",\"FR-29\",\"FR-37\",\"FR-38\",\"FR-39\",\"FR-40\"],\"allocation_status\":\"proposed_not_verified\"}],\"common_interface_families\":[{\"id\":\"IF-01\",\"name\":\"Engineering use\",\"actors_or_resources\":\"Project Manager, Systems Engineer, EPS Engineer, Non-EPS Engineer. Roles may overlap.\",\"input_output_contract\":\"Needs, requirements, design revisions, candidate requests, mission assumptions and decisions → templates, models, traces, impact, BOM/cost and justification packages\",\"boundary_authority\":\"Engineers own the mission decisions and EPS acceptance criteria. The framework captures and checks their records.\",\"logical_endpoint_ids\":[\"L09\",\"L02\"],\"physical_endpoint_ids\":[\"CDT-M01\",\"CDT-M13\",\"CDT-S03\",\"CDT-S10\"],\"validation_owner\":\"CDT-M03 for envelope/semantic acceptance plus the named domain endpoint for applicability\",\"failure_behavior\":\"Preserve raw rejected submission and findings. Do not replace accepted revisions or grant an unsupported result/approval label.\"},{\"id\":\"IF-02\",\"name\":\"Source knowledge and components\",\"actors_or_resources\":\"Suppliers, standards owners and literature sources\",\"input_output_contract\":\"Datasheets, part identities, prices, evidence, methods and tailoring rules → source-linked catalogue and registered assumptions\",\"boundary_authority\":\"Supplier qualification and source truth are external. Unsupported component characteristics remain visible.\",\"logical_endpoint_ids\":[\"L01\",\"L04\",\"L08\"],\"physical_endpoint_ids\":[\"CDT-M01\",\"CDT-M03\",\"CDT-S02\",\"CDT-S05\"],\"validation_owner\":\"CDT-M03 for envelope/semantic acceptance plus the named domain endpoint for applicability\",\"failure_behavior\":\"Preserve raw rejected submission and findings. Do not replace accepted revisions or grant an unsupported result/approval label.\"},{\"id\":\"IF-03\",\"name\":\"Discipline execution\",\"actors_or_resources\":\"Electrical, thermal, EMC, CAD, orbit/attitude, battery and RAM tools or their operators\",\"input_output_contract\":\"Controlled inputs and run contract → raw results, environment identity, runtime and limitations\",\"boundary_authority\":\"A candidate may include the tool as a physical component or use an external checked exchange. The logical contract is unchanged.\",\"logical_endpoint_ids\":[\"L05\",\"L06\",\"L08\"],\"physical_endpoint_ids\":[\"CDT-C6\",\"CDT-M03\",\"CDT-M06\",\"CDT-M07\",\"CDT-M08\",\"CDT-S06\",\"CDT-S07\"],\"validation_owner\":\"CDT-M03 for envelope/semantic acceptance plus the named domain endpoint for applicability\",\"failure_behavior\":\"Preserve raw rejected submission and findings. Do not replace accepted revisions or grant an unsupported result/approval label.\"},{\"id\":\"IF-04\",\"name\":\"EPS software engineering\",\"actors_or_resources\":\"Flight and ground software engineers and cFS/F-Prime build/configuration environments\",\"input_output_contract\":\"EPS dictionaries, hardware interfaces, command/mode behavior and target profile → checked mappings, integration findings and resource evidence\",\"boundary_authority\":\"Flight/ground mission-specific implementation is an engineered artifact. No automatic full software implementation or flight qualification is presumed.\",\"logical_endpoint_ids\":[\"L03\",\"L05\"],\"physical_endpoint_ids\":[\"CDT-C7\",\"CDT-M12\",\"CDT-S01\",\"CDT-S09\"],\"validation_owner\":\"CDT-M03 for envelope/semantic acceptance plus the named domain endpoint for applicability\",\"failure_behavior\":\"Preserve raw rejected submission and findings. Do not replace accepted revisions or grant an unsupported result/approval label.\"},{\"id\":\"IF-05\",\"name\":\"Facility planning and supplied evidence\",\"actors_or_resources\":\"Testing Facility Technician, facility safety authority and future instruments/DUTs\",\"input_output_contract\":\"Proposal, equipment/DUT profile, safety review, timestamped observations and calibration data → procedure/evidence contract, quality checks and update records\",\"boundary_authority\":\"The facility owns feasibility, safety approval and physical execution. This project covers planning, virtual fixtures and supplied data exchange.\",\"logical_endpoint_ids\":[\"L07\",\"L06\",\"L08\"],\"physical_endpoint_ids\":[\"CDT-M11\",\"CDT-M09\",\"CDT-S07\",\"CDT-S08\",\"CDT-P4\"],\"validation_owner\":\"CDT-M03 for envelope/semantic acceptance plus the named domain endpoint for applicability\",\"failure_behavior\":\"Preserve raw rejected submission and findings. Do not replace accepted revisions or grant an unsupported result/approval label.\"},{\"id\":\"IF-06\",\"name\":\"Independent review and evaluation\",\"actors_or_resources\":\"Reviewer, researcher or reproducer. These may be people in the mission team serving a distinct role.\",\"input_output_contract\":\"Named analysis, review request, reference answers and findings → reconstructable package, replay verdict, views, measured observations and dispositions\",\"boundary_authority\":\"Reviewer outcome, study governance and research deliverable assessment are separate authorities.\",\"logical_endpoint_ids\":[\"L09\",\"L05\",\"L08\"],\"physical_endpoint_ids\":[\"CDT-M13\",\"CDT-S04\",\"CDT-S06\",\"CDT-S10\",\"CDT-P7\",\"CDT-H3\"],\"validation_owner\":\"CDT-M03 for envelope/semantic acceptance plus the named domain endpoint for applicability\",\"failure_behavior\":\"Preserve raw rejected submission and findings. Do not replace accepted revisions or grant an unsupported result/approval label.\"}],\"dependency_declarations\":[{\"id\":\"CDT-DEP01\",\"name\":\"Native textual SysML v2 editor/parser/query/semantic toolchain\",\"placement\":\"integrated_dependency_CDT-PN1\",\"interface_family\":null,\"scope\":\"C2 and M01 author/inspect controlled C1/S01 data. Existing partial conversion documentation does not establish usable library completeness.\",\"required_contract_checks\":[\"native syntax and semantic coverage\",\"stable ID queries\",\"quantity interpretation\",\"release and license compatibility\"],\"version\":\"unresolved_must_be_pinned\",\"license_and_availability\":\"unverified\",\"deployment_status\":\"not_installed_or_validated_by_this_work\"},{\"id\":\"CDT-DEP02\",\"name\":\"Python runtime and Git/file custody\",\"placement\":\"integrated_dependencies_CDT-PN1_and_CDT-PN2\",\"interface_family\":null,\"scope\":\"One bounded Python package contains M02–M13. PN1 also runs M01 workbench extensions. Git manifests resolve stored artifacts. No new service platform is required.\",\"required_contract_checks\":[\"locked dependencies\",\"clean-start reconstruction\",\"access and backup/recovery\",\"binary checksum and retention policy\"],\"version\":\"unresolved_must_be_pinned\",\"license_and_availability\":\"unverified\",\"deployment_status\":\"not_installed_or_validated_by_this_work\"},{\"id\":\"CDT-DEP03\",\"name\":\"PyBaMM and simpler EPS/battery models\",\"placement\":\"integrated_dependency_CDT-PN2\",\"interface_family\":\"IF-03\",\"scope\":\"CPU electrical/lumped thermal and an identified aging-model integration path through C5/M07. Detailed fidelity is enabled for justified use. Missing supported mechanisms remain explicit.\",\"required_contract_checks\":[\"chemistry/parameter provenance\",\"fresh/aged fixtures\",\"model validity and uncertainty\",\"electrical/thermal/aging output definitions\"],\"version\":\"unresolved_must_be_pinned\",\"license_and_availability\":\"unverified\",\"deployment_status\":\"not_installed_or_validated_by_this_work\"},{\"id\":\"CDT-DEP04\",\"name\":\"Pinned FMI/FMU runtime\",\"placement\":\"integrated_dependency_CDT-PN2\",\"interface_family\":\"IF-03\",\"scope\":\"C6/M07 provide one supported importer and explicit master schedule. FMUs remain controlled engineering artifacts, not automatically trusted executables.\",\"required_contract_checks\":[\"supported FMI capabilities and platform\",\"initialization/events/step policy\",\"coupling and conservation\",\"security and redistribution\"],\"version\":\"unresolved_must_be_pinned\",\"license_and_availability\":\"unverified\",\"deployment_status\":\"not_installed_or_validated_by_this_work\"},{\"id\":\"CDT-DEP05\",\"name\":\"Electrical, thermal, EMC, CAD and orbit/attitude specialists\",\"placement\":\"external_controlled_services\",\"interface_family\":\"IF-03\",\"scope\":\"C6 profiles package and import versioned native analyses. Each discipline declares a chosen product/operator and mapping before use. LTspice, COMSOL, SIMULINK and STK are reported examples, not mandatory acquired licenses.\",\"required_contract_checks\":[\"native revision and field/port mapping\",\"units/frames/polarity\",\"tool environment and limitations\",\"raw result validity and unsupported checks\"],\"version\":\"unresolved_must_be_pinned\",\"license_and_availability\":\"unverified\",\"deployment_status\":\"not_installed_or_validated_by_this_work\"},{\"id\":\"CDT-DEP06\",\"name\":\"cFS build/configuration and ground definition tools\",\"placement\":\"external_controlled_service\",\"interface_family\":\"IF-04\",\"scope\":\"C7/M12 coordinate a pinned application/message/software-bus profile and checked definition fixtures. Mission behavior remains externally implemented.\",\"required_contract_checks\":[\"message/encoding schema\",\"bus producer/consumer mapping\",\"ground dictionary consistency\",\"target compatibility and resource evidence\"],\"version\":\"unresolved_must_be_pinned\",\"license_and_availability\":\"unverified\",\"deployment_status\":\"not_installed_or_validated_by_this_work\"},{\"id\":\"CDT-DEP07\",\"name\":\"F Prime build/configuration and ground definition tools\",\"placement\":\"external_controlled_service\",\"interface_family\":\"IF-04\",\"scope\":\"C7/M12 coordinate a pinned component/typed-port/topology profile and checked definition fixtures. No complete mission software generator.\",\"required_contract_checks\":[\"port/topology/schema validity\",\"command/telemetry/event/parameter mappings\",\"ground dictionary consistency\",\"target compatibility and resource evidence\"],\"version\":\"unresolved_must_be_pinned\",\"license_and_availability\":\"unverified\",\"deployment_status\":\"not_installed_or_validated_by_this_work\"},{\"id\":\"CDT-DEP08\",\"name\":\"Declared bounded calibration solver, such as SciPy least-squares\",\"placement\":\"integrated_dependency_CDT-PN2\",\"interface_family\":\"IF-03\",\"scope\":\"M08 applies a purpose-specific identifiable parameter-fit recipe. Solver choice and numerical bounds are proposed, not derived as a validated algorithm from the sources.\",\"required_contract_checks\":[\"objective/parameters/bounds\",\"data split and uncertainty\",\"reference fit reproducibility\",\"version/license declaration\"],\"version\":\"unresolved_must_be_pinned\",\"license_and_availability\":\"unverified\",\"deployment_status\":\"not_installed_or_validated_by_this_work\"},{\"id\":\"CDT-DEP09\",\"name\":\"OpenUSD libraries and NVIDIA Omniverse Kit/Isaac\",\"placement\":\"optional_integrated_dependencies_CDT-PN3\",\"interface_family\":\"IF-03\",\"scope\":\"X1–X4 retain semantic scene/robotics/FMI bindings. CPU mapping work may run where supported. Scene activation requires H4 and an identified decision.\",\"required_contract_checks\":[\"GPU/OS/driver/release compatibility\",\"semantic prim/frame/unit mapping\",\"action-to-electrical-load calibration\",\"clock/seed/result provenance\",\"assets and use licenses\"],\"version\":\"unresolved_must_be_pinned\",\"license_and_availability\":\"unverified\",\"deployment_status\":\"not_installed_or_validated_by_this_work\"},{\"id\":\"CDT-DEP10\",\"name\":\"Testing facility, measurement and future HIL/target resources\",\"placement\":\"external_planning_or_future_execution\",\"interface_family\":\"IF-05\",\"scope\":\"Core S08 plans and S07 supplied-data ingestion use no live hazardous endpoint. Later X5 hardware integration is external/future.\",\"required_contract_checks\":[\"DUT/setup/equipment revision\",\"calibration/safe bounds/interlocks\",\"clock and interface delay\",\"responsible facility approval\"],\"version\":\"unresolved_must_be_pinned\",\"license_and_availability\":\"unverified\",\"deployment_status\":\"not_installed_or_validated_by_this_work\"}],\"procedure_placement\":[{\"procedure_id\":\"CDT-P1\",\"performer_roles\":[\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"},{\"procedure_id\":\"CDT-P2\",\"performer_roles\":[\"EPS Engineer\",\"Project Manager\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"},{\"procedure_id\":\"CDT-P3\",\"performer_roles\":[\"EPS Engineer\",\"Systems Engineer or Non-EPS Engineer acting as qualified model/RAM reviewer\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\",\"CDT-H3\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"},{\"procedure_id\":\"CDT-P4\",\"performer_roles\":[\"Systems Engineer\",\"EPS Engineer\",\"Testing Facility Technician for proposal review only\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"external facility only\",\"status\":\"proposed_procedure_not_observed\"},{\"procedure_id\":\"CDT-P5\",\"performer_roles\":[\"EPS Engineer\",\"Non-EPS Engineer acting as flight/ground software contributor\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"},{\"procedure_id\":\"CDT-P6\",\"performer_roles\":[\"Project Manager or Systems Engineer for release\",\"Relevant engineers as learners/reviewers\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"},{\"procedure_id\":\"CDT-P7\",\"performer_roles\":[\"Systems Engineer acting as framework evaluator\",\"Qualified independent reproducer\",\"Project Manager for cost scope\"],\"workspaces\":[\"CDT-PN1\",\"CDT-PN2\"],\"execution_host_ids\":[\"CDT-H1\",\"CDT-H3\"],\"storage_host_ids\":[\"CDT-H2\"],\"physical_execution_authority\":\"No facility or flight execution conferred\",\"status\":\"proposed_procedure_not_observed\"}],\"evidence_catalog\":[{\"id\":\"CDT-E01\",\"original_evidence_id\":\"E01\",\"source_key\":\"citation-2362\",\"source_maturity\":\"reference_model\",\"supported_claim\":\"CSRM supplies reusable space and ground logical architecture and relationships among stakeholders, requirements, architecture, measures, and use cases. Mission teams prune, extend, or replace content.\",\"source_locator\":\"`citation-2362`, pp. 2–5, CSRM, CSRM Application, and Transition sections\",\"transfer_limit\":\"Reported SysML v1 reference model. It is a tailoring basis, not a ready EPS requirements set.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E02\",\"original_evidence_id\":\"E02\",\"source_key\":\"citation-2362\",\"source_maturity\":\"reference_model\",\"supported_claim\":\"The mission model is maintained as a central design baseline. Component power, weight, cost, and performance can roll up. Verification activities can reference plans, procedures, results, and status.\",\"source_locator\":\"`citation-2362`, pp. 5–6, MSM Verification and Validation\",\"transfer_limit\":\"Reported modeling pattern. The paper says power, weight, and cost parametrics had not been added to CSRM, p. 6. BOM and cost automation remain proposed.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E03\",\"original_evidence_id\":\"E03\",\"source_key\":\"review-1563\",\"source_maturity\":\"simulation_proof_of_concept\",\"supported_claim\":\"SysML behavior called STK, MATLAB, and Java analyses through ModelCenter and MBSE Analyzer. Returned time histories supported solar area and battery capacity trades and mission requirement checks.\",\"source_locator\":\"`review-1563`, pp. 4–5 and 10–13, Sections 4–6\",\"transfer_limit\":\"Reported simulation proof of concept. It concentrates on energy and data, with several other subsystems simplified. It does not validate a Python or SysML v2 bridge.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E04\",\"original_evidence_id\":\"E04\",\"source_key\":\"review-0602\",\"source_maturity\":\"software_proof_of_concept\",\"supported_claim\":\"A Python parser extracts model data, requirements lists, and dependency graphs and can write analysis updates back. Its demonstrated parser is Gaphor specific.\",\"source_locator\":\"`review-0602`, pp. 14–21, Sections 3.3–6\",\"transfer_limit\":\"Reported software proof of concept on a theoretical academic mission. The paper identifies missing safe/off-nominal and early orbit coverage. Parser code is GPLv3.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E05\",\"original_evidence_id\":\"E05\",\"source_key\":\"handpicked-0003\",\"source_maturity\":\"laboratory_case_partial_qualification\",\"supported_claim\":\"EPS development proceeds through mission definition, preliminary power budget, topology and component selection, and functional and environmental verification. Thermal and EMC analyses precede fabrication.\",\"source_locator\":\"`handpicked-0003`, pp. 2–5, Sections 2–5\",\"transfer_limit\":\"Reported lifecycle method with one 3U hardware case. Useful procedure structure. It does not establish this framework's trace or reproduction services.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E06\",\"original_evidence_id\":\"E06\",\"source_key\":\"handpicked-0003\",\"source_maturity\":\"laboratory_case_partial_qualification\",\"supported_claim\":\"A mission simulation relates attitude and communication modes to solar generation, load peaks, and battery discharge. Battery sizing considers mission cycles and depth of discharge.\",\"source_locator\":\"`handpicked-0003`, pp. 4 and 6–8, Sections 3 and 6.2\",\"transfer_limit\":\"Reported sizing and simulation case. Its empirical aging equation, margins, topology, and thresholds require independent applicability checks. They are not generic framework constants.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E07\",\"original_evidence_id\":\"E07\",\"source_key\":\"handpicked-0003\",\"source_maturity\":\"laboratory_case_partial_qualification\",\"supported_claim\":\"Battery protection is simulated in LTspice before experimental overcurrent and undervoltage/overvoltage checks. The equipment setup identifies power supply, electronic loads, multimeter, and oscilloscope.\",\"source_locator\":\"`handpicked-0003`, pp. 11 and 13–14, Sections 8.1 and 8.1.6\",\"transfer_limit\":\"Reported laboratory mechanism. A simulated fault is useful for planning. It does not establish a universally safe hardware injection limit.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E08\",\"original_evidence_id\":\"E08\",\"source_key\":\"handpicked-0003\",\"source_maturity\":\"laboratory_case_partial_qualification\",\"supported_claim\":\"The telemetry test couples STK attitude data to an OBC, records dynamic ADCS current, and checks timestamped telemetry identities, uptime, channel currents, modes, and temperatures.\",\"source_locator\":\"`handpicked-0003`, p. 14 and Figs. 25–26 on pp. 18–19, Section 8.1.7\",\"transfer_limit\":\"Reported HIL case, external to the current project scope. Sampling and mission behavior are case specific.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E09\",\"original_evidence_id\":\"E09\",\"source_key\":\"handpicked-0003\",\"source_maturity\":\"laboratory_case_partial_qualification\",\"supported_claim\":\"Thermal vacuum results are reported through referenced work. EMC, radiation, and mechanical qualification tests were not performed and are future work. Data are confidential.\",\"source_locator\":\"`handpicked-0003`, pp. 16–18, Section 8.2 and Data availability\",\"transfer_limit\":\"Partial qualification. The conclusion's broader flight readiness wording should not conceal these explicit limits.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E10\",\"original_evidence_id\":\"E10\",\"source_key\":\"handpicked-0001\",\"source_maturity\":\"preprint_dataset_evaluation\",\"supported_claim\":\"Omniverse supplies a USD scene, semantic identities, units, coordinate frames, telemetry and simulation bindings, and read/write visualization APIs.\",\"source_locator\":\"`handpicked-0001`, pp. 3–5, Architecture Overview and Virtual 3D Environment Module\",\"transfer_limit\":\"Reported battery architecture and visualization. Transfer to CubeSat geometry and interfaces is proposed.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E11\",\"original_evidence_id\":\"E11\",\"source_key\":\"handpicked-0001\",\"source_maturity\":\"preprint_dataset_evaluation\",\"supported_claim\":\"PyBaMM electrochemical and lumped thermal models are calibrated against XJTU battery data. SOH prediction and an uncertainty proxy are evaluated. The dataset includes a satellite-use profile.\",\"source_locator\":\"`handpicked-0001`, pp. 7–9, System Implementation and Evaluation\",\"transfer_limit\":\"Reported dataset evaluation in a 2025 preprint. It does not demonstrate a CubeSat pack, radiation effects, safe hardware control, or the full autonomous closed loop. Its errors do not transfer to this candidate.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E12\",\"original_evidence_id\":\"E12\",\"source_key\":\"handpicked-0002\",\"source_maturity\":\"workshop_presentation_proof_of_concept\",\"supported_claim\":\"The presentation combines Python, OpenModelica, Kit extensions, FMI/FMU, and external solvers. Isaac examples include UUV battery consumption and energy tracking for a lunar robot.\",\"source_locator\":\"`handpicked-0002`, slides/PDF pp. 8–18\",\"transfer_limit\":\"Workshop demonstration and architectural patterns. The examples are not CubeSat EPS validation.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E13\",\"original_evidence_id\":\"E13\",\"source_key\":\"handpicked-0002\",\"source_maturity\":\"workshop_presentation_proof_of_concept\",\"supported_claim\":\"USD plus FMI integration is described as an MVP and open sample proof of concept. Standard and implementation work is in progress.\",\"source_locator\":\"`handpicked-0002`, slides/PDF pp. 20–24\",\"transfer_limit\":\"Explicitly immature integration. FMI itself and proposed USD bindings have different maturity. Compatibility and clock behavior require checks.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E14\",\"original_evidence_id\":\"E14\",\"source_key\":\"review-0573\",\"source_maturity\":\"hardware_correlation_chil_phil_case\",\"supported_claim\":\"A 6U EPS model represents solar arrays, regulators, battery, PDU, and loads. Python updates inputs. A simplified one-array/one-regulator model is compared with hardware before CHIL and PHIL demonstrations. The complete model is then used for an orbit simulation.\",\"source_locator\":\"`review-0573`, pp. 3–12, Sections 2–4\",\"transfer_limit\":\"Reported laboratory correlation of a simplified EPS model on Typhoon HIL. It supports an assurance sequence, not the new implementation's real-time capability.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E15\",\"original_evidence_id\":\"E15\",\"source_key\":\"review-0573\",\"source_maturity\":\"hardware_correlation_chil_phil_case\",\"supported_claim\":\"The 6U model fixes battery temperature and health, simplifies switching converters and PDU loads, and omits solar and battery degradation and cell balancing.\",\"source_locator\":\"`review-0573`, pp. 4, 7–8, and 13–14, Sections 2 and 5\",\"transfer_limit\":\"Explicit model limits. This source alone cannot justify coupled thermal or lifetime predictions. Replacing physical mission replicas remains a possibility.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E16\",\"original_evidence_id\":\"E16\",\"source_key\":\"review-1251\",\"source_maturity\":\"qualification_telemetry_replay\",\"supported_claim\":\"SONATE diagnosis compares expected behavior with telemetry. Calibration, tolerance intervals, state-dependent valid values, and conditional component mappings are required. Poor models produce false positives and negatives.\",\"source_locator\":\"`review-1251`, pp. 22–24 and 31–32, Sections 4.1–5.1 and 6–7\",\"transfer_limit\":\"Reported replay and manipulated qualification telemetry experiments. An apparent transceiver fault was an unmodeled external supply, pp. 25–26. Onboard use and automatic recalibration were future work.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E17\",\"original_evidence_id\":\"E17\",\"source_key\":\"review-0853\",\"source_maturity\":\"architecture_generation_proof_of_concept\",\"supported_claim\":\"SysML hardware and software groupings can differ. A MagicDraw plugin exports F Prime architecture, while mission functionality and command, telemetry, event, and parameter definitions need separate work in the reported workflow.\",\"source_locator\":\"`review-0853`, pp. 7–10 and 16–17, Sections 3 and 5\",\"transfer_limit\":\"Reported architecture generation proof of concept. It does not provide a native SysML v2 generator. Current F Prime support must be checked against a pinned release.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E18\",\"original_evidence_id\":\"E18\",\"source_key\":\"review-0853\",\"source_maturity\":\"architecture_generation_proof_of_concept\",\"supported_claim\":\"Software view products include command conditions and impacts, dictionaries, interface descriptions, software requirements, model cohesion, and V&V plans. F Prime typed connections and cFS publish-subscribe require different mappings.\",\"source_locator\":\"`review-0853`, pp. 10–14 and 16, Sections 3–5\",\"transfer_limit\":\"Reported framework distinctions and proposed view taxonomy. No general cross-framework code generator is validated.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E19\",\"original_evidence_id\":\"E19\",\"source_key\":\"citation-0136\",\"source_maturity\":\"embedded_software_flatsat_case\",\"supported_claim\":\"The PHI-Demo software separates EPS control, telemetry collection, FDIR, and script management. Resource checks include CPU, memory, and task traces. Processor and OS choice affect power.\",\"source_locator\":\"`citation-0136`, pp. 7–9 and 12–15, Sections III.A.3, IV.A.1, V, and VI\",\"transfer_limit\":\"Reported embedded software and FlatSat case. The selected implementation is FreeRTOS based, not a validation of cFS or F Prime. Version-specific OS claims need current checking.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E20\",\"original_evidence_id\":\"E20\",\"source_key\":\"psr-0024\",\"source_maturity\":\"review_synthesis\",\"supported_claim\":\"Digital thread continuity requires explicit coupling and synchronization, model validity, uncertainty, contracts, configuration control, data quality, and integration V&V. Higher fidelity increases computing and validation effort.\",\"source_locator\":\"`psr-0024`, pp. 14–18, Sections 8.2–9 and Tables 13–14\",\"transfer_limit\":\"Review synthesis and design principles. It establishes research gaps and mechanisms, not this framework's benefits.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E21\",\"original_evidence_id\":\"E21\",\"source_key\":\"oosem-guide\",\"source_maturity\":\"method_guidance\",\"supported_claim\":\"Physical architecture includes software, hardware, persistent data, and procedures. Node partitioning can follow organizational responsibility. Logical distribution precedes technology allocation.\",\"source_locator\":\"Friedenthal et al., Section 17.3.5, PDF pp. 468–480 and 486–495\",\"transfer_limit\":\"OOSEM method guidance. It permits cohosted services and procedure realizations.\",\"framework_implementation_evidence\":false},{\"id\":\"CDT-E22\",\"original_evidence_id\":\"E22\",\"source_key\":\"cubesat-handbook-part-i\",\"source_maturity\":\"domain_method_guidance\",\"supported_claim\":\"CubeSat requirements should be atomic, quantified, feasible, necessary, and verifiable. Review packages mature requirements, interfaces, budgets, AIV plans, and verification records. Costs include effort, facilities, supplies, and uncertainty.\",\"source_locator\":\"CubeSat Handbook, Part I, I.3–I.5, physical PDF pp. 22–37\",\"transfer_limit\":\"Domain method guidance. Requirements examples and cost heuristics are not adopted as thresholds or estimates.\",\"framework_implementation_evidence\":false,\"reviewed_report_bib_key\":\"aguado2021cubesatse\"},{\"id\":\"CDT-A01\",\"source_key\":\"baseline-csrm-conversion\",\"source_maturity\":\"documented_partial_repository_asset\",\"supported_claim\":\"Partial native conversion and source audits exist. Relevant requirement, stakeholder, behavior, V&V, quantity, and runtime evaluation work remains. Documented semantic checks were not rerun.\",\"source_locator\":\"csrm-sysmlv2/README.md and PENDING.md at baseline b826d9915407bbd861d8d39b2558048f3d534bdc\",\"transfer_limit\":\"Partial conversion and documented checks. No required runtime/quantity completeness or new check is established.\",\"framework_implementation_evidence\":false}],\"prior_research_checks\":[{\"id\":\"K01\",\"name\":\"Requirement quality and learning\",\"evidence_required\":\"Have new users tailor and write requirements using the core. Compare correctness, review findings, active effort, and tool learning with the common comparison procedure.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"},{\"id\":\"K02\",\"name\":\"Trace and change control\",\"evidence_required\":\"Apply controlled requirement, load, component, software type, and parameter changes. Compare the affected artifacts and stale verdicts with an independent qualified assessment. Record time only for correctly completed changes.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"},{\"id\":\"K03\",\"name\":\"BOM, cost, and RAM records\",\"evidence_required\":\"Independently inspect quantities, alternative configurations, quote provenance, unknown totals, RAM assumptions, generated analysis inputs, and their change propagation.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"},{\"id\":\"K04\",\"name\":\"EPS credibility\",\"evidence_required\":\"Check unit/sign conventions, time-dependent energy and voltage behavior, parameter sources, model omissions, calibration/holdout separation, uncertainty, and validity gating. EPS correlation data remain external evidence inputs.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"},{\"id\":\"K05\",\"name\":\"FMI integration\",\"evidence_required\":\"Demonstrate supported FMU import, initialization, events, step changes, failed runs, coupling sensitivity, conservation checks, and reproducibility for the pinned runtime.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"},{\"id\":\"K06\",\"name\":\"Safe faults and data quality\",\"evidence_required\":\"Confirm virtual faults cannot drive hardware. Test invalid/inactive sensors, missing/duplicate records, clock offsets, mapping changes, and distinction among drift, faults, and model mismatch.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"},{\"id\":\"K07\",\"name\":\"Technician package\",\"evidence_required\":\"Obtain a technician's desk assessment of one proposed normal and one fault activity. Record missing setup, interface, equipment, evidence, safety, and recovery information. No actual authorization is presumed.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"},{\"id\":\"K08\",\"name\":\"Software definitions and sequences\",\"evidence_required\":\"Compile or schema-check small cFS and F Prime fixtures against pinned releases. Compare flight and ground definitions, preconditions/effects, mode ownership, and resource evidence gaps.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"},{\"id\":\"K09\",\"name\":\"Independent reproduction\",\"evidence_required\":\"Reconstruct a released run on a separate clean environment from stored dependencies, versions, inputs, and instructions. Compare raw results using declared numerical tolerances. Record active effort and unresolved differences.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"},{\"id\":\"K10\",\"name\":\"Two contrasting cases\",\"evidence_required\":\"Freeze the core before evaluation. Use configuration and declared case adapters for both cases. Record adaptation effort. Any framework correction is a visible change that invalidates the claim of completing both cases with an unchanged core.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"},{\"id\":\"K11\",\"name\":\"Review and adoption\",\"evidence_required\":\"Test readable tables and the few structure/interface views with all relevant roles. Record review effort, installation, training, support, direct cost, and clean export/backup recovery.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"},{\"id\":\"K12\",\"name\":\"Optional scene and Isaac integration\",\"evidence_required\":\"For activated extensions, check ID/quantity mapping, geometry/clock versions, action-to-load calibration, EPS/FMU coupling, repeatability, and GPU/license prerequisites. Credit only demonstrated decisions supported by this path.\",\"status\":\"pending\",\"subject\":\"framework_service_or_assessment\",\"thresholds\":\"No numerical threshold proposed in this research turn. Criteria must be declared in the common verification baseline.\"}],\"coverage_summary\":{\"FR_leaf_count\":40,\"logical_component_count\":9,\"intended_design_coverage_count\":40,\"verified_leaf_count\":0,\"eligibility\":\"not_established\",\"satisfaction\":\"not_established\"},\"source_record_policy\":\"Original sources are retained without promoted maturity. Corrected citation aliases/locators and candidate-local evidence IDs are separate reviewed catalog records. Component reviewed_scope fields supersede original scope text where explicitly present.\",\"unresolved_conflicts\":[{\"id\":\"CDT-G01\",\"leaves\":[\"FR-15\"],\"issue\":\"Partial CSRM native conversion is reusable input. Required behavior, requirement/V&V fields and native units are incomplete.\",\"disposition\":\"Keep as explicit development and validation work, with no completeness credit.\"},{\"id\":\"CDT-G02\",\"leaves\":[\"FR-20\"],\"issue\":\"The research core initially allowed fixed aging assumptions and optional detailed aging. FR-20 also requires an actual identified degradation-model integration path.\",\"disposition\":\"M07 now explicitly includes a mandatory offline aging path and fresh/aged fixture. Choice, implementation and representative validity remain open.\"},{\"id\":\"CDT-G03\",\"leaves\":[\"FR-18\",\"FR-34\",\"FR-36\"],\"issue\":\"No specialist engine profile, cFS/F Prime release or target compatibility has been validated.\",\"disposition\":\"Declare specialist and build tools as external controlled services with exact mappings and limitations. Keep every undeveloped discipline/profile visible.\"},{\"id\":\"CDT-G04\",\"leaves\":[\"FR-27\"],\"issue\":\"The sources do not establish a ready native SysML v2 RAM generator.\",\"disposition\":\"M10 is proposed qualitative FMEA/dependency development. Do not import diagnostic pseudo probabilities as reliability rates.\"},{\"id\":\"CDT-G05\",\"leaves\":[\"FR-39\",\"FR-40\"],\"issue\":\"Licenses, exact resource footprint, two predefined case profiles and frozen permitted extensions are unresolved.\",\"disposition\":\"P7 records actual profile-specific evidence and core changes. Optional GPU/Isaac costs are separate. No completed trial or measurement is claimed.\"}]}"; status = "proposed comparison description, not implemented or verified"; }
part def PhysicalFramework :> Framework {
doc /* A comparison alternative for the same framework black box. Responsibility partitions and host/storage resources are separate. References to facilities, engineered hardware and operational software establish boundary roles only. No available equipment or deployed implementation is asserted. */
ref part facility : ExternalFacility [0..*];
ref part engineeredEPS : EPSHardware [0..*];
ref part flightTarget : FlightSoftware [0..*];
ref part groundTarget : GroundSoftware [0..*];
part <'CDT-LN1'> node_CDT_LN1 : ResponsibilityPartition;
@PhysicalRecord { identifier = "CDT-LN1"; recordJSON = "{\"id\":\"CDT-LN1\",\"level\":\"logical\",\"name\":\"Engineering definition and configuration\",\"responsibilities\":\"Requirements guidance, stakeholder and mission context, EPS structure and interfaces, component catalog, BOM, cost basis, hardware/software mappings, dictionaries, baseline identities, dependency and change records\",\"rationale\":\"Requirements and design edits need one controlled semantic baseline. Fast edits must identify dependent budgets, evidence, and software artifacts.\",\"status\":\"proposed_product_neutral_distribution\"}"; status = "proposed comparison description, not implemented or verified"; }
part <'CDT-LN2'> node_CDT_LN2 : ResponsibilityPartition;
@PhysicalRecord { identifier = "CDT-LN2"; recordJSON = "{\"id\":\"CDT-LN2\",\"level\":\"logical\",\"name\":\"Analysis execution and model assurance\",\"responsibilities\":\"Dynamic load/environment histories, EPS and battery calculations, specialist tool adapters, RAM analysis inputs, model calibration and validity, uncertainty, fault scenarios, telemetry quality, independent reproduction packages\",\"rationale\":\"Analyses need isolated, replaceable tools and reproducible inputs. Calculation success and decision credibility are separate judgments.\",\"status\":\"proposed_product_neutral_distribution\"}"; status = "proposed comparison description, not implemented or verified"; }
part <'CDT-LN3'> node_CDT_LN3 : ResponsibilityPartition;
@PhysicalRecord { identifier = "CDT-LN3"; recordJSON = "{\"id\":\"CDT-LN3\",\"level\":\"logical\",\"name\":\"Verification planning and decision communication\",\"responsibilities\":\"Pass/fail criteria, tailored method and standard records, technician packages, safety and interface review, evidence interpretation, discrepancy disposition, readable review views, onboarding and adoption observations\",\"rationale\":\"V&V plans must serve EPS, non-EPS, and technician roles. Human acceptance and safety authority remain explicit.\",\"status\":\"proposed_product_neutral_distribution\"}"; status = "proposed comparison description, not implemented or verified"; }
part <'CDT-PN1'> node_CDT_PN1 : ResponsibilityPartition;
@PhysicalRecord { identifier = "CDT-PN1"; recordJSON = "{\"id\":\"CDT-PN1\",\"level\":\"physical\",\"name\":\"Engineering workspace and controlled store\",\"activation\":\"mandatory_core\",\"logical_nodes\":[\"CDT-LN1\",\"CDT-LN3\"],\"resources\":[\"CDT-H1\",\"CDT-H2\"],\"cohosting\":\"May share a CPU computer with PN2. Access and released identities remain distinct.\"}"; status = "proposed comparison description, not implemented or verified"; }
part <'CDT-PN2'> node_CDT_PN2 : ResponsibilityPartition;
@PhysicalRecord { identifier = "CDT-PN2"; recordJSON = "{\"id\":\"CDT-PN2\",\"level\":\"physical\",\"name\":\"Isolated Python analysis workspace\",\"activation\":\"mandatory_core\",\"logical_nodes\":[\"CDT-LN2\"],\"resources\":[\"CDT-H1\",\"CDT-H2\"],\"isolation\":\"Declared environment and bounded adapters. No initial physical command path.\"}"; status = "proposed comparison description, not implemented or verified"; }
part <'CDT-PN3'> node_CDT_PN3 : ResponsibilityPartition;
@PhysicalRecord { identifier = "CDT-PN3"; recordJSON = "{\"id\":\"CDT-PN3\",\"level\":\"physical\",\"name\":\"Omniverse and Isaac extension workspace\",\"activation\":\"optional_decision_specific_profile\",\"logical_nodes\":[\"CDT-LN2\",\"CDT-LN3\"],\"resources\":[\"CDT-H4\"],\"maturity\":\"proposed_integration_using_separate_reported_mechanisms\"}"; status = "proposed comparison description, not implemented or verified"; }
ref part role_1 : EPSEngineer [0..*];
@PhysicalRecord { identifier = "performer-role_1"; recordJSON = "{\"declared_role\":\"EPS Engineer\",\"actual_staffing\":\"unasserted\",\"authority\":\"No physical or flight execution authority conferred\"}"; status = "proposed comparison description, not implemented or verified"; }
ref part role_2 : NonEPSEngineer [0..*];
@PhysicalRecord { identifier = "performer-role_2"; recordJSON = "{\"declared_role\":\"Non-EPS Engineer\",\"actual_staffing\":\"unasserted\",\"authority\":\"No physical or flight execution authority conferred\"}"; status = "proposed comparison description, not implemented or verified"; }
ref part role_3 : NonEPSEngineer [0..*];
@PhysicalRecord { identifier = "performer-role_3"; recordJSON = "{\"declared_role\":\"Non-EPS Engineer acting as flight/ground software contributor\",\"actual_staffing\":\"unasserted\",\"authority\":\"No physical or flight execution authority conferred\"}"; status = "proposed comparison description, not implemented or verified"; }
ref part role_4 : ProjectManager [0..*];
