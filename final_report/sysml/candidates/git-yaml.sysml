@PhysicalRecord { identifier = "allocate_FR_22_GY_C17"; recordJSON = "{\"requirement_id\":\"FR-22\",\"requirement_title\":\"Model update workflow\",\"requirement_text\":\"The framework shall use supplied measurements to create an identified calibration or parameter-update record with data quality, prior and revised parameters, residuals and affected analyses.\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-09\"],\"logical_component_ids\":[\"L06\",\"L04\",\"L02\"],\"physical_component_ids\":[\"GY-C17\",\"GY-C21\",\"GY-C13\",\"GY-C14\",\"GY-C10\"],\"realization_mechanism\":\"C21 qualified measurements feed C17 declared bounded fitting recipe and residual report. It writes prior/revised parameter sets as a proposal. C13 finds affected runs and C14 releases a revision only after review.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: independent diagnostic/calibration study, independent battery preprint study.\",\"evidence_ids\":[\"GY-E15\",\"GY-E16\"],\"source_locators\":[{\"evidence_id\":\"GY-E15\",\"source_id\":\"review-1251\",\"bib_key\":\"review-1251\",\"sections\":\"3.1, 4.1, 4.2, 6\",\"pdf_pages\":[7,8,9,22,23,31],\"pdf_page_ranges\":null,\"source_maturity\":\"independent diagnostic prototype, not availability/maintainability validation\"},{\"evidence_id\":\"GY-E16\",\"source_id\":\"handpicked-0001\",\"bib_key\":\"handpicked-0001\",\"sections\":\"Preliminaries, System Implementation and Evaluation\",\"pdf_pages\":[2,3,7,8,9],\"pdf_page_ranges\":null,\"source_maturity\":\"preprint, independent dataset study, not validated PA-GY controller/hardware decisions\"}],\"verification_id\":\"V22\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Apply a measurement fixture, compare the declared calibration result with a reference, retain both parameter revisions, and flag analyses affected by drift or update.\",\"implementation_gap\":\"Implement calibration recipe, quality gates and known reference fit. Parameter identifiability and data coverage remain empirical.\",\"boundary_authority_note\":\"IF-05 supplied data and EPS model reviewer participate. No automatic overwrite or live control feedback.\",\"interface_family_ids\":[\"IF-03\",\"IF-05\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and qualified model/data reviewer\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
