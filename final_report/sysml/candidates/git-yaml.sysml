@PhysicalRecord { identifier = "allocate_FR_25_GY_C17"; recordJSON = "{\"requirement_id\":\"FR-25\",\"requirement_title\":\"Anomaly assessment\",\"requirement_text\":\"The framework shall compare time-correlated EPS telemetry with modeled expected behavior while retaining operating mode, model validity, degradation and sensor uncertainty, and alternative fault explanations.\",\"mission_need_ids\":[\"MN-05\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-04\"],\"logical_component_ids\":[\"L06\"],\"physical_component_ids\":[\"GY-C17\",\"GY-C21\",\"GY-C16\",\"GY-C8\"],\"realization_mechanism\":\"C21 aligns and masks mode/active-unit valid observations. C17 compares C16 nominal expectations using declared tolerance/noise/degradation rules and retains residuals plus alternative fault explanations.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: independent diagnostic/calibration study.\",\"evidence_ids\":[\"GY-E15\"],\"source_locators\":[{\"evidence_id\":\"GY-E15\",\"source_id\":\"review-1251\",\"bib_key\":\"review-1251\",\"sections\":\"3.1, 4.1, 4.2, 6\",\"pdf_pages\":[7,8,9,22,23,31],\"pdf_page_ranges\":null,\"source_maturity\":\"independent diagnostic prototype, not availability/maintainability validation\"}],\"verification_id\":\"V25\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Use nominal, degrading, noisy and injected-fault fixtures. Retain residuals and diagnoses with TP, FP and FN against an expert reference. No pre-threshold detection capability is presumed.\",\"implementation_gap\":\"Implement nominal/degraded/noisy/fault fixtures and qualified oracle. No diagnosis or pre-threshold detection accuracy is assumed.\",\"boundary_authority_note\":\"Supplied telemetry IF-05 is not flight operation. Engineers adjudicate hypotheses and sensor/model ambiguity.\",\"interface_family_ids\":[\"IF-05\"],\"execution_host_ids\":[\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and qualified model/data reviewer\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
