#intendedRealization allocation allocate_FR_19_GY_C16 allocate FrameworkRequirements::FR_19 to physical.GY_C16;
@PhysicalRecord { identifier = "allocate_FR_19_GY_C16"; recordJSON = "{\"requirement_id\":\"FR-19\",\"requirement_title\":\"Early verification scenarios\",\"requirement_text\":\"The framework shall execute or coordinate declared virtual EPS and component verification scenarios for dynamic loads, supply changes, protection events, rare faults, and controller electrical and timing constraints.\",\"mission_need_ids\":[\"MN-04\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-07\"],\"logical_component_ids\":[\"L05\",\"L07\"],\"physical_component_ids\":[\"GY-C16\",\"GY-C20\",\"GY-C5\",\"GY-C17\",\"GY-C25\"],\"realization_mechanism\":\"C20 frozen virtual test specifications drive C16 registered plant/controller routines with dynamic loads, supply changes, protection and rare virtual faults. C5 retains request/stimulus/raw outputs and timing status.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: independent dynamic energy study, independent EPS/HIL case with limits, independent battery preprint study, independent EPS design/test case.\",\"evidence_ids\":[\"GY-E13\",\"GY-E14\",\"GY-E16\",\"GY-E19\"],\"source_locators\":[{\"evidence_id\":\"GY-E13\",\"source_id\":\"review-1231\",\"bib_key\":\"review-1231\",\"sections\":\"I through III, V, VI\",\"pdf_pages\":[1,2,3,5,6,7],\"pdf_page_ranges\":null,\"source_maturity\":\"independent NetSat simulation study, not integrated PA-GY software\"},{\"evidence_id\":\"GY-E14\",\"source_id\":\"review-0573\",\"bib_key\":\"review-0573\",\"sections\":\"2, 3, 4, 5\",\"pdf_pages\":[3,4,5,6,7,8,9,12,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS implementation with explicit model limits\"},{\"evidence_id\":\"GY-E16\",\"source_id\":\"handpicked-0001\",\"bib_key\":\"handpicked-0001\",\"sections\":\"Preliminaries, System Implementation and Evaluation\",\"pdf_pages\":[2,3,7,8,9],\"pdf_page_ranges\":null,\"source_maturity\":\"preprint, independent dataset study, not validated PA-GY controller/hardware decisions\"},{\"evidence_id\":\"GY-E19\",\"source_id\":\"handpicked-0003\",\"bib_key\":\"handpicked-0003\",\"sections\":\"7.7, 8.1.6, 8.1.7\",\"pdf_pages\":[10,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS case, its thresholds are not transferred\"}],\"verification_id\":\"V19\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"D,T\",\"proposed_verification_fixture\":\"Retain stimulus, conditions, expected response, outputs and status for nominal and failure fixtures. Unsupported behavior and physical validation needs are explicit, including COTS evidence gaps.\",\"implementation_gap\":\"Implement nominal/failure and COTS fixtures. Real electrical/timing fidelity and unsupported behavior require evidence.\",\"boundary_authority_note\":\"IF-03 coordination supports early EPS evidence. No hazardous fault injection or physical controller operation occurs in the core.\",\"interface_family_ids\":[\"IF-03\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer or designated analysis operator, independent reproducer for replay\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
