@PhysicalRecord { identifier = "allocate_FR_30_GY_C20"; recordJSON = "{\"requirement_id\":\"FR-30\",\"requirement_title\":\"Safety declaration\",\"requirement_text\":\"The framework shall include hazards, battery and electronics operating limits, fault-injection envelope, isolation, abort conditions and responsible safety-review status in each proposed physical verification activity.\",\"mission_need_ids\":[\"MN-07\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-04\"],\"logical_component_ids\":[\"L07\"],\"physical_component_ids\":[\"GY-C20\",\"GY-C10\",\"GY-C15\",\"GY-C8\"],\"realization_mechanism\":\"C20 safety declarations require sourced battery/electronics limits, hazard/fault envelope, isolation, abort/recovery and responsible review identity/status. Missing fields or disposition block physical-ready labels.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated component/assembly pattern, independent battery preprint study, independent EPS design/test case.\",\"evidence_ids\":[\"GY-E09\",\"GY-E16\",\"GY-E19\"],\"source_locators\":[{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"},{\"evidence_id\":\"GY-E16\",\"source_id\":\"handpicked-0001\",\"bib_key\":\"handpicked-0001\",\"sections\":\"Preliminaries, System Implementation and Evaluation\",\"pdf_pages\":[2,3,7,8,9],\"pdf_page_ranges\":null,\"source_maturity\":\"preprint, independent dataset study, not validated PA-GY controller/hardware decisions\"},{\"evidence_id\":\"GY-E19\",\"source_id\":\"handpicked-0003\",\"bib_key\":\"handpicked-0003\",\"sections\":\"7.7, 8.1.6, 8.1.7\",\"pdf_pages\":[10,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS case, its thresholds are not transferred\"}],\"verification_id\":\"V30\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_verification_fixture\":\"Use a safe virtual fault fixture and an incomplete physical proposal. Missing limits or approval status block a ready-for-physical-execution label. The framework does not authorize laboratory operations.\",\"implementation_gap\":\"Implement gate and safe virtual/incomplete proposal fixtures. Safe numerical bounds and facility authorization remain outstanding.\",\"boundary_authority_note\":\"Facility safety authority controls approval via IF-05. Core has no physical actuation or hazardous execution path.\",\"interface_family_ids\":[\"IF-02\",\"IF-05\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS/Systems Engineer specifies activity, technician/facility evaluates feasibility and safety\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
