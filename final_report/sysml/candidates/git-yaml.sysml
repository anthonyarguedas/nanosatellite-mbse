@PhysicalRecord { identifier = "allocate_FR_27_GY_C19"; recordJSON = "{\"requirement_id\":\"FR-27\",\"requirement_title\":\"RAM model generation\",\"requirement_text\":\"The framework shall generate a declared RAM analysis representation from identified functions, components and failure dependencies with traceable transformation rules and sourced or missing reliability data.\",\"mission_need_ids\":[\"MN-06\"],\"mission_requirement_ids\":[\"MR-06\"],\"logical_component_ids\":[\"L04\",\"L05\",\"L08\"],\"physical_component_ids\":[\"GY-C19\",\"GY-C24\",\"GY-C15\",\"GY-C14\"],\"realization_mechanism\":\"C19 versioned transformation joins C24 functions/occurrences/failure dependencies to curated failure templates, generating FMEA rows and dependency records for current and changed designs with input data provenance.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: source design and explicit exclusions, demonstrated component/assembly pattern, OOSEM method guidance.\",\"evidence_ids\":[\"GY-E01\",\"GY-E09\",\"GY-E20\"],\"source_locators\":[{\"evidence_id\":\"GY-E01\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"2, RQ-1 through RQ-8 and 2.0.1 Non-Requirements\",\"pdf_pages\":[3,4,5],\"pdf_page_ranges\":null,\"source_maturity\":\"source design\"},{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"},{\"evidence_id\":\"GY-E20\",\"source_id\":\"friedenthal2014practical\",\"bib_key\":\"friedenthal2014practical\",\"sections\":\"17.3.5, partitioning, logical nodes and component architectures\",\"pdf_pages\":null,\"pdf_page_ranges\":[[468,473],[486,492]],\"source_maturity\":\"OOSEM method guidance\"}],\"verification_id\":\"V27\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Generate an FMEA, fault tree or other justified representation for a reference design and its changed variant. Compare entities and dependencies with an expert model. Missing probabilities cannot become factual reliability estimates.\",\"implementation_gap\":\"Implement FMEA transformation and expert model fixture. Missing dependencies/rates/repair data stay unknown, not inferred probabilities.\",\"boundary_authority_note\":\"Framework-generated representation is integrated code/data. Expert failure mechanisms and source truth remain separate from transformation correctness.\",\"interface_family_ids\":[\"IF-01\",\"IF-02\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer maintains characterization, Project Manager reviews cost, Systems Engineer reviews RAM basis\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
