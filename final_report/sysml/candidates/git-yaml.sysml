#intendedRealization allocation allocate_FR_36_GY_C22 allocate FrameworkRequirements::FR_36 to physical.GY_C22;
@PhysicalRecord { identifier = "allocate_FR_36_GY_C22"; recordJSON = "{\"requirement_id\":\"FR-36\",\"requirement_title\":\"Target integration assessment\",\"requirement_text\":\"The framework shall retain a versioned OBC, operating-system, flight-framework and toolchain configuration with compatibility evidence and processor, memory, timing and power budget evidence for EPS functions.\",\"mission_need_ids\":[\"MN-08\",\"MN-05\"],\"mission_requirement_ids\":[\"MR-08\",\"MR-05\"],\"logical_component_ids\":[\"L03\",\"L04\",\"L05\"],\"physical_component_ids\":[\"GY-C22\",\"GY-C7\",\"GY-C15\",\"GY-C8\"],\"realization_mechanism\":\"C22 versioned target manifest links OBC/OS/framework/compiler configurations to compatibility reports, memory/link maps, CPU/scheduling traces and measured or modeled power. Compares with declared mission allocations.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: independent limited F-Prime export study, independent FreeRTOS flight software case.\",\"evidence_ids\":[\"GY-E17\",\"GY-E18\"],\"source_locators\":[{\"evidence_id\":\"GY-E17\",\"source_id\":\"review-0853\",\"bib_key\":\"review-0853\",\"sections\":\"3, Table 5, 5\",\"pdf_pages\":[7,8,9,10,12,13,14,16,17],\"pdf_page_ranges\":null,\"source_maturity\":\"independent SysML/F-Prime architecture export demonstration, no PA-GY exporter\"},{\"evidence_id\":\"GY-E18\",\"source_id\":\"citation-0136\",\"bib_key\":\"citation-0136\",\"sections\":\"III.A.3 through III.B, IV.A.1, V, VI.A through VI.C\",\"pdf_pages\":[7,8,9,10,12,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent flight software case, no current framework/OS compatibility guarantee\"}],\"verification_id\":\"V36\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,A,T\",\"proposed_verification_fixture\":\"Inspect a build/deployment profile and reference resource records. Distinguish measurements, estimates and unknown target compatibility. Check against mission-supplied allocations when available.\",\"implementation_gap\":\"Target releases/access, adapters and resource evidence unresolved. Missing compatibility/budgets are explicit.\",\"boundary_authority_note\":\"IF-04 engineers provide target evidence. Host build success and host CPU use never establish OBC timing/power margins.\",\"interface_family_ids\":[\"IF-04\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and Non-EPS flight/ground engineers\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
