#intendedRealization allocation allocate_FR_02_GY_C12 allocate FrameworkRequirements::FR_02 to physical.GY_C12;
@PhysicalRecord { identifier = "allocate_FR_02_GY_C12"; recordJSON = "{\"requirement_id\":\"FR-02\",\"requirement_title\":\"Learning and templates\",\"requirement_text\":\"The framework shall provide requirement and traceability templates, worked EPS examples, and a guided reference workflow that covers writing criteria, linking evidence, and interpreting gaps.\",\"mission_need_ids\":[\"MN-01\",\"MN-11\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-11\"],\"logical_component_ids\":[\"L01\",\"L09\"],\"physical_component_ids\":[\"GY-C12\",\"GY-C9\",\"GY-C4\",\"GY-C23\"],\"realization_mechanism\":\"Versioned C12 EPS examples and criterion/trace templates plus C9 guided CLI/editor workflow. C4 renders lessons, C23 records clean-start learner errors and effort.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated documentation approach, demonstrated incomplete trace pattern, reported adoption/change limits, procedural guidance.\",\"evidence_ids\":[\"GY-E05\",\"GY-E06\",\"GY-E11\",\"GY-E12\"],\"source_locators\":[{\"evidence_id\":\"GY-E05\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"2.2, 2.3, Table 2.1, 2.5\",\"pdf_pages\":[26,27,28,29,30],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated documentation approach, not general executable behavior\"},{\"evidence_id\":\"GY-E06\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"3.1, 3.2, Figs. 3.1 through 3.4\",\"pdf_pages\":[31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated but incomplete trace pattern\"},{\"evidence_id\":\"GY-E11\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"Chapter 3 opening, Chapter 5, 5.2\",\"pdf_pages\":[31,77,78,79],\"pdf_page_ranges\":null,\"source_maturity\":\"reported adoption/change limitations\"},{\"evidence_id\":\"GY-E12\",\"source_id\":\"cubesat-handbook-part-I\",\"bib_key\":\"aguado2021cubesatse\",\"sections\":\"I.4.1 through I.4.1.5 and I.5 through I.5.2\",\"pdf_pages\":[28,29,30,31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"procedural guidance, no PA-GY performance evidence\"}],\"verification_id\":\"V02\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_verification_fixture\":\"Inspect the learning package and demonstrate the workflow from a declared clean start. Measure learner effort and errors without imposing an unagreed time limit.\",\"implementation_gap\":\"Curate and trial examples with novice users. SeaLion ease-of-use assertions provide no measured onboarding outcome.\",\"boundary_authority_note\":\"L01 curates knowledge. Learner observations via IF-01/IF-06 are framework evaluation records.\",\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer curates guidance with EPS/Non-EPS specialists\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
