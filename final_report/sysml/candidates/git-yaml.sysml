#intendedRealization allocation allocate_FR_37_GY_C4 allocate FrameworkRequirements::FR_37 to physical.GY_C4;
@PhysicalRecord { identifier = "allocate_FR_37_GY_C4"; recordJSON = "{\"requirement_id\":\"FR-37\",\"requirement_title\":\"Readable design views\",\"requirement_text\":\"The framework shall produce filtered context, structure, interface and selected-design views from controlled EPS records with identifiers, units, legends and links to the represented baseline.\",\"mission_need_ids\":[\"MN-10\"],\"mission_requirement_ids\":[\"MR-10\"],\"logical_component_ids\":[\"L09\"],\"physical_component_ids\":[\"GY-C4\",\"GY-C24\",\"GY-C14\"],\"realization_mechanism\":\"C4 filters C24 controlled records into limited context/structure/interface/selected-design views with IDs, applicable units, legends and source/generator revisions. Tables retain detailed fields.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated generation/issue linkage, demonstrated component/assembly pattern, future N2 capability.\",\"evidence_ids\":[\"GY-E08\",\"GY-E09\",\"GY-E10\"],\"source_locators\":[{\"evidence_id\":\"GY-E08\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.2, 4.3, Figs. 4.8 and 4.9\",\"pdf_pages\":[66,67,68],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated generation/workflow pattern, no general cross tool change propagation proof\"},{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"},{\"evidence_id\":\"GY-E10\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.5\",\"pdf_pages\":[75,76],\"pdf_page_ranges\":null,\"source_maturity\":\"future capability\"}],\"verification_id\":\"V37\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_verification_fixture\":\"Compare generated views with a fixture model and apply a declared reviewer task checklist. Assess correctness and readability without proliferating requirement, measure, scenario or state diagrams.\",\"implementation_gap\":\"Implement EPS view templates and reviewer tasks. Automatic N2 generation is not a demonstrated inherited capability.\",\"boundary_authority_note\":\"L09 produces projections via IF-01/IF-06. No new diagrams are generated in this allocation turn.\",\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"All five stakeholder roles, named reviewer/reproducer and study evaluator\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
