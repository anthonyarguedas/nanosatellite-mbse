#intendedRealization allocation allocate_FR_21_GY_C17 allocate FrameworkRequirements::FR_21 to physical.GY_C17;
@PhysicalRecord { identifier = "allocate_FR_21_GY_C17"; recordJSON = "{\"requirement_id\":\"FR-21\",\"requirement_title\":\"Intended-use credibility\",\"requirement_text\":\"The framework shall associate each analytical verification claim with the model intended use, tested validity domain, calibration and validation evidence, uncertainty and acceptable prediction-error rule.\",\"mission_need_ids\":[\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-09\"],\"logical_component_ids\":[\"L06\",\"L07\"],\"physical_component_ids\":[\"GY-C17\",\"GY-C20\",\"GY-C10\",\"GY-C8\"],\"realization_mechanism\":\"C17 intended-use cards bind each analytical claim to validity ranges, calibration/independent validation data, error metric/rule and uncertainty. C20 blocks unqualified admissibility outside the supported domain.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: independent EPS/HIL case with limits, independent diagnostic/calibration study, independent battery preprint study.\",\"evidence_ids\":[\"GY-E14\",\"GY-E15\",\"GY-E16\"],\"source_locators\":[{\"evidence_id\":\"GY-E14\",\"source_id\":\"review-0573\",\"bib_key\":\"review-0573\",\"sections\":\"2, 3, 4, 5\",\"pdf_pages\":[3,4,5,6,7,8,9,12,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS implementation with explicit model limits\"},{\"evidence_id\":\"GY-E15\",\"source_id\":\"review-1251\",\"bib_key\":\"review-1251\",\"sections\":\"3.1, 4.1, 4.2, 6\",\"pdf_pages\":[7,8,9,22,23,31],\"pdf_page_ranges\":null,\"source_maturity\":\"independent diagnostic prototype, not availability/maintainability validation\"},{\"evidence_id\":\"GY-E16\",\"source_id\":\"handpicked-0001\",\"bib_key\":\"handpicked-0001\",\"sections\":\"Preliminaries, System Implementation and Evaluation\",\"pdf_pages\":[2,3,7,8,9],\"pdf_page_ranges\":null,\"source_maturity\":\"preprint, independent dataset study, not validated PA-GY controller/hardware decisions\"}],\"verification_id\":\"V21\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_verification_fixture\":\"Exercise an in-domain and an extrapolated claim. Separate calibration from validation data where available. Flag untested domains and absent error limits. Prediction accuracy limits require prior agreement.\",\"implementation_gap\":\"Author/test applicability rules and independent validation records. Error limits require intended-use review before execution.\",\"boundary_authority_note\":\"Model owner states applicability. L07 judges admissibility. Record completeness and low fitting error do not prove hardware truth.\",\"interface_family_ids\":[\"IF-03\",\"IF-05\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and qualified model/data reviewer\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
#intendedRealization allocation allocate_FR_21_GY_C20 allocate FrameworkRequirements::FR_21 to physical.GY_C20;
