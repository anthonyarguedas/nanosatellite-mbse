@PhysicalRecord { identifier = "allocate_FR_13_GY_C15"; recordJSON = "{\"requirement_id\":\"FR-13\",\"requirement_title\":\"Financial estimate\",\"requirement_text\":\"The framework shall derive a revision-linked financial estimate from the BOM and declared additional cost categories while retaining price source, date, currency, quantity, estimate basis, uncertainty and missing data.\",\"mission_need_ids\":[\"MN-03\"],\"mission_requirement_ids\":[\"MR-03\"],\"logical_component_ids\":[\"L04\"],\"physical_component_ids\":[\"GY-C15\",\"GY-C2\",\"GY-C4\"],\"realization_mechanism\":\"C15 joins the selected BOM with dated quantity-basis/currency quotes and scoped labour/tool/facility/test categories. Versioned arithmetic records uncertainty and missing costs without substituting zero.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: explicit future work, demonstrated component/assembly pattern, procedural guidance.\",\"evidence_ids\":[\"GY-E04\",\"GY-E09\",\"GY-E12\"],\"source_locators\":[{\"evidence_id\":\"GY-E04\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"4 Conclusion\",\"pdf_pages\":[10],\"pdf_page_ranges\":null,\"source_maturity\":\"explicit source limitation\"},{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"},{\"evidence_id\":\"GY-E12\",\"source_id\":\"cubesat-handbook-part-I\",\"bib_key\":\"aguado2021cubesatse\",\"sections\":\"I.4.1 through I.4.1.5 and I.5 through I.5.2\",\"pdf_pages\":[28,29,30,31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"procedural guidance, no PA-GY performance evidence\"}],\"verification_id\":\"V13\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Recalculate a sourced-price fixture after a quantity and part change. Match reference arithmetic and preserve unknown costs. Do not import historical project costs as new framework measurements.\",\"implementation_gap\":\"Implement formulas, currency/quote basis and uncertainty policy with reference arithmetic. No cost measurements are available.\",\"boundary_authority_note\":\"Project Manager owns estimate scope/decision. IF-02 prices are source claims. Framework operating cost is a separate FR-39 record.\",\"interface_family_ids\":[\"IF-01\",\"IF-02\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer maintains characterization, Project Manager reviews cost, Systems Engineer reviews RAM basis\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
