@PhysicalRecord { identifier = "allocate_FR_14_GY_C16"; recordJSON = "{\"requirement_id\":\"FR-14\",\"requirement_title\":\"EPS candidate comparison\",\"requirement_text\":\"The framework shall produce a comparison of designated EPS architectures using a common requirement, assumption, evidence and criterion basis with feasibility status, raw measures, uncertainty and decision rationale.\",\"mission_need_ids\":[\"MN-03\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-03\",\"MR-04\"],\"logical_component_ids\":[\"L05\",\"L04\",\"L02\"],\"physical_component_ids\":[\"GY-C16\",\"GY-C15\",\"GY-C12\",\"GY-C17\",\"GY-C20\",\"GY-C4\"],\"realization_mechanism\":\"C16 comparison manifest pins common EPS requirements, scenarios, assumptions and criteria. C15 provides sourced BOM/cost, C17/C20 provide applicability/feasibility and gaps. C4 reports raw measures, uncertainty and rationale separately from preference.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated component/assembly pattern, OOSEM method guidance.\",\"evidence_ids\":[\"GY-E09\",\"GY-E20\"],\"source_locators\":[{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"},{\"evidence_id\":\"GY-E20\",\"source_id\":\"friedenthal2014practical\",\"bib_key\":\"friedenthal2014practical\",\"sections\":\"17.3.5, partitioning, logical nodes and component architectures\",\"pdf_pages\":null,\"pdf_page_ranges\":[[468,473],[486,492]],\"source_maturity\":\"OOSEM method guidance\"}],\"verification_id\":\"V14\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Compare candidates with a failing requirement and incomplete evidence. Keep feasibility and u