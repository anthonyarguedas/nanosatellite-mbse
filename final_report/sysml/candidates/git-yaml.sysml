@PhysicalRecord { identifier = "allocate_FR_34_GY_C7"; recordJSON = "{\"requirement_id\":\"FR-34\",\"requirement_title\":\"Flight framework mapping\",\"requirement_text\":\"The framework shall produce or coordinate checked mappings of the EPS software contract to declared cFS software-bus and F-Prime typed-connection profiles and identify behavior and implementation gaps.\",\"mission_need_ids\":[\"MN-08\"],\"mission_requirement_ids\":[\"MR-08\"],\"logical_component_ids\":[\"L03\",\"L05\"],\"physical_component_ids\":[\"GY-C7\",\"GY-C24\",\"GY-C22\",\"GY-C14\"],\"realization_mechanism\":\"C7 separate cFS message/topic and FPP/F-Prime typed-port profiles produce/check reference mappings with profile/source versions. C22 validates build context and explicit unsupported behavior/export reports.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated data specification pattern, independent limited F-Prime export study.\",\"evidence_ids\":[\"GY-E07\",\"GY-E17\"],\"source_locators\":[{\"evidence_id\":\"GY-E07\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"3.3 and 4.1\",\"pdf_pages\":[43,44,45,46,56,57,58],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated data specifications, no cFS/F-Prime exporter demonstrated\"},{\"evidence_id\":\"GY-E17\",\"source_id\":\"review-0853\",\"bib_key\":\"review-0853\",\"sections\":\"3, Table 5, 5\",\"pdf_pages\":[7,8,9,10,12,13,14,16,17],\"pdf_page_ranges\":null,\"source_maturity\":\"independent SysML/F-Prime architecture export demonstration, no PA-GY exporter\"}],\"verification_id\":\"V34\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"D,T\",\"proposed_verification_fixture\":\"Round-trip or validate reference message and port mappings in both profiles. Declare framework version and unsupported exports. Architecture or dictionary generation is distinct from mission-specific functionality.\",\"implementation_gap\":\"Implement/test both version-specific mappings. No universal framework interchange or complete mission software generation is established.\",\"boundary_authority_note\":\"IF-04 build/configuration services and mission code remain external engineered artifacts. Architecture/dictionary output is bounded.\",\"interface_family_ids\":[\"IF-04\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and Non-EPS flight/ground engineers\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
