item obligation_FR_04 : EngineeringArtifact;
@PhysicalRecord { identifier = "FR-04"; recordJSON = "{\"requirement_id\":\"FR-04\",\"requirement_title\":\"Bidirectional trace retrieval\",\"requirement_text\":\"The framework shall retrieve applicable links from needs and requirements to design decisions, model inputs, verification criteria and results, and retrieve the reverse paths.\",\"mission_need_ids\":[\"MN-02\",\"MN-10\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-10\"],\"logical_component_ids\":[\"L02\",\"L08\"],\"physical_component_ids\":[\"GY-C12\",\"GY-C13\",\"GY-C3\",\"GY-C8\"],\"realization_mechanism\":\"C13 builds forward/reverse indexes over typed need/requirement/decision/input/criterion/result links and returns exact revision paths with missing, ambiguous and stale endpoints.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated incomplete trace pattern, demonstrated generation/issue linkage.\",\"evidence_ids\":[\"GY-E06\",\"GY-E08\"],\"source_locators\":[{\"evidence_id\":\"GY-E06\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"3.1, 3.2, Figs. 3.1 through 3.4\",\"pdf_pages\":[31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated but incomplete trace pattern\"},{\"evidence_id\":\"GY-E08\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.2, 4.3, Figs. 4.8 and 4.9\",\"pdf_pages\":[66,67,68],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated generation/workflow pattern, no general cross tool change propagation proof\"}],\"verification_id\":\"V04\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_verification_fixture\":\"Compare both query directions with the fixture relation set. Missing, ambiguous and stale endpoints remain visible.\",\"implementation_gap\":\"Implement relation vocabulary and fixture oracle. SeaLion derivedFrom links do not demonstrate this complete evidence graph.\",\"boundary_authority_note\":\"L02 owns link meaning. L08 controls endpoint identity. IF-01/IF-06 queries do not change records.\",\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer coordinates decisions with responsible engineers and Project Manager\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
