item obligation_FR_35 : EngineeringArtifact;
@PhysicalRecord { identifier = "FR-35"; recordJSON = "{\"requirement_id\":\"FR-35\",\"requirement_title\":\"Command and recovery contract\",\"requirement_text\":\"The framework shall specify and check EPS command preconditions, order, expected effects, rejection and failure behavior, mode transitions and recovery responsibilities across EPS, telemetry, fault-management and safe-mode functions.\",\"mission_need_ids\":[\"MN-08\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-08\",\"MR-04\"],\"logical_component_ids\":[\"L03\",\"L05\",\"L07\"],\"physical_component_ids\":[\"GY-C7\",\"GY-C24\",\"GY-C16\",\"GY-C20\"],\"realization_mechanism\":\"C24 command/recovery records declare guards, order, effects, rejection/timeout, modes and EPS/housekeeping/FDIR/safe-mode ownership. C7 virtual trace checker and C16 registered behavior stubs replay nominal/rejected/recovery sequences.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: independent limited F-Prime export study, independent FreeRTOS flight software case.\",\"evidence_ids\":[\"GY-E17\",\"GY-E18\"],\"source_locators\":[{\"evidence_id\":\"GY-E17\",\"source_id\":\"review-0853\",\"bib_key\":\"review-0853\",\"sections\":\"3, Table 5, 5\",\"pdf_pages\":[7,8,9,10,12,13,14,16,17],\"pdf_page_ranges\":null,\"source_maturity\":\"independent SysML/F-Prime architecture export demonstration, no PA-GY exporter\"},{\"evidence_id\":\"GY-E18\",\"source_id\":\"citation-0136\",\"bib_key\":\"citation-0136\",\"sections\":\"III.A.3 through III.B, IV.A.1, V, VI.A through VI.C\",\"pdf_pages\":[7,8,9,10,12,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent flight software case, no current framework/OS compatibility guarantee\"}],\"verification_id\":\"V35\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Replay nominal, rejected and recovery sequences with a qualified software reference. Confirm functional flow and ownership without claiming deployment of flight software.\",\"implementation_gap\":\"Implement checkable predicate/event semantics and qualified software reference fixtures. Human mission behavior implementation remains required.\",\"boundary_authority_note\":\"Checks run on virtual traces only. No deployment, flight operation or real protection actuation is claimed.\",\"interface_family_ids\":[\"IF-01\",\"IF-04\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and Non-EPS flight/ground engineers\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
