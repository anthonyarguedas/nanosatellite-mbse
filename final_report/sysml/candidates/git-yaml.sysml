#intendedRealization allocation allocate_FR_08_GY_C14 allocate FrameworkRequirements::FR_08 to physical.GY_C14;
@PhysicalRecord { identifier = "allocate_FR_08_GY_C14"; recordJSON = "{\"requirement_id\":\"FR-08\",\"requirement_title\":\"Semantic transfers\",\"requirement_text\":\"The framework shall check transferred identifiers, structure, quantities, units, polarity, time bases, interface meanings, and provenance against a declared contract and retain explicit rejection findings.\",\"mission_need_ids\":[\"MN-02\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-09\"],\"logical_component_ids\":[\"L08\"],\"physical_component_ids\":[\"GY-C14\",\"GY-C3\",\"GY-C18\",\"GY-C2\"],\"realization_mechanism\":\"C14 validates schema IDs/structure and declared dimensional, polarity, reference-frame, clock and interface mapping rules. C18 imports to quarantine before acceptance and records rejected/lossy mappings.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: parameter/API design only, demonstrated data specification pattern, independent diagnostic/calibration study.\",\"evidence_ids\":[\"GY-E03\",\"GY-E07\",\"GY-E15\"],\"source_locators\":[{\"evidence_id\":\"GY-E03\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"3.1 RQ-5 through RQ-7 and 3.2 Parameter Representation\",\"pdf_pages\":[8,9,10],\"pdf_page_ranges\":null,\"source_maturity\":\"source design and UI pattern, no demonstrated complete semantic or dependency engine\"},{\"evidence_id\":\"GY-E07\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"3.3 and 4.1\",\"pdf_pages\":[43,44,45,46,56,57,58],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated data specifications, no cFS/F-Prime exporter demonstrated\"},{\"evidence_id\":\"GY-E15\",\"source_id\":\"review-1251\",\"bib_key\":\"review-1251\",\"sections\":\"3.1, 4.1, 4.2, 6\",\"pdf_pages\":[7,8,9,22,23,31],\"pdf_page_ranges\":null,\"source_maturity\":\"independent diagnostic prototype, not availability/maintainability validation\"}],\"verification_id\":\"V08\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_verification_fixture\":\"Inject unit, sign, identifier and time-base mismatches. Reject incompatible transfers without replacing controlled content. Record unsupported or lossy mappings.\",\"implementation_gap\":\"Implement each semantic profile and rejection fixture. YAML parsing or nominal unit labels alone are insufficient.\",\"boundary_authority_note\":\"IF-02 through IF-05 producer content stays outside accepted records until checked. Native field authority is declared per mapping.\",\"interface_family_ids\":[\"IF-03\",\"IF-04\",\"IF-05\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer or delegated configuration custodian\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
