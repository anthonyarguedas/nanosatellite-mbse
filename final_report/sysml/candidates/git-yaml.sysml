#intendedRealization allocation allocate_FR_06_GY_C13 allocate FrameworkRequirements::FR_06 to physical.GY_C13;
@PhysicalRecord { identifier = "allocate_FR_06_GY_C13"; recordJSON = "{\"requirement_id\":\"FR-06\",\"requirement_title\":\"Change disposition\",\"requirement_text\":\"The framework shall issue a successor baseline for an accepted change that retains its request and failed-gate context and marks affected evidence as regenerated, stale, or unresolved.\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-07\"],\"logical_component_ids\":[\"L02\",\"L08\"],\"physical_component_ids\":[\"GY-C13\",\"GY-C14\",\"GY-C1\",\"GY-C8\",\"GY-C9\"],\"realization_mechanism\":\"C13 links request, failed gate and disposition. C14 emits a successor manifest only after human acceptance and labels dependent evidence regenerated, stale or unresolved while retaining prior releases.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: parameter/API design only, demonstrated documentation approach, reported adoption/change limits.\",\"evidence_ids\":[\"GY-E03\",\"GY-E05\",\"GY-E11\"],\"source_locators\":[{\"evidence_id\":\"GY-E03\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"3.1 RQ-5 through RQ-7 and 3.2 Parameter Representation\",\"pdf_pages\":[8,9,10],\"pdf_page_ranges\":null,\"source_maturity\":\"source design and UI pattern, no demonstrated complete semantic or dependency engine\"},{\"evidence_id\":\"GY-E05\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"2.2, 2.3, Table 2.1, 2.5\",\"pdf_pages\":[26,27,28,29,30],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated documentation approach, not general executable behavior\"},{\"evidence_id\":\"GY-E11\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"Chapter 3 opening, Chapter 5, 5.2\",\"pdf_pages\":[31,77,78,79],\"pdf_page_ranges\":null,\"source_maturity\":\"reported adoption/change limitations\"}],\"verification_id\":\"V06\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_verification_fixture\":\"Exercise a failed verification gate followed by correction. Preserve the prior baseline and prevent stale results from appearing current.\",\"implementation_gap\":\"Implement transaction/release checks and failed-gate fixture. Git merge alone does not establish engineering acceptance.\",\"boundary_authority_note\":\"L02 dispositions and L08 release custody are distinct. Prior criteria/results cannot be rewritten into a passed claim.\",\"interface_family_ids\":[\"IF-01\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer coordinates decisions with responsible engineers and Project Manager\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
