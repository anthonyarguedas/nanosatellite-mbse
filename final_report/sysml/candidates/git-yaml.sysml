@PhysicalRecord { identifier = "FR-18"; recordJSON = "{\"requirement_id\":\"FR-18\",\"requirement_title\":\"Discipline model integration\",\"requirement_text\":\"The framework shall exchange identified EPS component and design data with declared electrical, thermal, EMC and CAD analysis tools and retain model mappings, applicable outputs and unsupported checks.\",\"mission_need_ids\":[\"MN-04\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-07\"],\"logical_component_ids\":[\"L03\",\"L05\",\"L08\"],\"physical_component_ids\":[\"GY-C18\",\"GY-C14\",\"GY-C5\",\"GY-C24\"],\"realization_mechanism\":\"C18 separate electrical/thermal/EMC/CAD profiles send identified native model/input packages and register output mapping/results through C14. Missing discipline/property mappings are explicit development items.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: parameter/API design only, independent EPS design/test case.\",\"evidence_ids\":[\"GY-E03\",\"GY-E19\"],\"source_locators\":[{\"evidence_id\":\"GY-E03\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"3.1 RQ-5 through RQ-7 and 3.2 Parameter Representation\",\"pdf_pages\":[8,9,10],\"pdf_page_ranges\":null,\"source_maturity\":\"source design and UI pattern, no demonstrated complete semantic or dependency engine\"},{\"evidence_id\":\"GY-E19\",\"source_id\":\"handpicked-0003\",\"bib_key\":\"handpicked-0003\",\"sections\":\"7.7, 8.1.6, 8.1.7\",\"pdf_pages\":[10,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS case, its thresholds are not transferred\"}],\"verification_id\":\"V18\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"D,T\",\"proposed_verification_fixture\":\"Every electrical, thermal, EMC and CAD exchange profile required by the frozen minimum shall complete its reference request/result exchange and declared identity, quantity, unit, meaning and revision checks. Retain unsupported mappings and development gaps. A missing required profile remains not verified or undetermined and cannot pass V18. A narrower minimum requires a reviewed scope disposition before evaluation.\",\"implementation_gap\":\"LTspice/COMSOL/Simulink profiles and CAD tool/export profile require access, implementation and transfer tests. No bidirectional native model adapter is demonstrated.\",\"boundary_authority_note\":\"IF-03 specialist services are external except integrated C25 battery runtime. Each native/YAML field has one declared authority.\",\"interface_family_ids\":[\"IF-03\",\"IF-04\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and Non-EPS flight/ground engineers\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
