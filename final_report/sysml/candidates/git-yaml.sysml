#intendedRealization allocation allocate_FR_24_GY_C16 allocate FrameworkRequirements::FR_24 to physical.GY_C16;
@PhysicalRecord { identifier = "allocate_FR_24_GY_C16"; recordJSON = "{\"requirement_id\":\"FR-24\",\"requirement_title\":\"Controller policy assessment\",\"requirement_text\":\"The framework shall compare designated charging and power-management policies under declared load, thermal, health, electrical and timing conditions with safety constraints and policy-specific outcome evidence.\",\"mission_need_ids\":[\"MN-05\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-04\"],\"logical_component_ids\":[\"L05\",\"L06\",\"L07\"],\"physical_component_ids\":[\"GY-C16\",\"GY-C25\",\"GY-C17\",\"GY-C20\"],\"realization_mechanism\":\"C16 executes registered baseline/changed controller policies against identical load/thermal/health/electrical/time profiles. C20 constraint checks and C17 applicability distinguish predicted outcomes from separately supplied hardware evidence.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: independent EPS/HIL case with limits, independent battery preprint study.\",\"evidence_ids\":[\"GY-E14\",\"GY-E16\"],\"source_locators\":[{\"evidence_id\":\"GY-E14\",\"source_id\":\"review-0573\",\"bib_key\":\"review-0573\",\"sections\":\"2, 3, 4, 5\",\"pdf_pages\":[3,4,5,6,7,8,9,12,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS implementation with explicit model limits\"},{\"evidence_id\":\"GY-E16\",\"source_id\":\"handpicked-0001\",\"bib_key\":\"handpicked-0001\",\"sections\":\"Preliminaries, System Implementation and Evaluation\",\"pdf_pages\":[2,3,7,8,9],\"pdf_page_ranges\":null,\"source_maturity\":\"preprint, independent dataset study, not validated PA-GY controller/hardware decisions\"}],\"verification_id\":\"V24\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Replay a baseline and a changed policy against the same fixture conditions. A model prediction cannot be labeled a demonstrated hardware improvement. Retain pending SIL, HIL or hardware evidence.\",\"implementation_gap\":\"Implement controller/plant fixtures and agreed policy measures. Safe or improved hardware performance is unverified.\",\"boundary_authority_note\":\"Controller code is an engineered artifact registered for SIL. Policy results never authorize physical charging or autonomous actuation.\",\"interface_family_ids\":[\"IF-01\",\"IF-03\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer or designated analysis operator, independent reproducer for replay\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
