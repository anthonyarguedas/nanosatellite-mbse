#intendedRealization allocation allocate_FR_26_GY_C12 allocate FrameworkRequirements::FR_26 to physical.GY_C12;
@PhysicalRecord { identifier = "allocate_FR_26_GY_C12"; recordJSON = "{\"requirement_id\":\"FR-26\",\"requirement_title\":\"RAM requirement coverage\",\"requirement_text\":\"The framework shall identify the RAM variables and failure assumptions applicable to designated EPS and spacecraft requirements and report their verification-method coverage and gaps.\",\"mission_need_ids\":[\"MN-06\",\"MN-01\"],\"mission_requirement_ids\":[\"MR-06\",\"MR-01\"],\"logical_component_ids\":[\"L02\",\"L04\",\"L07\"],\"physical_component_ids\":[\"GY-C12\",\"GY-C19\",\"GY-C15\",\"GY-C20\"],\"realization_mechanism\":\"C19 RAM coverage query joins declared variables, mission/failure/recovery assumptions and C12 requirement links to C20 inspection/analysis/demonstration/test rationale and gaps.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: source design and explicit exclusions, demonstrated component/assembly pattern, OOSEM method guidance.\",\"evidence_ids\":[\"GY-E01\",\"GY-E09\",\"GY-E20\"],\"source_locators\":[{\"evidence_id\":\"GY-E01\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"2, RQ-1 through RQ-8 and 2.0.1 Non-Requirements\",\"pdf_pages\":[3,4,5],\"pdf_page_ranges\":null,\"source_maturity\":\"source design\"},{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"},{\"evidence_id\":\"GY-E20\",\"source_id\":\"friedenthal2014practical\",\"bib_key\":\"friedenthal2014practical\",\"sections\":\"17.3.5, partitioning, logical nodes and component architectures\",\"pdf_pages\":null,\"pdf_page_ranges\":[[468,473],[486,492]],\"source_maturity\":\"OOSEM method guidance\"}],\"verification_id\":\"V26\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_verification_fixture\":\"Compare the declared RAM variable and requirement set with a reference. Report analysis, inspection, demonstration or test rationale without forcing every claim to use analysis.\",\"implementation_gap\":\"Curate RAM variables and reference coverage set. Primary lightweight tool excludes failure management.\",\"boundary_authority_note\":\"Systems/EPS Engineer determines applicability and method. Framework coverage never establishes achieved spacecraft RAM.\",\"interface_family_ids\":[\"IF-01\",\"IF-02\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer coordinates decisions with responsible engineers and Project Manager\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
