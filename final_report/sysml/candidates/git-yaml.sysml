#intendedRealization allocation allocate_FR_31_GY_C21 allocate FrameworkRequirements::FR_31 to physical.GY_C21;
@PhysicalRecord { identifier = "allocate_FR_31_GY_C21"; recordJSON = "{\"requirement_id\":\"FR-31\",\"requirement_title\":\"Evidence timing\",\"requirement_text\":\"The framework shall record the time base, sampling and synchronization rules and known measurement, calculation and output delays for applied stimuli, responses and telemetry.\",\"mission_need_ids\":[\"MN-07\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-09\"],\"logical_component_ids\":[\"L06\",\"L08\"],\"physical_component_ids\":[\"GY-C21\",\"GY-C14\",\"GY-C8\"],\"realization_mechanism\":\"C21 observation timing records retain origins/scales, sample versus receipt times, offsets/drift, sync/resampling rules and measured/estimated delays. Alignment produces transformed series plus uncertainty without changing raw data.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: independent EPS/HIL case with limits, independent diagnostic/calibration study, independent EPS design/test case.\",\"evidence_ids\":[\"GY-E14\",\"GY-E15\",\"GY-E19\"],\"source_locators\":[{\"evidence_id\":\"GY-E14\",\"source_id\":\"review-0573\",\"bib_key\":\"review-0573\",\"sections\":\"2, 3, 4, 5\",\"pdf_pages\":[3,4,5,6,7,8,9,12,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS implementation with explicit model limits\"},{\"evidence_id\":\"GY-E15\",\"source_id\":\"review-1251\",\"bib_key\":\"review-1251\",\"sections\":\"3.1, 4.1, 4.2, 6\",\"pdf_pages\":[7,8,9,22,23,31],\"pdf_page_ranges\":null,\"source_maturity\":\"independent diagnostic prototype, not availability/maintainability validation\"},{\"evidence_id\":\"GY-E19\",\"source_id\":\"handpicked-0003\",\"bib_key\":\"handpicked-0003\",\"sections\":\"7.7, 8.1.6, 8.1.7\",\"pdf_pages\":[10,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS case, its thresholds are not transferred\"}],\"verification_id\":\"V31\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Align a known timestamp fixture and expose injected skew and missing timing metadata. Report alignment error or uncertainty against the agreed profile, with no invented global limit.\",\"implementation_gap\":\"Implement known-skew and missing-metadata fixtures. No universal synchronization error threshold is set.\",\"boundary_authority_note\":\"L06 owns interpretation, L08 common time vocabulary and custody. Equipment clocks/delays are IF-05 source evidence.\",\"interface_family_ids\":[\"IF-05\"],\"execution_host_ids\":[\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and qualified model/data reviewer\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
