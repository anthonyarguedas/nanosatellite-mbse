#intendedRealization allocation allocate_FR_01_GY_C12 allocate FrameworkRequirements::FR_01 to physical.GY_C12;
@PhysicalRecord { identifier = "allocate_FR_01_GY_C12"; recordJSON = "{\"requirement_id\":\"FR-01\",\"requirement_title\":\"Requirement record\",\"requirement_text\":\"The framework shall retain each requirement as an identified record with source need, parent, rationale, observable quantities or conditions and applicable units, owner, verification method, criterion, and resolution status.\",\"mission_need_ids\":[\"MN-01\",\"MN-02\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-02\"],\"logical_component_ids\":[\"L02\"],\"physical_component_ids\":[\"GY-C12\",\"GY-C2\",\"GY-C14\"],\"realization_mechanism\":\"C12 typed requirement records retain source/parent/rationale/owner, observable quantities or qualitative conditions, applicable units, method/criterion and resolution. C14 checks round trips and justified not-applicable fields.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: source design and explicit exclusions, demonstrated incomplete trace pattern, procedural guidance.\",\"evidence_ids\":[\"GY-E01\",\"GY-E06\",\"GY-E12\"],\"source_locators\":[{\"evidence_id\":\"GY-E01\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"2, RQ-1 through RQ-8 and 2.0.1 Non-Requirements\",\"pdf_pages\":[3,4,5],\"pdf_page_ranges\":null,\"source_maturity\":\"source design\"},{\"evidence_id\":\"GY-E06\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"3.1, 3.2, Figs. 3.1 through 3.4\",\"pdf_pages\":[31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated but incomplete trace pattern\"},{\"evidence_id\":\"GY-E12\",\"source_id\":\"cubesat-handbook-part-I\",\"bib_key\":\"aguado2021cubesatse\",\"sections\":\"I.4.1 through I.4.1.5 and I.5 through I.5.2\",\"pdf_pages\":[28,29,30,31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"procedural guidance, no PA-GY performance evidence\"}],\"verification_id\":\"V01\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_verification_fixture\":\"Round-trip a quantitative requirement and a qualitative demonstration requirement, including source, condition or quantity, applicable units and criterion. An inapplicable field retains rationale. An absent criterion remains unresolved and cannot acquire a verified label.\",\"implementation_gap\":\"Implement schema and qualitative/demonstration fixtures. A complete record does not prove technical truth.\",\"boundary_authority_note\":\"Domain requirement owner decides meaning and criteria through IF-01. No mandatory numerical criterion.\",\"interface_family_ids\":[\"IF-01\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer coordinates decisions with responsible engineers and Project Manager\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
