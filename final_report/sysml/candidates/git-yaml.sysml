#intendedRealization allocation allocate_FR_11_GY_C13 allocate FrameworkRequirements::FR_11 to physical.GY_C13;
@PhysicalRecord { identifier = "allocate_FR_11_GY_C13"; recordJSON = "{\"requirement_id\":\"FR-11\",\"requirement_title\":\"Evidence and discrepancy status\",\"requirement_text\":\"The framework shall report missing, rejected, stale, out-of-domain, failed, and unresolved evidence with its affected claim, criticality rationale, owner and disposition.\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-10\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-10\"],\"logical_component_ids\":[\"L02\",\"L07\",\"L09\"],\"physical_component_ids\":[\"GY-C13\",\"GY-C20\",\"GY-C4\",\"GY-C8\"],\"realization_mechanism\":\"C20 evidence-status rules link missing/rejected/stale/out-of-domain/failed/unresolved findings to claim, criticality rationale, owner and disposition. C13 propagates effects and C4 exposes blocked claims.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: parameter/API design only, demonstrated incomplete trace pattern, reported adoption/change limits.\",\"evidence_ids\":[\"GY-E03\",\"GY-E06\",\"GY-E11\"],\"source_locators\":[{\"evidence_id\":\"GY-E03\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"3.1 RQ-5 through RQ-7 and 3.2 Parameter Representation\",\"pdf_pages\":[8,9,10],\"pdf_page_ranges\":null,\"source_maturity\":\"source design and UI pattern, no demonstrated complete semantic or dependency engine\"},{\"evidence_id\":\"GY-E06\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"3.1, 3.2, Figs. 3.1 through 3.4\",\"pdf_pages\":[31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated but incomplete trace pattern\"},{\"evidence_id\":\"GY-E11\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"Chapter 3 opening, Chapter 5, 5.2\",\"pdf_pages\":[31,77,78,79],\"pdf_page_ranges\":null,\"source_maturity\":\"reported adoption/change limitations\"}],\"verification_id\":\"V11\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_verification_fixture\":\"Seed each status including a critical finding. A claim affected by unresolved critical evidence cannot receive an unqualified supported or verified status.\",\"implementation_gap\":\"Define/test the status policy and critical finding fixture. Parameter approval states are only a source pattern.\",\"boundary_authority_note\":\"L02 governs disposition, L07 admissibility, L09 displays outcome. No unqualified supported/verified label with unresolved critical evidence.\",\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer coordinates decisions with responsible engineers and Project Manager\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
