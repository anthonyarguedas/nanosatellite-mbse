#intendedRealization allocation allocate_FR_09_GY_C14 allocate FrameworkRequirements::FR_09 to physical.GY_C14;
@PhysicalRecord { identifier = "allocate_FR_09_GY_C14"; recordJSON = "{\"requirement_id\":\"FR-09\",\"requirement_title\":\"Result provenance\",\"requirement_text\":\"The framework shall associate each result with its producer, method, requirement and decision, design and hardware configuration, software and model versions, parameter set, input data, environment, and raw output.\",\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-09\"],\"logical_component_ids\":[\"L08\",\"L06\"],\"physical_component_ids\":[\"GY-C14\",\"GY-C8\",\"GY-C17\",\"GY-C21\"],\"realization_mechanism\":\"C14 result envelopes bind producer/method, requirement/decision, design/hardware/software/model/parameter/input/environment IDs and raw artifact digests. C17/C21 attach credibility and measurement context without copying authorities.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: limited proof of concept and storage design, demonstrated incomplete trace pattern, demonstrated component/assembly pattern, independent diagnostic/calibration study.\",\"evidence_ids\":[\"GY-E02\",\"GY-E06\",\"GY-E09\",\"GY-E15\"],\"source_locators\":[{\"evidence_id\":\"GY-E02\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"Abstract, 3, 3.1, Fig. 6\",\"pdf_pages\":[1,5,6,9],\"pdf_page_ranges\":null,\"source_maturity\":\"limited proof of concept plus storage design\"},{\"evidence_id\":\"GY-E06\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"3.1, 3.2, Figs. 3.1 through 3.4\",\"pdf_pages\":[31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated but incomplete trace pattern\"},{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"},{\"evidence_id\":\"GY-E15\",\"source_id\":\"review-1251\",\"bib_key\":\"review-1251\",\"sections\":\"3.1, 4.1, 4.2, 6\",\"pdf_pages\":[7,8,9,22,23,31],\"pdf_page_ranges\":null,\"source_maturity\":\"independent diagnostic prototype, not availability/maintainability validation\"}],\"verification_id\":\"V09\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_verification_fixture\":\"Trace an analytical and a supplied measurement result to every applicable configuration item. An unknown identity remains a gap and blocks a contradictory validity claim.\",\"implementation_gap\":\"Complete envelopes and unknown-identity gates for analytical and supplied measurement fixtures are unimplemented.\",\"boundary_authority_note\":\"Registered custody and scientific applicability are separate. IF-03/IF-05 raw outputs do not acquire verification status on import.\",\"interface_family_ids\":[\"IF-03\",\"IF-04\",\"IF-05\"],\"execution_host_ids\":[\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer or delegated configuration custodian\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
