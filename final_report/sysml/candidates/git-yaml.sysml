ification_id\":\"V21\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_verification_fixture\":\"Exercise an in-domain and an extrapolated claim. Separate calibration from validation data where available. Flag untested domains and absent error limits. Prediction accuracy limits require prior agreement.\",\"implementation_gap\":\"Author/test applicability rules and independent validation records. Error limits require intended-use review before execution.\",\"boundary_authority_note\":\"Model owner states applicability. L07 judges admissibility. Record completeness and low fitting error do not prove hardware truth.\",\"interface_family_ids\":[\"IF-03\",\"IF-05\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and qualified model/data reviewer\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
