#intendedRealization allocation allocate_FR_28_GY_C20 allocate FrameworkRequirements::FR_28 to physical.GY_C20;
@PhysicalRecord { identifier = "allocate_FR_28_GY_C20"; recordJSON = "{\"requirement_id\":\"FR-28\",\"requirement_title\":\"Verification activity record\",\"requirement_text\":\"The framework shall retain each EPS or component verification activity with requirement, method, DUT baseline, applicable quantities or observable conditions, inputs, expected response, criterion, evidence variables and status. An inapplicable field shall retain its rationale.\",\"mission_need_ids\":[\"MN-07\",\"MN-01\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-01\"],\"logical_component_ids\":[\"L07\"],\"physical_component_ids\":[\"GY-C20\",\"GY-C12\",\"GY-C2\",\"GY-C8\"],\"realization_mechanism\":\"C20 method-specific YAML activity schemas preserve subject/requirement/method/DUT revision, quantities or applicable conditions, inputs/expected response, criterion, evidence variables, status and failed-gate context.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: source design and explicit exclusions, demonstrated component/assembly pattern, procedural guidance, independent EPS design/test case.\",\"evidence_ids\":[\"GY-E01\",\"GY-E09\",\"GY-E12\",\"GY-E19\"],\"source_locators\":[{\"evidence_id\":\"GY-E01\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"2, RQ-1 through RQ-8 and 2.0.1 Non-Requirements\",\"pdf_pages\":[3,4,5],\"pdf_page_ranges\":null,\"source_maturity\":\"source design\"},{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"},{\"evidence_id\":\"GY-E12\",\"source_id\":\"cubesat-handbook-part-I\",\"bib_key\":\"aguado2021cubesatse\",\"sections\":\"I.4.1 through I.4.1.5 and I.5 through I.5.2\",\"pdf_pages\":[28,29,30,31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"procedural guidance, no PA-GY performance evidence\"},{\"evidence_id\":\"GY-E19\",\"source_id\":\"handpicked-0003\",\"bib_key\":\"handpicked-0003\",\"sections\":\"7.7, 8.1.6, 8.1.7\",\"pdf_pages\":[10,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS case, its thresholds are not transferred\"}],\"verification_id\":\"V28\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_verification_fixture\":\"Inspect quantitative analysis/test and qualitative inspection/demonstration fixtures against their method-specific fields. Check the applicable quantity or observable condition, criterion, expected response and evidence. An inapplicable field retains rationale. Missing mandatory fields, failed gates and unresolved criteria remain explicit and prevent an unsupported verdict.\",\"implementation_gap\":\"Implement/test all four method profiles and preserve baseline statement without making every activity quantitative.\",\"boundary_authority_note\":\"EPS activity records concern the engineered EPS. V28 tests the framework record mechanism, not completion of each EPS activity.\",\"interface_family_ids\":[\"IF-01\",\"IF-05\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS/Systems Engineer specifies activity, technician/facility evaluates feasibility and safety\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
