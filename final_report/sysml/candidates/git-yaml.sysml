@PhysicalRecord { identifier = "allocate_FR_12_GY_C15"; recordJSON = "{\"requirement_id\":\"FR-12\",\"requirement_title\":\"Candidate BOM\",\"requirement_text\":\"The framework shall generate and revise a candidate-specific BOM from identified physical design items with assembly, quantities, part identifiers, variant and selection status, and source revision.\",\"mission_need_ids\":[\"MN-03\"],\"mission_requirement_ids\":[\"MR-03\"],\"logical_component_ids\":[\"L04\"],\"physical_component_ids\":[\"GY-C15\",\"GY-C24\",\"GY-C2\",\"GY-C4\"],\"realization_mechanism\":\"C15 expands selected C24 assembly occurrences using quantity/part/variant/status records into revision-linked separate candidate BOMs, with explicit missing parts and substitution effects.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated component/assembly pattern.\",\"evidence_ids\":[\"GY-E09\"],\"source_locators\":[{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"}],\"verification_id\":\"V12\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Compare two alternative assemblies and one component substitution with a reference BOM. Candidate alternatives remain distinct. Missing part data is reported.\",\"implementation_gap\":\"Implement rollup and shared-instance rules. Source parts/assembly examples do not verify PA-GY BOM correctness.\",\"boundary_authority_note\":\"EPS Engineer controls physical selection via IF-01. Supplier identifiers are sourced through IF-02.\",\"interface_family_ids\":[\"IF-01\",\"IF-02\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\"