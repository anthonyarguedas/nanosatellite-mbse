#intendedRealization allocation allocate_FR_16_GY_C16 allocate FrameworkRequirements::FR_16 to physical.GY_C16;
@PhysicalRecord { identifier = "allocate_FR_16_GY_C16"; recordJSON = "{\"requirement_id\":\"FR-16\",\"requirement_title\":\"Dynamic mission composition\",\"requirement_text\":\"The framework shall compose time-dependent subsystem demand, duty cycles, schedules and mode transitions with orbit, attitude, irradiance, eclipse, thermal conditions and EPS supply and protection behavior.\",\"mission_need_ids\":[\"MN-04\",\"MN-05\",\"MN-08\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-05\",\"MR-08\"],\"logical_component_ids\":[\"L05\",\"L03\",\"L04\"],\"physical_component_ids\":[\"GY-C16\",\"GY-C24\",\"GY-C15\",\"GY-C25\",\"GY-C6\"],\"realization_mechanism\":\"C16 time coordinator combines registered orbit/attitude/irradiance/eclipse/temperature profiles, scheduled/mode-dependent loads and supply/protection routines. C25 battery state feeds coupled current/energy balances.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: parameter/API design only, independent dynamic energy study, independent EPS/HIL case with limits.\",\"evidence_ids\":[\"GY-E03\",\"GY-E13\",\"GY-E14\"],\"source_locators\":[{\"evidence_id\":\"GY-E03\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"3.1 RQ-5 through RQ-7 and 3.2 Parameter Representation\",\"pdf_pages\":[8,9,10],\"pdf_page_ranges\":null,\"source_maturity\":\"source design and UI pattern, no demonstrated complete semantic or dependency engine\"},{\"evidence_id\":\"GY-E13\",\"source_id\":\"review-1231\",\"bib_key\":\"review-1231\",\"sections\":\"I through III, V, VI\",\"pdf_pages\":[1,2,3,5,6,7],\"pdf_page_ranges\":null,\"source_maturity\":\"independent NetSat simulation study, not integrated PA-GY software\"},{\"evidence_id\":\"GY-E14\",\"source_id\":\"review-0573\",\"bib_key\":\"review-0573\",\"sections\":\"2, 3, 4, 5\",\"pdf_pages\":[3,4,5,6,7,8,9,12,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS implementation with explicit model limits\"}],\"verification_id\":\"V16\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Use a fixture whose average budget passes while a coupled load and illumination event creates a transient shortage. Inspect inputs, interactions and event timing against a reference calculation.\",\"implementation_gap\":\"Implement/check time coupling and shortage fixture. Primary sources do not contain a complete coupled EPS solver.\",\"boundary_authority_note\":\"Inputs from IF-01/IF-03 have declared units/frame/time authority. Execution success and model fidelity remain separate.\",\"interface_family_ids\":[\"IF-01\",\"IF-03\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer or designated analysis operator, independent reproducer for replay\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
