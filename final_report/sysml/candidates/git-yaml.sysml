item obligation_FR_02 : EngineeringArtifact;
@PhysicalRecord { identifier = "FR-02"; recordJSON = "{\"requirement_id\":\"FR-02\",\"requirement_title\":\"Learning and templates\",\"requirement_text\":\"The framework shall provide requirement and traceability templates, worked EPS examples, and a guided reference workflow that covers writing criteria, linking evidence, and interpreting gaps.\",\"mission_need_ids\":[\"MN-01\",\"MN-11\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-11\"],\"logical_component_ids\":[\"L01\",\"L09\"],\"physical_component_ids\":[\"GY-C12\",\"GY-C9\",\"GY-C4\",\"GY-C23\"],\"realization_mechanism\":\"Versioned C12 EPS examples and criterion/trace templates plus C9 guided CLI/editor workflow. C4 renders lessons, C23 records clean-start learner errors and effort.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated documentation approach, demonstrated incomplete trace pattern, reported adoption/change limits, procedural guidance.\",\"evidence_ids\":[\"GY-E05\",\"GY-E06\",\"GY-E11\",\"GY-E12\"],\"source_locators\":[{\"evidence_id\":\"GY-E05\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"2.2, 2.3, Table 2.1, 2.5\",\"pdf_pages\":[26,27,28,29,30],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated documentation approach, not general executable behavior\"},{\"evidence_id\":\"GY-E06\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"3.1, 3.2, Figs. 3.1 through 3.4\",\"pdf_pages\":[31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated but incomplete trace pattern\"},{\"evidence_id\":\"GY-E11\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"Chapter 3 opening, Chapter 5, 5.2\",\"pdf_pages\":[31,77,78,79],\"pdf_page_ranges\":null,\"source_maturity\":\"reported adoption/change limitations\"},{\"evidence_id\":\"GY-E12\",\"source_id\":\"cubesat-handbook-part-I\",\"bib_key\":\"aguado2021cubesatse\",\"sections\":\"I.4.1 through I.4.1.5 and I.5 through I.5.2\",\"pdf_pages\":[28,29,30,31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"procedural guidance, no PA-GY performance evidence\"}],\"verification_id\":\"V02\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_verification_fixture\":\"Inspect the learning package and demonstrate the workflow from a declared clean start. Measure learner effort and errors without imposing an unagreed time limit.\",\"implementation_gap\":\"Curate and trial examples with novice users. SeaLion ease-of-use assertions provide no measured onboarding outcome.\",\"boundary_authority_note\":\"L01 curates knowledge. Learner observations via IF-01/IF-06 are framework evaluation records.\",\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer curates guidance with EPS/Non-EPS specialists\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
#plannedVerification dependency planned_FR_02_V02 from obligation_FR_02 to FrameworkVerification::V02;
@PhysicalRecord { identifier = "planned_FR_02_V02"; recordJSON = "{\"status\":\"planned, not executed\"}"; status = "proposed comparison description, not implemented or verified"; }
#executionHost dependency obligation_FR_02_execution_host_ids_GY_H1 from obligation_FR_02 to physical::GY_H1;
#executionHost dependency obligation_FR_02_execution_host_ids_GY_H3 from obligation_FR_02 to physical::GY_H3;
#storageCustody dependency obligation_FR_02_storage_host_ids_GY_H2 from obligation_FR_02 to physical::GY_H2;
#intendedRealization allocation allocate_FR_03_GY_C12 allocate FrameworkRequirements::FR_03 to physical.GY_C12;
@PhysicalRecord { identifier = "allocate_FR_03_GY_C12"; recordJSON = "{\"requirement_id\":\"FR-03\",\"requirement_title\":\"Method applicability\",\"requirement_text\":\"The framework shall retain a source-linked catalogue of requirement derivation and verification methods, standards, and activity templates with applicability, tailoring rationale, and limitations.\",\"mission_need_ids\":[\"MN-01\",\"MN-07\",\"MN-11\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-07\",\"MR-11\"],\"logical_component_ids\":[\"L01\",\"L07\"],\"physical_component_ids\":[\"GY-C12\",\"GY-C20\",\"GY-C9\"],\"realization_mechanism\":\"C12 catalogue entries link method/standard edition, source section, applicability, exclusions and tailoring reasons to C20 method-specific activity templates.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: source design and explicit exclusions, procedural guidance, independent EPS design/test case.\",\"evidence_ids\":[\"GY-E01\",\"GY-E12\",\"GY-E19\"],\"source_locators\":[{\"evidence_id\":\"GY-E01\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"2, RQ-1 through RQ-8 and 2.0.1 Non-Requirements\",\"pdf_pages\":[3,4,5],\"pdf_page_ranges\":null,\"source_maturity\":\"source design\"},{\"evidence_id\":\"GY-E12\",\"source_id\":\"cubesat-handbook-part-I\",\"bib_key\":\"aguado2021cubesatse\",\"sections\":\"I.4.1 through I.4.1.5 and I.5 through I.5.2\",\"pdf_pages\":[28,29,30,31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"procedural guidance, no PA-GY performance evidence\"},{\"evidence_id\":\"GY-E19\",\"source_id\":\"handpicked-0003\",\"bib_key\":\"handpicked-0003\",\"sections\":\"7.7, 8.1.6, 8.1.7\",\"pdf_pages\":[10,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS case, its thresholds are not transferred\"}],\"verification_id\":\"V03\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_verification_fixture\":\"For subsystem and component fixtures retrieve the chosen method and its source, conditions, tailoring decision, and excluded alternatives. A catalogue entry does not assert standards compliance.\",\"implementation_gap\":\"Catalogue coverage and applicability require domain curation. Standards compliance cannot be inferred from a source link.\",\"boundary_authority_note\":\"Source authority IF-02 is external. Engineer selects applicable methods and unresolved alternatives.\",\"interface_family_ids\":[\"IF-02\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer curates guidance with EPS/Non-EPS specialists\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
