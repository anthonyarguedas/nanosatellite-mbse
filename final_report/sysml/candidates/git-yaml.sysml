@PhysicalRecord { identifier = "FR-20"; recordJSON = "{\"requirement_id\":\"FR-20\",\"requirement_title\":\"Battery model coupling\",\"requirement_text\":\"The framework shall integrate identified battery electrical, thermal and degradation models with mission loads and retain the states, health and lifetime outputs, assumptions and uncertainty supported by each model.\",\"mission_need_ids\":[\"MN-05\"],\"mission_requirement_ids\":[\"MR-05\"],\"logical_component_ids\":[\"L05\",\"L06\",\"L04\"],\"physical_component_ids\":[\"GY-C16\",\"GY-C25\",\"GY-C17\",\"GY-C15\"],\"realization_mechanism\":\"C16 battery adapter couples load current and thermal conditions to registered C25 electrical/thermal/selected degradation models. C17 retains model-supported SoC/SoH/lifetime outputs and uncertainty with parameter/health context.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: independent EPS/HIL case with limits, independent battery preprint study.\",\"evidence_ids\":[\"GY-E14\",\"GY-E16\"],\"source_locators\":[{\"evidence_id\":\"GY-E14\",\"source_id\":\"review-0573\",\"bib_key\":\"review-0573\",\"sections\":\"2, 3, 4, 5\",\"pdf_pages\":[3,4,5,6,7,8,9,12,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS implementation with explicit model limits\"},{\"evidence_id\":\"GY-E16\",\"source_id\":\"handpicked-0001\",\"bib_key\":\"handpicked-0001\",\"sections\":\"Preliminaries, System Implementation and Evaluation\",\"pdf_pages\":[2,3,7,8,9],\"pdf_page_ranges\":null,\"source_maturity\":\"preprint, independent dataset study, not validated PA-GY controller/hardware decisions\"}],\"verification_id\":\"V20\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,D\",\"proposed_verification_fixture\":\"Replay fresh and aged battery fixtures under different load and temperature profiles. Verify coupling and provenance. Missing aging mechanisms and latent-state uncertainty remain visible.\",\"