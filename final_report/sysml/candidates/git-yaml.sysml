@PhysicalRecord { identifier = "allocate_FR_32_GY_C21"; recordJSON = "{\"requirement_id\":\"FR-32\",\"requirement_title\":\"Telemetry quality\",\"requirement_text\":\"The framework shall check expected telemetry channels, units, timestamps, completeness and sensor validity conditions and preserve raw samples, invalid values and processing masks.\",\"mission_need_ids\":[\"MN-07\",\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-05\",\"MR-09\"],\"logical_component_ids\":[\"L06\",\"L08\"],\"physical_component_ids\":[\"GY-C21\",\"GY-C14\",\"GY-C8\"],\"realization_mechanism\":\"C21 validates channel manifest/units/timestamps and completeness, evaluates mode/active-unit sensor conditions, preserves raw invalid samples and writes explicit masks for subsequent analysis.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: independent diagnostic/calibration study, independent EPS design/test case.\",\"evidence_ids\":[\"GY-E15\",\"GY-E19\"],\"source_locators\":[{\"evidence_id\":\"GY-E15\",\"source_id\":\"review-1251\",\"bib_key\":\"review-1251\",\"sections\":\"3.1, 4.1, 4.2, 6\",\"pdf_pages\":[7,8,9,22,23,31],\"pdf_page_ranges\":null,\"source_maturity\":\"independent diagnostic prototype, not availability/maintainability validation\"},{\"evidence_id\":\"GY-E19\",\"source_id\":\"handpicked-0003\",\"bib_key\":\"handpicked-0003\",\"sections\":\"7.7, 8.1.6, 8.1.7\",\"pdf_pages\":[10,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS case, its thresholds are not transferred\"}],\"verification_id\":\"V32\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_verification_fixture\":\"Inject missing samples, inactive sensors and invalid values. Do not treat inactive invalid readings as valid measurements. Match the fixture quality verdict and retained raw data.\",\"implementation_gap\":\"Implement inactive/missing/invalid sample fixtures. Sensors and calibration specifications need declared sources.\",\"boundary_authority_note\":\"Quality verdict differs from transfer acceptance and EPS verification. Invalid readings never silently become zero or valid measurements.\",\"interface_family_ids\":[\"IF-05\"],\"execution_host_ids\":[\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and qualified model/data reviewer\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
