#intendedRealization allocation allocate_FR_15_GY_C24 allocate FrameworkRequirements::FR_15 to physical.GY_C24;
@PhysicalRecord { identifier = "allocate_FR_15_GY_C24"; recordJSON = "{\"requirement_id\":\"FR-15\",\"requirement_title\":\"Reusable EPS representation\",\"requirement_text\":\"The framework shall provide a configurable generic EPS representation covering requirements, functions, logical and physical elements, interfaces, modes and states, with case-specific parameter and extension records.\",\"mission_need_ids\":[\"MN-04\",\"MN-11\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-11\"],\"logical_component_ids\":[\"L03\"],\"physical_component_ids\":[\"GY-C24\",\"GY-C12\",\"GY-C2\",\"GY-C23\"],\"realization_mechanism\":\"C24 YAML generic EPS library covers functions/elements/allocations/interfaces/modes/states and references C12 requirements. C23 case overlays pin the core and declare parameter/extension relations.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated incomplete trace pattern, demonstrated data specification pattern, demonstrated component/assembly pattern.\",\"evidence_ids\":[\"GY-E06\",\"GY-E07\",\"GY-E09\"],\"source_locators\":[{\"evidence_id\":\"GY-E06\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"3.1, 3.2, Figs. 3.1 through 3.4\",\"pdf_pages\":[31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated but incomplete trace pattern\"},{\"evidence_id\":\"GY-E07\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"3.3 and 4.1\",\"pdf_pages\":[43,44,45,46,56,57,58],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated data specifications, no cFS/F-Prime exporter demonstrated\"},{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"}],\"verification_id\":\"V15\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_verification_fixture\":\"Instantiate the representation in two contrasting cases and trace a requirement through function, allocation, interface and analysis. An extension retains its relation to the generic core.\",\"implementation_gap\":\"Generic EPS content, extension semantics and both case fixtures remain to be authored and checked.\",\"boundary_authority_note\":\"Framework-native modeling is internal. SysML v2 can describe the OOSEM design without prescribing the PA-GY runtime.\",\"interface_family_ids\":[\"IF-01\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and Non-EPS flight/ground engineers\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
