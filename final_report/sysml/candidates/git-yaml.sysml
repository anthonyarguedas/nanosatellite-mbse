#intendedRealization allocation allocate_FR_40_GY_C23 allocate FrameworkRequirements::FR_40 to physical.GY_C23;
@PhysicalRecord { identifier = "allocate_FR_40_GY_C23"; recordJSON = "{\"requirement_id\":\"FR-40\",\"requirement_title\":\"Contrasting-case reuse\",\"requirement_text\":\"The framework shall apply an identified common core to two predefined contrasting EPS cases using declared parameters, mappings and extensions and retain case outcomes and any core changes.\",\"mission_need_ids\":[\"MN-11\"],\"mission_requirement_ids\":[\"MR-11\"],\"logical_component_ids\":[\"L09\",\"L01\",\"L08\"],\"physical_component_ids\":[\"GY-C23\",\"GY-C24\",\"GY-C1\",\"GY-C8\",\"GY-C9\"],\"realization_mechanism\":\"C23 pins core/schema/adapter/recipe digests and two declared case overlays/extensions. C1 diff checks retain every core change. Outcomes stay case-specific and changed core requires both cases to be rebaselined/replayed.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated documentation approach, demonstrated component/assembly pattern, OOSEM method guidance.\",\"evidence_ids\":[\"GY-E05\",\"GY-E09\",\"GY-E20\"],\"source_locators\":[{\"evidence_id\":\"GY-E05\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"2.2, 2.3, Table 2.1, 2.5\",\"pdf_pages\":[26,27,28,29,30],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated documentation approach, not general executable behavior\"},{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"},{\"evidence_id\":\"GY-E20\",\"source_id\":\"friedenthal2014practical\",\"bib_key\":\"friedenthal2014practical\",\"sections\":\"17.3.5, partitioning, logical nodes and component architectures\",\"pdf_pages\":null,\"pdf_page_ranges\":[[468,473],[486,492]],\"source_maturity\":\"OOSEM method guidance\"}],\"verification_id\":\"V40\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D,T\",\"proposed_verification_fixture\":\"Complete the same declared workflow in both cases without undeclared or post hoc core changes. If the core changes, rebaseline and rerun both cases before a reuse claim. No implementation or successful outcome is asserted here.\",\"implementation_gap\":\"Define both contrasting cases and permitted tailoring before evaluation. Common-core completion is not demonstrated.\",\"boundary_authority_note\":\"IF-01 engineer freezes case declarations, IF-06 evaluator records outcomes. Undeclared or post hoc core changes cannot be disguised as adaptation.\",\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"All five stakeholder roles, named reviewer/reproducer and study evaluator\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
