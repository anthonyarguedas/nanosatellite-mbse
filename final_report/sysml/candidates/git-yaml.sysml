#intendedRealization allocation allocate_FR_05_GY_C13 allocate FrameworkRequirements::FR_05 to physical.GY_C13;
@PhysicalRecord { identifier = "allocate_FR_05_GY_C13"; recordJSON = "{\"requirement_id\":\"FR-05\",\"requirement_title\":\"Change impact\",\"requirement_text\":\"The framework shall identify the requirements, EPS and non-EPS allocations, BOMs, models, software definitions, procedures, and evidence affected by a designated change.\",\"mission_need_ids\":[\"MN-02\",\"MN-03\",\"MN-08\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-03\",\"MR-08\"],\"logical_component_ids\":[\"L02\",\"L08\"],\"physical_component_ids\":[\"GY-C13\",\"GY-C15\",\"GY-C24\",\"GY-C7\",\"GY-C20\"],\"realization_mechanism\":\"C13 traverses explicit dependency types from a designated diff across EPS/non-EPS allocations, component/BOM/model/service/procedure and evidence IDs. Produces impacted and unmapped sets, not only Git filenames.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: parameter/API design only, demonstrated generation/issue linkage, demonstrated component/assembly pattern, reported adoption/change limits.\",\"evidence_ids\":[\"GY-E03\",\"GY-E08\",\"GY-E09\",\"GY-E11\"],\"source_locators\":[{\"evidence_id\":\"GY-E03\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"3.1 RQ-5 through RQ-7 and 3.2 Parameter Representation\",\"pdf_pages\":[8,9,10],\"pdf_page_ranges\":null,\"source_maturity\":\"source design and UI pattern, no demonstrated complete semantic or dependency engine\"},{\"evidence_id\":\"GY-E08\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.2, 4.3, Figs. 4.8 and 4.9\",\"pdf_pages\":[66,67,68],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated generation/workflow pattern, no general cross tool change propagation proof\"},{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"},{\"evidence_id\":\"GY-E11\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"Chapter 3 opening, Chapter 5, 5.2\",\"pdf_pages\":[31,77,78,79],\"pdf_page_ranges\":null,\"source_maturity\":\"reported adoption/change limitations\"}],\"verification_id\":\"V05\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Use seeded cross-subsystem and component changes. Compare the returned impact set and unresolved coverage with an adjudicated reference.\",\"implementation_gap\":\"Engineer-supplied dependencies and adapter links must be complete and compared with a qualified reference.\",\"boundary_authority_note\":\"IF-01 engineering changes are proposals. Impact has no authority to accept a design or automatically edit external artifacts.\",\"interface_family_ids\":[\"IF-01\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer coordinates decisions with responsible engineers and Project Manager\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
