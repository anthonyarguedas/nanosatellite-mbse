#intendedRealization allocation allocate_FR_39_GY_C23 allocate FrameworkRequirements::FR_39 to physical.GY_C23;
@PhysicalRecord { identifier = "allocate_FR_39_GY_C23"; recordJSON = "{\"requirement_id\":\"FR-39\",\"requirement_title\":\"Minimum adoption and measurement package\",\"requirement_text\":\"The framework shall declare prerequisites, resource footprint, licenses, dependencies and learning instructions for its minimum workflow and record adoption, adaptation, change, reproduction and direct-cost observations under one evaluation protocol.\",\"mission_need_ids\":[\"MN-11\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-11\",\"MR-09\"],\"logical_component_ids\":[\"L09\",\"L01\",\"L08\"],\"physical_component_ids\":[\"GY-C23\",\"GY-C9\",\"GY-C11\",\"GY-C1\",\"GY-C6\"],\"realization_mechanism\":\"C23 minimum-workflow manifest enumerates hosts, versions/licenses/dependencies and learning steps. Fixed task forms/logs distinguish elapsed time from active effort, cost period/inclusions, adaptation/change/reproduction correctness and unknown costs.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: explicit future work, demonstrated documentation approach, reported adoption/change limits, procedural guidance.\",\"evidence_ids\":[\"GY-E04\",\"GY-E05\",\"GY-E11\",\"GY-E12\"],\"source_locators\":[{\"evidence_id\":\"GY-E04\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"4 Conclusion\",\"pdf_pages\":[10],\"pdf_page_ranges\":null,\"source_maturity\":\"explicit source limitation\"},{\"evidence_id\":\"GY-E05\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"2.2, 2.3, Table 2.1, 2.5\",\"pdf_pages\":[26,27,28,29,30],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated documentation approach, not general executable behavior\"},{\"evidence_id\":\"GY-E11\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"Chapter 3 opening, Chapter 5, 5.2\",\"pdf_pages\":[31,77,78,79],\"pdf_page_ranges\":null,\"source_maturity\":\"reported adoption/change limitations\"},{\"evidence_id\":\"GY-E12\",\"source_id\":\"cubesat-handbook-part-I\",\"bib_key\":\"aguado2021cubesatse\",\"sections\":\"I.4.1 through I.4.1.5 and I.5 through I.5.2\",\"pdf_pages\":[28,29,30,31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"procedural guidance, no PA-GY performance evidence\"}],\"verification_id\":\"V39\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_verification_fixture\":\"Demonstrate the minimum workflow from a clean declared environment. Record wall-clock time separately from active person-hours and state the cost period and inclusions. Unknown cost stays unknown.\",\"implementation_gap\":\"Select complete dependency profiles and evaluate representative users. No cost, speed, effort or resource fit value is asserted.\",\"boundary_authority_note\":\"IF-06 evaluator controls protocol/reference outcomes. PM reports cost scope. Framework direct usage cost differs from EPS BOM cost.\",\"interface_family_ids\":[\"IF-02\",\"IF-06\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"All five stakeholder roles, named reviewer/reproducer and study evaluator\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
