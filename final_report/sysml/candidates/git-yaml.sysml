fication_status\":\"planned, not executed\",\"verification_method\":\"D,T\",\"proposed_verification_fixture\":\"An independent participant replays a baseline from a clean declared environment. Retain logs, seeds when relevant, failures and comparison verdicts. Tolerances are fixed before replay.\",\"implementation_gap\":\"Implement environment reconstruction and comparison plugins. Missing licenses, dependencies or tolerances must be reported.\",\"boundary_authority_note\":\"IF-06 independent reproducer supplies replay outcome. Framework replay is not EPS qualification or research deliverable assessment.\",\"interface_family_ids\":[\"IF-03\",\"IF-06\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer or designated analysis operator, independent reproducer for replay\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
