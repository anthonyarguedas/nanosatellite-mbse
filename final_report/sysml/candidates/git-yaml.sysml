#intendedRealization allocation allocate_FR_10_GY_C5 allocate FrameworkRequirements::FR_10 to physical.GY_C5;
@PhysicalRecord { identifier = "allocate_FR_10_GY_C5"; recordJSON = "{\"requirement_id\":\"FR-10\",\"requirement_title\":\"Independent replay\",\"requirement_text\":\"The framework shall provide controlled instructions and dependencies to reconstruct and execute a designated analysis and compare its raw outputs using declared result-specific rules and tolerances.\",\"mission_need_ids\":[\"MN-09\"],\"mission_requirement_ids\":[\"MR-09\"],\"logical_component_ids\":[\"L05\",\"L08\",\"L09\"],\"physical_component_ids\":[\"GY-C5\",\"GY-C16\",\"GY-C8\",\"GY-C9\",\"GY-C23\"],\"realization_mechanism\":\"C23 selects a release and clean-start recipe. C5 executes its locked C16 analysis entry point with source inputs, dependency versions and seeds. A versioned comparator applies result-specific rules fixed before replay.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: limited proof of concept and storage design, demonstrated documentation approach, demonstrated generation/issue linkage.\",\"evidence_ids\":[\"GY-E02\",\"GY-E05\",\"GY-E08\"],\"source_locators\":[{\"evidence_id\":\"GY-E02\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"Abstract, 3, 3.1, Fig. 6\",\"pdf_pages\":[1,5,6,9],\"pdf_page_ranges\":null,\"source_maturity\":\"limited proof of concept plus storage design\"},{\"evidence_id\":\"GY-E05\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"2.2, 2.3, Table 2.1, 2.5\",\"pdf_pages\":[26,27,28,29,30],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated documentation approach, not general executable behavior\"},{\"evidence_id\":\"GY-E08\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.2, 4.3, Figs. 4.8 and 4.9\",\"pdf_pages\":[66,67,68],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated generation/workflow pattern, no general cross tool change propagation proof\"}],\"verification_id\":\"V10\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"D,T\",\"proposed_verification_fixture\":\"An independent participant replays a baseline from a clean declared environment. Retain logs, seeds when relevant, failures and comparison verdicts. Tolerances are fixed before replay.\",\"implementation_gap\":\"Implement environment reconstruction and comparison plugins. Missing licenses, dependencies or tolerances must be reported.\",\"boundary_authority_note\":\"IF-06 independent reproducer supplies replay outcome. Framework replay is not EPS qualification or research deliverable assessment.\",\"interface_family_ids\":[\"IF-03\",\"IF-06\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer or designated analysis operator, independent reproducer for replay\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
