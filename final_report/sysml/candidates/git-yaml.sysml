#intendedRealization allocation allocate_FR_33_GY_C24 allocate FrameworkRequirements::FR_33 to physical.GY_C24;
@PhysicalRecord { identifier = "allocate_FR_33_GY_C24"; recordJSON = "{\"requirement_id\":\"FR-33\",\"requirement_title\":\"Shared software definitions\",\"requirement_text\":\"The framework shall retain revision-linked EPS command, telemetry, event and parameter definitions with identifiers, types, units, ranges and encodings mapped to hardware, functional software and ground dictionaries.\",\"mission_need_ids\":[\"MN-08\",\"MN-02\"],\"mission_requirement_ids\":[\"MR-08\",\"MR-02\"],\"logical_component_ids\":[\"L03\"],\"physical_component_ids\":[\"GY-C24\",\"GY-C7\",\"GY-C14\",\"GY-C2\"],\"realization_mechanism\":\"C24 canonical YAML service records hold command/telemetry/event/parameter identity/type/unit/range/encoding and hardware-to-functional links. C7 generates bounded dictionary projections or checks imported flight/ground definitions against that revision.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated data specification pattern, demonstrated generation/issue linkage, independent limited F-Prime export study.\",\"evidence_ids\":[\"GY-E07\",\"GY-E08\",\"GY-E17\"],\"source_locators\":[{\"evidence_id\":\"GY-E07\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"3.3 and 4.1\",\"pdf_pages\":[43,44,45,46,56,57,58],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated data specifications, no cFS/F-Prime exporter demonstrated\"},{\"evidence_id\":\"GY-E08\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.2, 4.3, Figs. 4.8 and 4.9\",\"pdf_pages\":[66,67,68],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated generation/workflow pattern, no general cross tool change propagation proof\"},{\"evidence_id\":\"GY-E17\",\"source_id\":\"review-0853\",\"bib_key\":\"review-0853\",\"sections\":\"3, Table 5, 5\",\"pdf_pages\":[7,8,9,10,12,13,14,16,17],\"pdf_page_ranges\":null,\"source_maturity\":\"independent SysML/F-Prime architecture export demonstration, no PA-GY exporter\"}],\"verification_id\":\"V33\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_verification_fixture\":\"Compare model, flight and ground fixtures against a shared contract. Detect a changed definition in one representation and report every affected mapping.\",\"implementation_gap\":\"Complete all four definition types and mapping tests. Packet/issue patterns do not demonstrate target exporter conformance.\",\"boundary_authority_note\":\"L03 owns common meaning. IF-04 engineers own handwritten functions and supplied implementation dictionaries. Projections do not compete as authorities.\",\"interface_family_ids\":[\"IF-04\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer and Non-EPS flight/ground engineers\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
