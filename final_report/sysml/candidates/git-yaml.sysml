@PhysicalRecord { identifier = "allocate_FR_29_GY_C20"; recordJSON = "{\"requirement_id\":\"FR-29\",\"requirement_title\":\"Facility proposal\",\"requirement_text\":\"The framework shall produce a technician-readable verification proposal that specifies conditions, equipment and fixture identities, DUT connections, stimulus sequence, observations and evidence-generation procedure.\",\"mission_need_ids\":[\"MN-07\"],\"mission_requirement_ids\":[\"MR-07\"],\"logical_component_ids\":[\"L07\",\"L09\"],\"physical_component_ids\":[\"GY-C20\",\"GY-C4\",\"GY-C10\",\"GY-C24\"],\"realization_mechanism\":\"C20 technician template resolves DUT/equipment IDs and connections, conditions, ordered stimuli, observations and logging from controlled activity/interface records. C4 renders a version-linked proposal for C10 dry-run review.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: demonstrated component/assembly pattern, independent EPS design/test case.\",\"evidence_ids\":[\"GY-E09\",\"GY-E19\"],\"source_locators\":[{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"},{\"evidence_id\":\"GY-E19\",\"source_id\":\"handpicked-0003\",\"bib_key\":\"handpicked-0003\",\"sections\":\"7.7, 8.1.6, 8.1.7\",\"pdf_pages\":[10,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS case, its thresholds are not transferred\"}],\"verification_id\":\"V29\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_verification_fixture\":\"A technician or qualified proxy checks a fixture proposal against a declared completeness checklist and identifies how equipment interacts with the DUT. Facility feasibility remains a separate decision.\",\"implementation_gap\":\"Implement templates and test readability/completeness with a qualified technician or proxy.\",\"boundary_authority_note\":\"IF-05 facility decides feasibility and safe execution. A generated document is a proposal, not approval.\",\"interface_family_ids\":[\"IF-05\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS/Systems Engineer specifies activity, technician/facility evaluates feasibility and safety\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
