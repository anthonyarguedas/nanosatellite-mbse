#intendedRealization allocation allocate_FR_23_GY_C16 allocate FrameworkRequirements::FR_23 to physical.GY_C16;
@PhysicalRecord { identifier = "allocate_FR_23_GY_C16"; recordJSON = "{\"requirement_id\":\"FR-23\",\"requirement_title\":\"Fidelity and execution contract\",\"requirement_text\":\"The framework shall record the selected model fidelity, execution environment, time step, measured or estimated runtime and interface delays for each declared SIL or HIL interaction profile.\",\"mission_need_ids\":[\"MN-05\",\"MN-07\",\"MN-08\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-07\",\"MR-08\"],\"logical_component_ids\":[\"L05\",\"L06\"],\"physical_component_ids\":[\"GY-C16\",\"GY-C17\",\"GY-C21\",\"GY-C8\"],\"realization_mechanism\":\"C16 interaction profile records fidelity, solver step/environment and measured versus estimated runtime. C21 binds clock, sampling/calculation/output delay metadata. C17 relates that profile to model use.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: independent EPS/HIL case with limits, independent battery preprint study, independent FreeRTOS flight software case.\",\"evidence_ids\":[\"GY-E14\",\"GY-E16\",\"GY-E18\"],\"source_locators\":[{\"evidence_id\":\"GY-E14\",\"source_id\":\"review-0573\",\"bib_key\":\"review-0573\",\"sections\":\"2, 3, 4, 5\",\"pdf_pages\":[3,4,5,6,7,8,9,12,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS implementation with explicit model limits\"},{\"evidence_id\":\"GY-E16\",\"source_id\":\"handpicked-0001\",\"bib_key\":\"handpicked-0001\",\"sections\":\"Preliminaries, System Implementation and Evaluation\",\"pdf_pages\":[2,3,7,8,9],\"pdf_page_ranges\":null,\"source_maturity\":\"preprint, independent dataset study, not validated PA-GY controller/hardware decisions\"},{\"evidence_id\":\"GY-E18\",\"source_id\":\"citation-0136\",\"bib_key\":\"citation-0136\",\"sections\":\"III.A.3 through III.B, IV.A.1, V, VI.A through VI.C\",\"pdf_pages\":[7,8,9,10,12,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent flight software case, no current framework/OS compatibility guarantee\"}],\"verification_id\":\"V23\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_verification_fixture\":\"Profile a declared executable model and replay timestamped input/output fixtures. Real-time suitability remains unresolved until the applicable hardware and deadline are verified.\",\"implementation_gap\":\"Implement executable profiling/timestamp fixtures. HIL deadlines, latency and equipment remain unverified.\",\"boundary_authority_note\":\"Hardware/HIL execution and clock evidence enter through IF-05. Numerical step size does not establish real-time suitability.\",\"interface_family_ids\":[\"IF-03\",\"IF-05\"],\"execution_host_ids\":[\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"EPS Engineer or designated analysis operator, independent reproducer for replay\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
