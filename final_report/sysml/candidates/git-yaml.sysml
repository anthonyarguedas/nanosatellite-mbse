@PhysicalRecord { identifier = "allocate_FR_17_GY_C12"; recordJSON = "{\"requirement_id\":\"FR-17\",\"requirement_title\":\"Requirement parameter derivation\",\"requirement_text\":\"The framework shall record how sourced component power and thermal characteristics and subsystem behavior become EPS or component requirement parameters, including units, uncertainties, allowable ranges and criterion decisions.\",\"mission_need_ids\":[\"MN-01\",\"MN-02\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-02\",\"MR-04\"],\"logical_component_ids\":[\"L02\",\"L04\"],\"physical_component_ids\":[\"GY-C12\",\"GY-C15\",\"GY-C16\",\"GY-C9\"],\"realization_mechanism\":\"C15 derivation records link rated/measured component properties and C16 behavior results to versioned formulas, source units, uncertainty/ranges and C12 criterion decisions. Unknown allowable ranges stay undecided.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: parameter/API design only, procedural guidance, independent EPS design/test case.\",\"evidence_ids\":[\"GY-E03\",\"GY-E12\",\"GY-E19\"],\"source_locators\":[{\"evidence_id\":\"GY-E03\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"3.1 RQ-5 through RQ-7 and 3.2 Parameter Representation\",\"pdf_pages\":[8,9,10],\"pdf_page_ranges\":null,\"source_maturity\":\"source design and UI pattern, no demonstrated complete semantic or dependency engine\"},{\"evidence_id\":\"GY-E12\",\"source_id\":\"cubesat-handbook-part-I\",\"bib_key\":\"aguado2021cubesatse\",\"sections\":\"I.4.1 through I.4.1.5 and I.5 through I.5.2\",\"pdf_pages\":[28,29,30,31,32,33,34,35],\"pdf_page_ranges\":null,\"source_maturity\":\"procedural guidance, no PA-GY performance evidence\"},{\"evidence_id\":\"GY-E19\",\"source_id\":\"handpicked-0003\",\"bib_key\":\"handpicked-0003\",\"sections\":\"7.7, 8.1.6, 8.1.7\",\"pdf_pages\":[10,13,14],\"pdf_page_ranges\":null,\"source_maturity\":\"independent EPS case, its thresholds are not transferred\"}],\"verification_id\":\"V17\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_verification_fixture\":\"Derive a fixture allocation from datasheet and supplied measurement inputs using a declared method. Preserve assumptions and flag unsupported ranges and undecided pass/fail values.\",\"implementation_gap\":\"Implement representative derivation recipes and expert-reviewed range decisions. No threshold is invented.\",\"boundary_authority_note\":\"Engineers own EPS/non-EPS/component criteria. Datasheets and supplied measurements through IF-02/IF-05 do not automatically verify them.\",\"interface_family_ids\":[\"IF-01\",\"IF-02\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer coordinates decisions with responsible engineers and Project Manager\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
