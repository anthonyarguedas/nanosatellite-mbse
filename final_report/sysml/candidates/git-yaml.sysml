#intendedRealization allocation allocate_FR_07_GY_C1 allocate FrameworkRequirements::FR_07 to physical.GY_C1;
@PhysicalRecord { identifier = "allocate_FR_07_GY_C1"; recordJSON = "{\"requirement_id\":\"FR-07\",\"requirement_title\":\"Controlled baselines\",\"requirement_text\":\"The framework shall retain identified, retrievable baselines of engineering records, case configuration, and evidence with revision history and distinct identities for accepted successors.\",\"mission_need_ids\":[\"MN-02\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-09\"],\"logical_component_ids\":[\"L08\"],\"physical_component_ids\":[\"GY-C1\",\"GY-C14\",\"GY-C8\"],\"realization_mechanism\":\"C14 records exact YAML/script/native/binary digests and selected revisions in retained release manifests. C1 supplies history, C8 protected artifact copies and restore procedures preserve both revisions.\",\"maturity_evidence_status\":\"Proposed PA-GY realization, not implemented or verified. Source support: limited proof of concept and storage design, demonstrated documentation approach, demonstrated component/assembly pattern.\",\"evidence_ids\":[\"GY-E02\",\"GY-E05\",\"GY-E09\"],\"source_locators\":[{\"evidence_id\":\"GY-E02\",\"source_id\":\"review-0522\",\"bib_key\":\"kanavouras2024lightweight\",\"sections\":\"Abstract, 3, 3.1, Fig. 6\",\"pdf_pages\":[1,5,6,9],\"pdf_page_ranges\":null,\"source_maturity\":\"limited proof of concept plus storage design\"},{\"evidence_id\":\"GY-E05\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"2.2, 2.3, Table 2.1, 2.5\",\"pdf_pages\":[26,27,28,29,30],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated documentation approach, not general executable behavior\"},{\"evidence_id\":\"GY-E09\",\"source_id\":\"review-0787\",\"bib_key\":\"chiu2023sealion\",\"sections\":\"4.4, 4.5, Table 4.6, Figs. 4.11 through 4.15\",\"pdf_pages\":[69,70,71,72,73,74,75],\"pdf_page_ranges\":null,\"source_maturity\":\"demonstrated component/assembly pattern with incomplete mission coverage\"}],\"verification_id\":\"V07\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_verification_fixture\":\"Reconstruct two revisions after a change and compare their manifests and contents. Attempted overwrite cannot erase the retained prior baseline.\",\"implementation_gap\":\"Protect retention, prevent rewrite/delete through policy, and test full restoration including binary/environment dependencies.\",\"boundary_authority_note\":\"Framework retains baseline custody even on a managed host. Storage administrator cannot silently redefine a domain baseline.\",\"interface_family_ids\":[\"IF-06\"],\"execution_host_ids\":[\"GY-H1\",\"GY-H2\",\"GY-H3\"],\"storage_host_ids\":[\"GY-H2\"],\"procedure_performer\":\"Systems Engineer or delegated configuration custodian\",\"design_coverage\":\"specific intended realization with explicit implementation gap\",\"verified_satisfaction\":false,\"verified_eligibility\":false}"; status = "proposed comparison description, not implemented or verified"; }
