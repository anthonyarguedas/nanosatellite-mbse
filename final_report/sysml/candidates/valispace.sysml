@PhysicalRecord { identifier = "allocate_FR_23_VS_PC_SCENARIO"; recordJSON = "{\"requirement_id\":\"FR-23\",\"title\":\"Fidelity and execution contract\",\"logical_component_ids\":[\"L05\",\"L06\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-SCENARIO\",\"VS-PC-CREDIBILITY\",\"VS-PC-RUNNER\",\"VS-PC-MODELS\",\"VS-PC-OBSERVATION\"],\"realization_mechanism\":\"Runtime/fidelity profiler records solver step, environment, model scope and labeled measured/estimated runtime. Timestamp profile distinguishes simulation, wall-clock, sampling, computation and output delays and declares SIL/HIL deadline assumptions.\",\"maturity\":[\"proposed\",\"transferable\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E08\"],\"source_locators\":[{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.4 Electrical and Power System, Figs. 3 and 4\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E08\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"5 Discussion and 6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E08\"}],\"verification_id\":\"V23\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Profile a declared executable model and replay timestamped input/output fixtures. Real-time suitability remains unresolved until the applicable hardware and deadline are verified.\",\"implementation_gap\":\"Implement profiler and delay fixtures. HIL hardware, interfaces, deadline and suitability are unresolved and not required physical execution in core.\",\"boundary_authority_note\":\"A short solver step or fast desktop run proves no real-time hardware compatibility.\",\"procedure_performers\":[\"EPS Engineer\",\"Non-EPS Engineer\",\"Testing Facility Technician\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-03\",\"IF-05\"],\"mission_need_ids\":[\"MN-05\",\"MN-07\",\"MN-08\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-07\",\"MR-08\"]}"; status = "proposed comparison description, not implemented or verified"; }
