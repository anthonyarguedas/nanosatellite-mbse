@PhysicalRecord { identifier = "allocate_FR_36_VS_PC_FSW"; recordJSON = "{\"requirement_id\":\"FR-36\",\"title\":\"Target integration assessment\",\"logical_component_ids\":[\"L03\",\"L04\",\"L05\"],\"candidate_node_ids\":[\"VS-LN-ARCH\",\"VS-LN-ENG\",\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-FSW\",\"VS-PC-CHARACTERIZATION\",\"VS-PC-SCENARIO\",\"VS-PC-EVIDENCE\",\"VS-PC-CONTRACT\"],\"realization_mechanism\":\"Target-profile record identifies OBC/OS/framework/toolchain revisions. Named build/resource importer retains compile/deploy findings, CPU/memory/timing/power observations or estimates and run conditions. Comparator checks mission-supplied allocations and preserves unknown compatibility.\",\"maturity\":[\"proposed\",\"unknown\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V36\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,A,T\",\"proposed_acceptance\":\"Inspect a build/deployment profile and reference resource records. Distinguish measurements, estimates and unknown target compatibility. Check against mission-supplied allocations when available.\",\"implementation_gap\":\"Select target profiles, integrate build/resource records and test allocation comparisons. No target, resource value or compatibility result is established.\",\"boundary_authority_note\":\"External build/target evidence services supply results. Estimates, measurements and unknowns remain separate. Flight operation is outside core.\",\"procedure_performers\":[\"Non-EPS Engineer\",\"EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-FLIGHTBUILD\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-04\"],\"mission_need_ids\":[\"MN-08\",\"MN-05\"],\"mission_requirement_ids\":[\"MR-08\",\"MR-05\"]}"; status = "proposed comparison description, not implemented or verified"; }
