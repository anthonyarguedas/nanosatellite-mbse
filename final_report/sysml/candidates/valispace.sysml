_pdf_pages\":[90,91],\"evidence_id\":\"VS-E06\"}],\"verification_id\":\"V02\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_acceptance\":\"Inspect the learning package and demonstrate the workflow from a declared clean start. Measure learner effort and errors without imposing an unagreed time limit.\",\"implementation_gap\":\"Write and trial EPS learning content and clean-start instructions. Ease-of-use claims do not establish learning outcomes.\",\"boundary_authority_note\":\"L01 owns reviewed knowledge. L09 presents it and observes use without asserting stakeholder approval.\",\"procedure_performers\":[\"Systems Engineer\",\"Independent reviewer or reproducer (a distinct task role)\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"mission_need_ids\":[\"MN-01\",\"MN-11\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-11\"]}"; status = "proposed comparison description, not implemented or verified"; }
