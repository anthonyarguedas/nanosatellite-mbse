#intendedRealization allocation allocate_FR_35_VS_PC_FSW allocate FrameworkRequirements::FR_35 to physical.VS_PC_FSW;
@PhysicalRecord { identifier = "allocate_FR_35_VS_PC_FSW"; recordJSON = "{\"requirement_id\":\"FR-35\",\"title\":\"Command and recovery contract\",\"logical_component_ids\":[\"L03\",\"L05\",\"L07\"],\"candidate_node_ids\":[\"VS-LN-ARCH\",\"VS-LN-ANALYSIS\",\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-FSW\",\"VS-PC-SCENARIO\",\"VS-PC-VERIFICATION\",\"VS-PC-CAPELLA\",\"VS-PC-EVIDENCE\"],\"realization_mechanism\":\"Sequence checker consumes dictionary guards/effects/order/rejection/timeout rules and Capella mode/recovery allocation. Virtual sequence harness replays nominal, rejected and recovery flows across EPS control, telemetry, fault management and safe mode and reports owner/flow discrepancies.\",\"maturity\":[\"proposed\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V35\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Replay nominal, rejected and recovery sequences with a qualified software reference. Confirm functional flow and ownership without claiming deployment of flight software.\",\"implementation_gap\":\"Implement sequence rules and qualified software reference fixtures. Actual target behavior and flight deployment remain unverified.\",\"boundary_authority_note\":\"Core checks service contracts and virtual sequences. It does not implement or operate complete mission flight software.\",\"procedure_performers\":[\"EPS Engineer\",\"Non-EPS Engineer\",\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-FLIGHTBUILD\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-04\",\"IF-03\"],\"mission_need_ids\":[\"MN-08\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-08\",\"MR-04\"]}"; status = "proposed comparison description, not implemented or verified"; }
