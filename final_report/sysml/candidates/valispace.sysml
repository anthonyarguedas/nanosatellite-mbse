@PhysicalRecord { identifier = "allocate_FR_06_VS_PC_GOVERNANCE"; recordJSON = "{\"requirement_id\":\"FR-06\",\"title\":\"Change disposition\",\"logical_component_ids\":[\"L02\",\"L08\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-GOVERNANCE\",\"VS-PC-ARCHIVE\",\"VS-PC-CONTRACT\",\"VS-PC-PROCEDURES\"],\"realization_mechanism\":\"Accepted-change procedure preserves request, failed-gate context and prior manifest. Stale-evidence checker marks each affected result regenerated/stale/unresolved before the archive issues a distinct successor manifest after authorization.\",\"maturity\":[\"proposed\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V06\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_acceptance\":\"Exercise a failed verification gate followed by correction. Preserve the prior baseline and prevent stale results from appearing current.\",\"implementation_gap\":\"Implement transaction, status propagation and recovery. A successor manifest alone does not establish a correct completed change.\",\"boundary_authority_note\":\"Valispace stores decision meaning. L08 controls revision custody. Old failed results keep their original criterion and applicability.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\"],\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-07\"]}"; status = "proposed comparison description, not implemented or verified"; }
