@PhysicalRecord { identifier = "allocate_FR_39_VS_PC_EVALUATION"; recordJSON = "{\"requirement_id\":\"FR-39\",\"title\":\"Minimum adoption and measurement package\",\"logical_component_ids\":[\"L09\",\"L01\",\"L08\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-EVALUATION\",\"VS-PC-GUIDANCE\",\"VS-PC-PROCEDURES\",\"VS-PC-CONTRACT\",\"VS-PC-HOSTS\"],\"realization_mechanism\":\"Adoption package declares service/OS/tool/add-on/library prerequisites, supported profiles, compute/storage/access footprint and learning steps. One task manifest captures adoption/adaptation/change/reproduction and direct-cost observations with period, inclusions and separate elapsed/active effort.\",\"maturity\":[\"source_supported\",\"proposed\",\"unknown\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E06\",\"VS-E09\"],\"source_locators\":[{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[8],\"evidence_id\":\"VS-E06\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.1 DDSE-MBSE approach, Table 3.2\",\"physical_pdf_pages\":[46,47],\"evidence_id\":\"VS-E06\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.3 Python for Capella\",\"physical_pdf_pages\":[51,52],\"evidence_id\":\"VS-E06\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"Conclusions\",\"physical_pdf_pages\":[90,91],\"evidence_id\":\"VS-E06\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"2 Requirements management in small space enterprises: problems and needs\",\"physical_pdf_pages\":[4,5],\"evidence_id\":\"VS-E09\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"3 Software for requirement management: overview and proposal, Table 1\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E09\"}],\"verification_id\":\"V39\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_acceptance\":\"Demonstrate the minimum workflow from a clean declared environment. Record wall-clock time separately from active person-hours and state the cost period and inclusions. Unknown cost stays unknown.\",\"implementation_gap\":\"Produce and trial clean-start package. Current license/user/API/export terms, versions and actual resource/cost/effort observations remain open.\",\"boundary_authority_note\":\"Licensed access establishes no infeasibility without real budget evidence. Framework costs remain separate from EPS acquisition and research deliverable assessment.\",\"procedure_performers\":[\"Project Manager\",\"Systems Engineer\",\"Independent reviewer or reproducer (a distinct task role)\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"mission_need_ids\":[\"MN-11\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-11\",\"MR-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
