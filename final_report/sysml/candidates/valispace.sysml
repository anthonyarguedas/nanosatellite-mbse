private import PhysicalVocabulary::*;
doc /* Capella and Valispace with controlled analysis and evidence. Complete implementation and empirical framework verification remain pending. The source record packages preserve native technologies, authority rules, resource/performance profiles, uncertainties and maturity. */
item candidateProfile : EngineeringArtifact;
@PhysicalRecord { identifier = "PA-VS"; recordJSON = "{\"id\":\"PA-VS\",\"name\":\"Capella and Valispace with controlled analysis and evidence\",\"baseline_head\":\"b826d9915407bbd861d8d39b2558048f3d534bdc\",\"status\":\"Author-reviewed design allocations. No satisfy assertions, verified eligibility, implementation, test verdict, performance or selection.\",\"common_id_allocations\":\"Adopted FR-01..40 and exact reviewed L01..L09 mapping in allocations.\",\"boundary\":{\"system\":\"EPS engineering framework\",\"included\":[\"Shared engineering and review services\",\"Architecture authoring and its case configuration\",\"Analysis coordination and adapter contracts\",\"Configuration and evidence assurance\",\"Reusable data and operating procedures\"],\"engineered_artifacts\":[\"EPS hardware\",\"EPS flight software\",\"EPS ground software\",\"Case analysis models and verification evidence\"],\"external_participants_or_resources\":[\"Project Manager\",\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\",\"Testing Facility Technician\",\"Devices under test\",\"Testing facilities and instruments\"],\"verification_separation\":\"Framework verification checks framework behavior and controls. EPS verification evaluates a particular EPS design using suitable evidence. Research deliverable assessment has separate indicators and verdicts.\"},\"sources\":[{\"id\":\"review-0356\",\"bibkey\":\"campioli2025integration\",\"title\":\"Integrating Concurrent Engineering with Data-Driven and Model-Based Systems Engineering for End-to-End Small-Satellite Design\",\"authors\":[\"Serena Campioli\",\"Carlotta Deiana\",\"Sabrina Corpino\"],\"year\":2025,\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"source_pdf\":\"SLR/SLR1/pdfs/review-reports/review-report-0356.pdf\",\"checked_locators\":[{\"evidence_id\":\"VS-E02\",\"section\":\"3.1 Data-Driven MBSE Methodology\",\"physical_pdf_pages\":[3],\"claim\":\"Capella architecture master and Valispace requirements/data/budget environment connected through Python for Capella and REST API.\"},{\"evidence_id\":\"VS-E03\",\"section\":\"4.3.2 Logical Architecture\",\"physical_pdf_pages\":[6,7],\"claim\":\"Hierarchy import, discrepancy report and automatic addition of missing components from Capella.\"},{\"evidence_id\":\"VS-E05\",\"section\":\"4.3.2 Logical Architecture and 4.4 Subsystem Design and Trade-Offs\",\"physical_pdf_pages\":[7],\"claim\":\"Mode-indexed power budget and battery alternative example.\"},{\"evidence_id\":\"VS-E06\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[8],\"claim\":\"Demonstrated preliminary design. AIV/T extension and integration GUI remain future work.\"}],\"maturity\":\"Reported preliminary-design application, not verified full-lifecycle assurance.\",\"independence_limit\":\"Same integration lineage as citation-4690. Do not count these as independent replications.\"},{\"id\":\"citation-4690\",\"bibkey\":\"citation-4690\",\"title\":\"Integrating Data-Driven and Model-Based Systems Engineering for End-to-End Small-Satellite Design\",\"authors\":[\"Carlotta Deiana\"],\"year\":2025,\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"source_pdf\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690.pdf\",\"checked_locators\":[{\"evidence_id\":\"VS-E01\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"claim\":\"Browser UI, dependencies/formulas, notification and six platform modules. Python/Octave scripting and procedures with attachments and tags.\"},{\"evidence_id\":\"VS-E02\",\"section\":\"3.2 Integration\",\"physical_pdf_pages\":[47,48,49,50,51],\"claim\":\"Capella master authority, Valispace support and explicitly unimplemented links. Physical subsystem design only started.\"},{\"evidence_id\":\"VS-E03\",\"section\":\"3.3 Python for Capella and 3.4 Valispace Python API, named export/import/Components_bridge.py descriptions\",\"physical_pdf_pages\":[53,54,55,56],\"claim\":\"Excel component export with name, parent name and hierarchy level. Product-tree comparison and missing-component import.\"},{\"evidence_id\":\"VS-E03\",\"section\":\"4.4 System Design, Figs. 4.21 and 4.22\",\"physical_pdf_pages\":[79,80],\"claim\":\"Screenshots/report of hierarchy import and missing-component restoration.\"},{\"evidence_id\":\"VS-E04\",\"section\":\"3.3 Export_SF_MO.py and 3.4 Import_Requirements.py\",\"physical_pdf_pages\":[53,54,55],\"claim\":\"Imports selected system functions as requirements using requirement text prepared in function descriptions.\"},{\"evidence_id\":\"VS-E04\",\"section\":\"3.2 System Design\",\"physical_pdf_pages\":[50],\"claim\":\"Logical-function-to-requirement import was not implemented in that thesis instance.\"},{\"evidence_id\":\"VS-E05\",\"section\":\"4.4 System Design, Figs. 4.25 through 4.27\",\"physical_pdf_pages\":[84,85,86],\"claim\":\"Imported mode lists, per-mode power matrices, mass and volume budgets.\"},{\"evidence_id\":\"VS-E05\",\"section\":\"4.5 Subsystem Design, Fig. 4.29\",\"physical_pdf_pages\":[88],\"claim\":\"Battery trade example with budget updates.\"},{\"evidence_id\":\"VS-E06\",\"section\":\"3.1 DDSE-MBSE approach, Table 3.2\",\"physical_pdf_pages\":[46,47],\"claim\":\"Source comparison reports weak Valispace architecture/functional/ConOps support and stronger engineering data and requirements support.\"},{\"evidence_id\":\"VS-E06\",\"section\":\"3.3 Python for Capella\",\"physical_pdf_pages\":[51,52],\"claim\":\"Python for Capella runs inside the Capella application.\"},{\"evidence_id\":\"VS-E06\",\"section\":\"Conclusions\",\"physical_pdf_pages\":[90,91],\"claim\":\"AIV/T, a headless capellambse bridge and a GUI remain prospective. Current script operation is disconnected and fragmented.\"}],\"maturity\":\"Platform feature description plus a narrow integration demonstration. Adoption claims are not measurements of this framework.\",\"page_convention\":\"Use physical PDF_PAGE markers. Printed thesis pages differ because of front matter.\"},{\"id\":\"review-0793\",\"bibkey\":\"review-0793\",\"title\":\"Spacecraft digital engineering: the tale of digital twins and lessons learned\",\"authors\":[\"Anton B. Ivanov\"],\"year\":2023,\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"source_pdf\":\"SLR/SLR1/pdfs/review-reports/review-report-0793.pdf\",\"checked_locators\":[{\"evidence_id\":\"VS-E07\",\"section\":\"4.1 Systems Engineering\",\"physical_pdf_pages\":[5,6],\"claim\":\"Valispace requirements hub, integration with STK, mass/power/data/cost/TRL budgets and requirement-linked testing procedures in a CubeSat project.\"},{\"evidence_id\":\"VS-E07\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[9],\"claim\":\"Reports usefulness of a commercial open-API environment interfacing with open-source tools.\"},{\"evidence_id\":\"VS-E08\",\"section\":\"4.4 Electrical and Power System, Figs. 3 and 4\",\"physical_pdf_pages\":[7],\"claim\":\"Separate ENOVIA/SIMULIA/OpenModelica RFLP EPS study checked against Python and a bench. Difficult STK synchronization through static CSV.\"},{\"evidence_id\":\"VS-E08\",\"section\":\"5 Discussion and 6 Conclusions\",\"physical_pdf_pages\":[9],\"claim\":\"Interdependent specialist models remain necessary. A universal single-tool satellite digital twin is not established.\"}],\"maturity\":\"Experience report from an actual CubeSat project. Model comparison is reported without project-applicable calibration/error/coverage data.\",\"attribution_limit\":\"The OpenModelica example is not demonstrated native Valispace or Capella-Valispace coupled simulation.\"},{\"id\":\"citation-0569\",\"bibkey\":\"citation-0569\",\"title\":\"Model-Based Approach For Requirements Management Connection With Verification Procedures Applied To Space Systems\",\"authors\":[\"Karolina Latserus\",\"Petr Mukhachev\",\"Anton B. Ivanov\",\"Angelina Prokopeva\"],\"year\":2020,\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"source_pdf\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.pdf\",\"checked_locators\":[{\"evidence_id\":\"VS-E09\",\"section\":\"2 Requirements management in small space enterprises: problems and needs\",\"physical_pdf_pages\":[4,5],\"claim\":\"Role-based procedure assignment, external execution and feedback concerns.\"},{\"evidence_id\":\"VS-E09\",\"section\":\"3 Software for requirement management: overview and proposal, Table 1\",\"physical_pdf_pages\":[5,6],\"claim\":\"Reports Valispace requirement/procedure/functional links and performer assignment. Unlicensed status change, SysML diagrams and text-document generation are absent in the comparison.\"},{\"evidence_id\":\"VS-E10\",\"section\":\"4.2 Software toolchain, 4.3 Implementation: processes chain and 4.4 Implementation example\",\"physical_pdf_pages\":[8,9,10],\"claim\":\"RVT performer/feedback concept uses MagicDraw and Teamwork Cloud. Gamma Swarm uses Valispace and CPD for budgets, with MagicDraw model authority.\"},{\"evidence_id\":\"VS-E10\",\"section\":\"6 Conclusion\",\"physical_pdf_pages\":[11],\"claim\":\"Web RVT implementation and broader application remain future work.\"}],\"maturity\":\"Dated tool comparison, process proposal and preliminary interface proof of concept.\",\"attribution_limit\":\"Do not present the MagicDraw RVT concept or its proof of concept as an implemented Valispace technician interface. Current license/access/export terms are unresolved.\"}],\"nodes\":[{\"id\":\"VS-LN-ENG\",\"name\":\"Shared engineering and review\",\"purpose\":\"Requirement learning/criteria, engineering properties, alternatives, BOM/cost and stakeholder-facing records\",\"primary_components\":[\"VS-PC-WEB\",\"VS-PC-CASE\",\"VS-PC-PROCEDURES\",\"VS-PC-GUIDANCE\",\"VS-PC-GOVERNANCE\",\"VS-PC-CHARACTERIZATION\",\"VS-PC-REVIEW\",\"VS-PC-EVALUATION\"]},{\"id\":\"VS-LN-ARCH\",\"name\":\"Architecture and interfaces\",\"purpose\":\"Structure, functions, modes, exchanges and hardware/software grouping\",\"primary_components\":[\"VS-PC-CAPELLA\",\"VS-PC-CASE\",\"VS-PC-FSW\",\"VS-PC-EPS-TEMPLATE\"]},{\"id\":\"VS-LN-ANALYSIS\",\"name\":\"Analysis and verification coordination\",\"purpose\":\"RAM, coupled EPS/battery/controller analysis, credibility, safe procedures and software evidence\",\"primary_components\":[\"VS-PC-RUNNER\",\"VS-PC-MODELS\",\"VS-PC-FSW\",\"VS-PC-PROCEDURES\",\"VS-PC-SCENARIO\",\"VS-PC-EPS-ENGINE\",\"VS-PC-CREDIBILITY\",\"VS-PC-OBSERVATION\",\"VS-PC-RAM\",\"VS-PC-VERIFICATION\"]},{\"id\":\"VS-LN-ASSURANCE\",\"name\":\"Configuration and evidence assurance\",\"purpose\":\"Semantic exchange, versions, change transactions, evidence custody and reconstruction\",\"primary_components\":[\"VS-PC-BRIDGE\",\"VS-PC-CONTRACT\",\"VS-PC-ARCHIVE\",\"VS-PC-EVIDENCE\"]}],\"authority_rules\":[{\"owner\":\"Capella architecture\",\"authoritative_fields\":\"Composition, functional allocation, topology, exchanges and mode/transition definitions\",\"derived_views\":\"Valispace product trees and mode lists\",\"rule\":\"A transferred mode list does not establish preservation of transition semantics.\"},{\"owner\":\"Valispace requirements and engineering properties\",\"authoritative_fields\":\"Requirement text, criteria references, component properties, alternatives, BOM quantities, cost sources and budget formulas\",\"rule\":\"Function import creates a draft. Systems Engineer review establishes requirement quality and applicability.\"},{\"owner\":\"Controlled common dictionary\",\"authoritative_fields\":\"Detailed command, telemetry, event and parameter fields, types, units, enums, conditions, effects and timing conventions\",\"rule\":\"Capella owns architectural placement. Flight, ground and Valispace artifacts reference common IDs and revisions. Do not author competing field definitions.\"},{\"owner\":\"Controlled model package\",\"authoritative_fields\":\"Executable analysis source, calibration, validity evidence and controller configuration\",\"rule\":\"Measured parameter changes create new revisions and impact review. Preserve old result applicability.\"},{\"owner\":\"Released evidence archive\",\"authoritative_fields\":\"Composite baseline and run provenance, raw results and fixed review packages\",\"rule\":\"Valispace stores links/status and reviewed conclusions. Current database values do not reconstruct a historical run.\"},{\"owner\":\"Authorized change workflow\",\"authoritative_fields\":\"Reviewed source/destination revisions, diff, owner authorization and transaction log\",\"rule\":\"Replace automatic repair at release boundaries with dry-run comparison and controlled application. Handle partial failure without silent overwrite.\"},{\"owner\":\"Qualified safety and verification roles\",\"authoritative_fields\":\"Applicable acceptance criteria, equipment constraints, fault limits, stop/recovery actions and release decision\",\"rule\":\"A simulation supports a hardware test proposal. It does not authorize hazardous fault injection.\"},{\"owner\":\"Separate verification records\",\"authoritative_fields\":\"Framework checks, EPS requirement evidence and research deliverable assessment\",\"rule\":\"These have distinct objects, criteria and verdicts. Automatic budget status is not a universal EPS verification verdict.\"}],\"logical_responsibilities\":[{\"name\":\"Requirement learning and observable criteria\",\"node\":\"VS-LN-ENG\",\"components\":[\"VS-PC-WEB\",\"VS-PC-PROCEDURES\",\"VS-PC-CASE\"],\"status\":\"Reported requirement links and hierarchy. Proposed guidance, method references and criterion controls.\"},{\"name\":\"BOM, sourced cost and candidate comparison\",\"node\":\"VS-LN-ENG\",\"components\":[\"VS-PC-WEB\",\"VS-PC-CASE\"],\"status\":\"Reported parametric budgets/trades. Proposed controlled quantities, dated cost sources and framework/EPS cost separation.\"},{\"name\":\"Readable review, procedure assignment and external feedback\",\"node\":\"VS-LN-ENG\",\"components\":[\"VS-PC-WEB\",\"VS-PC-PROCEDURES\",\"VS-PC-ARCHIVE\"],\"status\":\"Reported browser/report/procedure foundations. Proposed export/feedback and comprehension checks.\"},{\"name\":\"Architecture and reciprocal cross-subsystem requirement context\",\"node\":\"VS-LN-ARCH\",\"components\":[\"VS-PC-CAPELLA\",\"VS-PC-CASE\",\"VS-PC-CONTRACT\"],\"status\":\"Reported architecture master. Proposed complete changed-load/supply requirement impact semantics.\"},{\"name\":\"Hardware-to-software grouping and common definitions\",\"node\":\"VS-LN-ARCH\",\"components\":[\"VS-PC-CAPELLA\",\"VS-PC-FSW\",\"VS-PC-CONTRACT\"],\"status\":\"Proposed cFS/F-Prime and flight/ground extension.\"},{\"name\":\"RAM model preparation and evidence coverage\",\"node\":\"VS-LN-ANALYSIS\",\"components\":[\"VS-PC-RUNNER\",\"VS-PC-MODELS\",\"VS-PC-CASE\"],\"status\":\"Proposed.\"},{\"name\":\"Coupled dynamic EPS/battery/controller analysis and model credibility\",\"node\":\"VS-LN-ANALYSIS\",\"components\":[\"VS-PC-RUNNER\",\"VS-PC-MODELS\",\"VS-PC-EVIDENCE\"],\"status\":\"Proposed. Per-mode budgets and a separate OpenModelica example are precedents only.\"},{\"name\":\"Technician-ready V&V, virtual faults and conditional safe bench coordination\",\"node\":\"VS-LN-ANALYSIS\",\"components\":[\"VS-PC-WEB\",\"VS-PC-PROCEDURES\",\"VS-PC-EVIDENCE\",\"VS-PC-RUNNER\"],\"status\":\"Reported test record pattern. Proposed complete safety, timing and diagnostic contract.\"},{\"name\":\"Software sequences, target compatibility and resource evidence\",\"node\":\"VS-LN-ANALYSIS\",\"components\":[\"VS-PC-FSW\",\"VS-PC-RUNNER\",\"VS-PC-EVIDENCE\"],\"status\":\"Proposed.\"},{\"name\":\"Semantic transfer, controlled change and composite baseline\",\"node\":\"VS-LN-ASSURANCE\",\"components\":[\"VS-PC-BRIDGE\",\"VS-PC-CONTRACT\",\"VS-PC-ARCHIVE\"],\"status\":\"Reported tree comparator. Proposed stable IDs, units, time, field ownership and transactions.\"},{\"name\":\"Evidence provenance and independent reconstruction\",\"node\":\"VS-LN-ASSURANCE\",\"components\":[\"VS-PC-ARCHIVE\",\"VS-PC-EVIDENCE\",\"VS-PC-MODELS\",\"VS-PC-PROCEDURES\"],\"status\":\"Proposed.\"},{\"name\":\"Adoption observation and two-case frozen-core evaluation\",\"node\":\"VS-LN-ASSURANCE\",\"components\":[\"VS-PC-PROCEDURES\",\"VS-PC-ARCHIVE\",\"VS-PC-HOSTS\"],\"status\":\"Proposed. Observe real effort/cost and distinguish core changes from supported case configuration.\"}],\"concern_coverage\":[{\"family\":\"requirements_learning_criteria\",\"stakeholders\":[\"Project Manager\",\"Systems Engineer\",\"EPS Engineer\"],\"need\":\"Lower learning and authoring effort while maintaining verifiable, applicable requirements and traces.\",\"proposed_observations\":[\"Authoring/training effort\",\"Criterion defects\",\"Correct trace and criterion interpretation\",\"Trace-repair effort\"],\"provisional_requirement\":\"Preserve concern/need/requirement/decision/evidence links and provide worked examples, observable quantities or conditions and applicable units, explicit pass/fail criteria, method references and applicability.\",\"logical_nodes\":[\"VS-LN-ENG\",\"VS-LN-ARCH\"],\"components\":[\"VS-PC-WEB\",\"VS-PC-CASE\",\"VS-PC-PROCEDURES\"],\"evidence\":[\"VS-E01\",\"VS-E04\",\"VS-E09\"],\"coverage_status\":\"Reported management mechanism. Learning, criterion quality and complete chains are proposed.\",\"required_checks\":[\"VS-CHK-02\"]},{\"family\":\"bom_cost_alternatives\",\"stakeholders\":[\"Project Manager\",\"Systems Engineer\",\"EPS Engineer\"],\"need\":\"Keep alternatives, BOM quantities and sourced budgets aligned with changes without inventing procurement or operating costs.\",\"proposed_observations\":[\"Stale/incorrect budget entries\",\"Update effort\",\"Actual direct framework cost\"],\"provisional_requirement\":\"Bind quantities, cost sources, dates, currencies, scope and exclusions to component options and revisions. Separate EPS product cost from framework usage cost.\",\"logical_nodes\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"components\":[\"VS-PC-WEB\",\"VS-PC-CASE\",\"VS-PC-CONTRACT\"],\"evidence\":[\"VS-E05\",\"VS-E07\",\"VS-E10\"],\"coverage_status\":\"Reported tree/budget/trade foundation. Complete BOM sourcing and change control are proposed.\",\"required_checks\":[\"VS-CHK-01\",\"VS-CHK-03\"]},{\"family\":\"ram\",\"stakeholders\":[\"Systems Engineer\",\"EPS Engineer\"],\"need\":\"Expose RAM coverage, failure effects, availability/maintenance assumptions and evidence gaps early.\",\"proposed_observations\":[\"RAM requirement coverage\",\"Assumption/evidence gaps\",\"Model-preparation effort\"],\"provisional_requirement\":\"Link failure modes and RAM requirements to components, mission states, analysis assumptions, consequences and verification evidence. Support proportionate inspection/analysis with uncertainty.\",\"logical_nodes\":[\"VS-LN-ANALYSIS\",\"VS-LN-ARCH\"],\"components\":[\"VS-PC-RUNNER\",\"VS-PC-MODELS\",\"VS-PC-CASE\"],\"evidence\":[],\"coverage_status\":\"Proposed capability. Storing parameters establishes no RAM assurance or reliability gain.\",\"required_checks\":[\"VS-CHK-04\"]},{\"family\":\"technician_vv_safe_faults_failed_gate_feedback\",\"stakeholders\":[\"Testing Facility Technician\",\"Systems Engineer\",\"EPS Engineer\",\"Project Manager\"],\"need\":\"Make procedures feasible, safe and diagnostically useful to people without modeling-tool knowledge.\",\"proposed_observations\":[\"Package completeness\",\"Handoff defects\",\"Execution effort\",\"Timestamp/telemetry defects\",\"Usefulness for redesign\"],\"provisional_requirement\":\"Include DUT configuration, equipment/calibration, fixture/interfaces, stimuli, conditions, limits, stop/recovery actions, diagnostic variables, synchronization and evidence format. Preserve failures through corrective changes.\",\"logical_nodes\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"components\":[\"VS-PC-WEB\",\"VS-PC-PROCEDURES\",\"VS-PC-EVIDENCE\",\"VS-PC-ARCHIVE\"],\"evidence\":[\"VS-E01\",\"VS-E09\",\"VS-E10\"],\"coverage_status\":\"Reported record and performer process patterns. Complete safe technician handoff and external feedback are proposed.\",\"required_checks\":[\"VS-CHK-05\",\"VS-CHK-09\"]},{\"family\":\"coupled_eps_battery_controller_credibility\",\"stakeholders\":[\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\",\"Testing Facility Technician\",\"Project Manager\"],\"need\":\"Detect temporary energy shortages, load/supply/protection effects, anomalies, model-health divergence and unsafe control decisions before committing to hardware.\",\"proposed_observations\":[\"Validity-envelope coverage\",\"Prediction residuals and uncertainty\",\"Runtime adequacy for intended use\",\"Diagnostic completeness\"],\"provisional_requirement\":\"Coordinate time-dependent attitude/generation and non-EPS demand, mode transitions, electrical/thermal battery states and selected aging effects. Identify state-of-charge/health observability, depth-of-discharge and lifetime limits. Retain calibration and measured updates. Distinguish faults, aging and sensor error where uncertainty evidence allows. Retain controller policy/implementation response and conditional thermal/EMC evidence.\",\"logical_nodes\":[\"VS-LN-ANALYSIS\",\"VS-LN-ASSURANCE\"],\"components\":[\"VS-PC-RUNNER\",\"VS-PC-MODELS\",\"VS-PC-EVIDENCE\"],\"evidence\":[\"VS-E05\",\"VS-E08\"],\"coverage_status\":\"Mode budgets are reported. Time-domain coupling, calibrated battery behavior, anomaly discrimination and controller credibility are proposed.\",\"required_checks\":[\"VS-CHK-06\"]},{\"family\":\"semantics_provenance_reproduction_change\",\"stakeholders\":[\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\",\"Testing Facility Technician\"],\"need\":\"Avoid semantic loss and stale cross-subsystem evidence. Make analyses independently reconstructable and measured updates controlled.\",\"proposed_observations\":[\"Detected/missed seeded discrepancies versus qualified review\",\"Correct change-processing effort\",\"Independent reconstruction effort\"],\"provisional_requirement\":\"Preserve IDs, units, type/time/activation semantics and revisions. Release complete run packages. Propagate reciprocal EPS/non-EPS impacts and create controlled model revisions from measured updates.\",\"logical_nodes\":[\"VS-LN-ASSURANCE\",\"VS-LN-ARCH\",\"VS-LN-ANALYSIS\"],\"components\":[\"VS-PC-BRIDGE\",\"VS-PC-CONTRACT\",\"VS-PC-ARCHIVE\",\"VS-PC-EVIDENCE\"],\"evidence\":[\"VS-E03\",\"VS-E06\"],\"coverage_status\":\"Narrow tree comparison is reported. Complete semantic, transaction, provenance and reproduction controls are proposed.\",\"required_checks\":[\"VS-CHK-09\",\"VS-CHK-10\"]},{\"family\":\"cfs_fprime_definitions_sequences_resources\",\"stakeholders\":[\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\"],\"need\":\"Maintain consistent EPS hardware, model, flight and ground definitions with credible command and resource evidence.\",\"proposed_observations\":[\"Definition drift\",\"Sequence defects\",\"Adapter failures\",\"Uncovered compatibility/resource checks\"],\"provisional_requirement\":\"Maintain common command/telemetry/event/parameter definitions and hardware-to-functional mappings. Check execution conditions/effects, recovery/safe-mode sequences, target communication, CPU/memory/timing/power and OS/framework-version compatibility.\",\"logical_nodes\":[\"VS-LN-ARCH\",\"VS-LN-ANALYSIS\",\"VS-LN-ASSURANCE\"],\"components\":[\"VS-PC-FSW\",\"VS-PC-CAPELLA\",\"VS-PC-RUNNER\",\"VS-PC-CONTRACT\",\"VS-PC-EVIDENCE\"],\"evidence\":[],\"coverage_status\":\"Entire PA-VS extension is proposed. The four sources demonstrate no cFS/F-Prime assurance workflow.\",\"required_checks\":[\"VS-CHK-07\",\"VS-CHK-08\"]},{\"family\":\"readable_reviews_adoption_mission_scale\",\"stakeholders\":[\"Project Manager\",\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\",\"Testing Facility Technician\"],\"need\":\"Communicate evidence without requiring all participants to learn Capella. Tailor tools to mission scale and support independent access.\",\"proposed_observations\":[\"Review interpretation errors\",\"Onboarding effort\",\"Case adapter effort\",\"Access barriers\",\"Actual licenses/service/compute cost\"],\"provisional_requirement\":\"Publish concise trace tables, procedures, findings and selected structural/interface views. Provide a controlled export and feedback route and declare dependencies. Observe two contrasting cases with a frozen core.\",\"logical_nodes\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"components\":[\"VS-PC-WEB\",\"VS-PC-CAPELLA\",\"VS-PC-ARCHIVE\",\"VS-PC-PROCEDURES\",\"VS-PC-HOSTS\"],\"evidence\":[\"VS-E01\",\"VS-E06\",\"VS-E07\",\"VS-E09\",\"VS-E10\"],\"coverage_status\":\"Reported browser/report foundation. Training, external access, export and adoption outcomes remain unverified.\",\"required_checks\":[\"VS-CHK-01\",\"VS-CHK-11\"]}],\"proposals\":[{\"name\":\"Requirement and criterion guidance\",\"minimum_scope\":\"Worked EPS examples, method/standard applicability, observable criteria with applicable units and not-applicable rationale and trace review. Imported function text stays draft.\"},{\"name\":\"Controlled BOM and cost records\",\"minimum_scope\":\"Quantities and alternatives tied to revisions with dated supplier/currency/scope sources. No invented price or procurement approval.\"},{\"name\":\"RAM preparation\",\"minimum_scope\":\"Reviewed failure/maintenance assumptions and evidence-linked tables or proportionate Python analyses. No full new RAM platform.\"},{\"name\":\"Controlled model execution and credibility\",\"minimum_scope\":\"One reproducible runner contract and selected case models for time-dependent EPS/battery/controller decisions with stated calibration, uncertainty and validity.\"},{\"name\":\"Safe technician handoff and feedback\",\"minimum_scope\":\"Readable verification package, limits, stop/recovery actions, synchronized variables and returned raw evidence. Hardware fault testing is conditional on facility release.\"},{\"name\":\"Semantic and transaction assurance\",\"minimum_scope\":\"Stable IDs, declared field authority, types/units/time/activation semantics, reviewed diffs and partial-failure recovery.\"},{\"name\":\"Evidence custody and reconstruction\",\"minimum_scope\":\"Hashed composite baseline, source/input/environment package, raw output and external review/feedback export on existing managed storage.\"},{\"name\":\"Common software definitions and assurance\",\"minimum_scope\":\"One canonical dictionary, thin cFS/F-Prime adapters, EPS command/recovery sequence checks and resource/build evidence. No automatic complete flight software generation.\"},{\"name\":\"Adoption and reuse evaluation\",\"minimum_scope\":\"Observe actual effort/cost, review comprehension and discrepancy detection on common tasks and two contrasting EPS cases with the core frozen.\"}],\"limitations\":[\"No framework implementation or empirical PA-VS performance has been verified in this project.\",\"The earlier 18-component distribution, universal external-model boundary, old estimates and winner are superseded. This reviewed copy uses the common nine-L and forty-FR baseline.\",\"Reported product-tree conformity does not establish complete semantic, temporal, provenance or change consistency.\",\"Mode-indexed power budgets do not establish time-domain coupled EPS/battery/controller behavior.\",\"The OpenModelica RFLP example is separate from the Capella-Valispace integration and supplies no transferable error thresholds or controller assurance.\",\"RAM, cFS/F-Prime, complete technician-safe procedures, immutable baselines and independent reconstruction require proposed extensions.\",\"Capella scripts execute inside Capella. The headless bridge and integration GUI are future work in the source.\",\"Current license prices, seat/access permissions, API/export rights, hosting, backup, vendor continuity and supported versions are unresolved. Licensed access establishes no infeasibility without budget evidence.\",\"Older comparisons report access/document limitations. Present vendor/version behavior must be checked rather than assumed unchanged.\",\"Source claims of ease of use, speed, cost reduction or automatic verification are not measurements of this new framework.\",\"A universal digital twin, continuous online calibration, full AIV/T service and automatic controller synthesis are outside the minimum scope.\",\"Specialist geometry, real-time execution and physical replicas are conditional verification resources. Their adequacy and safety need case-specific evidence.\",\"The requested Jev search returned no chunks because API credits were unavailable after a local wrapper-signature correction. Central claims were checked directly in the four specified sources.\",\"A captured default cache path defeated module-level isolation and registered the failed query in the tracked cache. Zero chunks were scored. The pre-query snapshot and cache-incident.json are available. No repository repair was attempted.\"],\"retrieval\":{\"requested_mode\":\"jev\",\"requested_reranker\":\"jev\",\"requested_top_k\":12,\"result_artifact\":\"retrieval.json\",\"status\":\"failed_no_api_credits\",\"returned_chunks\":0,\"follow_up\":\"No further query. Four specified source Markdown files checked directly.\",\"repository_cache_modified\":true,\"cache_incident_artifact\":\"cache-incident.json\",\"pre_query_cache_snapshot\":\"search-cache/noul-index.sqlite3\",\"review_update\":\"No new searches in this turn. Review-decisions records that the earlier accidental cache metadata was backed up and restored by the orchestrator.\"},\"review_revision\":\"allocation-turn-02\",\"logical_baseline\":[{\"logical_component_id\":\"L01\",\"name\":\"Engineering guidance and knowledge\",\"candidate_node_ids\":[\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-GUIDANCE\",\"VS-PC-PROCEDURES\",\"VS-PC-EVALUATION\",\"VS-PC-WEB\"],\"control_and_data_placement\":\"Systems Engineer curates reviewed guidance. Valispace pages/templates store source-linked knowledge and the archive freezes its release.\",\"procedure_performers\":[\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"status\":\"Design allocation only. Implementation and verification pending.\"},{\"logical_component_id\":\"L02\",\"name\":\"Needs, requirements and decision governance\",\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-GOVERNANCE\",\"VS-PC-WEB\",\"VS-PC-CASE\",\"VS-PC-BRIDGE\"],\"control_and_data_placement\":\"Valispace requirements/decisions are authoritative. The relation index is a generated projection. Engineers authorize changes and statuses.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"status\":\"Design allocation only. Implementation and verification pending.\"},{\"logical_component_id\":\"L03\",\"name\":\"Architecture and service contracts\",\"candidate_node_ids\":[\"VS-LN-ARCH\"],\"physical_component_ids\":[\"VS-PC-CAPELLA\",\"VS-PC-EPS-TEMPLATE\",\"VS-PC-FSW\",\"VS-PC-CONTRACT\"],\"control_and_data_placement\":\"Capella owns topology, function allocation and modes/transitions. Controlled dictionary owns detailed service fields. Models and exports name both revisions.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"status\":\"Design allocation only. Implementation and verification pending.\"},{\"logical_component_id\":\"L04\",\"name\":\"Component and lifecycle characterization\",\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-CHARACTERIZATION\",\"VS-PC-WEB\",\"VS-PC-CASE\",\"VS-PC-RAM\"],\"control_and_data_placement\":\"Valispace owns characterization, quantities, quotes and sourced failure inputs. Capella occurrence IDs provide topology. Missing inputs remain explicit.\",\"procedure_performers\":[\"EPS Engineer\",\"Project Manager\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"status\":\"Design allocation only. Implementation and verification pending.\"},{\"logical_component_id\":\"L05\",\"name\":\"Scenario and analysis orchestration\",\"candidate_node_ids\":[\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-SCENARIO\",\"VS-PC-EPS-ENGINE\",\"VS-PC-RUNNER\",\"VS-PC-RAM\",\"VS-PC-FSW\",\"VS-PC-ARCHIVE\"],\"control_and_data_placement\":\"Workstation scenario module freezes run inputs and invokes integrated OpenModelica or declared external services. Raw outputs and settings go to the archive.\",\"procedure_performers\":[\"EPS Engineer\",\"Non-EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\"],\"status\":\"Design allocation only. Implementation and verification pending.\"},{\"logical_component_id\":\"L06\",\"name\":\"Model credibility and observation reconciliation\",\"candidate_node_ids\":[\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-CREDIBILITY\",\"VS-PC-OBSERVATION\",\"VS-PC-MODELS\",\"VS-PC-EVIDENCE\"],\"control_and_data_placement\":\"EPS Engineer reviews credibility/parameter proposals. Workstation calibration/residual/observation functions preserve raw and transformed data and prior parameters.\",\"procedure_performers\":[\"EPS Engineer\",\"Testing Facility Technician\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\"],\"status\":\"Design allocation only. Implementation and verification pending.\"},{\"logical_component_id\":\"L07\",\"name\":\"Verification specification and safety\",\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-VERIFICATION\",\"VS-PC-WEB\",\"VS-PC-PROCEDURES\",\"VS-PC-EVIDENCE\"],\"control_and_data_placement\":\"Systems/EPS Engineers author Valispace Tests specifications. Workstation export/readiness checks preserve external Technician/facility disposition. No physical actuation.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\",\"Testing Facility Technician\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"status\":\"Design allocation only. Implementation and verification pending.\"},{\"logical_component_id\":\"L08\",\"name\":\"Information and configuration authority\",\"candidate_node_ids\":[\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-CONTRACT\",\"VS-PC-BRIDGE\",\"VS-PC-ARCHIVE\",\"VS-PC-EVIDENCE\"],\"control_and_data_placement\":\"Framework archive owns accepted manifest and custody. Bridge validates contracts and recoverable changes. Domain meanings remain with their native owners.\",\"procedure_performers\":[\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"status\":\"Design allocation only. Implementation and verification pending.\"},{\"logical_component_id\":\"L09\",\"name\":\"Case workspace and technical review\",\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-WEB\",\"VS-PC-REVIEW\",\"VS-PC-EVALUATION\",\"VS-PC-CASE\",\"VS-PC-ARCHIVE\"],\"control_and_data_placement\":\"Valispace workspace is the primary shared surface. Derived Capella views and release exports support reviews/replay. Named findings and evaluation observations remain separate from approval.\",\"procedure_performers\":[\"Project Manager\",\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\",\"Testing Facility Technician\",\"Independent reviewer or reproducer (a distinct task role)\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"status\":\"Design allocation only. Implementation and verification pending.\"}],\"candidate_node_placement\":[{\"candidate_node_id\":\"VS-LN-ENG\",\"control\":\"Valispace workflow/field/formula/report features plus governance schemas and human authorization.\",\"persistent_data\":\"Requirements, decisions, guidance, characterization, BOM/cost and review records in Valispace. Release exports in the archive.\",\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"]},{\"candidate_node_id\":\"VS-LN-ARCH\",\"control\":\"Capella native architecture editing and in-application exports. Detailed dictionary revision maintained by bounded FSW package.\",\"persistent_data\":\"Native Capella EPS template/cases and dictionary/bindings on managed volume. Derived product-tree/mode/property links in Valispace.\",\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"]},{\"candidate_node_id\":\"VS-LN-ANALYSIS\",\"control\":\"Named scenario, OpenModelica backend, RAM transformation, credibility/calibration/observation and verification modules. Human model/readiness review.\",\"persistent_data\":\"Models, profiles, run manifests and raw/processed results in the archive. Summary criteria/status/parameter references in Valispace.\",\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\",\"VS-HOST-SPECIALIST\",\"VS-HOST-FLIGHTBUILD\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"]},{\"candidate_node_id\":\"VS-LN-ASSURANCE\",\"control\":\"Bridge contract checks, baseline release, reviewed transaction/recovery and exact package retrieval. Domain facts keep their native owner.\",\"persistent_data\":\"ID/schema manifest, transformation revisions, exported native artifacts, transaction log and rejected/accepted evidence on managed volume.\",\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\"]}],\"interface_families\":[{\"id\":\"IF-01\",\"name\":\"Engineering use\",\"physical_component_ids\":[\"VS-PC-WEB\",\"VS-PC-CAPELLA\",\"VS-PC-GOVERNANCE\",\"VS-PC-REVIEW\"],\"exchange\":\"Engineer needs/requirements/changes and case requests to templates/model/trace/BOM/review outputs.\",\"owner_validation_failure_rule\":\"Validate identity, schema, applicability and owner authorization. Missing decisions remain unresolved. Engineers own mission decisions.\"},{\"id\":\"IF-02\",\"name\":\"Source knowledge and components\",\"physical_component_ids\":[\"VS-PC-GUIDANCE\",\"VS-PC-CHARACTERIZATION\",\"VS-PC-BRIDGE\",\"VS-PC-CONTRACT\"],\"exchange\":\"Datasheets, part IDs, sourced quotes, methods and evidence to registered characterization/knowledge.\",\"owner_validation_failure_rule\":\"Record source locator/revision/date, units and claim scope. Missing or conflicting source data stays flagged. Supplier truth/qualification stays external.\"},{\"id\":\"IF-03\",\"name\":\"Discipline execution\",\"physical_component_ids\":[\"VS-PC-SCENARIO\",\"VS-PC-RUNNER\",\"VS-PC-EPS-ENGINE\",\"VS-PC-RAM\",\"VS-PC-CREDIBILITY\",\"VS-PC-BRIDGE\"],\"exchange\":\"Frozen request/input/model/tool profile to raw results, environment identity, runtime and limitations.\",\"owner_validation_failure_rule\":\"The proposed integrated OpenModelica backend requires a checked local profile. Profile implementation and verification remain pending. Electrical/thermal/EMC/CAD/orbit specialist services use external checked profiles. Unsupported/failed exchanges are retained with no supported claim.\"},{\"id\":\"IF-04\",\"name\":\"EPS software engineering\",\"physical_component_ids\":[\"VS-PC-FSW\",\"VS-PC-RUNNER\",\"VS-PC-CONTRACT\",\"VS-PC-EVIDENCE\"],\"exchange\":\"Common service dictionary/topology/sequence/target profile to cFS/F-Prime mappings and build/resource findings.\",\"owner_validation_failure_rule\":\"Validate schema/encoding/routes/ports and source/target revisions. Unmapped behavior or unknown target compatibility stays open. Complete mission implementation and flight operation remain external.\"},{\"id\":\"IF-05\",\"name\":\"Facility planning and supplied evidence\",\"physical_component_ids\":[\"VS-PC-VERIFICATION\",\"VS-PC-OBSERVATION\",\"VS-PC-CREDIBILITY\",\"VS-PC-CONTRACT\",\"VS-PC-ARCHIVE\"],\"exchange\":\"Proposal, DUT/equipment/calibration/timing/safety disposition and supplied observations to readiness, quality and model-update records.\",\"owner_validation_failure_rule\":\"Check completeness, safe-handoff status and observation semantics. No physical execution or autonomous control path. Facility authorization remains external.\"},{\"id\":\"IF-06\",\"name\":\"Independent review and evaluation\",\"physical_component_ids\":[\"VS-PC-REVIEW\",\"VS-PC-EVALUATION\",\"VS-PC-ARCHIVE\",\"VS-PC-SCENARIO\"],\"exchange\":\"Review/replay request, reference answers and findings to controlled package, replay verdict and actual task observations.\",\"owner_validation_failure_rule\":\"Resolve exact manifest, qualified reference and output rules. Retain failures and independent feedback. Reviewer outcome and research assessment remain separate.\"}],\"resource_dependency_declarations\":{\"deployment_center\":\"Valispace shared requirements/property/budget/test workspace and Capella native architecture center, connected through the reported Python/Excel bridge lineage. Named assurance modules are bounded extensions on the controlled workstation.\",\"hosts\":[{\"id\":\"VS-HOST-VALI\",\"name\":\"Valispace service host\",\"kind\":\"execution_or_storage_host\",\"placement\":\"framework_vendor_service\",\"scope\":\"Valispace web modules, database and API. Vendor deployment details remain unconfirmed.\",\"maturity\":\"Proposed resource declaration. Availability and resource limits are not measured.\"},{\"id\":\"VS-HOST-ENG\",\"name\":\"Engineering workstation\",\"kind\":\"execution_or_storage_host\",\"placement\":\"framework_controlled_existing_compute\",\"scope\":\"Browser, Capella and in-application Python for Capella, bridge extensions, Python numerical modules and integrated OpenModelica runtime. OS and versions must be declared.\",\"maturity\":\"Proposed resource declaration. Availability and resource limits are not measured.\"},{\"id\":\"VS-HOST-STORE\",\"name\":\"Managed evidence volume\",\"kind\":\"execution_or_storage_host\",\"placement\":\"framework_controlled_storage_on_existing_host\",\"scope\":\"Archive, manifests, native exports, raw files, model sources, dictionaries and release packages. May reside on VS-HOST-ENG. Backup and retention arrangements need confirmation.\",\"maturity\":\"Proposed resource declaration. Availability and resource limits are not measured.\"},{\"id\":\"VS-HOST-SPECIALIST\",\"name\":\"Declared discipline service environment\",\"kind\":\"execution_or_storage_host\",\"placement\":\"external_controlled_service\",\"scope\":\"Mission-selected CAD/electrical/thermal/EMC/orbit service runtime. Actual products, versions, licenses and capabilities are unresolved per profile.\",\"maturity\":\"Proposed resource declaration. Availability and resource limits are not measured.\"},{\"id\":\"VS-HOST-FLIGHTBUILD\",\"name\":\"Flight software build and target evidence environment\",\"kind\":\"execution_or_storage_host\",\"placement\":\"external_controlled_service\",\"scope\":\"Declared cFS/F-Prime build/configuration tools and any supplied target profile or observations. Flight deployment/operation is outside core.\",\"maturity\":\"Proposed resource declaration. Availability and resource limits are not measured.\"}],\"integrated_dependencies\":[{\"id\":\"VS-DEP-VALISPACE\",\"component_ids\":[\"VS-PC-WEB\"],\"host_id\":\"VS-HOST-VALI\",\"role\":\"Shared service, six native modules, database/API\",\"open_checks\":\"Current license, access, API/export permissions, vendor/version continuity, retention and hosting contract.\"},{\"id\":\"VS-DEP-CAPELLA\",\"component_ids\":[\"VS-PC-CAPELLA\"],\"host_id\":\"VS-HOST-ENG\",\"role\":\"Capella, Python for Capella and case-required VPMS\",\"open_checks\":\"Supported release/add-on combination, in-application script execution and export semantics. Headless capellambse is not assumed.\"},{\"id\":\"VS-DEP-PYTHON\",\"component_ids\":[\"VS-PC-BRIDGE\",\"VS-PC-RUNNER\",\"VS-PC-SCENARIO\",\"VS-PC-CREDIBILITY\",\"VS-PC-OBSERVATION\",\"VS-PC-RAM\",\"VS-PC-FSW\"],\"host_id\":\"VS-HOST-ENG\",\"role\":\"Declared Python environment and selected numerical/data libraries for named modules\",\"open_checks\":\"Pin actual versions, package all executable dependencies and test clean-start installation. No supported environment is asserted yet.\"},{\"id\":\"VS-DEP-OPENMODELICA\",\"component_ids\":[\"VS-PC-EPS-ENGINE\",\"VS-PC-MODELS\"],\"host_id\":\"VS-HOST-ENG\",\"role\":\"Declared integrated local EPS/battery analysis runtime and selected model source packages\",\"open_checks\":\"Select and test version, solver settings, model library and Python request/result profile. Aging and controller credibility remain proposed.\"}],\"external_controlled_services\":[{\"id\":\"VS-DEP-DISCIPLINE\",\"host_id\":\"VS-HOST-SPECIALIST\",\"physical_client_ids\":[\"VS-PC-BRIDGE\",\"VS-PC-RUNNER\",\"VS-PC-CONTRACT\"],\"profiles\":[\"electrical\",\"thermal\",\"EMC\",\"CAD\",\"orbit/attitude\"],\"placement\":\"External solver/operator services through IF-03. The named host is a declaration, not a selected platform.\",\"open_checks\":\"Actual engine/products, versions, data mappings, licenses, execution availability and returned environment/provenance are unresolved per profile. No universal adapter is implied.\"},{\"id\":\"VS-DEP-FLIGHTBUILD\",\"host_id\":\"VS-HOST-FLIGHTBUILD\",\"physical_client_ids\":[\"VS-PC-FSW\",\"VS-PC-RUNNER\",\"VS-PC-CONTRACT\"],\"profiles\":[\"cFS software bus\",\"F-Prime typed connections\",\"OBC/OS target resource evidence\"],\"placement\":\"External build/configuration and supplied target evidence through IF-04.\",\"open_checks\":\"Select supported versions/toolchains/OS/OBC. Demonstrate both mappings and import estimates/measurements without claiming full functionality, deployment or flight qualification.\"}],\"hardware_scope\":\"Existing computers, network and managed storage are proposed. No GPU, new server, physical EPS replica, real-time target or hazardous test equipment is required by the virtual core. Facility/DUT equipment is external and procedure-specific.\",\"execution_storage_rules\":\"Software modules execute on VS-HOST-ENG unless native Valispace services use VS-HOST-VALI. Authoritative web records remain in Valispace. Exact released artifacts/inputs/results are retained on VS-HOST-STORE. External service results return through checked contracts.\",\"versions_capacity_and_cost\":\"Actual versions, CPU/RAM/disk/runtime/network needs, users/access, backup, retention, prices and cost period remain to be established. No resource ceiling, hours or cost value is invented.\"},\"unresolved_conflicts\":[\"Electrical, thermal, EMC, CAD and orbit/attitude specialist service profiles remain unselected and unimplemented. FR-18 records these gaps explicitly.\",\"OpenModelica is a declared integrated local backend. The source precedent is a separate RFLP example. Aging, controller and prediction-credibility coverage require new case-specific evidence.\",\"Detailed service dictionary ownership is separated from Capella topology and from L08 schema/revision authority. Current Valispace API field/export support must be confirmed.\",\"Both cFS/F-Prime adapters, sequence checks and target evidence import are proposed. Framework/OS/OBC/toolchain compatibility is unresolved.\",\"Current licenses, user access, export rights, vendor/version continuity and independent offline reconstruction are unresolved. No budget-based infeasibility is asserted.\",\"Physical fault limits, protections, HIL timing and facility authorization remain external and unverified. The core has no hazardous execution path.\"],\"original_local_checks_note\":\"VS-CHK-01..11 remain useful supplemental checks. They do not replace common planned V01..V40.\",\"allocation_evidence_note\":{\"source_supported\":\"Only a named native feature or narrow integration mechanism is directly reported.\",\"transferable\":\"A process/model precedent is reported in another tool configuration or project and requires PA-VS implementation.\",\"synthesized\":\"An architectural combination or mapping inferred from reported mechanisms, not a demonstration.\",\"proposed\":\"New PA-VS software/data/procedure realization with implementation and verification pending.\",\"unknown\":\"Actual service/version/access/profile/capacity or physical validity is not established.\"},\"scope_note\":\"Named extension modules refine existing components and execute within the Capella/Valispace lineage. They are no additional generic modeling platform and confer design coverage only.\",\"selection_context\":{\"decision_source\":\"selection-decision.md\",\"status\":\"Selected author design direction under declared analyst reuse-first priority. No elicited stakeholder preference, procurement authorization or empirical optimum.\",\"reopen_conditions\":[\"licensing/access/price\",\"export rights and completeness\",\"stable-ID synchronization\",\"recovery and clean reconstruction\",\"proposed domain and assurance modules\"],\"principal_alternative\":\"PA-CDT when portable local semantic authority takes priority or selected conditions fail\"}}"; status = "proposed comparison description, not implemented or verified"; }
part def Deployment {
part Workstation : CPU;
@PhysicalRecord { identifier = "VS-HOST-ENG"; recordJSON = "{\"id\":\"VS-HOST-ENG\",\"name\":\"Engineering workstation\",\"kind\":\"execution_or_storage_host\",\"placement\":\"framework_controlled_existing_compute\",\"scope\":\"Browser, Capella and in-application Python for Capella, bridge extensions, Python numerical modules and integrated OpenModelica runtime. OS and versions must be declared.\",\"maturity\":\"Proposed resource declaration. Availability and resource limits are not measured.\"}"; status = "proposed comparison description, not implemented or verified"; }
part Valispace : SaaS;
@PhysicalRecord { identifier = "VS-HOST-VALI"; recordJSON = "{\"id\":\"VS-HOST-VALI\",\"name\":\"Valispace service host\",\"kind\":\"execution_or_storage_host\",\"placement\":\"framework_vendor_service\",\"scope\":\"Valispace web modules, database and API. Vendor deployment details remain unconfirmed.\",\"maturity\":\"Proposed resource declaration. Availability and resource limits are not measured.\"}"; status = "proposed comparison description, not implemented or verified"; }
part EvidenceStore : Store;
@PhysicalRecord { identifier = "VS-HOST-STORE"; recordJSON = "{\"id\":\"VS-HOST-STORE\",\"name\":\"Managed evidence volume\",\"kind\":\"execution_or_storage_host\",\"placement\":\"framework_controlled_storage_on_existing_host\",\"scope\":\"Archive, manifests, native exports, raw files, model sources, dictionaries and release packages. May reside on VS-HOST-ENG. Backup and retention arrangements need confirmation.\",\"maturity\":\"Proposed resource declaration. Availability and resource limits are not measured.\"}"; status = "proposed comparison description, not implemented or verified"; }
ref part Specialist : External;
@PhysicalRecord { identifier = "VS-HOST-SPECIALIST"; recordJSON = "{\"id\":\"VS-HOST-SPECIALIST\",\"name\":\"Declared discipline service environment\",\"kind\":\"execution_or_storage_host\",\"placement\":\"external_controlled_service\",\"scope\":\"Mission-selected CAD/electrical/thermal/EMC/orbit service runtime. Actual products, versions, licenses and capabilities are unresolved per profile.\",\"maturity\":\"Proposed resource declaration. Availability and resource limits are not measured.\"}"; status = "proposed comparison description, not implemented or verified"; }
interface REST : Sync connect Workstation.api to Valispace.api;
@PhysicalRecord { identifier = "VS-PIF-REST"; recordJSON = "{\"exchange\":\"Controlled Capella in-application Python/Excel/REST bridge. Stable IDs, authorized diff and failure recovery are proposed. No headless demonstration.\",\"owner\":\"L08 with L02/L03\",\"failure\":\"Reject/quarantine incompatible mappings, retain accepted baseline and diagnostics\"}"; status = "proposed comparison description, not implemented or verified"; }
interface STORE : Archive connect Workstation.files to EvidenceStore.files;
@PhysicalRecord { identifier = "VS-PIF-STORE"; recordJSON = "{\"exchange\":\"Native exports, exact manifests, sources, raw outputs and release packages. Web exports are frozen projections, not second working authorities.\",\"owner\":\"L08\",\"failure\":\"Reject incomplete/checksum-mismatched release and preserve prior baseline\",\"cohosting\":\"Store may reside on engineering workstation. Backup/retention unresolved.\"}"; status = "proposed comparison description, not implemented or verified"; }
interface IF03 : Discipline connect Workstation.IF03 to Specialist.IF03;
@PhysicalRecord { identifier = "VS-PIF-IF03"; recordJSON = "{\"exchange\":\"Common IF-03 run plan to raw result/environment/provenance\",\"placement\":\"External declared CAD/electrical/thermal/EMC/orbit profiles. Local OpenModelica is integrated on CPU.\",\"owner\":\"L05/L06/L08\",\"failure\":\"Reject unsupported or mismatched profile. Preserve explicit gaps.\",\"maturity\":\"Proposed, exact products/access unresolved\"}"; status = "proposed comparison description, not implemented or verified"; }
}
part def PhysicalFramework :> Framework {
doc /* A comparison alternative for the same framework black box. Responsibility partitions and host/storage resources are separate. References to facilities, engineered hardware and operational software establish boundary roles only. No available equipment or deployed implementation is asserted. */
ref part facility : ExternalFacility [0..*];
ref part engineeredEPS : EPSHardware [0..*];
ref part flightTarget : FlightSoftware [0..*];
ref part groundTarget : GroundSoftware [0..*];
