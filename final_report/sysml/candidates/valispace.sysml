stems Engineering\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E07\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E07\"}],\"verification_id\":\"V13\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Recalculate a sourced-price fixture after a quantity and part change. Match reference arithmetic and preserve unknown costs. Do not import historical project costs as new framework measurements.\",\"implementation_gap\":\"Implement quote schema, currency/source rules, uncertainty/unknown handling and arithmetic reference tests. Current prices are not supplied by the literature.\",\"boundary_authority_note\":\"EPS product estimate and framework license/service/compute costs are separate. No invented procurement budget is used.\",\"procedure_performers\":[\"Project Manager\",\"EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-02\"],\"mission_need_ids\":[\"MN-03\"],\"mission_requirement_ids\":[\"MR-03\"]}"; status = "proposed comparison description, not implemented or verified"; }
