@PhysicalRecord { identifier = "allocate_FR_40_VS_PC_EVALUATION"; recordJSON = "{\"requirement_id\":\"FR-40\",\"title\":\"Contrasting-case reuse\",\"logical_component_ids\":[\"L09\",\"L01\",\"L08\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-EVALUATION\",\"VS-PC-GUIDANCE\",\"VS-PC-EPS-TEMPLATE\",\"VS-PC-CASE\",\"VS-PC-CONTRACT\",\"VS-PC-ARCHIVE\"],\"realization_mechanism\":\"Frozen-core ledger identifies common templates/schema/modules/procedures and two predefined contrasting EPS cases. Case records declare permitted parameters/maps/extensions and retain outcomes, errors and any core change. A core revision requires rebaseline and rerun of both cases before reuse claims.\",\"maturity\":[\"proposed\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V40\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D,T\",\"proposed_acceptance\":\"Complete the same declared workflow in both cases without undeclared or post hoc core changes. If the core changes, rebaseline and rerun both cases before a reuse claim. No implementation or successful outcome is asserted here.\",\"implementation_gap\":\"Define the two cases, permitted adaptations and fixed workflow, then implement and run both. No successful reuse outcome is asserted.\",\"boundary_authority_note\":\"Case adaptation cannot hide post hoc core development. Planned V40 is framework verification, not EPS qualification or project objective assessment.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\",\"Independent reviewer or reproducer (a distinct task role)\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"mission_need_ids\":[\"MN-11\"],\"mission_requirement_ids\":[\"MR-11\"]}"; status = "proposed comparison description, not implemented or verified"; }
