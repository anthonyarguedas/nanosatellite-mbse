@PhysicalRecord { identifier = "allocate_FR_31_VS_PC_OBSERVATION"; recordJSON = "{\"requirement_id\":\"FR-31\",\"title\":\"Evidence timing\",\"logical_component_ids\":[\"L06\",\"L08\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-OBSERVATION\",\"VS-PC-CONTRACT\",\"VS-PC-EVIDENCE\",\"VS-PC-ARCHIVE\"],\"realization_mechanism\":\"Clock-alignment importer preserves sample/receipt/stimulus times, clock origin/scale, offset/drift/uncertainty, sampling/resampling rules and measured/estimated calculation/output delays. It emits alignment residuals and missing-metadata findings with retained raw series.\",\"maturity\":[\"proposed\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V31\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Align a known timestamp fixture and expose injected skew and missing timing metadata. Report alignment error or uncertainty against the agreed profile, with no invented global limit.\",\"implementation_gap\":\"Implement alignment functions, capture schema and skew fixtures. Profile-specific error/uncertainty limits need justification.\",\"boundary_authority_note\":\"Data alignment does not certify a real-time loop. Supplied timing data remains bound to actual setup and source revisions.\",\"procedure_performers\":[\"EPS Engineer\",\"Testing Facility Technician\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-05\",\"IF-03\"],\"mission_need_ids\":[\"MN-07\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
