@PhysicalRecord { identifier = "VS-PC-EPS-TEMPLATE"; recordJSON = "{\"id\":\"VS-PC-EPS-TEMPLATE\",\"name\":\"Generic Capella EPS template and case bindings\",\"kind\":\"persistent_data\",\"candidate_node_id\":\"VS-LN-ARCH\",\"minimum_realization\":\"Native reusable Capella functions, elements, allocations, exchanges, modes and states with Valispace requirement/property bindings. Separate template/core and declared case extension revisions.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[\"VS-E02\",\"VS-E05\"],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
part <'VS-PC-SCENARIO'> VS_PC_SCENARIO : CompositeResource;
@PhysicalRecord { identifier = "VS-PC-SCENARIO"; recordJSON = "{\"id\":\"VS-PC-SCENARIO\",\"name\":\"Time-indexed scenario composer and virtual test harness\",\"kind\":\"software_and_data\",\"candidate_node_id\":\"VS-LN-ANALYSIS\",\"minimum_realization\":\"Python scenario compiler joins orbit/attitude/irradiance/eclipse, thermal, mode/schedule/duty-cycle/load and supply/protection histories by controlled IDs and clocks. Executes nominal/fault/policy fixtures, freezes solver settings and result comparison rules.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[\"VS-E05\",\"VS-E08\"],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
part <'VS-PC-EPS-ENGINE'> VS_PC_EPS_ENGINE : SoftwareResource;
@PhysicalRecord { identifier = "VS-PC-EPS-ENGINE"; recordJSON = "{\"id\":\"VS-PC-EPS-ENGINE\",\"name\":\"Integrated OpenModelica EPS analysis backend\",\"kind\":\"integrated_software_dependency\",\"candidate_node_id\":\"VS-LN-ANALYSIS\",\"minimum_realization\":\"Declared local OpenModelica runtime invoked through a checked input/result profile. Executes selected case electrical and thermal EPS/battery models. Aging coupling and controller model coverage are proposed and require case-specific model packages.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[\"VS-E08\"],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
part <'VS-PC-CREDIBILITY'> VS_PC_CREDIBILITY : CompositeResource;
@PhysicalRecord { identifier = "VS-PC-CREDIBILITY"; recordJSON = "{\"id\":\"VS-PC-CREDIBILITY\",\"name\":\"Calibration, validity and residual assessment module\",\"kind\":\"software_and_data\",\"candidate_node_id\":\"VS-LN-ANALYSIS\",\"minimum_realization\":\"Named calibration-fit, held-out-validation, validity-domain, parameter-update, runtime/fidelity and expected-observed assessment functions. Records old/new parameters, residuals, uncertainty, alternate fault explanations and model/policy claim scope.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[\"VS-E08\"],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
part <'VS-PC-OBSERVATION'> VS_PC_OBSERVATION : CompositeResource;
@PhysicalRecord { identifier = "VS-PC-OBSERVATION"; recordJSON = "{\"id\":\"VS-PC-OBSERVATION\",\"name\":\"Observation clock and channel-quality importer\",\"kind\":\"software_and_data\",\"candidate_node_id\":\"VS-LN-ANALYSIS\",\"minimum_realization\":\"Supplied-file importer preserves raw channels and setup/calibration provenance. Named clock-alignment, resampling, active-unit/mode mapping, channel-completeness and validity-mask functions retain skew, invalid and inactive samples.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
part <'VS-PC-RAM'> VS_PC_RAM : CompositeResource;
@PhysicalRecord { identifier = "VS-PC-RAM"; recordJSON = "{\"id\":\"VS-PC-RAM\",\"name\":\"Capella-to-FMEA transformation and RAM coverage module\",\"kind\":\"software_and_data\",\"candidate_node_id\":\"VS-LN-ANALYSIS\",\"minimum_realization\":\"Declared transformation joins identified Capella functions/components and explicit failure dependencies with Valispace characterization. Produces an identified FMEA and RAM-variable/method coverage table. Missing rates and recovery inputs stay unknown.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
part <'VS-PC-VERIFICATION'> VS_PC_VERIFICATION : CompositeResource;
@PhysicalRecord { identifier = "VS-PC-VERIFICATION"; recordJSON = "{\"id\":\"VS-PC-VERIFICATION\",\"name\":\"Valispace verification specification and readiness module\",\"kind\":\"software_and_data\",\"candidate_node_id\":\"VS-LN-ANALYSIS\",\"minimum_realization\":\"Tests-module field templates for inspection/analysis/demonstration/test. Technician package exporter and completeness/readiness gate check DUT/equipment identities, connections, limits, stimuli, capture and external safety-review status.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[\"VS-E01\",\"VS-E09\",\"VS-E10\"],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
part <'VS-PC-REVIEW'> VS_PC_REVIEW : CompositeResource { action procedure : OperatingProcedure; }
@PhysicalRecord { identifier = "VS-PC-REVIEW"; recordJSON = "{\"id\":\"VS-PC-REVIEW\",\"name\":\"Baseline-linked review projection and feedback procedure\",\"kind\":\"software_and_procedure\",\"candidate_node_id\":\"VS-LN-ENG\",\"minimum_realization\":\"Valispace Analyses tables/plots and filtered native Capella context/structure/interface views assembled from the accepted manifest. Export carries source IDs, units, legends, claims, validity and findings. External feedback is registered before disposition.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[\"VS-E01\",\"VS-E02\",\"VS-E07\",\"VS-E09\"],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
part <'VS-PC-EVALUATION'> VS_PC_EVALUATION : CompositeResource { action procedure : OperatingProcedure; }
@PhysicalRecord { identifier = "VS-PC-EVALUATION"; recordJSON = "{\"id\":\"VS-PC-EVALUATION\",\"name\":\"Adoption and frozen-core two-case evaluation package\",\"kind\":\"persistent_data_and_procedure\",\"candidate_node_id\":\"VS-LN-ENG\",\"minimum_realization\":\"Clean-start instructions, dependency/access inventory, task/reference manifest, participant/effort/cost observation forms, core versus case customization ledger and both case outcomes. Stores declared period and inclusions. No predicted performance.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[\"VS-E06\",\"VS-E09\"],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
