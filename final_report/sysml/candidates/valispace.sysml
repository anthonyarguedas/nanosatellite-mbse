dure_performers\":[\"EPS Engineer\",\"Non-EPS Engineer\",\"Testing Facility Technician\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-03\",\"IF-05\"],\"mission_need_ids\":[\"MN-05\",\"MN-07\",\"MN-08\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-07\",\"MR-08\"]}"; status = "proposed comparison description, not implemented or verified"; }
