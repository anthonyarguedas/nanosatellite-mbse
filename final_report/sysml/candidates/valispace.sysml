@PhysicalRecord { identifier = "allocate_FR_13_VS_PC_CHARACTERIZATION"; recordJSON = "{\"requirement_id\":\"FR-13\",\"title\":\"Financial estimate\",\"logical_component_ids\":[\"L04\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-CHARACTERIZATION\",\"VS-PC-WEB\",\"VS-PC-CASE\"],\"realization_mechanism\":\"Valispace budget formulas roll selected BOM quantities into scoped financial estimates using dated/currency/quantity quote records, other declared cost categories, uncertainty and unknown-price flags. Export binds the calculation to its revision.\",\"maturity\":[\"source_supported\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E05\",\"VS-E07\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"4.3.2 Logical Architecture and 4.4 Subsystem Design and Trade-Offs\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.4 System Design, Figs. 4.25 through 4.27\",\"physical_pdf_pages\":[84,85,86],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.5 Subsystem Design, Fig. 4.29\",\"physical_pdf_pages\":[88],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.1 Systems Engineering\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E07\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E07\"}],\"verification_id\":\"V13\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Recalculate a sourced-price fixture after a quantity and part change. Match reference arithmetic and preserve unknown costs. Do not import historical project costs as new framework measurements.\",\"implementation_gap\":\"Implement quote schema, currency/source rules, uncertainty/unknown handling and arithmetic reference tests. Current prices are not supplied by the literature.\",\"boundary_authority_note\":\"EPS product estimate and framework license/service/compute costs are separate. No invented procurement budget is used.\",\"procedure_performers\":[\"Project Manager\",\"EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-02\"],\"mission_need_ids\":[\"MN-03\"],\"mission_requirement_ids\":[\"MR-03\"]}"; status = "proposed comparison description, not implemented or verified"; }
