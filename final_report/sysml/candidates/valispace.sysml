@PhysicalRecord { identifier = "allocate_FR_32_VS_PC_OBSERVATION"; recordJSON = "{\"requirement_id\":\"FR-32\",\"title\":\"Telemetry quality\",\"logical_component_ids\":[\"L06\",\"L08\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-OBSERVATION\",\"VS-PC-CONTRACT\",\"VS-PC-EVIDENCE\",\"VS-PC-ARCHIVE\"],\"realization_mechanism\":\"Channel-quality checker compares expected channels/units/timestamps and active-unit/mode context with raw observations. It retains missing, invalid, inactive and suspect samples plus explicit processing masks. Invalid/inactive values are excluded from measurement-required comparisons.\",\"maturity\":[\"proposed\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V32\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_acceptance\":\"Inject missing samples, inactive sensors and invalid values. Do not treat inactive invalid readings as valid measurements. Match the fixture quality verdict and retained raw data.\",\"implementation_gap\":\"Implement channel/activation schema and sample-quality fixtures. No sensor value is silently replaced by zero.\",\"boundary_authority_note\":\"Quality flags and raw samples remain distinct. Estimated battery states are not direct measurements.\",\"procedure_performers\":[\"EPS Engineer\",\"Testing Facility Technician\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-05\"],\"mission_need_ids\":[\"MN-07\",\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-05\",\"MR-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
