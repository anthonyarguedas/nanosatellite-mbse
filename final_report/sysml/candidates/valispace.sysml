#intendedRealization allocation allocate_FR_16_VS_PC_SCENARIO allocate FrameworkRequirements::FR_16 to physical.VS_PC_SCENARIO;
@PhysicalRecord { identifier = "allocate_FR_16_VS_PC_SCENARIO"; recordJSON = "{\"requirement_id\":\"FR-16\",\"title\":\"Dynamic mission composition\",\"logical_component_ids\":[\"L05\",\"L03\",\"L04\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ARCH\",\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-SCENARIO\",\"VS-PC-EPS-ENGINE\",\"VS-PC-MODELS\",\"VS-PC-CHARACTERIZATION\",\"VS-PC-EPS-TEMPLATE\"],\"realization_mechanism\":\"Scenario compiler composes time-indexed orbit/attitude/irradiance/eclipse/thermal histories, subsystem duty/schedules/mode transitions and supply/protection behavior. Integrated OpenModelica profile consumes controlled inputs and returns generation/load/energy/event traces.\",\"maturity\":[\"transferable\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E05\",\"VS-E08\"],\"source_locators\":[{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"4.3.2 Logical Architecture and 4.4 Subsystem Design and Trade-Offs\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.4 System Design, Figs. 4.25 through 4.27\",\"physical_pdf_pages\":[84,85,86],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.5 Subsystem Design, Fig. 4.29\",\"physical_pdf_pages\":[88],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.4 Electrical and Power System, Figs. 3 and 4\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E08\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"5 Discussion and 6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E08\"}],\"verification_id\":\"V16\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Use a fixture whose average budget passes while a coupled load and illumination event creates a transient shortage. Inspect inputs, interactions and event timing against a reference calculation.\",\"implementation_gap\":\"Implement timed composition, profiles, coupling and the average-pass/transient-fail fixture. Mode-indexed budget demonstration does not establish time-domain coupling.\",\"boundary_authority_note\":\"Scenario inputs and solver settings are controlled framework artifacts. Specialist mission histories arrive through IF-03. No live spacecraft control is included.\",\"procedure_performers\":[\"EPS Engineer\",\"Non-EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-SPECIALIST\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-01\",\"IF-03\"],\"mission_need_ids\":[\"MN-04\",\"MN-05\",\"MN-08\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-05\",\"MR-08\"]}"; status = "proposed comparison description, not implemented or verified"; }
