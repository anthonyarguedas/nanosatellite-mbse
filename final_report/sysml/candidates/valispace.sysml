#intendedRealization allocation allocate_FR_11_VS_PC_GOVERNANCE allocate FrameworkRequirements::FR_11 to physical.VS_PC_GOVERNANCE;
@PhysicalRecord { identifier = "allocate_FR_11_VS_PC_GOVERNANCE"; recordJSON = "{\"requirement_id\":\"FR-11\",\"title\":\"Evidence and discrepancy status\",\"logical_component_ids\":[\"L02\",\"L07\",\"L09\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\",\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-GOVERNANCE\",\"VS-PC-VERIFICATION\",\"VS-PC-REVIEW\",\"VS-PC-EVIDENCE\"],\"realization_mechanism\":\"Claim-status rule table associates missing/rejected/stale/out-of-domain/failed/unresolved evidence with affected claims, criticality rationale, owner and disposition. It blocks an unqualified supported/verified label when a critical finding remains open.\",\"maturity\":[\"source_supported\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E09\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"2 Requirements management in small space enterprises: problems and needs\",\"physical_pdf_pages\":[4,5],\"evidence_id\":\"VS-E09\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"3 Software for requirement management: overview and proposal, Table 1\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E09\"}],\"verification_id\":\"V11\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_acceptance\":\"Seed each status including a critical finding. A claim affected by unresolved critical evidence cannot receive an unqualified supported or verified status.\",\"implementation_gap\":\"Implement the distinct evidence states and criticality gate instead of relying on a native test-status field alone.\",\"boundary_authority_note\":\"Author status, admissibility verdict, review outcome and external approval remain distinct.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\",\"Independent reviewer or reproducer (a distinct task role)\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-10\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-10\"]}"; status = "proposed comparison description, not implemented or verified"; }
