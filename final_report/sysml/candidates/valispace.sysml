@PhysicalRecord { identifier = "allocate_FR_10_VS_PC_SCENARIO"; recordJSON = "{\"requirement_id\":\"FR-10\",\"title\":\"Independent replay\",\"logical_component_ids\":[\"L05\",\"L08\",\"L09\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ASSURANCE\",\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-SCENARIO\",\"VS-PC-RUNNER\",\"VS-PC-ARCHIVE\",\"VS-PC-MODELS\",\"VS-PC-EVALUATION\"],\"realization_mechanism\":\"Replay procedure reconstructs the released model source, input histories, solver/dependency versions, seed and numerical settings from the manifest. Named output comparator applies result-specific rules fixed before replay and retains logs, failures and raw outputs.\",\"maturity\":[\"source_supported\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E08\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.4 Electrical and Power System, Figs. 3 and 4\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E08\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"5 Discussion and 6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E08\"}],\"verification_id\":\"V10\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"D,T\",\"proposed_acceptance\":\"An independent participant replays a baseline from a clean declared environment. Retain logs, seeds when relevant, failures and comparison verdicts. Tolerances are fixed before replay.\",\"implementation_gap\":\"Implement and independently test clean-environment reconstruction and comparator rules. Hosted scripts do not establish full reconstruction.\",\"boundary_authority_note\":\"Independent replay evaluates the framework. Reproducibility can hold for an inaccurate model.\",\"procedure_performers\":[\"Independent reviewer or reproducer (a distinct task role)\",\"EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-03\",\"IF-06\"],\"mission_need_ids\":[\"MN-09\"],\"mission_requirement_ids\":[\"MR-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
