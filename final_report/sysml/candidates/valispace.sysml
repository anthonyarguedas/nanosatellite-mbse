#intendedRealization allocation allocate_FR_33_VS_PC_FSW allocate FrameworkRequirements::FR_33 to physical.VS_PC_FSW;
@PhysicalRecord { identifier = "allocate_FR_33_VS_PC_FSW"; recordJSON = "{\"requirement_id\":\"FR-33\",\"title\":\"Shared software definitions\",\"logical_component_ids\":[\"L03\"],\"candidate_node_ids\":[\"VS-LN-ARCH\"],\"physical_component_ids\":[\"VS-PC-FSW\",\"VS-PC-CAPELLA\",\"VS-PC-CONTRACT\",\"VS-PC-CASE\"],\"realization_mechanism\":\"Canonical service dictionary retains command/telemetry/event/parameter IDs, types, units, ranges and encodings. Binding table maps detailed fields once to Capella hardware exchanges, software functional allocations and flight/ground artifacts. Drift checker compares identified revisions.\",\"maturity\":[\"proposed\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V33\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Compare model, flight and ground fixtures against a shared contract. Detect a changed definition in one representation and report every affected mapping.\",\"implementation_gap\":\"Build the dictionary/schema, hardware-to-functional mapping and drift fixtures. No native cFS/F-Prime PA-VS capability is evidenced.\",\"boundary_authority_note\":\"VS-PC-FSW owns detailed service fields, Capella owns topology/allocation, Valispace presents references and L08 owns revision identity.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-04\"],\"mission_need_ids\":[\"MN-08\",\"MN-02\"],\"mission_requirement_ids\":[\"MR-08\",\"MR-02\"]}"; status = "proposed comparison description, not implemented or verified"; }
