@PhysicalRecord { identifier = "allocate_FR_21_VS_PC_CREDIBILITY"; recordJSON = "{\"requirement_id\":\"FR-21\",\"title\":\"Intended-use credibility\",\"logical_component_ids\":[\"L06\",\"L07\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-CREDIBILITY\",\"VS-PC-VERIFICATION\",\"VS-PC-MODELS\",\"VS-PC-EVIDENCE\"],\"realization_mechanism\":\"Validity-domain assessor joins claim/use to exact model/parameter/data revisions, calibration versus validation split, tested ranges, uncertainty and a sourced acceptable-error rule. It records in-domain, extrapolated and missing-evidence outcomes before admissibility review.\",\"maturity\":[\"transferable\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E08\"],\"source_locators\":[{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.4 Electrical and Power System, Figs. 3 and 4\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E08\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"5 Discussion and 6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E08\"}],\"verification_id\":\"V21\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Exercise an in-domain and an extrapolated claim. Separate calibration from validation data where available. Flag untested domains and absent error limits. Prediction accuracy limits require prior agreement.\",\"implementation_gap\":\"Implement credibility schema, applicability logic and representative independent validation. Prediction-error values and decision limits are unresolved.\",\"boundary_authority_note\":\"L06 owns model applicability. L07 owns evidence admissibility. Agreement with calibration data alone does not establish analytical verification.\",\"procedure_performers\":[\"EPS Engineer\",\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-03\",\"IF-05\"],\"mission_need_ids\":[\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
#intendedRealization allocation allocate_FR_21_VS_PC_VERIFICATION allocate FrameworkRequirements::FR_21 to physical.VS_PC_VERIFICATION;
@PhysicalRecord { identifier = "allocate_FR_21_VS_PC_VERIFICATION"; recordJSON = "{\"requirement_id\":\"FR-21\",\"title\":\"Intended-use credibility\",\"logical_component_ids\":[\"L06\",\"L07\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-CREDIBILITY\",\"VS-PC-VERIFICATION\",\"VS-PC-MODELS\",\"VS-PC-EVIDENCE\"],\"realization_mechanism\":\"Validity-domain assessor joins claim/use to exact model/parameter/data revisions, calibration versus validation split, tested ranges, uncertainty and a sourced acceptable-error rule. It records in-domain, extrapolated and missing-evidence outcomes before admissibility review.\",\"maturity\":[\"transferable\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E08\"],\"source_locators\":[{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.4 Electrical and Power System, Figs. 3 and 4\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E08\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"5 Discussion and 6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E08\"}],\"verification_id\":\"V21\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Exercise an in-domain and an extrapolated claim. Separate calibration from validation data where available. Flag untested domains and absent error limits. Prediction accuracy limits require prior agreement.\",\"implementation_gap\":\"Implement credibility schema, applicability logic and representative independent validation. Prediction-error values and decision limits are unresolved.\",\"boundary_authority_note\":\"L06 owns model applicability. L07 owns evidence admissibility. Agreement with calibration data alone does not establish analytical verification.\",\"procedure_performers\":[\"EPS Engineer\",\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-03\",\"IF-05\"],\"mission_need_ids\":[\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
