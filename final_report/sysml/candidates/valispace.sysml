R1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.1 Systems Engineering\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E07\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E07\"}],\"verification_id\":\"V17\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Derive a fixture allocation from datasheet and supplied measurement inputs using a declared method. Preserve assumptions and flag unsupported ranges and undecided pass/fail values.\",\"implementation_gap\":\"Implement derivation lineage and criterion-decision templates, including component and non-EPS updates. Formula recalculation alone does not justify allowable ranges.\",\"boundary_authority_note\":\"Engineers set criterion decisions from justified sources. Complete fields establish no technical truth.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-02\",\"IF-05\"],\"mission_need_ids\":[\"MN-01\",\"MN-02\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-02\",\"MR-04\"]}"; status = "proposed comparison description, not implemented or verified"; }
