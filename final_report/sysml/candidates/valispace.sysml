#intendedRealization allocation allocate_FR_04_VS_PC_GOVERNANCE allocate FrameworkRequirements::FR_04 to physical.VS_PC_GOVERNANCE;
@PhysicalRecord { identifier = "allocate_FR_04_VS_PC_GOVERNANCE"; recordJSON = "{\"requirement_id\":\"FR-04\",\"title\":\"Bidirectional trace retrieval\",\"logical_component_ids\":[\"L02\",\"L08\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-GOVERNANCE\",\"VS-PC-BRIDGE\",\"VS-PC-CONTRACT\",\"VS-PC-ARCHIVE\"],\"realization_mechanism\":\"Valispace relation fields and Capella/native IDs feed a baseline-derived typed relation index. Forward/reverse trace queries resolve needs, requirements, decisions, input sets, criteria and result revisions and return missing/ambiguous/stale endpoints.\",\"maturity\":[\"source_supported\",\"synthesized\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E03\",\"VS-E09\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"4.3.2 Logical Architecture\",\"physical_pdf_pages\":[6,7],\"evidence_id\":\"VS-E03\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.3 Python for Capella and 3.4 Valispace Python API, named export/import/Components_bridge.py descriptions\",\"physical_pdf_pages\":[53,54,55,56],\"evidence_id\":\"VS-E03\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.4 System Design, Figs. 4.21 and 4.22\",\"physical_pdf_pages\":[79,80],\"evidence_id\":\"VS-E03\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"2 Requirements management in small space enterprises: problems and needs\",\"physical_pdf_pages\":[4,5],\"evidence_id\":\"VS-E09\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"3 Software for requirement management: overview and proposal, Table 1\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E09\"}],\"verification_id\":\"V04\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_acceptance\":\"Compare both query directions with the fixture relation set. Missing, ambiguous and stale endpoints remain visible.\",\"implementation_gap\":\"Implement cross-store relation semantics and bidirectional queries beyond tree comparison.\",\"boundary_authority_note\":\"The index is a projection. Valispace owns requirements/decisions, Capella owns topology and the archive resolves exact accepted revisions.\",\"procedure_performers\":[\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"mission_need_ids\":[\"MN-02\",\"MN-10\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-10\"]}"; status = "proposed comparison description, not implemented or verified"; }
