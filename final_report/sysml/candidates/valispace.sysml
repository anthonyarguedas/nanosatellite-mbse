#intendedRealization allocation allocate_FR_34_VS_PC_FSW allocate FrameworkRequirements::FR_34 to physical.VS_PC_FSW;
@PhysicalRecord { identifier = "allocate_FR_34_VS_PC_FSW"; recordJSON = "{\"requirement_id\":\"FR-34\",\"title\":\"Flight framework mapping\",\"logical_component_ids\":[\"L03\",\"L05\"],\"candidate_node_ids\":[\"VS-LN-ARCH\",\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-FSW\",\"VS-PC-RUNNER\",\"VS-PC-CONTRACT\",\"VS-PC-EVIDENCE\"],\"realization_mechanism\":\"Named cFS adapter checks software-bus message IDs, encoding and pub-sub routes. Named F-Prime adapter checks typed ports and definition mappings. Each declares version/profile, emits only supported dictionary/scaffold mappings and coordinates native build checks with retained unsupported exports.\",\"maturity\":[\"proposed\",\"unknown\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V34\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"D,T\",\"proposed_acceptance\":\"Round-trip or validate reference message and port mappings in both profiles. Declare framework version and unsupported exports. Architecture or dictionary generation is distinct from mission-specific functionality.\",\"implementation_gap\":\"Implement both adapters and native mapping fixtures. Actual framework/toolchain versions and exports remain unverified.\",\"boundary_authority_note\":\"Native build tools are external controlled services. Checked architecture/dictionary scaffolds are distinct from mission-specific software functionality.\",\"procedure_performers\":[\"Non-EPS Engineer\",\"EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-FLIGHTBUILD\"],\"storage_host_ids\":[\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-04\"],\"mission_need_ids\":[\"MN-08\"],\"mission_requirement_ids\":[\"MR-08\"]}"; status = "proposed comparison description, not implemented or verified"; }
