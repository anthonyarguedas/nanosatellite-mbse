#intendedRealization allocation allocate_FR_18_VS_PC_BRIDGE allocate FrameworkRequirements::FR_18 to physical.VS_PC_BRIDGE;
@PhysicalRecord { identifier = "allocate_FR_18_VS_PC_BRIDGE"; recordJSON = "{\"requirement_id\":\"FR-18\",\"title\":\"Discipline model integration\",\"logical_component_ids\":[\"L03\",\"L05\",\"L08\"],\"candidate_node_ids\":[\"VS-LN-ARCH\",\"VS-LN-ANALYSIS\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-BRIDGE\",\"VS-PC-CONTRACT\",\"VS-PC-RUNNER\",\"VS-PC-CAPELLA\",\"VS-PC-ARCHIVE\"],\"realization_mechanism\":\"Discipline-profile registry names electrical, thermal, EMC and CAD services and exact native artifacts. Checked request/result adapters map occurrence/parameter/quantity IDs and capture tool/environment revisions, outputs and unsupported checks. Transfer failures are retained.\",\"maturity\":[\"source_supported\",\"transferable\",\"proposed\",\"unknown\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E02\",\"VS-E07\",\"VS-E08\"],\"source_locators\":[{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"3.1 Data-Driven MBSE Methodology\",\"physical_pdf_pages\":[3],\"evidence_id\":\"VS-E02\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.2 Integration\",\"physical_pdf_pages\":[47,48,49,50,51],\"evidence_id\":\"VS-E02\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.1 Systems Engineering\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E07\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E07\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.4 Electrical and Power System, Figs. 3 and 4\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E08\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"5 Discussion and 6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E08\"}],\"verification_id\":\"V18\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"D,T\",\"proposed_acceptance\":\"Every electrical, thermal, EMC and CAD exchange profile required by the frozen minimum shall complete its reference request/result exchange and declared identity, quantity, unit, meaning and revision checks. Retain unsupported mappings and development gaps. A missing required profile remains not verified or undetermined and cannot pass V18. A narrower minimum requires a reviewed scope disposition before evaluation.\",\"implementation_gap\":\"Actual electrical/thermal/EMC/CAD service products, versions and profiles are not selected or implemented. FR-18 currently has explicit discipline gaps, not a supported universal adapter.\",\"boundary_authority_note\":\"These specialist solvers are external controlled services at VS-HOST-SPECIALIST. The local OpenModelica EPS backend is separately declared integrated. Baseline custody stays with the framework.\",\"procedure_performers\":[\"EPS Engineer\",\"Non-EPS Engineer\",\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-SPECIALIST\"],\"storage_host_ids\":[\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-03\"],\"mission_need_ids\":[\"MN-04\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-07\"]}"; status = "proposed comparison description, not implemented or verified"; }
