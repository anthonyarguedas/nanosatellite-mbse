#intendedRealization allocation allocate_FR_17_VS_PC_GOVERNANCE allocate FrameworkRequirements::FR_17 to physical.VS_PC_GOVERNANCE;
@PhysicalRecord { identifier = "allocate_FR_17_VS_PC_GOVERNANCE"; recordJSON = "{\"requirement_id\":\"FR-17\",\"title\":\"Requirement parameter derivation\",\"logical_component_ids\":[\"L02\",\"L04\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\",\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-GOVERNANCE\",\"VS-PC-CHARACTERIZATION\",\"VS-PC-GUIDANCE\",\"VS-PC-CASE\"],\"realization_mechanism\":\"Derivation record links datasheet/measurement revisions and load/mode/thermal assumptions to a selected budget or allocation formula, units/uncertainty, allowable range and criterion disposition in Valispace. Unsupported ranges and undecided limits remain visible.\",\"maturity\":[\"source_supported\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E05\",\"VS-E07\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"4.3.2 Logical Architecture and 4.4 Subsystem Design and Trade-Offs\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.4 System Design, Figs. 4.25 through 4.27\",\"physical_pdf_pages\":[84,85,86],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.5 Subsystem Design, Fig. 4.29\",\"physical_pdf_pages\":[88],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.1 Systems Engineering\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E07\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E07\"}],\"verification_id\":\"V17\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Derive a fixture allocation from datasheet and supplied measurement inputs using a declared method. Preserve assumptions and flag unsupported ranges and undecided pass/fail values.\",\"implementation_gap\":\"Implement derivation lineage and criterion-decision templates, including component and non-EPS updates. Formula recalculation alone does not justify allowable ranges.\",\"boundary_authority_note\":\"Engineers set criterion decisions from justified sources. Complete fields establish no technical truth.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-02\",\"IF-05\"],\"mission_need_ids\":[\"MN-01\",\"MN-02\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-02\",\"MR-04\"]}"; status = "proposed comparison description, not implemented or verified"; }
