#intendedRealization allocation allocate_FR_08_VS_PC_BRIDGE allocate FrameworkRequirements::FR_08 to physical.VS_PC_BRIDGE;
@PhysicalRecord { identifier = "allocate_FR_08_VS_PC_BRIDGE"; recordJSON = "{\"requirement_id\":\"FR-08\",\"title\":\"Semantic transfers\",\"logical_component_ids\":[\"L08\"],\"candidate_node_ids\":[\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-BRIDGE\",\"VS-PC-CONTRACT\",\"VS-PC-ARCHIVE\"],\"realization_mechanism\":\"Transfer validator checks canonical/native IDs, hierarchy, quantity kinds, unit scale/offset, polarity, field semantics, clocks and provenance. It quarantines rejected inputs, records unsupported/lossy mappings and leaves accepted revisions unchanged.\",\"maturity\":[\"source_supported\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E03\"],\"source_locators\":[{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"4.3.2 Logical Architecture\",\"physical_pdf_pages\":[6,7],\"evidence_id\":\"VS-E03\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.3 Python for Capella and 3.4 Valispace Python API, named export/import/Components_bridge.py descriptions\",\"physical_pdf_pages\":[53,54,55,56],\"evidence_id\":\"VS-E03\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.4 System Design, Figs. 4.21 and 4.22\",\"physical_pdf_pages\":[79,80],\"evidence_id\":\"VS-E03\"}],\"verification_id\":\"V08\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_acceptance\":\"Inject unit, sign, identifier and time-base mismatches. Reject incompatible transfers without replacing controlled content. Record unsupported or lossy mappings.\",\"implementation_gap\":\"Implement checks beyond the reported name/parent tree comparator. Define and exercise each mapping profile.\",\"boundary_authority_note\":\"Domain owners define meaning. L08 validates contracts and never infers semantic equivalence from equal names.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-02\",\"IF-03\",\"IF-04\",\"IF-05\"],\"mission_need_ids\":[\"MN-02\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
