#intendedRealization allocation allocate_FR_05_VS_PC_GOVERNANCE allocate FrameworkRequirements::FR_05 to physical.VS_PC_GOVERNANCE;
@PhysicalRecord { identifier = "allocate_FR_05_VS_PC_GOVERNANCE"; recordJSON = "{\"requirement_id\":\"FR-05\",\"title\":\"Change impact\",\"logical_component_ids\":[\"L02\",\"L08\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-GOVERNANCE\",\"VS-PC-BRIDGE\",\"VS-PC-CONTRACT\",\"VS-PC-CASE\"],\"realization_mechanism\":\"Impact-closure module traverses explicit typed dependencies from a proposed changed revision to EPS/non-EPS allocations, quantities, BOM/cost, models, dictionary fields, procedures and results. Unmapped dependencies are returned as coverage gaps.\",\"maturity\":[\"source_supported\",\"synthesized\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E03\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"4.3.2 Logical Architecture\",\"physical_pdf_pages\":[6,7],\"evidence_id\":\"VS-E03\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.3 Python for Capella and 3.4 Valispace Python API, named export/import/Components_bridge.py descriptions\",\"physical_pdf_pages\":[53,54,55,56],\"evidence_id\":\"VS-E03\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.4 System Design, Figs. 4.21 and 4.22\",\"physical_pdf_pages\":[79,80],\"evidence_id\":\"VS-E03\"}],\"verification_id\":\"V05\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Use seeded cross-subsystem and component changes. Compare the returned impact set and unresolved coverage with an adjudicated reference.\",\"implementation_gap\":\"Define dependency types and seeded reference sets. Formula propagation and tree repair do not implement the required complete impact set.\",\"boundary_authority_note\":\"L02 proposes impact and human owners adjudicate it. External change frequency and fewer failed gates are not guaranteed.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\",\"Non-EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\"],\"mission_need_ids\":[\"MN-02\",\"MN-03\",\"MN-08\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-03\",\"MR-08\"]}"; status = "proposed comparison description, not implemented or verified"; }
