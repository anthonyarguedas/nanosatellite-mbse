#intendedRealization allocation allocate_FR_30_VS_PC_VERIFICATION allocate FrameworkRequirements::FR_30 to physical.VS_PC_VERIFICATION;
@PhysicalRecord { identifier = "allocate_FR_30_VS_PC_VERIFICATION"; recordJSON = "{\"requirement_id\":\"FR-30\",\"title\":\"Safety declaration\",\"logical_component_ids\":[\"L07\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-VERIFICATION\",\"VS-PC-CASE\",\"VS-PC-PROCEDURES\",\"VS-PC-EVIDENCE\"],\"realization_mechanism\":\"Safety/readiness schema records battery/electronics limits, hazards, fault envelope, isolation, abort/recovery and external responsible-review status. Completeness gate blocks ready-for-physical-handoff status when applicable limits or review evidence are absent.\",\"maturity\":[\"proposed\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V30\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Use a safe virtual fault fixture and an incomplete physical proposal. Missing limits or approval status block a ready-for-physical-execution label. The framework does not authorize laboratory operations.\",\"implementation_gap\":\"Implement gate, sourced limits and incomplete-proposal fixtures. Facility protections, safe numerical limits and authorization remain unresolved external inputs.\",\"boundary_authority_note\":\"Framework readiness is informational. Facility authorization and hazardous execution are outside core.\",\"procedure_performers\":[\"EPS Engineer\",\"Systems Engineer\",\"Testing Facility Technician\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-05\"],\"mission_need_ids\":[\"MN-07\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-04\"]}"; status = "proposed comparison description, not implemented or verified"; }
