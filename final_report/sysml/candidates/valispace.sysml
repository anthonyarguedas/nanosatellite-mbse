#intendedRealization allocation allocate_FR_37_VS_PC_REVIEW allocate FrameworkRequirements::FR_37 to physical.VS_PC_REVIEW;
@PhysicalRecord { identifier = "allocate_FR_37_VS_PC_REVIEW"; recordJSON = "{\"requirement_id\":\"FR-37\",\"title\":\"Readable design views\",\"logical_component_ids\":[\"L09\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-REVIEW\",\"VS-PC-CAPELLA\",\"VS-PC-WEB\",\"VS-PC-CASE\",\"VS-PC-CONTRACT\"],\"realization_mechanism\":\"Review projection filters native Capella context/structure/interface/selected-design views and Valispace tables/plots from one accepted manifest. Output carries element IDs, applicable units, legends and exact baseline links and is checked against represented native records.\",\"maturity\":[\"source_supported\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E02\",\"VS-E06\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"3.1 Data-Driven MBSE Methodology\",\"physical_pdf_pages\":[3],\"evidence_id\":\"VS-E02\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.2 Integration\",\"physical_pdf_pages\":[47,48,49,50,51],\"evidence_id\":\"VS-E02\"},{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[8],\"evidence_id\":\"VS-E06\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.1 DDSE-MBSE approach, Table 3.2\",\"physical_pdf_pages\":[46,47],\"evidence_id\":\"VS-E06\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.3 Python for Capella\",\"physical_pdf_pages\":[51,52],\"evidence_id\":\"VS-E06\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"Conclusions\",\"physical_pdf_pages\":[90,91],\"evidence_id\":\"VS-E06\"}],\"verification_id\":\"V37\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_acceptance\":\"Compare generated views with a fixture model and apply a declared reviewer task checklist. Assess correctness and readability without proliferating requirement, measure, scenario or state diagrams.\",\"implementation_gap\":\"Implement filtering/export provenance and reviewer readability task. Existing diagrams do not prove correct or readable generated packages.\",\"boundary_authority_note\":\"Views are derived projections. This allocation adds no new report diagrams and requires no native Valispace SysML support.\",\"procedure_performers\":[\"EPS Engineer\",\"Systems Engineer\",\"Independent reviewer or reproducer (a distinct task role)\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-06\",\"IF-01\"],\"mission_need_ids\":[\"MN-10\"],\"mission_requirement_ids\":[\"MR-10\"]}"; status = "proposed comparison description, not implemented or verified"; }
