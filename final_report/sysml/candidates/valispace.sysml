@PhysicalRecord { identifier = "allocate_FR_15_VS_PC_WEB"; recordJSON = "{\"requirement_id\":\"FR-15\",\"title\":\"Reusable EPS representation\",\"logical_component_ids\":[\"L03\"],\"candidate_node_ids\":[\"VS-LN-ARCH\"],\"physical_component_ids\":[\"VS-PC-EPS-TEMPLATE\",\"VS-PC-CAPELLA\",\"VS-PC-CASE\",\"VS-PC-WEB\",\"VS-PC-CONTRACT\"],\"realization_mechanism\":\"Instantiate a native generic Capella EPS model with functions, logical/physical elements, allocations, exchanges, modes/states and linked Valispace requirements. Case-binding records identify parameters, maps and explicit extensions relative to the frozen core.\",\"maturity\":[\"source_supported\",\"synthesized\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E02\",\"VS-E05\",\"VS-E06\"],\"source_locators\":[{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"3.1 Data-Driven MBSE Methodology\",\"physical_pdf_pages\":[3],\"evidence_id\":\"VS-E02\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.2 Integration\",\"physical_pdf_pages\":[47,48,49,50,51],\"evidence_id\":\"VS-E02\"},{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"4.3.2 Logical Architecture and 4.4 Subsystem Design and Trade-Offs\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.4 System Design, Figs. 4.25 through 4.27\",\"physical_pdf_pages\":[84,85,86],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.5 Subsystem Design, Fig. 4.29\",\"physical_pdf_pages\":[88],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[8],\"evidence_id\":\"VS-E06\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.1 DDSE-MBSE approach, Table 3.2\",\"physical_pdf_pages\":[46,47],\"evidence_id\":\"VS-E06\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.3 Python for Capella\",\"physical_pdf_pages\":[51,52],\"evidence_id\":\"VS-E06\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"Conclusions\",\"physical_pdf_pages\":[90,91],\"evidence_id\":\"VS-E06\"}],\"verification_id\":\"V15\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_acceptance\":\"Instantiate the representation in two contrasting cases and trace a requirement through function, allocation, interface and analysis. An extension retains its relation to the generic core.\",\"implementation_gap\":\"Build the reusable generic template and bindings. The source EPS physical design is only outlined and proves no two-case reuse.\",\"boundary_authority_note\":\"Capella remains the candidate architecture authoring center. No universal external-model constraint or additional SysML runtime is imposed.\",\"procedure_performers\":[\"EPS Engineer\",\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-01\"],\"mission_need_ids\":[\"MN-04\",\"MN-11\"],\"mission_requirement_ids\":