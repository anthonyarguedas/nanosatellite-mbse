#intendedRealization allocation allocate_FR_14_VS_PC_SCENARIO allocate FrameworkRequirements::FR_14 to physical.VS_PC_SCENARIO;
@PhysicalRecord { identifier = "allocate_FR_14_VS_PC_SCENARIO"; recordJSON = "{\"requirement_id\":\"FR-14\",\"title\":\"EPS candidate comparison\",\"logical_component_ids\":[\"L05\",\"L04\",\"L02\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-SCENARIO\",\"VS-PC-CHARACTERIZATION\",\"VS-PC-GOVERNANCE\",\"VS-PC-WEB\",\"VS-PC-CREDIBILITY\"],\"realization_mechanism\":\"Valispace trade/Analyses views compare EPS variants using a frozen requirement/scenario/criterion basis, sourced characterization, raw outcomes and model applicability. Comparison module keeps feasibility, unknown evidence and preference rationale separate.\",\"maturity\":[\"source_supported\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E05\",\"VS-E07\"],\"source_locators\":[{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"4.3.2 Logical Architecture and 4.4 Subsystem Design and Trade-Offs\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.4 System Design, Figs. 4.25 through 4.27\",\"physical_pdf_pages\":[84,85,86],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.5 Subsystem Design, Fig. 4.29\",\"physical_pdf_pages\":[88],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.1 Systems Engineering\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E07\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E07\"}],\"verification_id\":\"V14\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Compare candidates with a failing requirement and incomplete evidence. Keep feasibility and unknown status separate from ranking. Any preference weights are declared before results.\",\"implementation_gap\":\"Implement the common-basis manifest and failing/incomplete candidate fixtures. No preference weights or winner are defined here.\",\"boundary_authority_note\":\"This is comparison of engineered EPS options. It does not select the framework PA or certify feasible hardware.\",\"procedure_performers\":[\"EPS Engineer\",\"Systems Engineer\",\"Project Manager\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-03\"],\"mission_need_ids\":[\"MN-03\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-03\",\"MR-04\"]}"; status = "proposed comparison description, not implemented or verified"; }
