#intendedRealization allocation allocate_FR_24_VS_PC_SCENARIO allocate FrameworkRequirements::FR_24 to physical.VS_PC_SCENARIO;
@PhysicalRecord { identifier = "allocate_FR_24_VS_PC_SCENARIO"; recordJSON = "{\"requirement_id\":\"FR-24\",\"title\":\"Controller policy assessment\",\"logical_component_ids\":[\"L05\",\"L06\",\"L07\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-SCENARIO\",\"VS-PC-EPS-ENGINE\",\"VS-PC-CREDIBILITY\",\"VS-PC-VERIFICATION\",\"VS-PC-MODELS\"],\"realization_mechanism\":\"Policy comparison harness executes baseline/changed charging or power-management policy artifacts against the same load/thermal/health/electrical/timing fixtures. It retains safety-constraint comparisons, outcome definitions and separate predicted versus SIL/HIL/hardware evidence labels.\",\"maturity\":[\"proposed\",\"transferable\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E08\"],\"source_locators\":[{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.4 Electrical and Power System, Figs. 3 and 4\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E08\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"5 Discussion and 6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E08\"}],\"verification_id\":\"V24\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Replay a baseline and a changed policy against the same fixture conditions. A model prediction cannot be labeled a demonstrated hardware improvement. Retain pending SIL, HIL or hardware evidence.\",\"implementation_gap\":\"Implement policy artifacts, intended outcome definitions and credible comparison fixtures. Hardware benefit and controller safety remain unverified.\",\"boundary_authority_note\":\"Policy is an engineered artifact. Core comparison does not control physical charging or assert hardware improvement.\",\"procedure_performers\":[\"EPS Engineer\",\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-03\",\"IF-05\"],\"mission_need_ids\":[\"MN-05\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-04\"]}"; status = "proposed comparison description, not implemented or verified"; }
