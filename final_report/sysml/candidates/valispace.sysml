@PhysicalRecord { identifier = "allocate_FR_20_VS_PC_EPS_ENGINE"; recordJSON = "{\"requirement_id\":\"FR-20\",\"title\":\"Battery model coupling\",\"logical_component_ids\":[\"L05\",\"L06\",\"L04\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-EPS-ENGINE\",\"VS-PC-SCENARIO\",\"VS-PC-MODELS\",\"VS-PC-CREDIBILITY\",\"VS-PC-CHARACTERIZATION\"],\"realization_mechanism\":\"Battery profile binds identified electrical, thermal and selected degradation submodels to mission load/temperature histories. Model package declares SOC/SOH/lifetime meanings, latent-state uncertainty, initial health, coupling settings and omitted aging mechanisms.\",\"maturity\":[\"transferable\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E08\"],\"source_locators\":[{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.4 Electrical and Power System, Figs. 3 and 4\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E08\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"5 Discussion and 6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E08\"}],\"verification_id\":\"V20\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,D\",\"proposed_acceptance\":\"Replay fresh and aged battery fixtures under different load and temperature profiles. Verify coupling and provenance. Missing aging mechanisms and latent-state uncertainty remain visible.\",\"implementation_gap\":\"Select/build calibrated battery submodels, aging couplings and fresh/aged fixtures. The separate reported EPS model does not prove degradation or latent-state credibility.\",\"boundary_authority_note\":\"SOC/SOH/lifetime are estimates with declared definitions and validity. No generic lifetime accuracy or validated CubeSat aging library is asserted.\",\"procedure_performers\":[\"EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-03\"],\"mission_need_ids\":[\"MN-05\"],\"mission_requirement_ids\":[\"MR-05\"]}"; status = "proposed comparison description, not implemented or verified"; }
