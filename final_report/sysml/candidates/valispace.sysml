@PhysicalRecord { identifier = "VS-PC-CHARACTERIZATION"; recordJSON = "{\"id\":\"VS-PC-CHARACTERIZATION\",\"name\":\"Component, BOM and cost property package\",\"kind\":\"persistent_data_and_procedure\",\"candidate_node_id\":\"VS-LN-ENG\",\"minimum_realization\":\"Valispace Components properties for occurrence quantity, part/variant/selection status, sourced power/thermal/RAM inputs and dated/currency/scoped quote records. BOM projection and budget formulas retain unknowns.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[\"VS-E01\",\"VS-E05\",\"VS-E07\"],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
