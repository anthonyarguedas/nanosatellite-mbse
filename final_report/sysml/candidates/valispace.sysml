@PhysicalRecord { identifier = "allocate_FR_25_VS_PC_CREDIBILITY"; recordJSON = "{\"requirement_id\":\"FR-25\",\"title\":\"Anomaly assessment\",\"logical_component_ids\":[\"L06\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-CREDIBILITY\",\"VS-PC-OBSERVATION\",\"VS-PC-MODELS\",\"VS-PC-EVIDENCE\"],\"realization_mechanism\":\"Expected-observed assessment aligns valid telemetry with modeled outputs and retains mode, active unit, validity, degradation and sensor uncertainty. Residual interpretation records alternative fault explanations and comparison with expert-labeled nominal/degraded/noisy/fault fixtures.\",\"maturity\":[\"proposed\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V25\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Use nominal, degrading, noisy and injected-fault fixtures. Retain residuals and diagnoses with TP, FP and FN against an expert reference. No pre-threshold detection capability is presumed.\",\"implementation_gap\":\"Implement residual/diagnostic rules and expert fixture labels. No validated pre-threshold anomaly detection or fault classifier is reported for PA-VS.\",\"boundary_authority_note\":\"A residual can be ambiguous. Model error, sensor error and aging remain alternatives to a component-fault hypothesis.\",\"procedure_performers\":[\"EPS Engineer\",\"Independent reviewer or reproducer (a distinct task role)\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-05\",\"IF-03\"],\"mission_need_ids\":[\"MN-05\",\"MN-04\"],\"mission_requirement_ids\":[\"MR-05\",\"MR-04\"]}"; status = "proposed comparison description, not implemented or verified"; }
