@PhysicalRecord { identifier = "allocate_FR_27_VS_PC_CONTRACT"; recordJSON = "{\"requirement_id\":\"FR-27\",\"title\":\"RAM model generation\",\"logical_component_ids\":[\"L04\",\"L05\",\"L08\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ANALYSIS\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-RAM\",\"VS-PC-CAPELLA\",\"VS-PC-CHARACTERIZATION\",\"VS-PC-CONTRACT\",\"VS-PC-MODELS\"],\"realization_mechanism\":\"Capella-to-FMEA transformation applies declared rules to accepted function/component IDs and explicit failure-effect/dependency relations. It joins sourced or missing rates/recovery assumptions from Valispace, emits versioned FMEA rows and records rule/source revisions.\",\"maturity\":[\"proposed\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V27\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Generate an FMEA, fault tree or other justified representation for a reference design and its changed variant. Compare entities and dependencies with an expert model. Missing probabilities cannot become factual reliability estimates.\",\"implementation_gap\":\"Implement transformation, failure dependency inputs and expert comparison fixtures. Capella hierarchy alone is insufficient failure causality.\",\"boundary_authority_note\":\"A generated FMEA is the declared minimum RAM representation. Missing probabilities remain unknown and never become reliability estimates.\",\"procedure_performers\":[\"EPS Engineer\",\"Systems Engineer\",\"Independent reviewer or reproducer (a distinct task role)\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-02\",\"IF-03\"],\"mission_need_ids\":[\"MN-06\"],\"mission_requirement_ids\":[\"MR-06\"]}"; status = "proposed comparison description, not implemented or verified"; }
