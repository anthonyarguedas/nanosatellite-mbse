@PhysicalRecord { identifier = "allocate_FR_29_VS_PC_VERIFICATION"; recordJSON = "{\"requirement_id\":\"FR-29\",\"title\":\"Facility proposal\",\"logical_component_ids\":[\"L07\",\"L09\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-VERIFICATION\",\"VS-PC-REVIEW\",\"VS-PC-ARCHIVE\",\"VS-PC-PROCEDURES\"],\"realization_mechanism\":\"Technician exporter renders a baseline-linked procedure with conditions, equipment/fixture/DUT identities and connection table, stimulus sequence, observations, capture steps and diagnostic variables. Feedback importer retains feasibility questions and dispositions.\",\"maturity\":[\"source_supported\",\"transferable\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E09\",\"VS-E10\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"2 Requirements management in small space enterprises: problems and needs\",\"physical_pdf_pages\":[4,5],\"evidence_id\":\"VS-E09\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"3 Software for requirement management: overview and proposal, Table 1\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E09\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"4.2 Software toolchain, 4.3 Implementation: processes chain and 4.4 Implementation