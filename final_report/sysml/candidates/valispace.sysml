@PhysicalRecord { identifier = "allocate_FR_26_VS_PC_GOVERNANCE"; recordJSON = "{\"requirement_id\":\"FR-26\",\"title\":\"RAM requirement coverage\",\"logical_component_ids\":[\"L02\",\"L04\",\"L07\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\",\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-GOVERNANCE\",\"VS-PC-RAM\",\"VS-PC-CHARACTERIZATION\",\"VS-PC-VERIFICATION\"],\"realization_mechanism\":\"RAM coverage table links mission-declared RAM variables/failure assumptions to Valispace requirements and method-specific evidence needs. Named coverage checker reports included/excluded variables, analysis/inspection/demonstration/test rationale and gaps.\",\"maturity\":[\"proposed\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V26\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Compare the declared RAM variable and requirement set with a reference. Report analysis, inspection, demonstration or test rationale without forcing every claim to use analysis.\",\"implementation_gap\":\"Define the RAM-variable schema, sources and expert coverage fixture. No achieved spacecraft RAM is inferred from framework records.\",\"boundary_authority_note\":\"L02 owns requirement meaning. L04 owns sourced failure/repair inputs. L07 records method rationale without forcing analysis for every claim.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-02\"],\"mission_need_ids\":[\"MN-06\",\"MN-01\"],\"mission_requirement_ids\":[\"MR-06\",\"MR-01\"]}"; status = "proposed comparison description, not implemented or verified"; }
