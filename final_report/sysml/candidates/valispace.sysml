#intendedRealization allocation allocate_FR_28_VS_PC_VERIFICATION allocate FrameworkRequirements::FR_28 to physical.VS_PC_VERIFICATION;
@PhysicalRecord { identifier = "allocate_FR_28_VS_PC_VERIFICATION"; recordJSON = "{\"requirement_id\":\"FR-28\",\"title\":\"Verification activity record\",\"logical_component_ids\":[\"L07\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-VERIFICATION\",\"VS-PC-WEB\",\"VS-PC-CASE\",\"VS-PC-EVIDENCE\"],\"realization_mechanism\":\"Tests-module activity templates retain subject/requirement, method, DUT baseline, quantities or applicable conditions, stimuli, expected response, criterion, diagnostic variables and status. Method-specific validation covers inspection/analysis/demonstration/test and retains failed gates.\",\"maturity\":[\"source_supported\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E09\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"2 Requirements management in small space enterprises: problems and needs\",\"physical_pdf_pages\":[4,5],\"evidence_id\":\"VS-E09\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"3 Software for requirement management: overview and proposal, Table 1\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E09\"}],\"verification_id\":\"V28\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,T\",\"proposed_acceptance\":\"Inspect quantitative analysis/test and qualitative inspection/demonstration fixtures against their method-specific fields. Check the applicable quantity or observable condition, criterion, expected response and evidence. An inapplicable field retains rationale. Missing mandatory fields, failed gates and unresolved criteria remain explicit and prevent an unsupported verdict.\",\"implementation_gap\":\"Implement full templates, method-specific fields and unresolved-value checks. Native procedures/tags alone are incomplete.\",\"boundary_authority_note\":\"EPS/component activity records are distinct from framework V01..V40 records and project assessment indicators.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-05\"],\"mission_need_ids\":[\"MN-07\",\"MN-01\"],\"mission_requirement_ids\":[\"MR-07\",\"MR-01\"]}"; status = "proposed comparison description, not implemented or verified"; }
