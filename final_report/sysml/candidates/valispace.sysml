#intendedRealization allocation allocate_FR_19_VS_PC_SCENARIO allocate FrameworkRequirements::FR_19 to physical.VS_PC_SCENARIO;
@PhysicalRecord { identifier = "allocate_FR_19_VS_PC_SCENARIO"; recordJSON = "{\"requirement_id\":\"FR-19\",\"title\":\"Early verification scenarios\",\"logical_component_ids\":[\"L05\",\"L07\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\"],\"physical_component_ids\":[\"VS-PC-SCENARIO\",\"VS-PC-EPS-ENGINE\",\"VS-PC-VERIFICATION\",\"VS-PC-MODELS\",\"VS-PC-EVIDENCE\"],\"realization_mechanism\":\"Virtual-test harness loads nominal, demand/supply/protection, rare-fault and controller timing/electrical fixture specifications. It executes supported model profiles, captures internal diagnostic outputs and compares expected response with declared criteria and unsupported-behavior status.\",\"maturity\":[\"transferable\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E08\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.4 Electrical and Power System, Figs. 3 and 4\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E08\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"5 Discussion and 6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E08\"}],\"verification_id\":\"V19\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"D,T\",\"proposed_acceptance\":\"Retain stimulus, conditions, expected response, outputs and status for nominal and failure fixtures. Unsupported behavior and physical validation needs are explicit, including COTS evidence gaps.\",\"implementation_gap\":\"Implement fixture models, controller constraints and capture/criterion checks. COTS evidence and later physical validation remain explicit gaps.\",\"boundary_authority_note\":\"Core executes virtual fixtures and coordinates declared services. Facility physical execution and hazardous fault injection are outside core.\",\"procedure_performers\":[\"EPS Engineer\",\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-03\",\"IF-05\"],\"mission_need_ids\":[\"MN-04\",\"MN-07\"],\"mission_requirement_ids\":[\"MR-04\",\"MR-07\"]}"; status = "proposed comparison description, not implemented or verified"; }
