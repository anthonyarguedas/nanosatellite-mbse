#intendedRealization allocation allocate_FR_07_VS_PC_ARCHIVE allocate FrameworkRequirements::FR_07 to physical.VS_PC_ARCHIVE;
@PhysicalRecord { identifier = "allocate_FR_07_VS_PC_ARCHIVE"; recordJSON = "{\"requirement_id\":\"FR-07\",\"title\":\"Controlled baselines\",\"logical_component_ids\":[\"L08\"],\"candidate_node_ids\":[\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-ARCHIVE\",\"VS-PC-CONTRACT\",\"VS-PC-BRIDGE\",\"VS-PC-PROCEDURES\"],\"realization_mechanism\":\"Baseline-release utility exports exact Valispace records and Capella/model/dictionary/source files with content hashes, native IDs, dependency revisions and a history manifest. Storage procedure prevents overwrite of earlier released packages and tests retrieval.\",\"maturity\":[\"proposed\"],\"evidence_status\":\"Proposed realization with no direct PA-VS demonstration in the four checked sources.\",\"evidence_ids\":[],\"source_locators\":[],\"verification_id\":\"V07\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"T\",\"proposed_acceptance\":\"Reconstruct two revisions after a change and compare their manifests and contents. Attempted overwrite cannot erase the retained prior baseline.\",\"implementation_gap\":\"Implement release/export completeness, retention, permissions and tested recovery. Current vendor database state is insufficient historical custody.\",\"boundary_authority_note\":\"The framework owns accepted baseline custody even when its storage is a managed service.\",\"procedure_performers\":[\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\",\"VS-HOST-VALI\"],\"storage_host_ids\":[\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-06\"],\"mission_need_ids\":[\"MN-02\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
