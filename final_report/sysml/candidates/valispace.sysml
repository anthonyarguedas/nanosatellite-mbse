#intendedRealization allocation allocate_FR_38_VS_PC_REVIEW allocate FrameworkRequirements::FR_38 to physical.VS_PC_REVIEW;
@PhysicalRecord { identifier = "allocate_FR_38_VS_PC_REVIEW"; recordJSON = "{\"requirement_id\":\"FR-38\",\"title\":\"Review package\",\"logical_component_ids\":[\"L09\",\"L02\",\"L08\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-REVIEW\",\"VS-PC-GOVERNANCE\",\"VS-PC-ARCHIVE\",\"VS-PC-EVIDENCE\",\"VS-PC-CONTRACT\"],\"realization_mechanism\":\"Review assembler resolves designated requirements/decisions/design/results and includes assumptions, uncertainty, validity limits, findings and dispositions. It freezes the package manifest and registers named reviewer feedback separately from author status and decision authorization.\",\"maturity\":[\"source_supported\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E07\",\"VS-E09\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.1 Systems Engineering\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E07\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E07\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"2 Requirements management in small space enterprises: problems and needs\",\"physical_pdf_pages\":[4,5],\"evidence_id\":\"VS-E09\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"3 Software for requirement management: overview and proposal, Table 1\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E09\"}],\"verification_id\":\"V38\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_acceptance\":\"An independent reviewer locates the designated claims and evidence and records findings and outcomes. Keep author status, reviewer outcome and approval authority distinct.\",\"implementation_gap\":\"Implement complete package resolution, accessible export and feedback custody. Dated export/access limitations need current checking.\",\"boundary_authority_note\":\"Package generation conveys no stakeholder approval. Reviewer outcome, author status and external approval authority remain distinct.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\",\"Independent reviewer or reproducer (a distinct task role)\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-06\"],\"mission_need_ids\":[\"MN-10\",\"MN-02\"],\"mission_requirement_ids\":[\"MR-10\",\"MR-02\"]}"; status = "proposed comparison description, not implemented or verified"; }
