@PhysicalRecord { identifier = "allocate_FR_22_VS_PC_CREDIBILITY"; recordJSON = "{\"requirement_id\":\"FR-22\",\"title\":\"Model update workflow\",\"logical_component_ids\":[\"L06\",\"L04\",\"L02\"],\"candidate_node_ids\":[\"VS-LN-ANALYSIS\",\"VS-LN-ENG\",\"VS-LN-ASSURANCE\"],\"physical_component_ids\":[\"VS-PC-CREDIBILITY\",\"VS-PC-OBSERVATION\",\"VS-PC-CHARACTERIZATION\",\"VS-PC-GOVERNANCE\",\"VS-PC-MODELS\"],\"realization_mechanism\":\"Calibration-fit function consumes quality-masked supplied observations under a declared objective/bounds. It retains prior/revised parameter sets, data quality and residuals in an update proposal. Impact checker flags affected analyses before owner acceptance and reanalysis.\",\"maturity\":[\"transferable\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E08\"],\"source_locators\":[{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"4.4 Electrical and Power System, Figs. 3 and 4\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E08\"},{\"source_id\":\"review-0793\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0793/review-report-0793.md\",\"section\":\"5 Discussion and 6 Conclusions\",\"physical_pdf_pages\":[9],\"evidence_id\":\"VS-E08\"}],\"verification_id\":\"V22\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Apply a measurement fixture, compare the declared calibration result with a reference, retain both parameter revisions, and flag analyses affected by drift or update.\",\"implementation_gap\":\"Implement fit method, reference fixtures, provenance and drift/update propagation. Neither online nor automatic overwrite is assumed.\",\"boundary_authority_note\":\"Measurements create a proposed model revision. EPS Engineer acceptance and Systems Engineer impact disposition preserve earlier parameters and results.\",\"procedure_performers\":[\"EPS Engineer\",\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-STORE\",\"VS-HOST-VALI\"],\"interface_family_ids\":[\"IF-05\",\"IF-03\"],\"mission_need_ids\":[\"MN-02\",\"MN-05\",\"MN-09\"],\"mission_requirement_ids\":[\"MR-02\",\"MR-05\",\"MR-09\"]}"; status = "proposed comparison description, not implemented or verified"; }
