@PhysicalRecord { identifier = "allocate_FR_03_VS_PC_GUIDANCE"; recordJSON = "{\"requirement_id\":\"FR-03\",\"title\":\"Method applicability\",\"logical_component_ids\":[\"L01\",\"L07\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-GUIDANCE\",\"VS-PC-VERIFICATION\",\"VS-PC-CASE\"],\"realization_mechanism\":\"Source-linked catalogue records derivation and verification methods, standard revision/locator, applicability, activity templates, tailoring decision, exclusions and limitations. Verification templates reference chosen entries.\",\"maturity\":[\"proposed\",\"transferable\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E09\",\"VS-E10\"],\"source_locators\":[{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"2 Requirements management in small space enterprises: problems and needs\",\"physical_pdf_pages\":[4,5],\"evidence_id\":\"VS-E09\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"3 Software for requirement management: overview and proposal, Table 1\",\"physical_pdf_pages\":[5,6],\"evidence_id\":\"VS-E09\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"4.2 Software toolchain, 4.3 Implementation: processes chain and 4.4 Implementation example\",\"physical_pdf_pages\":[8,9,10],\"evidence_id\":\"VS-E10\"},{\"source_id\":\"citation-0569\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-0569/citation-report-0569.md\",\"section\":\"6 Conclusion\",\"physical_pdf_pages\":[11],\"evidence_id\":\"VS-E10\"}],\"verification_id\":\"V03\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"I,D\",\"proposed_acceptance\":\"For subsystem and component fixtures retrieve the chosen method and its source, conditions, tailoring decision, and excluded alternatives. A catalogue entry does not assert standards compliance.\",\"implementation_gap\":\"Curate and review the catalogue. The cited performer process is transferable and is not an implemented PA-VS standards catalogue.\",\"boundary_authority_note\":\"Engineers select methods. A catalogue record conveys no standards compliance or universal mandatory method.\",\"procedure_performers\":[\"Systems Engineer\",\"EPS Engineer\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-02\"],\"mission_need_ids\":[\"MN-01\",\"MN-07\",\"MN-11\"],\"mission_requirement_ids\":[\"MR-01\",\"MR-07\",\"MR-11\"]}"; status = "proposed comparison description, not implemented or verified"; }
