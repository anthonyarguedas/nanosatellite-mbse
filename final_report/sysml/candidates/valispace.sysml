@PhysicalRecord { identifier = "allocate_FR_12_VS_PC_CHARACTERIZATION"; recordJSON = "{\"requirement_id\":\"FR-12\",\"title\":\"Candidate BOM\",\"logical_component_ids\":[\"L04\"],\"candidate_node_ids\":[\"VS-LN-ENG\",\"VS-LN-ANALYSIS\"],\"physical_component_ids\":[\"VS-PC-CHARACTERIZATION\",\"VS-PC-WEB\",\"VS-PC-CASE\",\"VS-PC-BRIDGE\"],\"realization_mechanism\":\"BOM projection joins selected Capella physical occurrences to Valispace component/part records, quantities, assembly/variant and selection status. Alternative assemblies have separate case IDs and released source revisions.\",\"maturity\":[\"source_supported\",\"synthesized\",\"proposed\"],\"evidence_status\":\"Cited evidence supports only the stated partial/native mechanism or transferable precedent. The complete allocation is proposed and unverified.\",\"evidence_ids\":[\"VS-E01\",\"VS-E03\",\"VS-E05\"],\"source_locators\":[{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"2.1 Valispace, Fig. 2.2\",\"physical_pdf_pages\":[34,35,36,37],\"evidence_id\":\"VS-E01\"},{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"4.3.2 Logical Architecture\",\"physical_pdf_pages\":[6,7],\"evidence_id\":\"VS-E03\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"3.3 Python for Capella and 3.4 Valispace Python API, named export/import/Components_bridge.py descriptions\",\"physical_pdf_pages\":[53,54,55,56],\"evidence_id\":\"VS-E03\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.4 System Design, Figs. 4.21 and 4.22\",\"physical_pdf_pages\":[79,80],\"evidence_id\":\"VS-E03\"},{\"source_id\":\"review-0356\",\"source_markdown\":\"SLR/SLR1/pdfs/review-reports/review-report-0356/review-report-0356.md\",\"section\":\"4.3.2 Logical Architecture and 4.4 Subsystem Design and Trade-Offs\",\"physical_pdf_pages\":[7],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.4 System Design, Figs. 4.25 through 4.27\",\"physical_pdf_pages\":[84,85,86],\"evidence_id\":\"VS-E05\"},{\"source_id\":\"citation-4690\",\"source_markdown\":\"SLR/SLR1/pdfs/citation-reports/citation-report-4690/citation-report-4690.md\",\"section\":\"4.5 Subsystem Design, Fig. 4.29\",\"physical_pdf_pages\":[88],\"evidence_id\":\"VS-E05\"}],\"verification_id\":\"V12\",\"verification_status\":\"planned, not executed\",\"verification_method\":\"A,T\",\"proposed_acceptance\":\"Compare two alternative assemblies and one component substitution with a reference BOM. Candidate alternatives remain distinct. Missing part data is reported.\",\"implementation_gap\":\"Implement occurrence-to-part mapping, variant selection and reference BOM tests. Missing part data stays explicit.\",\"boundary_authority_note\":\"Capella owns occurrence topology. Valispace owns part properties, quantities and selection records. A catalog definition is not an occurrence count.\",\"procedure_performers\":[\"EPS Engineer\",\"Systems Engineer\"],\"execution_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-ENG\"],\"storage_host_ids\":[\"VS-HOST-VALI\",\"VS-HOST-STORE\"],\"interface_family_ids\":[\"IF-01\",\"IF-02\"],\"mission_need_ids\":[\"MN-03\"],\"mission_requirement_ids\":[\"MR-03\"]}"; status = "proposed comparison description, not implemented or verified"; }
