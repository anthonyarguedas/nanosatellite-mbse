part <'VS-PC-WEB'> VS_PC_WEB : SoftwareResource;
@PhysicalRecord { identifier = "VS-PC-WEB"; recordJSON = "{\"id\":\"VS-PC-WEB\",\"name\":\"Valispace engineering service\",\"kind\":\"software_service\",\"contents\":[\"Browser interface\",\"Engineering database\",\"REST API\",\"Project module\",\"Components module\",\"Requirements module\",\"Analyses module\",\"Scripting module\",\"Tests module\"],\"maturity\":\"Reported features. Actual licensed instance and hosting contract unconfirmed.\",\"evidence\":[\"VS-E01\",\"VS-E07\",\"VS-E09\"]}"; status = "Reported features. Actual licensed instance and hosting contract unconfirmed."; }
part <'VS-PC-CAPELLA'> VS_PC_CAPELLA : SoftwareResource;
@PhysicalRecord { identifier = "VS-PC-CAPELLA"; recordJSON = "{\"id\":\"VS-PC-CAPELLA\",\"name\":\"Capella architecture environment\",\"kind\":\"software\",\"contents\":[\"Capella application\",\"Python for Capella\",\"Reported export scripts\",\"VPMS only when required by the case\"],\"maturity\":\"Reported native environment. Version compatibility and selected export scope require testing.\",\"execution_constraint\":\"Python for Capella executes inside Capella. A standalone headless bridge is not the reported implementation.\",\"evidence\":[\"VS-E02\",\"VS-E03\",\"VS-E04\",\"VS-E06\"]}"; status = "Reported native environment. Version compatibility and selected export scope require testing."; }
part <'VS-PC-BRIDGE'> VS_PC_BRIDGE : SoftwareResource;
@PhysicalRecord { identifier = "VS-PC-BRIDGE"; recordJSON = "{\"id\":\"VS-PC-BRIDGE\",\"name\":\"Controlled Python integration workflow\",\"kind\":\"software\",\"contents\":[\"Reported Excel import and product-tree comparison pattern\",\"Stable-ID map\",\"Unit/type checks\",\"Dry-run diff and authorized update\",\"Failure recovery and transaction log\"],\"maturity\":\"Reported import/comparison core with proposed assurance extensions.\",\"evidence\":[\"VS-E03\"]}"; status = "Reported import/comparison core with proposed assurance extensions."; }
part <'VS-PC-RUNNER'> VS_PC_RUNNER : SoftwareResource;
@PhysicalRecord { identifier = "VS-PC-RUNNER"; recordJSON = "{\"id\":\"VS-PC-RUNNER\",\"name\":\"Controlled analysis launcher and result importer\",\"kind\":\"software\",\"contents\":[\"Declared Python execution environment\",\"Budget and RAM calculations\",\"EPS/battery/controller backend contract\",\"Conditional CAD/electrical/thermal/EMC tool adapter\"],\"maturity\":\"Proposed controlled execution. API and scripting patterns are reported. An OpenModelica EPS example is an optional backend precedent.\",\"evidence\":[\"VS-E01\",\"VS-E07\",\"VS-E08\"],\"authority_note\":\"Launcher/importer only. Scenario, RAM, credibility, observation and verification semantics belong to their named modules.\"}"; status = "Proposed controlled execution. API and scripting patterns are reported. An OpenModelica EPS example is an optional backend precedent."; }
part <'VS-PC-FSW'> VS_PC_FSW : CompositeResource;
@PhysicalRecord { identifier = "VS-PC-FSW"; recordJSON = "{\"id\":\"VS-PC-FSW\",\"name\":\"Common flight/ground definition and assurance package\",\"kind\":\"software_and_data\",\"contents\":[\"Canonical command/telemetry/event/parameter dictionary\",\"Thin cFS mapping\",\"Thin F-Prime mapping\",\"Sequence checks\",\"Build/target/resource evidence collector\"],\"maturity\":\"Proposed throughout PA-VS. No full flight-software code generator is assumed.\",\"evidence\":[],\"named_submodules\":[\"Canonical service dictionary and hardware/functional/ground binding table\",\"cFS message ID, encoding, pub-sub and software-bus profile adapter\",\"F-Prime typed-port, command, telemetry, event and parameter profile adapter\",\"Guard/effect/order/rejection/timeout/recovery sequence checker\",\"Target build/resource evidence importer and mission-allocation comparator\"],\"authority_note\":\"Detailed service fields are authored once here. Capella owns topology and allocation. VS-PC-CONTRACT references this dictionary revision rather than reauthoring its fields.\"}"; status = "Proposed throughout PA-VS. No full flight-software code generator is assumed."; }
part <'VS-PC-ARCHIVE'> VS_PC_ARCHIVE : CompositeResource;
@PhysicalRecord { identifier = "VS-PC-ARCHIVE"; recordJSON = "{\"id\":\"VS-PC-ARCHIVE\",\"name\":\"Controlled artifact store and export/import utility\",\"kind\":\"software_and_data\",\"contents\":[\"Composite baseline exports\",\"Content hashes and revision records\",\"Source and dependency packages\",\"Raw outputs\",\"Review/technician packages\"],\"maturity\":\"Proposed. May use existing managed storage without a new dedicated server.\",\"evidence\":[]}"; status = "Proposed. May use existing managed storage without a new dedicated server."; }
item <'VS-PC-CASE'> VS_PC_CASE : DataResource;
@PhysicalRecord { identifier = "VS-PC-CASE"; recordJSON = "{\"id\":\"VS-PC-CASE\",\"name\":\"Case engineering records\",\"kind\":\"persistent_data\",\"contents\":[\"Native Capella EPS architecture\",\"Valispace requirements and criteria references\",\"Component alternatives and BOM quantities\",\"Sourced costs and budget formulas\",\"Procedure and finding records\",\"Separate framework/EPS namespaces\"],\"maturity\":\"Reported record types with proposed case conventions.\",\"evidence\":[\"VS-E01\",\"VS-E05\",\"VS-E07\"]}"; status = "Reported record types with proposed case conventions."; }
item <'VS-PC-CONTRACT'> VS_PC_CONTRACT : DataResource;
@PhysicalRecord { identifier = "VS-PC-CONTRACT"; recordJSON = "{\"id\":\"VS-PC-CONTRACT\",\"name\":\"Exchange and baseline contracts\",\"kind\":\"persistent_data\",\"contents\":[\"Native and canonical ID map\",\"Unit/type/time/activation schema\",\"Dictionary revision\",\"Semantic field ownership\",\"Adapter revisions\",\"Baseline manifest\"],\"maturity\":\"Proposed.\",\"evidence\":[],\"authority_note\":\"Owns common IDs, schemas, units/time/sign conventions, identity mappings and accepted baseline manifest. Domain field definitions retain one owner.\"}"; status = "Proposed."; }
item <'VS-PC-MODELS'> VS_PC_MODELS : DataResource;
@PhysicalRecord { identifier = "VS-PC-MODELS"; recordJSON = "{\"id\":\"VS-PC-MODELS\",\"name\":\"Analysis and credibility packages\",\"kind\":\"persistent_data\",\"contents\":[\"Analysis source and dependencies\",\"Load/generation profiles and mode scenarios\",\"Selected electrical/thermal/battery aging models\",\"State-of-charge/health observability and remaining-life limits\",\"Load/temperature/depth-of-discharge calibration coverage\",\"Controller policy and implementation configuration\",\"Calibration data and parameter provenance\",\"Validity envelopes, sensor/model uncertainty and residual interpretation\",\"Conditional sampling/computation/output timing budget\",\"RAM assumptions\"],\"maturity\":\"Proposed project-specific contents. No validated generic model is asserted.\",\"evidence\":[\"VS-E08\"]}"; status = "Proposed project-specific contents. No validated generic model is asserted."; }
item <'VS-PC-EVIDENCE'> VS_PC_EVIDENCE : DataResource;
@PhysicalRecord { identifier = "VS-PC-EVIDENCE"; recordJSON = "{\"id\":\"VS-PC-EVIDENCE\",\"name\":\"Released evidence records\",\"kind\":\"persistent_data\",\"contents\":[\"Raw results and synchronized telemetry\",\"Equipment/calibration metadata\",\"Case/baseline/source/software/input identifiers\",\"Discrepancy reports\",\"Verdict rationale\",\"Failed-gate diagnostic data\",\"Finding dispositions\"],\"maturity\":\"Proposed complete package over reported test/report mechanisms.\",\"evidence\":[\"VS-E01\",\"VS-E07\"]}"; status = "Proposed complete package over reported test/report mechanisms."; }
action <'VS-PC-PROCEDURES'> VS_PC_PROCEDURES : OperatingProcedure;
@PhysicalRecord { identifier = "VS-PC-PROCEDURES"; recordJSON = "{\"id\":\"VS-PC-PROCEDURES\",\"name\":\"Framework operating procedures\",\"kind\":\"procedure\",\"contents\":[\"Requirement and criteria guidance\",\"BOM and sourced-cost update\",\"Baseline/change authorization\",\"RAM and model credibility review\",\"Safe verification release\",\"Technician handoff and feedback\",\"Independent reconstruction\",\"Readable review and adoption observation\"],\"maturity\":\"Proposed candidate procedures using reported process patterns.\",\"evidence\":[\"VS-E09\",\"VS-E10\"]}"; status = "Proposed candidate procedures using reported process patterns."; }
part <'VS-PC-HOSTS'> VS_PC_HOSTS : HostResource;
@PhysicalRecord { identifier = "VS-PC-HOSTS"; recordJSON = "{\"id\":\"VS-PC-HOSTS\",\"name\":\"Existing engineering compute, network and storage\",\"kind\":\"hardware_or_service\",\"contents\":[\"Browser/Capella/Python-capable computers\",\"Network connectivity\",\"Managed storage and declared backup arrangements\",\"Unspecified Valispace service infrastructure\"],\"maturity\":\"Proposed deployment assumption. No required GPU, real-time target, hardware purchase or EPS replica.\",\"evidence\":[\"VS-E01\",\"VS-E06\"]}"; status = "Proposed deployment assumption. No required GPU, real-time target, hardware purchase or EPS replica."; }
part <'VS-PC-GUIDANCE'> VS_PC_GUIDANCE : CompositeResource { action procedure : OperatingProcedure; }
@PhysicalRecord { identifier = "VS-PC-GUIDANCE"; recordJSON = "{\"id\":\"VS-PC-GUIDANCE\",\"name\":\"Guidance and method catalogue\",\"kind\":\"persistent_data_and_procedure\",\"candidate_node_id\":\"VS-LN-ENG\",\"minimum_realization\":\"Valispace Analyses pages and source-linked template records for qualitative/demonstration and quantitative requirements, criteria, method applicability, tailoring and worked EPS examples.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[\"VS-E01\",\"VS-E09\"],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
part <'VS-PC-GOVERNANCE'> VS_PC_GOVERNANCE : CompositeResource;
@PhysicalRecord { identifier = "VS-PC-GOVERNANCE"; recordJSON = "{\"id\":\"VS-PC-GOVERNANCE\",\"name\":\"Valispace governance schema and trace-impact extension\",\"kind\":\"software_and_data\",\"candidate_node_id\":\"VS-LN-ENG\",\"minimum_realization\":\"Requirement/decision/change/finding field schemas in Valispace plus a bridge-side typed relation index generated from exact accepted revisions. Named trace-query, impact-closure, stale-evidence and claim-status checks. Human disposition procedure.\",\"maturity\":\"Proposed named realization. Source mechanisms, where cited, are partial or transferable only.\",\"evidence\":[\"VS-E01\",\"VS-E03\",\"VS-E04\"],\"new_in_allocation_turn\":true}"; status = "Proposed named realization. Source mechanisms, where cited, are partial or transferable only."; }
