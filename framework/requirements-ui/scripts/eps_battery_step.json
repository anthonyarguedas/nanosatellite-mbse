{
  "id": "eps_battery_step",
  "name": "EPS battery equivalent-circuit step",
  "description": "Constant current positive INTO battery, charge SOC Q/Qmax, supplied linear OCV and R0 + one R1C1 polarization branch. Exact analytical state, voltage extrema, terminal and resistor-loss integrals; at most two bounded zero-crossing solves. No SOC clipping, chemistry, aging or energy-SOC identification. Unknown optional voltage/SOC limits return null findings. See analyses/PATHS.md.",
  "timeoutMs": 3000,
  "inputs": [
    { "name": "capacity_C", "type": "float", "unit": "C" },
    { "name": "initial_soc", "type": "float" },
    { "name": "current_A", "type": "float", "unit": "A" },
    { "name": "ocv_at_zero_V", "type": "float", "unit": "V" },
    { "name": "ocv_slope_V", "type": "float", "unit": "V" },
    { "name": "r0_ohm", "type": "float", "unit": "ohm" },
    { "name": "r1_ohm", "type": "float", "unit": "ohm" },
    { "name": "c1_F", "type": "float", "unit": "F" },
    { "name": "initial_polarization_V", "type": "float", "unit": "V" },
    { "name": "duration_s", "type": "float", "unit": "s" },
    { "name": "voltage_limits_known", "type": "boolean" },
    { "name": "voltage_min_V", "type": "float", "unit": "V" },
    { "name": "voltage_max_V", "type": "float", "unit": "V" },
    { "name": "soc_limits_known", "type": "boolean" },
    { "name": "soc_min", "type": "float" },
    { "name": "soc_max", "type": "float" }
  ],
  "outputs": [
    { "name": "end_voltage_V", "type": "float", "unit": "V" },
    { "name": "min_voltage_V", "type": "float", "unit": "V" },
    { "name": "max_voltage_V", "type": "float", "unit": "V" },
    { "name": "end_soc", "type": "float" },
    { "name": "min_soc", "type": "float" },
    { "name": "max_soc", "type": "float" },
    { "name": "end_polarization_V", "type": "float", "unit": "V" },
    { "name": "charge_change_C", "type": "float", "unit": "C" },
    { "name": "terminal_energy_J", "type": "float", "unit": "J" },
    { "name": "accepted_energy_J", "type": "float", "unit": "J" },
    { "name": "delivered_energy_J", "type": "float", "unit": "J" },
    { "name": "ohmic_loss_J", "type": "float", "unit": "J" },
    { "name": "polarization_loss_J", "type": "float", "unit": "J" },
    { "name": "total_loss_J", "type": "float", "unit": "J" },
    { "name": "min_loss_W", "type": "float", "unit": "W" },
    { "name": "max_loss_W", "type": "float", "unit": "W" },
    { "name": "avg_loss_W", "type": "float", "unit": "W" },
    { "name": "voltage_low_margin_V", "type": "float", "unit": "V" },
    { "name": "voltage_high_margin_V", "type": "float", "unit": "V" },
    { "name": "soc_low_margin", "type": "float" },
    { "name": "soc_high_margin", "type": "float" },
    { "name": "voltage_ok", "type": "boolean" },
    { "name": "soc_ok", "type": "boolean" },
    { "name": "physical_soc_ok", "type": "boolean" },
    { "name": "step_ok", "type": "boolean" },
    { "name": "polarization_energy_change_J", "type": "float", "unit": "J" },
    { "name": "ocv_end_V", "type": "float", "unit": "V" }
  ]
}
