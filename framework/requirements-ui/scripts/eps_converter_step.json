{
  "id": "eps_converter_step",
  "name": "EPS first-order converter response",
  "description": "Exact declared first-order closed-loop voltage step with supplied target and time constant. Reports voltage bounds, startup and settling time, constant-current load energy and fixed-efficiency losses. No switching, current limiting, overshoot, reactive energy or stability model. Use the power-path assessment for converter source, topology and rating compatibility.",
  "inputs": [
    { "name": "duration_s", "type": "float", "unit": "s" },
    { "name": "initial_voltage_V", "type": "float", "unit": "V" },
    { "name": "target_voltage_V", "type": "float", "unit": "V" },
    { "name": "time_constant_s", "type": "float", "unit": "s" },
    { "name": "load_current_A", "type": "float", "unit": "A" },
    { "name": "conversion_efficiency", "type": "float" },
    { "name": "input_voltage_V", "type": "float", "unit": "V" },
    { "name": "required_min_V", "type": "float", "unit": "V" },
    { "name": "required_max_V", "type": "float", "unit": "V" },
    { "name": "regulation_tolerance_V", "type": "float", "unit": "V" }
  ],
  "outputs": [
    { "name": "voltage_end_V", "type": "float", "unit": "V" },
    { "name": "voltage_min_V", "type": "float", "unit": "V" },
    { "name": "voltage_max_V", "type": "float", "unit": "V" },
    { "name": "output_energy_J", "type": "float", "unit": "J" },
    { "name": "input_energy_J", "type": "float", "unit": "J" },
    { "name": "loss_energy_J", "type": "float", "unit": "J" },
    { "name": "peak_input_current_A", "type": "float", "unit": "A" },
    { "name": "settling_time_s", "type": "float", "unit": "s" },
    { "name": "settled", "type": "boolean" },
    { "name": "startup_time_s", "type": "float", "unit": "s" },
    { "name": "startup_reached", "type": "boolean" },
    { "name": "service_at_end", "type": "boolean" },
    { "name": "service_duration_s", "type": "float", "unit": "s" },
    { "name": "voltage_limits_ok", "type": "boolean" }
  ]
}
