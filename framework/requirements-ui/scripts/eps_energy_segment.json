{
  "id": "eps_energy_segment",
  "name": "EPS chronological energy segment",
  "description": "Exact constant-condition energy and independent coulomb balances for one scheduled interval. Chain ending energy and SOC into the next interval. Reports shortages, reserves, path losses, charging limits and surplus. Supply compatible retained capacities, efficiencies and battery terminal voltage. No voltage dynamics or automatic schedule inference.",
  "inputs": [
    { "name": "duration_s", "type": "float", "unit": "s" },
    { "name": "source_power_W", "type": "float", "unit": "W" },
    { "name": "source_efficiency", "type": "float" },
    { "name": "load_power_W", "type": "float", "unit": "W" },
    { "name": "load_efficiency", "type": "float" },
    { "name": "battery_voltage_V", "type": "float", "unit": "V" },
    { "name": "energy_capacity_J", "type": "float", "unit": "J" },
    { "name": "charge_capacity_C", "type": "float", "unit": "C" },
    { "name": "energy_initial_J", "type": "float", "unit": "J" },
    { "name": "soc_initial", "type": "float" },
    { "name": "energy_reserve_J", "type": "float", "unit": "J" },
    { "name": "soc_min", "type": "float" },
    { "name": "charge_efficiency", "type": "float" },
    { "name": "discharge_efficiency", "type": "float" },
    { "name": "coulomb_charge_efficiency", "type": "float" },
    { "name": "coulomb_discharge_efficiency", "type": "float" },
    { "name": "charge_current_limit_A", "type": "float", "unit": "A" },
    { "name": "discharge_current_limit_A", "type": "float", "unit": "A" },
    { "name": "charge_allowed", "type": "boolean" },
    { "name": "temperature_C", "type": "float", "unit": "degC" },
    { "name": "charge_temp_min_C", "type": "float", "unit": "degC" },
    { "name": "charge_temp_max_C", "type": "float", "unit": "degC" },
    { "name": "discharge_temp_min_C", "type": "float", "unit": "degC" },
    { "name": "discharge_temp_max_C", "type": "float", "unit": "degC" },
    { "name": "surplus_capacity_W", "type": "float", "unit": "W" },
    { "name": "shunt_surplus", "type": "boolean" }
  ],
  "outputs": [
    { "name": "energy_end_J", "type": "float", "unit": "J" },
    { "name": "soc_end", "type": "float" },
    { "name": "energy_min_J", "type": "float", "unit": "J" },
    { "name": "soc_minimum", "type": "float" },
    { "name": "source_energy_J", "type": "float", "unit": "J" },
    { "name": "load_energy_J", "type": "float", "unit": "J" },
    { "name": "served_energy_J", "type": "float", "unit": "J" },
    { "name": "unserved_energy_J", "type": "float", "unit": "J" },
    { "name": "service_duration_s", "type": "float", "unit": "s" },
    { "name": "accepted_charge_energy_J", "type": "float", "unit": "J" },
    { "name": "discharge_energy_J", "type": "float", "unit": "J" },
    { "name": "stored_energy_J", "type": "float", "unit": "J" },
    { "name": "removed_energy_J", "type": "float", "unit": "J" },
    { "name": "surplus_energy_J", "type": "float", "unit": "J" },
    { "name": "peak_surplus_W", "type": "float", "unit": "W" },
    { "name": "loss_energy_J", "type": "float", "unit": "J" },
    { "name": "shunt_energy_J", "type": "float", "unit": "J" },
    { "name": "curtailed_energy_J", "type": "float", "unit": "J" },
    { "name": "peak_charge_current_A", "type": "float", "unit": "A" },
    { "name": "peak_discharge_current_A", "type": "float", "unit": "A" },
    { "name": "energy_reserve_ok", "type": "boolean" },
    { "name": "soc_reserve_ok", "type": "boolean" },
    { "name": "charge_temperature_ok", "type": "boolean" },
    { "name": "discharge_temperature_ok", "type": "boolean" },
    { "name": "surplus_supported", "type": "boolean" }
  ]
}
