{
  "id": "eps_fit",
  "name": "EPS bounded parameter estimation",
  "description": "Quality-checked unweighted least squares on 3..5 masked scalar samples: local PV I-V, battery V=E-RI or first-order decay to a supplied asymptote. Explicit excitation and residual thresholds, raw parameters and empirical domain. Not general single-diode or electrochemical calibration. See analyses/MODELS.md for model-dependent units.",
  "inputs": [
    { "name": "model_kind", "type": "integer" },
    { "name": "sample_count", "type": "integer" },
    { "name": "valid_mask", "type": "integer" },
    { "name": "asymptote", "type": "float" },
    { "name": "rmse_limit", "type": "float" },
    { "name": "max_error_limit", "type": "float" },
    { "name": "min_x_span", "type": "float" },
    { "name": "x1", "type": "float" },
    { "name": "y1", "type": "float" },
    { "name": "x2", "type": "float" },
    { "name": "y2", "type": "float" },
    { "name": "x3", "type": "float" },
    { "name": "y3", "type": "float" },
    { "name": "x4", "type": "float" },
    { "name": "y4", "type": "float" },
    { "name": "x5", "type": "float" },
    { "name": "y5", "type": "float" }
  ],
  "outputs": [
    { "name": "fit_intercept", "type": "float" },
    { "name": "fit_slope", "type": "float" },
    { "name": "pv_intercept_A", "type": "float", "unit": "A" },
    { "name": "pv_slope_A_V", "type": "float", "unit": "A/V" },
    { "name": "battery_ocv_V", "type": "float", "unit": "V" },
    { "name": "battery_resistance_ohm", "type": "float", "unit": "ohm" },
    { "name": "exp_amplitude", "type": "float" },
    { "name": "time_constant_s", "type": "float", "unit": "s" },
    { "name": "residual_rmse", "type": "float" },
    { "name": "residual_max", "type": "float" },
    { "name": "transformed_rmse", "type": "float" },
    { "name": "r_squared", "type": "float" },
    { "name": "used_samples", "type": "integer" },
    { "name": "used_mask", "type": "integer" },
    { "name": "residual_dof", "type": "integer" },
    { "name": "domain_x_min", "type": "float" },
    { "name": "domain_x_max", "type": "float" },
    { "name": "domain_y_min", "type": "float" },
    { "name": "domain_y_max", "type": "float" },
    { "name": "fit_quality_ok", "type": "boolean" },
    { "name": "physical_model_ok", "type": "boolean" },
    { "name": "model_valid", "type": "boolean" }
  ],
  "timeoutMs": 3000
}
