{
  "id": "eps_geometry",
  "name": "EPS oriented box accommodation",
  "description": "Transform one rectangular component envelope and one keep-out to an installation frame. Six containment margins and 15-axis SAT detect box intersection with an explicit touching/tolerance policy. Projection gap is not Euclidean clearance. Mounting and access are assessed only if represented by the declared envelopes. See analyses/MODELS.md.",
  "inputs": [
    { "name": "size_x_m", "type": "float", "unit": "m" },
    { "name": "size_y_m", "type": "float", "unit": "m" },
    { "name": "size_z_m", "type": "float", "unit": "m" },
    { "name": "center_x_m", "type": "float", "unit": "m" },
    { "name": "center_y_m", "type": "float", "unit": "m" },
    { "name": "center_z_m", "type": "float", "unit": "m" },
    { "name": "roll_deg", "type": "float", "unit": "deg" },
    { "name": "pitch_deg", "type": "float", "unit": "deg" },
    { "name": "yaw_deg", "type": "float", "unit": "deg" },
    { "name": "install_min_x_m", "type": "float", "unit": "m" },
    { "name": "install_min_y_m", "type": "float", "unit": "m" },
    { "name": "install_min_z_m", "type": "float", "unit": "m" },
    { "name": "install_max_x_m", "type": "float", "unit": "m" },
    { "name": "install_max_y_m", "type": "float", "unit": "m" },
    { "name": "install_max_z_m", "type": "float", "unit": "m" },
    { "name": "keep_size_x_m", "type": "float", "unit": "m" },
    { "name": "keep_size_y_m", "type": "float", "unit": "m" },
    { "name": "keep_size_z_m", "type": "float", "unit": "m" },
    { "name": "keep_center_x_m", "type": "float", "unit": "m" },
    { "name": "keep_center_y_m", "type": "float", "unit": "m" },
    { "name": "keep_center_z_m", "type": "float", "unit": "m" },
    { "name": "keep_roll_deg", "type": "float", "unit": "deg" },
    { "name": "keep_pitch_deg", "type": "float", "unit": "deg" },
    { "name": "keep_yaw_deg", "type": "float", "unit": "deg" },
    { "name": "touching_allowed", "type": "boolean" },
    { "name": "tolerance_m", "type": "float", "unit": "m" }
  ],
  "outputs": [
    { "name": "bound_min_x_m", "type": "float", "unit": "m" },
    { "name": "bound_min_y_m", "type": "float", "unit": "m" },
    { "name": "bound_min_z_m", "type": "float", "unit": "m" },
    { "name": "bound_max_x_m", "type": "float", "unit": "m" },
    { "name": "bound_max_y_m", "type": "float", "unit": "m" },
    { "name": "bound_max_z_m", "type": "float", "unit": "m" },
    { "name": "keep_bound_min_x_m", "type": "float", "unit": "m" },
    { "name": "keep_bound_min_y_m", "type": "float", "unit": "m" },
    { "name": "keep_bound_min_z_m", "type": "float", "unit": "m" },
    { "name": "keep_bound_max_x_m", "type": "float", "unit": "m" },
    { "name": "keep_bound_max_y_m", "type": "float", "unit": "m" },
    { "name": "keep_bound_max_z_m", "type": "float", "unit": "m" },
    { "name": "contain_low_x_m", "type": "float", "unit": "m" },
    { "name": "contain_low_y_m", "type": "float", "unit": "m" },
    { "name": "contain_low_z_m", "type": "float", "unit": "m" },
    { "name": "contain_high_x_m", "type": "float", "unit": "m" },
    { "name": "contain_high_y_m", "type": "float", "unit": "m" },
    { "name": "contain_high_z_m", "type": "float", "unit": "m" },
    { "name": "volume_m3", "type": "float", "unit": "m**3" },
    { "name": "containment_margin_m", "type": "float", "unit": "m" },
    { "name": "contained", "type": "boolean" },
    { "name": "keepout_gap_m", "type": "float", "unit": "m" },
    { "name": "keepout_clear", "type": "boolean" },
    { "name": "overlap", "type": "boolean" },
    { "name": "accommodation_ok", "type": "boolean" },
    { "name": "axes_tested", "type": "integer" }
  ],
  "timeoutMs": 3000
}
