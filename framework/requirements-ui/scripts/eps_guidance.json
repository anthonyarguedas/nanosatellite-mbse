{
  "id": "eps_guidance",
  "name": "EPS method and activity eligibility",
  "description": "Proposes a registered model, RAM methods and the next activity from an engineer-supplied structured objective and input inventory. Returns explicit unmet-prerequisite bits and repeat-analysis advice. Does not parse requirement prose, infer data quality, generate full FMEA records or approve decisions. Codes and rules are documented in analyses/REPORT-COVERAGE.md.",
  "inputs": [
    { "name": "goal_code", "type": "integer" },
    { "name": "activity_code", "type": "integer" },
    { "name": "component_count", "type": "integer" },
    { "name": "operating_case_count", "type": "integer" },
    { "name": "valid_sample_count", "type": "integer" },
    { "name": "failure_mode_count", "type": "integer" },
    { "name": "failure_dependency_count", "type": "integer" },
    { "name": "basic_event_count", "type": "integer" },
    { "name": "cut_term_count", "type": "integer" },
    { "name": "has_reference_limits", "type": "boolean" },
    { "name": "has_model_parameters", "type": "boolean" },
    { "name": "has_schedule", "type": "boolean" },
    { "name": "has_retained_capacities", "type": "boolean" },
    { "name": "has_geometry", "type": "boolean" },
    { "name": "has_failure_logic", "type": "boolean" },
    { "name": "has_failure_effects", "type": "boolean" },
    { "name": "has_failure_probabilities", "type": "boolean" },
    { "name": "has_independent_reference", "type": "boolean" },
    { "name": "results_available", "type": "boolean" },
    { "name": "results_current", "type": "boolean" },
    { "name": "validation_required", "type": "boolean" }
  ],
  "outputs": [
    { "name": "method_code", "type": "integer" },
    { "name": "unmet_prerequisite_mask", "type": "integer" },
    { "name": "unmet_prerequisite_count", "type": "integer" },
    { "name": "executable", "type": "boolean" },
    { "name": "recommended_activity_code", "type": "integer" },
    { "name": "repeat_analysis", "type": "boolean" },
    { "name": "independent_validation_recommended", "type": "boolean" },
    { "name": "independent_validation_ready", "type": "boolean" },
    { "name": "fmea_eligible", "type": "boolean" },
    { "name": "fmeca_eligible", "type": "boolean" },
    { "name": "fault_tree_eligible", "type": "boolean" },
    { "name": "quantitative_fault_tree_eligible", "type": "boolean" },
    { "name": "failure_propagation_eligible", "type": "boolean" }
  ]
}
