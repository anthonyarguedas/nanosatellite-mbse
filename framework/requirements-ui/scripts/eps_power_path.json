{
  "id": "eps_power_path",
  "name": "EPS declared rail and power path",
  "description": "One constant-current steady/pulse rail with upstream efficiency and path drops. Topology 0=buck, 1=boost, 2=buckboost magnitude; effective input is source minus supplied dropout. All ratings and startup time are supplied case-specific bounds. See analyses/PATHS.md; not a switching transient or arbitrary converter envelope.",
  "timeoutMs": 3000,
  "inputs": [
    { "name": "source_voltage_V", "type": "float", "unit": "V" },
    { "name": "rail_voltage_V", "type": "float", "unit": "V" },
    { "name": "efficiency", "type": "float" },
    { "name": "idle_power_W", "type": "float", "unit": "W" },
    { "name": "steady_current_A", "type": "float", "unit": "A" },
    { "name": "pulse_current_A", "type": "float", "unit": "A" },
    { "name": "pulse_replaces_steady", "type": "boolean" },
    { "name": "pulse_duration_s", "type": "float", "unit": "s" },
    { "name": "path_resistance_ohm", "type": "float", "unit": "ohm" },
    { "name": "diode_drop_V", "type": "float", "unit": "V" },
    { "name": "load_min_V", "type": "float", "unit": "V" },
    { "name": "load_max_V", "type": "float", "unit": "V" },
    { "name": "input_min_V", "type": "float", "unit": "V" },
    { "name": "input_max_V", "type": "float", "unit": "V" },
    { "name": "startup_min_V", "type": "float", "unit": "V" },
    { "name": "dropout_V", "type": "float", "unit": "V" },
    { "name": "topology_code", "type": "integer" },
    { "name": "duty_min", "type": "float" },
    { "name": "duty_max", "type": "float" },
    { "name": "battery_cont_A", "type": "float", "unit": "A" },
    { "name": "battery_pulse_A", "type": "float", "unit": "A" },
    { "name": "converter_in_cont_A", "type": "float", "unit": "A" },
    { "name": "converter_in_pulse_A", "type": "float", "unit": "A" },
    { "name": "converter_out_cont_A", "type": "float", "unit": "A" },
    { "name": "converter_out_pulse_A", "type": "float", "unit": "A" },
    { "name": "switch_cont_A", "type": "float", "unit": "A" },
    { "name": "switch_pulse_A", "type": "float", "unit": "A" },
    { "name": "pulse_rating_duration_s", "type": "float", "unit": "s" },
    { "name": "startup_time_s", "type": "float", "unit": "s" },
    { "name": "startup_limit_s", "type": "float", "unit": "s" },
    { "name": "connection_cont_A", "type": "float", "unit": "A" },
    { "name": "connection_pulse_A", "type": "float", "unit": "A" }
  ],
  "outputs": [
    { "name": "steady_input_W", "type": "float", "unit": "W" },
    { "name": "pulse_input_W", "type": "float", "unit": "W" },
    { "name": "steady_source_A", "type": "float", "unit": "A" },
    { "name": "pulse_source_A", "type": "float", "unit": "A" },
    { "name": "steady_rail_W", "type": "float", "unit": "W" },
    { "name": "pulse_rail_W", "type": "float", "unit": "W" },
    { "name": "steady_load_V", "type": "float", "unit": "V" },
    { "name": "pulse_load_V", "type": "float", "unit": "V" },
    { "name": "steady_terminal_W", "type": "float", "unit": "W" },
    { "name": "pulse_terminal_W", "type": "float", "unit": "W" },
    { "name": "steady_converter_loss_W", "type": "float", "unit": "W" },
    { "name": "pulse_converter_loss_W", "type": "float", "unit": "W" },
    { "name": "steady_path_loss_W", "type": "float", "unit": "W" },
    { "name": "pulse_path_loss_W", "type": "float", "unit": "W" },
    { "name": "duty_required", "type": "float" },
    { "name": "dropout_margin_V", "type": "float", "unit": "V" },
    { "name": "input_ok", "type": "boolean" },
    { "name": "startup_ok", "type": "boolean" },
    { "name": "envelope_ok", "type": "boolean" },
    { "name": "startup_time_ok", "type": "boolean" },
    { "name": "steady_voltage_ok", "type": "boolean" },
    { "name": "pulse_voltage_ok", "type": "boolean" },
    { "name": "battery_current_ok", "type": "boolean" },
    { "name": "converter_current_ok", "type": "boolean" },
    { "name": "switch_current_ok", "type": "boolean" },
    { "name": "connection_current_ok", "type": "boolean" },
    { "name": "pulse_duration_ok", "type": "boolean" },
    { "name": "path_ok", "type": "boolean" }
  ]
