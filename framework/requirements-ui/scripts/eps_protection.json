{
  "id": "eps_protection",
  "name": "EPS three-phase protection MIL",
  "description": "Initially unlatched nominal/fault/recovery scenario with inclusive UV/OV/OC trips, hysteretic automatic or latched reset, explicit logical commands/inhibits and processor-off policies. Prospective current remains sensed while off. At most 100000 steps; phase durations align to the step. See analyses/PATHS.md for exact timer conventions and evidence limits.",
  "timeoutMs": 3000,
  "inputs": [
    { "name": "nominal_voltage_V", "type": "float", "unit": "V" },
    { "name": "fault_voltage_V", "type": "float", "unit": "V" },
    { "name": "recovery_voltage_V", "type": "float", "unit": "V" },
    { "name": "legitimate_current_A", "type": "float", "unit": "A" },
    { "name": "fault_current_A", "type": "float", "unit": "A" },
    { "name": "recovery_current_A", "type": "float", "unit": "A" },
    { "name": "nominal_duration_s", "type": "float", "unit": "s" },
    { "name": "fault_duration_s", "type": "float", "unit": "s" },
    { "name": "recovery_duration_s", "type": "float", "unit": "s" },
    { "name": "step_s", "type": "float", "unit": "s" },
    { "name": "uv_trip_V", "type": "float", "unit": "V" },
    { "name": "uv_reset_V", "type": "float", "unit": "V" },
    { "name": "ov_trip_V", "type": "float", "unit": "V" },
    { "name": "ov_reset_V", "type": "float", "unit": "V" },
    { "name": "oc_trip_A", "type": "float", "unit": "A" },
    { "name": "oc_reset_A", "type": "float", "unit": "A" },
    { "name": "trip_delay_s", "type": "float", "unit": "s" },
    { "name": "reset_delay_s", "type": "float", "unit": "s" },
    { "name": "nominal_command_on", "type": "boolean" },
    { "name": "fault_command_on", "type": "boolean" },
    { "name": "recovery_command_on", "type": "boolean" },
    { "name": "nominal_inhibited", "type": "boolean" },
    { "name": "fault_inhibited", "type": "boolean" },
    { "name": "recovery_inhibited", "type": "boolean" },
    { "name": "processor_available", "type": "boolean" },
    { "name": "autonomous_protection", "type": "boolean" },
    { "name": "autonomous_inhibit", "type": "boolean" },
    { "name": "processor_off_output_on", "type": "boolean" },
    { "name": "auto_reset", "type": "boolean" },
    { "name": "i2t_limit_A2s", "type": "float", "unit": "A2 s" },
    { "name": "peak_limit_A", "type": "float", "unit": "A" },
    { "name": "interruption_limit_s", "type": "float", "unit": "s" }
  ],
  "outputs": [
    { "name": "transition_count", "type": "integer" },
    { "name": "trip_count", "type": "integer" },
    { "name": "reset_count", "type": "integer" },
    { "name": "nominal_trip_count", "type": "integer" },
    { "name": "first_trip_time_s", "type": "float", "unit": "s" },
    { "name": "first_reset_time_s", "type": "float", "unit": "s" },
    { "name": "fault_interruption_s", "type": "float", "unit": "s" },
    { "name": "recovery_time_s", "type": "float", "unit": "s" },
    { "name": "nominal_unserved_s", "type": "float", "unit": "s" },
    { "name": "recovery_unserved_s", "type": "float", "unit": "s" },
    { "name": "fault_i2t_A2s", "type": "float", "unit": "A2 s" },
    { "name": "fault_peak_A", "type": "float", "unit": "A" },
    { "name": "inhibited_on_s", "type": "float", "unit": "s" },
    { "name": "final_output_on", "type": "boolean" },
    { "name": "final_latched", "type": "boolean" },
    { "name": "fault_seen", "type": "boolean" },
    { "name": "fault_interrupted", "type": "boolean" },
    { "name": "fault_reenergized", "type": "boolean" },
    { "name": "nuisance_free", "type": "boolean" },
    { "name": "inhibited_outputs_off", "type": "boolean" },
    { "name": "stress_ok", "type": "boolean" },
    { "name": "interruption_ok", "type": "boolean" },
    { "name": "recovery_observed", "type": "boolean" },
    { "name": "protection_active", "type": "boolean" },
    { "name": "protection_ok", "type": "boolean" },
    { "name": "sample_count", "type": "integer" },
    { "name": "fault_output_on_s", "type": "float", "unit": "s" },
    { "name": "total_on_s", "type": "float", "unit": "s" }
  ]
}
