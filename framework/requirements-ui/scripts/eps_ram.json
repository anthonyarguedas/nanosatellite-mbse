{
  "id": "eps_ram",
  "name": "EPS four-event fault tree",
  "description": "Execute a declared monotone OR-of-AND fault tree over four independent basic events by exact 16-state enumeration. Removes redundant cuts; returns reliability, conditional probabilities and Birnbaum/criticality importance. Supply sourced probabilities or nonrepairable constant rates, event semantics and dependency/common-cause rationale. No automatic full FMEA. See analyses/MODELS.md.",
  "inputs": [
    { "name": "value_kind", "type": "integer" },
    { "name": "exposure_h", "type": "float", "unit": "h" },
    { "name": "independence_confirmed", "type": "boolean" },
    { "name": "common_cause_resolved", "type": "boolean" },
    { "name": "term_count", "type": "integer" },
    { "name": "term1", "type": "integer" },
    { "name": "term2", "type": "integer" },
    { "name": "term3", "type": "integer" },
    { "name": "term4", "type": "integer" },
    { "name": "event1_value", "type": "float" },
    { "name": "event2_value", "type": "float" },
    { "name": "event3_value", "type": "float" },
    { "name": "event4_value", "type": "float" },
    { "name": "conditional_failed_mask", "type": "integer" },
    { "name": "conditional_healthy_mask", "type": "integer" }
  ],
  "outputs": [
    { "name": "top_failure_probability", "type": "float" },
    { "name": "mission_reliability", "type": "float" },
    { "name": "conditional_failure_probability", "type": "float" },
    { "name": "evidence_probability", "type": "float" },
    { "name": "minimal_cut_count", "type": "integer" },
    { "name": "cut1_mask", "type": "integer" },
    { "name": "cut1_probability", "type": "float" },
    { "name": "cut2_mask", "type": "integer" },
    { "name": "cut2_probability", "type": "float" },
    { "name": "cut3_mask", "type": "integer" },
    { "name": "cut3_probability", "type": "float" },
    { "name": "cut4_mask", "type": "integer" },
    { "name": "cut4_probability", "type": "float" },
    { "name": "top_given_event1", "type": "float" },
    { "name": "top_given_event2", "type": "float" },
    { "name": "top_given_event3", "type": "float" },
    { "name": "top_given_event4", "type": "float" },
    { "name": "top_given_no_event1", "type": "float" },
    { "name": "top_given_no_event2", "type": "float" },
    { "name": "top_given_no_event3", "type": "float" },
    { "name": "top_given_no_event4", "type": "float" },
    { "name": "birnbaum1", "type": "float" },
    { "name": "birnbaum2", "type": "float" },
    { "name": "birnbaum3", "type": "float" },
    { "name": "birnbaum4", "type": "float" },
    { "name": "criticality1", "type": "float" },
    { "name": "criticality2", "type": "float" },
    { "name": "criticality3", "type": "float" },
    { "name": "criticality4", "type": "float" },
    { "name": "states_enumerated", "type": "integer" }
  ],
  "timeoutMs": 3000
}
