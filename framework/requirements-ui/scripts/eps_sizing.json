{
  "id": "eps_sizing",
  "name": "EPS cell assembly sizing",
  "description": "Preliminary identical-cell PV/battery sizing with fixed-product protection, BOL/EOL retained energy and charge, packing residuals and optional necessary voltage screens. No mission defaults; source power must represent the attained DET/MPPT point. Full interface feasibility remains unknown without further ratings. See analyses/MODELS.md.",
  "inputs": [
    { "name": "sun_energy_Wh", "type": "float", "unit": "Wh" },
    { "name": "eclipse_energy_Wh", "type": "float", "unit": "Wh" },
    { "name": "sunlight_s", "type": "float", "unit": "s" },
    { "name": "sun_path_eff", "type": "float" },
    { "name": "eclipse_path_eff", "type": "float" },
    { "name": "sizing_margin", "type": "float" },
    { "name": "depth_of_discharge", "type": "float" },
    { "name": "pv_cell_power_W", "type": "float", "unit": "W" },
    { "name": "pv_retained_factor", "type": "float" },
    { "name": "pv_operating_factor", "type": "float" },
    { "name": "pv_series", "type": "integer" },
    { "name": "pv_parallel", "type": "integer" },
    { "name": "pv_fixed", "type": "boolean" },
    { "name": "pv_cell_area_m2", "type": "float", "unit": "m**2" },
    { "name": "usable_face_area_m2", "type": "float", "unit": "m**2" },
    { "name": "packing_fraction", "type": "float" },
    { "name": "bat_cell_energy_Wh", "type": "float", "unit": "Wh" },
    { "name": "bat_cell_charge_Ah", "type": "float", "unit": "Ah" },
    { "name": "bat_series", "type": "integer" },
    { "name": "bat_parallel", "type": "integer" },
    { "name": "bat_fixed", "type": "boolean" },
    { "name": "energy_retained_factor", "type": "float" },
    { "name": "charge_retained_factor", "type": "float" },
    { "name": "required_retained_charge_Ah", "type": "float", "unit": "Ah" },
    { "name": "source_low_V", "type": "float", "unit": "V" },
    { "name": "source_high_V", "type": "float", "unit": "V" },
    { "name": "receiver_low_V", "type": "float", "unit": "V" },
    { "name": "receiver_high_V", "type": "float", "unit": "V" },
    { "name": "interval_known", "type": "boolean" },
