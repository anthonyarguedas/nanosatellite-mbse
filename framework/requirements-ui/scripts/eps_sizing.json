    { "name": "pv_installed_cells", "type": "integer" },
    { "name": "pv_proposed_series", "type": "integer" },
    { "name": "pv_proposed_parallel", "type": "integer" },
    { "name": "pv_generation_bol_W", "type": "float", "unit": "W" },
    { "name": "pv_generation_eol_W", "type": "float", "unit": "W" },
    { "name": "generation_margin_W", "type": "float", "unit": "W" },
    { "name": "active_area_m2", "type": "float", "unit": "m**2" },
