    { "name": "battery_energy_bol_Wh", "type": "float", "unit": "Wh" },
    { "name": "battery_energy_eol_Wh", "type": "float", "unit": "Wh" },
    { "name": "battery_charge_bol_Ah", "type": "float", "unit": "Ah" },
    { "name": "battery_charge_eol_Ah", "type": "float", "unit": "Ah" },
    { "name": "bol_energy_margin_Wh", "type": "float", "unit": "Wh" },
    { "name": "retained_energy_margin_Wh", "type": "float", "unit": "Wh" },
    { "name": "retained_charge_margin_Ah", "type": "float", "unit": "Ah" },
    { "name": "bat_proposed_series", "type": "integer" },
    { "name": "bat_proposed_parallel", "type": "integer" },
