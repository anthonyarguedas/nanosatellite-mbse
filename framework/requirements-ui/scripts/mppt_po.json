{
  "id": "mppt_po",
  "name": "MPPT perturb and observe",
  "description": "Ideal sampled P&O controller for one uniformly illuminated section, using four reference I-V points, temperature and irradiance scaling, a tracking voltage window and one environmental step. Returns energy, settling and input envelope evidence. See analyses/README.md for limits.",
  "inputs": [
    { "name": "voc_ref_V", "type": "float", "unit": "V" },
    { "name": "isc_ref_A", "type": "float", "unit": "A" },
    { "name": "vmp_ref_V", "type": "float", "unit": "V" },
    { "name": "imp_ref_A", "type": "float", "unit": "A" },
    { "name": "reference_irradiance_W_m2", "type": "float", "unit": "W/m**2" },
    { "name": "reference_temperature_C", "type": "float", "unit": "degC" },
    { "name": "voltage_temp_coeff_V_C", "type": "float", "unit": "V/degC" },
    { "name": "current_temp_coeff_per_C", "type": "float", "unit": "1/degC" },
    { "name": "voltage_log_coefficient_V", "type": "float", "unit": "V" },
    { "name": "irradiance_start_W_m2", "type": "float", "unit": "W/m**2" },
    { "name": "irradiance_end_W_m2", "type": "float", "unit": "W/m**2" },
    { "name": "temperature_start_C", "type": "float", "unit": "degC" },
    { "name": "temperature_end_C", "type": "float", "unit": "degC" },
    { "name": "change_time_s", "type": "float", "unit": "s" },
    { "name": "duration_s", "type": "float", "unit": "s" },
    { "name": "sample_period_s", "type": "float", "unit": "s" },
    { "name": "voltage_step_V", "type": "float", "unit": "V" },
    { "name": "initial_voltage_V", "type": "float", "unit": "V" },
    { "name": "tracking_min_V", "type": "float", "unit": "V" },
    { "name": "tracking_max_V", "type": "float", "unit": "V" },
    { "name": "conversion_efficiency", "type": "float" },
    { "name": "settling_relative_band", "type": "float" },
    { "name": "settling_hold_s", "type": "float", "unit": "s" }
  ],
  "outputs": [
    { "name": "available_energy_J", "type": "float", "unit": "J" },
    { "name": "attainable_energy_J", "type": "float", "unit": "J" },
    { "name": "tracked_energy_J", "type": "float", "unit": "J" },
    { "name": "delivered_energy_J", "type": "float", "unit": "J" },
    { "name": "tracking_efficiency", "type": "float" },
    { "name": "capture_efficiency", "type": "float" },
    { "name": "min_mpp_voltage_V", "type": "float", "unit": "V" },
    { "name": "max_mpp_voltage_V", "type": "float", "unit": "V" },
    { "name": "max_open_circuit_voltage_V", "type": "float", "unit": "V" },
    { "name": "max_short_circuit_current_A", "type": "float", "unit": "A" },
    { "name": "min_operating_voltage_V", "type": "float", "unit": "V" },
    { "name": "max_operating_voltage_V", "type": "float", "unit": "V" },
    { "name": "max_input_current_A", "type": "float", "unit": "A" },
    { "name": "settled", "type": "boolean" },
    { "name": "settling_time_s", "type": "float", "unit": "s" },
    { "name": "max_power_error_fraction", "type": "float" },
    { "name": "sample_count", "type": "integer" },
    { "name": "voltage_reversals", "type": "integer" }
  ],
  "timeoutMs": 10000
}
