            package '5 - Architecture' {
                doc /* Source XMI: _19_0_2_3880181_1612801728335_93722_62542
                Comment _19_0_2_3880181_1638718136581_435671_56464 (Explanation)
                Enterprise Activities - Example
                UML kind: uml:Package */
                package 'L1_Enterprise Example' {
                    doc /* Source XMI: _19_0_2_3880181_1612808026045_646380_63573
                    UML kind: uml:Package */
                    package 'L1.1_Behaviors Example' {
                        doc /* Source XMI: _19_0_2_3880181_1612808128312_339919_63574
                        UML kind: uml:Package */
                        package 'L1.1-1 Collect and Distribute Mission Data  - Example' {
                            doc /* Source XMI: _18_5_2_3880181_1510846739316_126224_65163
                            Comment _19_0_2_3880181_1601049195385_674309_62598
                            Not part of the Foundational CSRM.  An illustration of use cases and activities: Collect and Distribute Mission Data.
                            Comment _19_0_3_2b0010b_1619477550432_651341_13241 (Explanation)
                            The Collect and Distribute Mission Data behavior can be described by a text based Use Case description, a Use Case diagram, or an Activity diagram - or all three.
                            UML kind: uml:Package */
                            package 'Collect and Distribute Mission Data - Use Case Example' {
                                doc /* Source XMI: _18_5_2_3880181_1510846739316_658349_65164
                                UML kind: uml:Package */
                                package 'CubeSat Mission Enterprise Example' {
                                    doc /* Source XMI: _18_5_2_3880181_1510846739316_598932_65166
                                    UML kind: uml:Model */
                                    use case def 'Collect Mission Data' {
                                        doc /* Source XMI: _18_5_2_3880181_1510846740816_400311_65303
                                        Comment _18_5_2_3880181_1510846741816_984729_65969
                                        Use Case Name: Collect Mission Data
                                        Scope: CubeSat Enterprise
                                        Primary Actor: Chief Scientist
                                        Supporting Actor: Mission Engineer
                                        Stakeholder: Chief Scientist
                                        Preconditions:
                                        Chief Scientist has provided:
                                        • A “list” of objects for study
                                        • The type of mission data to be collected and studied
                                        • The conditions under which the mission data is to be collected
                                        The CubeSat is:
                                        • On-orbit
                                        • Operating normally
                                        • Has an orbit and sensor capable of collecting the mission data under the specified condition
                                        Trigger: Chief Scientist requests collection of mission data
                                        Postconditions: Requested mission data is received by the Ground Segment
                                        UML kind: uml:UseCase */
                                    }
                                    use case def 'Distribute Mission Data' {
                                        doc /* Source XMI: _18_5_2_3880181_1510846740816_640078_65304
                                        Comment _18_5_2_3880181_1510846741816_95762_65970
                                        Use Case Name: Distribute Mission Data
                                        Scope: CubeSat Enterprise
                                        Primary Actor: Chief Scientist
                                        Supporting Actor: Mission Engineer
                                        Stakeholder: Chief Scientist
                                        Preconditions:  Required mission data has been downlinked to the Ground Segment
                                        Trigger: Notification that required mission data has been received
                                        Postconditions: Chief Scientist has received the required mission data and mission data products
                                        UML kind: uml:UseCase */
                                    }
                                    connection def association_2 {
                                        doc /* Source XMI: _18_5_2_3880181_1510846740816_676798_65305
                                        UML end details are in the source map (SysML v2 connector ends have fixed [1..1] multiplicity). */
                                        end end1 : OfficialCSRM::'Data'::'02 - CSRM Elements, Examples and Illustrations'::'5 - Architecture'::'L1_Enterprise Example'::'L1.1_Behaviors Example'::'L1.1-1 Collect and Distribute Mission Data  - Example'::'Collect and Distribute Mission Data - Use Case Example'::'CubeSat Mission Enterprise Example'::'Distribute Mission Data' {
                                            doc /* Source XMI: _18_5_2_3880181_1510846741816_849640_65971
                                            UML end name: (unnamed) */
                                        }
                                        end end2 : OfficialCSRM::'Data'::'02 - CSRM Elements, Examples and Illustrations'::'5 - Architecture'::'L1_Enterprise Example'::'L1.1_Behaviors Example'::'L1.1-1 Collect and Distribute Mission Data  - Example'::'Actors'::'Chief Scientist' {
